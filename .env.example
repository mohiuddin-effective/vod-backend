# Copy this file to .env for local development.
# On Render, set these under your service's Environment tab instead —
# never commit a real .env file to GitHub.

# Postgres connection string. On Render: create a Postgres instance, then
# copy its "Internal Database URL" here (or External URL for local dev).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=https://effectiveeducationhub.com,https://effectiveeduhub.com

# Only used once, by `npm run seed`, to create the first admin login.
# Pick a strong password — this account can approve courses, verify
# teachers, and trigger payouts.
ADMIN_EMAIL=admin@effectiveeducationhub.com
ADMIN_PASSWORD=

# Already in use by the existing Cloudflare Stream integration.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Powers every "AI" feature on the site (AI Tutor, News Brief, Study Plan,
# Fact Check, Exam Evaluator, ...) via routes/ai.js. Without this set, those
# features return a clear "not configured" error instead of failing silently.
ANTHROPIC_API_KEY=

PORT=10000
