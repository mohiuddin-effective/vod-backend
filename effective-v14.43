<!-- AI SOP CHECKER -->
<section class="hs-sec-light">
  <div class="wrap">
    <div class="sec-hd">
      <div><div class="sec-lbl">AI Tool — বিনামূল্যে</div><h2 class="sec-ttl">AI SOP & CV Checker</h2></div>
    </div>
    <div class="ai-sop-box">
      <div style="display:grid;grid-template-columns:minmax(0,1fr) min(360px,36%);gap:clamp(16px,3vw,36px);align-items:start;">
        <div>
          <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;margin-bottom:8px;">কনসালট্যান্টের কাছে পাঠানোর আগে AI দিয়ে চেক করুন</h3>
          <p style="font-family:'Noto Serif Bengali',serif;font-size:.86rem;color:var(--text2);line-height:1.8;margin-bottom:16px;">আপনার SOP বা CV-এর পাঠ্য নিচে পেস্ট করুন — AI স্বয়ংক্রিয়ভাবে ব্যাকরণ, কাঠামো, স্পষ্টতা এবং ATS স্কোর বিশ্লেষণ করবে।</p>
          <div style="margin-bottom:12px;display:flex;gap:8px;">
            <button class="fpill on" onclick="sopToggle(this,'sop')" id="sopTypeSOP" style="font-size:.75rem;">📄 SOP</button>
            <button class="fpill" onclick="sopToggle(this,'cv')" id="sopTypeCV" style="font-size:.75rem;">📋 CV / Resume</button>
            <button class="fpill" onclick="sopToggle(this,'lor')" id="sopTypeLOR" style="font-size:.75rem;">✉️ LOR</button>
          </div>
          <textarea id="sopText" placeholder="এখানে আপনার SOP, CV বা LOR-এর পাঠ্য পেস্ট করুন… (ইংরেজিতে)" style="width:100%;min-height:160px;padding:14px;border:1.5px solid var(--border2);border-radius:var(--r);font-family:'Outfit',sans-serif;font-size:.85rem;color:var(--text);background:var(--card);resize:vertical;outline:none;transition:border-color .2s;" onfocus="this.style.borderColor='var(--indigo)';" onblur="this.style.borderColor='var(--border2)';"></textarea>
          <div style="margin-top:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <button class="btn-gold" id="sopBtn" onclick="runAISopCheck()">🤖 AI দিয়ে বিশ্লেষণ করুন</button>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
              <span style="background:var(--indigo-dim);border:1px solid rgba(11,69,168,.15);border-radius:20px;padding:2px 10px;font-size:.67rem;color:var(--indigo);font-weight:600;">✓ ATS Score</span>
              <span style="background:var(--green-dim);border:1px solid rgba(26,138,82,.15);border-radius:20px;padding:2px 10px;font-size:.67rem;color:var(--green);font-weight:600;">✓ Grammar</span>
              <span style="background:var(--purple-dim);border:1px solid rgba(91,53,181,.15);border-radius:20px;padding:2px 10px;font-size:.67rem;color:var(--purple);font-weight:600;">✓ Structure</span>
              <span style="background:var(--gold-dim);border:1px solid rgba(184,109,5,.15);border-radius:20px;padding:2px 10px;font-size:.67rem;color:var(--gold);font-weight:600;">✓ Clarity</span>
            </div>
          </div>
          <!-- Loading -->
          <div id="sopLoading" style="display:none;margin-top:16px;text-align:center;padding:18px;">
            <div style="display:inline-flex;align-items:center;gap:12px;background:var(--indigo-dim);border:1px solid rgba(11,69,168,.18);border-radius:10px;padding:14px 24px;">
              <div class="eval-spinner"></div>
              <span style="font-family:'Noto Serif Bengali',serif;color:var(--indigo);font-weight:600;">AI বিশ্লেষণ করছে… একটু অপেক্ষা করুন</span>
            </div>
          </div>
          <!-- Result -->
          <div class="sop-result" id="sopResult" style="margin-top:16px;">
            <div id="sopResultContent"></div>
            <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
              <button class="btn-gold btn-sm" onclick="showToast('বিস্তারিত রিপোর্ট তৈরি হচ্ছে...')">বিস্তারিত রিপোর্ট দেখুন</button>
              <button class="btn-outline btn-sm" onclick="showToast('কনসালট্যান্ট বুকিং খুলছে...')">এক্সপার্ট রিভিউ নিন</button>
            </div>
          </div>
        </div>
        <div>
          <div style="background:#FFFFFF;border:1px solid rgba(11,69,168,.15);border-radius:var(--r2);padding:22px;position:sticky;top:80px;">
            <h4 style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:700;margin-bottom:12px;">📊 আমাদের AI টুলের সাফল্য</h4>
            <div style="display:flex;flex-direction:column;gap:10px;font-family:'Noto Serif Bengali',serif;font-size:.82rem;">
              <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid var(--border);"><span>মোট SOP বিশ্লেষণ</span><strong>১২,৪৫০+</strong></div>
              <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid var(--border);"><span>গড় স্কোর উন্নতি</span><strong style="color:var(--green);">+২৩%</strong></div>
              <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid var(--border);"><span>অ্যাডমিশন সফলতা</span><strong style="color:var(--green);">৭৮%</strong></div>
              <div style="display:flex;justify-content:space-between;"><span>স্কলারশিপ পাওয়ার হার</span><strong style="color:var(--indigo);">৬২%</strong></div>
            </div>
            <div style="margin-top:14px;padding:12px;background:var(--green-dim);border-radius:8px;">
              <p style="font-family:'Noto Serif Bengali',serif;font-size:.77rem;color:var(--green);font-weight:700;">🎉 এই সপ্তাহে ৩৪ জন শিক্ষার্থী অফার লেটার পেয়েছেন!</p>
            </div>
            <div style="margin-top:14px;padding:10px;background:var(--indigo-dim);border-radius:8px;border:1px solid rgba(11,69,168,.12);">
              <p style="font-family:'Noto Serif Bengali',serif;font-size:.74rem;color:var(--indigo);">💡 <strong>টিপস:</strong> ২০০+ শব্দের SOP পেস্ট করলে সবচেয়ে সঠিক বিশ্লেষণ পাবেন।</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

