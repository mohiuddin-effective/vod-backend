};

// District data by division
const JN_DISTRICTS = {
  'ঢাকা':['ঢাকা','গাজীপুর','নারায়ণগঞ্জ','টাঙ্গাইল','মুন্সীগঞ্জ','কিশোরগঞ্জ','ময়মনসিংহ','মানিকগঞ্জ','ফরিদপুর','নরসিংদী'],
  'চট্টগ্রাম':['চট্টগ্রাম','কক্সবাজার','ব্রাহ্মণবাড়িয়া','কুমিল্লা','ফেনী','নোয়াখালী','লক্ষ্মীপুর','চাঁদপুর','রাঙামাটি','খাগড়াছড়ি','বান্দরবান'],
  'রাজশাহী':['রাজশাহী','নওগাঁ','নাটোর','চাঁপাইনবাবগঞ্জ','পাবনা','সিরাজগঞ্জ','বগুড়া','জয়পুরহাট'],
  'খুলনা':['খুলনা','বাগেরহাট','সাতক্ষীরা','যশোর','নড়াইল','মাগুরা','ঝিনাইদহ','কুষ্টিয়া','মেহেরপুর','চুয়াডাঙ্গা'],
  'বরিশাল':['বরিশাল','পটুয়াখালী','ভোলা','পিরোজপুর','ঝালকাঠি','বরগুনা'],
  'সিলেট':['সিলেট','মৌলভীবাজার','হবিগঞ্জ','সুনামগঞ্জ'],
  'ময়মনসিংহ':['ময়মনসিংহ','জামালপুর','শেরপুর','নেত্রকোণা'],
  'রংপুর':['রংপুর','দিনাজপুর','নীলফামারী','গাইবান্ধা','কুড়িগ্রাম','লালমনিরহাট','ঠাকুরগাঁও','পঞ্চগড়'],
};

let jnCurrentRole = 'learner';
let jnCurrentStep = 1;

// ── Role selection ──
function jnRole(role) {
  jnCurrentRole = role;
  jnCurrentStep = 1;

  // Update role cards
  JN_ROLES.forEach(r => {
    document.getElementById('jrc-'+r)?.classList.toggle('on', r===role);
  });

  // Show/hide form wrappers
  JN_ROLES.forEach(r => {
    const fw = document.getElementById('jnf-'+r);
    if (fw) fw.style.display = r===role ? 'block' : 'none';
  });

  // Reset all steps for this role — show step 1 only
  const meta = JN_META[role];
  meta.steps.forEach((_, i) => {
    const s = document.getElementById(`jn-${role}-${i+1}`);
    if (s) {
      s.classList.toggle('active', i===0);
    }
  });

  // Update sidebar
  const sbRole = document.getElementById('jnSbRole');
  if (sbRole) sbRole.textContent = meta.label;
  jnUpdateSidebar(role, 1);
  jnUpdateProgress(role, 1);
  jnUpdateSummary();

  // Scroll to form
  setTimeout(() => {
    document.getElementById('jnShell')?.scrollIntoView({behavior:'smooth', block:'start'});
  }, 80);
}

// ── Step navigation ──
function jnNext(role, currentStep) {
  if (!jnValidateStep(role, currentStep)) return;
  const nextStep = currentStep + 1;
  const meta = JN_META[role];
  if (nextStep > meta.steps.length) return;

  document.getElementById(`jn-${role}-${currentStep}`)?.classList.remove('active');
  document.getElementById(`jn-${role}-${nextStep}`)?.classList.add('active');
  jnCurrentStep = nextStep;
  jnUpdateProgress(role, nextStep);
  jnUpdateSidebar(role, nextStep);
  jnUpdateSummary();
  document.getElementById('jnFormArea')?.scrollIntoView({behavior:'smooth', block:'start'});
}

function jnBack(role, currentStep) {
  const prevStep = currentStep - 1;
  if (prevStep < 1) return;
  document.getElementById(`jn-${role}-${currentStep}`)?.classList.remove('active');
  document.getElementById(`jn-${role}-${prevStep}`)?.classList.add('active');
  jnCurrentStep = prevStep;
  jnUpdateProgress(role, prevStep);
  jnUpdateSidebar(role, prevStep);
  document.getElementById('jnFormArea')?.scrollIntoView({behavior:'smooth', block:'start'});
}

// ── Validation ──
function jnValidateStep(role, step) {
  const panel = document.getElementById(`jn-${role}-${step}`);
  if (!panel) return true;
  let ok = true;

  // Check all required inputs within this step
  panel.querySelectorAll('.jni[id]').forEach(inp => {
    const id = inp.id;
    const type = inp.type || 'text';
    const val  = inp.value.trim();
    const errEl = document.getElementById('e-'+id);
    // Required check — look for .req sibling in parent .jnf
    const isRequired = inp.closest('.jnf')?.querySelector('.req') !== null;
    if (isRequired && !val) {
      inp.classList.add('invalid'); inp.classList.remove('valid');
      if (errEl) errEl.textContent = 'এই তথ্যটি প্রয়োজন';
      ok = false;
      return;
    }
    // Type-specific
    if (val) {
      if (type==='email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        inp.classList.add('invalid'); if (errEl) errEl.textContent = 'সঠিক ইমেইল দিন'; ok=false;
      } else if (type==='password' && val.length<8) {
        inp.classList.add('invalid'); if (errEl) errEl.textContent = 'কমপক্ষে ৮ অক্ষর দিন'; ok=false;
      } else if (type==='tel' && !/^0?1[3-9]\d{8}$/.test(val.replace(/\D/g,''))) {
        inp.classList.add('invalid'); if (errEl) errEl.textContent = 'সঠিক বাংলাদেশি নম্বর দিন'; ok=false;
      } else {
        inp.classList.remove('invalid'); inp.classList.add('valid');
        if (errEl) errEl.textContent = '';
      }
    }
  });

  // Check required chip groups
  panel.querySelectorAll('.jn-chip-row[id]').forEach(row => {
    const errEl = document.getElementById('e-'+row.id);
    if (errEl && row.closest('.jnf')?.querySelector('.req')) {
      if (!row.querySelector('.jnchip.on')) {
        errEl.textContent = 'কমপক্ষে একটি নির্বাচন করুন';
        row.style.outline = '2px solid var(--red)'; row.style.borderRadius='8px';
        ok = false;
      } else {
        errEl.textContent = ''; row.style.outline = '';
      }
    }
  });

  if (!ok) showToast('⚠️ প্রয়োজনীয় তথ্য পূরণ করুন');
  return ok;
}

// ── Live field validation ──
function jnValidate(inp, type) {
  const val = inp.value.trim();
  const errEl = document.getElementById('e-'+inp.id);
  const clear = () => { inp.classList.remove('invalid'); inp.classList.add('valid'); if(errEl) errEl.textContent=''; };
  const err   = (msg) => { inp.classList.add('invalid'); inp.classList.remove('valid'); if(errEl) errEl.textContent=msg; };

  if (!val) { inp.classList.remove('valid','invalid'); if(errEl) errEl.textContent=''; return; }

  if (type==='name'  && val.length<2)  err('নাম কমপক্ষে ২ অক্ষর হতে হবে');
  else if (type==='email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) err('সঠিক ইমেইল লিখুন (যেমন: name@email.com)');
  else if (type==='phone' && !/^0?1[3-9]\d{8}$/.test(val.replace(/\D/g,''))) err('বৈধ বাংলাদেশি নম্বর দিন (যেমন: 01712345678)');
  else if (type==='pass'  && val.length<8) err('কমপক্ষে ৮ অক্ষর প্রয়োজন');
  else clear();
  jnUpdateSummary();
}

// ── Phone formatter ──
function jnFormatPhone(inp) {
  let v = inp.value.replace(/\D/g,'');
  if (v.startsWith('0')) v = v.slice(1);
  if (v.length>11) v = v.slice(0,11);
  inp.value = v;
  jnValidate(inp, 'phone');
}

// ── Age calc ──
function jnCalcAge(inp) {
  const dob = new Date(inp.value);
  if (isNaN(dob)) return;
  const age = Math.floor((Date.now()-dob)/(365.25*24*3600*1000));
  const el = document.getElementById('l-dob-age');
  if (el) el.textContent = `বয়স: আনুমানিক ${age} বছর`;
}

// ── Password strength ──
function jnPassStrength(inp) {
  const v = inp.value;
  const sfx = inp.id.includes('t-') ? '-t' : inp.id.includes('g-') ? '-g' : inp.id.includes('ins-') ? '-ins' : '';
  const barId = sfx ? 'jn-pass-bar'+sfx : 'jn-pass-bar';
  const fillId = sfx ? 'jn-pass-fill'+sfx : 'jn-pass-fill';
  const fill = document.getElementById(fillId) || document.querySelector('.jn-pass-bar>div');
  if (!fill) return;
  let score = 0;
  if (v.length>=8) score++;
  if (/[A-Z]/.test(v)) score++;
  if (/[0-9]/.test(v)) score++;
  if (/[^A-Za-z0-9]/.test(v)) score++;
  const pcts = ['0%','30%','55%','80%','100%'];
  const colors = ['','var(--red)','var(--amber)','var(--gold)','var(--green)'];
  fill.style.width = pcts[score];
  fill.style.background = colors[score];
}

// ── Toggle password visibility ──
function jnTogglePass(inputId, btn) {
  const inp = document.getElementById(inputId);
  if (!inp) return;
  const isPass = inp.type==='password';
  inp.type = isPass ? 'text' : 'password';
  btn.textContent = isPass ? '🙈' : '👁';
}

// ── Photo preview ──
function jnPhotoPreview(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 5*1024*1024) { showToast('⚠️ ছবির আকার সর্বোচ্চ 5MB'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    const preview = document.getElementById('jnPhotoPreview');
    const placeholder = document.getElementById('jnPhotoPlaceholder');
    if (preview) { preview.src=e.target.result; preview.style.display='block'; }
    if (placeholder) placeholder.style.display='none';
  };
  reader.readAsDataURL(file);
}

// ── Chips ──
function jnChipSingle(el, groupId) {
  const row = el.closest('.jn-chip-row');
  row?.querySelectorAll('.jnchip').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
  // Clear error
  const errEl = document.getElementById('e-'+groupId);
  if (errEl) { errEl.textContent=''; if(row) row.style.outline=''; }
  jnUpdateSummary();
}

function jnChipMulti(el) {
  el.classList.toggle('on');
  jnUpdateSummary();
}

// ── District datalist from division ──
function jnLoadDistricts(div, distId) {
  const dl = document.getElementById('districtList');
  if (!dl) return;
  dl.innerHTML = '';
  (JN_DISTRICTS[div]||[]).forEach(d => {
    const opt = document.createElement('option');
    opt.value = d;
    dl.appendChild(opt);
  });
}

// ── Guardian child cards ──
function jnChildCards(n) {
  const container = document.getElementById('jnChildCards');
  if (!container) return;
  const count = Math.min(parseInt(n)||1, 4);
  container.innerHTML = '';
  for (let i=1; i<=count; i++) {
    container.innerHTML += `
      <div class="jn-child-card">
        <div class="jn-child-hd">👦 সন্তান ${i} — বিস্তারিত</div>
        <div class="jn-grid2">
          <div class="jnf"><label class="jnl">নাম</label><input class="jni" placeholder="সন্তানের নাম" id="g-c${i}-name"></div>
          <div class="jnf"><label class="jnl">লিঙ্গ</label><select class="jni"><option>পুরুষ</option><option>মহিলা</option></select></div>
          <div class="jnf"><label class="jnl">শ্রেণি</label><input class="jni" placeholder="যেমন: Class 8, HSC 1st Year"></div>
          <div class="jnf"><label class="jnl">প্রতিষ্ঠান</label><input class="jni" placeholder="স্কুল / কলেজের নাম"></div>
          <div class="jnf"><label class="jnl">গ্রুপ</label><select class="jni"><option>বিজ্ঞান</option><option>ব্যবসায় শিক্ষা</option><option>মানবিক</option><option>প্রযোজ্য নয়</option></select></div>
          <div class="jnf"><label class="jnl">বিষয়ে দুর্বলতা</label><input class="jni" placeholder="যেমন: গণিত, ইংরেজি"></div>
        </div>
      </div>`;
  }
}

// ── Progress bar update ──
function jnUpdateProgress(role, step) {
  const total = JN_META[role].steps.length;
  const pct   = Math.round((step / total) * 100);
  const fill  = document.getElementById('jnProgFill');
  const txt   = document.getElementById('jnProgTxt');
  if (fill) fill.style.width = pct+'%';
  if (txt)  txt.textContent  = `ধাপ ${step} / ${total} — ${JN_META[role].steps[step-1]||''}`;
}

// ── Sidebar step list ──
function jnUpdateSidebar(role, currentStep) {
  const meta = JN_META[role];
  const stepsEl = document.getElementById('jnSbSteps');
  if (!stepsEl) return;
  stepsEl.innerHTML = meta.steps.map((label, i) => {
    const n = i+1;
    const cls = n<currentStep ? 'done' : n===currentStep ? 'active' : '';
    const icon = n<currentStep ? '✓' : n===currentStep ? '●' : n;
    return `<div class="jn-sb-step ${cls}">
      <div class="jn-sb-step-dot">${icon}</div>
      <span>${label}</span>
    </div>`;
  }).join('');
}

// ── Live summary ──
function jnUpdateSummary() {
  const body = document.getElementById('jnSumContent');
  if (!body) return;
  const data = [];
  // Collect filled fields from current form
  const wrap = document.getElementById('jnf-'+jnCurrentRole);
  if (!wrap) return;
  wrap.querySelectorAll('.jni[id]').forEach(inp => {
    if (inp.value.trim() && !['password','file'].includes(inp.type)) {
      const label = inp.closest('.jnf')?.querySelector('.jnl')?.textContent.replace('*','').trim();
      if (label) data.push(`<div style="margin-bottom:5px;"><strong style="font-size:.65rem;color:var(--text3);display:block;">${label}</strong><span style="font-size:.75rem;color:var(--text);">${inp.value.trim().slice(0,32)}</span></div>`);
    }
  });
  // Collect active chips
  const chips = [...wrap.querySelectorAll('.jnchip.on')].map(c=>c.textContent.trim()).slice(0,5);
  if (chips.length) data.push(`<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">${chips.map(c=>`<span style="background:var(--indigo-dim);border:1px solid rgba(11,69,168,.15);border-radius:12px;padding:2px 7px;font-size:.63rem;color:var(--indigo);">${c}</span>`).join('')}</div>`);

  body.innerHTML = data.length ? data.join('') : '<span style="color:var(--text3);font-size:.75rem;">ফর্ম পূরণ করার সাথে সাথে এখানে দেখা যাবে।</span>';
}

// ── Submit ──
async function jnSubmit(role) {
  if (!jnValidateStep(role, jnCurrentStep)) return;

  const meta = JN_META[role];
  const btn  = document.querySelector(`#jnf-${role} .jn-btn-submit`);
  if (btn) { btn.disabled=true; btn.textContent='⏳ সংরক্ষণ হচ্ছে…'; }

  // Collect all chip selections
  const chips = [...(document.getElementById('jnf-'+role)?.querySelectorAll('.jnchip.on')||[])].map(c=>c.textContent.trim());

  // Get name for AI prompt
  const nameEl  = document.getElementById(`${role[0]}-name`) || document.getElementById('ins-name') || document.getElementById('re-org') || document.getElementById('se-biz') || document.getElementById('au-name') || document.getElementById('r-name');
  const goalEl  = document.getElementById('l-goal');
  const name    = nameEl?.value.trim() || 'বন্ধু';
  const goal    = goalEl?.value.trim() || '';

  await new Promise(r => setTimeout(r, 600));

  // Show modal
  const modal = document.getElementById('jnModal');
  document.getElementById('jnModalEmoji').textContent = meta.emoji;
  document.getElementById('jnModalTitle').textContent = meta.title;
  document.getElementById('jnModalBody').textContent  = meta.body;
  document.getElementById('jnModal').classList.add('open');
  document.body.style.overflow = 'hidden';

  // Render chips
  const chipWrap = document.getElementById('jnModalChips');
  if (chipWrap) chipWrap.innerHTML = chips.slice(0,8).map(c=>`<span class="jn-modal-chip">${c}</span>`).join('');

  // Setup action buttons
  const actions = document.getElementById('jnModalActions');
  if (actions) {
    const dest = {learner:'academy', teacher:'teachers', guardian:'dashboard', institution:'dashboard', researcher:'research', author:'publications', seller:'mart', recruiter:'careers'}[role]||'home';
    actions.innerHTML = `
      <button class="btn-gold" onclick="jnCloseModal();go('${dest}')">🚀 ${dest==='academy'?'Academy দেখুন':dest==='teachers'?'Teachers-এ যান':dest==='mart'?'Mart দেখুন':dest==='careers'?'Careers দেখুন':dest==='research'?'Research দেখুন':dest==='publications'?'Publications দেখুন':'Dashboard দেখুন'}</button>
      <button class="btn-outline" onclick="jnCloseModal();go('home')">🏠 হোমপেজে যান</button>`;
  }

  // Fire confetti
  jnConfetti();

  // AI welcome message (learner/teacher only)
  if (['learner','teacher'].includes(role)) {
    const aiBox = document.getElementById('jnAiWelcome');
    const aiTxt = document.getElementById('jnAiWelcomeText');
    if (aiBox) aiBox.style.display='block';

    try {
      const prompt = role==='learner'
        ? `You are Effective AI. Write a warm, motivating 3-sentence personalized welcome message in Bengali for a new learner named "${name}". Their goal: "${goal||'শিক্ষায় উন্নতি'}". Selected interests: ${chips.slice(0,5).join(', ')||'বিভিন্ন বিষয়'}. End with one specific actionable suggestion. Keep it under 80 words. Speak directly to them.`
        : `You are Effective AI. Write a warm 2-sentence welcome message in Bengali for a new teacher named "${name}" who joined Effective EduHub. Their expertise: ${chips.slice(0,4).join(', ')||'শিক্ষাদান'}. Keep it under 60 words, encouraging tone.`;

      const resp = await fetch((window.VOD_API_BASE||'')+'/ai/ask',{
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:200,messages:[{role:'user',content:prompt}]})
      });
      if(!resp.ok) throw new Error('AI unavailable');
      const data = await resp.json();
      const text = data?.content?.map(i=>i.text||'').join('') || '';
      if (text && aiTxt) {
        aiTxt.textContent = text;
        aiTxt.style.display='block';
        aiBox.querySelector('.jn-ai-w-hd').innerHTML='🤖 আপনার AI Personalized Path তৈরি হয়েছে:';
      } else {
        throw new Error('Empty AI response');
      }
    } catch(e) {
      // Graceful offline fallback — show a warm static message instead of hiding
      if (aiTxt) {
        aiTxt.textContent = role==='learner'
          ? `স্বাগতম, ${name}! আপনার শেখার যাত্রা শুরু হলো। প্রথম পদক্ষেপ: Academy-তে গিয়ে আপনার নির্বাচিত বিষয়ের একটি কোর্সে ভর্তি হোন।`
          : `স্বাগতম, ${name}! Effective EduHub পরিবারে আপনাকে পেয়ে আমরা আনন্দিত। আপনার প্রোফাইল যাচাই হলেই শিক্ষার্থীরা আপনাকে খুঁজে পাবেন।`;
        aiTxt.style.display='block';
        if (aiBox) aiBox.querySelector('.jn-ai-w-hd').innerHTML='💬 স্বাগতম বার্তা:';
      }
    }
  }

  if (btn) { btn.disabled=false; btn.textContent='✦ '+btn.textContent.split('✦')[1]?.trim()||'জমা দিন'; }
}

// ── Modal close ──
function jnCloseModal() {
  document.getElementById('jnModal')?.classList.remove('open');
  document.body.style.overflow='';
}

// ── Confetti burst ──
function jnConfetti() {
  const box = document.getElementById('jnConfetti');
  if (!box) return;
  const colors = ['#0B4BA8','#059669','#D97706','#7C3AED','#E11D48'];
  box.innerHTML = '';
  for (let i=0; i<40; i++) {
    const el = document.createElement('div');
    const size = 6+Math.random()*8;
    el.style.cssText = `position:absolute;width:${size}px;height:${size}px;background:${colors[i%colors.length]};border-radius:${Math.random()>.5?'50%':'2px'};left:${Math.random()*100}%;top:${-size}px;animation:confettiFall ${1.2+Math.random()*.8}s ${Math.random()*0.5}s ease-in forwards;opacity:0.85;`;
    box.appendChild(el);
  }
  if (!document.getElementById('confettiStyle')) {
    const s = document.createElement('style');
    s.id='confettiStyle';
    s.textContent='@keyframes confettiFall{0%{transform:translateY(0) rotate(0deg)}100%{transform:translateY(320px) rotate(720deg);opacity:0;}}';
    document.head.appendChild(s);
  }
  setTimeout(()=>{ if(box) box.innerHTML=''; }, 2000);
}

