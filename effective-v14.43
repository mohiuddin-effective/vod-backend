// 🌐 ARTICLE LANGUAGE TOGGLE
// ══════════════════════════════════════════════════════
let articleInEnglish = false;
function toggleArticleLanguage(){
  articleInEnglish = !articleInEnglish;
  const btn = document.getElementById('artTranslateBtn');
  if(!btn) return;
  if(articleInEnglish){
    btn.textContent = '🌐 বাংলা';
    btn.style.background = 'rgba(184,109,5,.25)';
    btn.style.borderColor = 'rgba(184,109,5,.4)';
    showToast('🔄 AI অনুবাদ — Phase 3-এ সম্পূর্ণভাবে পাওয়া যাবে');
  } else {
    btn.textContent = '🌐 English';
    btn.style.background = 'rgba(255,255,255,.1)';
    btn.style.borderColor = 'rgba(255,255,255,.2)';
    showToast('✅ বাংলায় ফিরে এসেছেন');
  }
}

