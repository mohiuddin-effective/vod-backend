// 🪙 GOLD COIN ECONOMY — JS SYSTEM
// ══════════════════════════════════════

// ── Flash Sale Header Timer (live hh:mm:ss, persistent across reloads) ──
(function(){
  const SALE_DURATION_SEC = 3 * 3600; // 3-hour flash sale window
  const STORAGE_KEY = 'eeh_flash_end';
  let endTime;
  try {
    const stored = localStorage.getItem(STORAGE_KEY);
    endTime = stored ? parseInt(stored, 10) : null;
    if(!endTime || endTime < Date.now()) {
      endTime = Date.now() + SALE_DURATION_SEC * 1000;
      localStorage.setItem(STORAGE_KEY, endTime);
    }
  } catch(e) { endTime = Date.now() + SALE_DURATION_SEC * 1000; }

  const el = document.getElementById('flashTimer');
  function updateFlashTimer(){
    if(!el) return;
    const diff = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
    const h = Math.floor(diff / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const s = diff % 60;
    el.textContent = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    if(diff === 0) { el.style.color='var(--red)'; try{ localStorage.removeItem(STORAGE_KEY); }catch(e){} }
  }
  updateFlashTimer();
  setInterval(updateFlashTimer, 1000);
})();

// ── Flash Sale Countdown (days:hours:min:sec to next sale) ──
(function(){
  const SALE2_KEY = 'eeh_flash2_end';
  const SALE2_DURATION = (7*86400)*1000; // 7-day sale window
  let endTime;
  try {
    const stored = localStorage.getItem(SALE2_KEY);
    endTime = stored ? parseInt(stored,10) : null;
    if(!endTime || endTime < Date.now()){
      endTime = Date.now() + SALE2_DURATION;
      localStorage.setItem(SALE2_KEY, endTime);
    }
  } catch(e){ endTime = Date.now() + SALE2_DURATION; }

  const els = { d:'cd-d', h:'cd-h', m:'cd-m', s:'cd-s' };

  function toBengali(n){
    const digits = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
    return String(n).padStart(2,'0').split('').map(c=>digits[+c]).join('');
  }

  function tick(){
    const diff = Math.max(0, Math.floor((endTime - Date.now())/1000));
    const d = Math.floor(diff/86400);
    const h = Math.floor((diff%86400)/3600);
    const m = Math.floor((diff%3600)/60);
    const s = diff%60;
    const upd = (id,v) => { const e=document.getElementById(id); if(e) e.textContent=toBengali(v); };
    upd('cd-d',d); upd('cd-h',h); upd('cd-m',m); upd('cd-s',s);
  }
  tick();
  setInterval(tick, 1000);
})();

// ── Weekly Leaderboard Timer ──
(function(){
  // Count down to next Sunday 00:00
  function updateLeaderTimer(){
    const now = new Date();
    const nextSun = new Date(now);
    nextSun.setDate(now.getDate() + (7 - now.getDay()) % 7 || 7);
    nextSun.setHours(0,0,0,0);
    const diff = Math.max(0, Math.floor((nextSun - now)/1000));
    const h = Math.floor(diff/3600);
    const m = Math.floor((diff%3600)/60);
    const s = diff%60;
    const str = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    document.querySelectorAll('#leaderTimer').forEach(el=>{ if(el) el.textContent=str; });
  }
  updateLeaderTimer();
  setInterval(updateLeaderTimer, 1000);
})();

