<!-- PROFILE EVALUATOR -->
<section class="hs-sec-alt">
  <div class="wrap">
    <div class="sec-hd">
      <div><div class="sec-lbl">AI-Powered</div><h2 class="sec-ttl">প্রোফাইল ইভালুয়েটর</h2></div>
    </div>
    <div class="profile-eval">
      <p style="font-family:'Noto Serif Bengali',serif;font-size:.9rem;color:var(--text2);margin-bottom:22px;">আপনার তথ্য দিন — AI স্বয়ংক্রিয়ভাবে বলবে আপনি কোন স্কলারশিপের জন্য যোগ্য।</p>
      <div class="pe-grid">
        <div class="pe-field"><label class="pe-label">CGPA (4.0 স্কেলে)</label><input class="pe-input" id="evalCgpa" type="number" step="0.01" max="4" placeholder="যেমন: 3.65"></div>
        <div class="pe-field"><label class="pe-label">IELTS স্কোর</label><input class="pe-input" id="evalIelts" type="number" step="0.5" max="9" placeholder="যেমন: 7.0"></div>
        <div class="pe-field"><label class="pe-label">GRE স্কোর (যদি থাকে)</label><input class="pe-input" id="evalGre" type="number" placeholder="যেমন: 320"></div>
        <div class="pe-field"><label class="pe-label">টার্গেট ডিগ্রি</label>
          <select class="pe-select" id="evalDegree">
            <option>Masters</option><option>PhD</option><option>Bachelors</option><option>MBA</option>
          </select>
        </div>
        <div class="pe-field"><label class="pe-label">বিষয়/Subject</label><input class="pe-input" id="evalSubject" placeholder="যেমন: Computer Science, Economics"></div>
        <div class="pe-field"><label class="pe-label">পছন্দের দেশ</label>
          <select class="pe-select" id="evalCountry">
            <option>যেকোনো দেশ</option><option>USA</option><option>UK</option><option>Canada</option><option>Germany</option><option>Australia</option><option>Japan</option>
          </select>
        </div>
      </div>
      <div id="evalPublicationCount" style="display:none;">
        <div class="pe-field"><label class="pe-label">গবেষণা প্রকাশনা (যদি থাকে)</label><input class="pe-input" id="evalPubs" type="number" min="0" placeholder="যেমন: 2"></div>
      </div>
      <button class="btn-gold" onclick="runAIEvaluation()" style="margin-bottom:16px;" id="evalBtn">🔍 AI দিয়ে স্কলারশিপ ম্যাচ বিশ্লেষণ করুন</button>
      <div id="evalLoading" style="display:none;text-align:center;padding:32px;">
        <div style="display:inline-flex;align-items:center;gap:12px;background:var(--indigo-dim);border:1px solid rgba(11,69,168,.18);border-radius:12px;padding:16px 28px;">
          <div class="eval-spinner"></div>
          <span style="font-family:'Noto Serif Bengali',serif;color:var(--indigo);font-weight:600;" id="evalLoadingText">AI আপনার প্রোফাইল বিশ্লেষণ করছে…</span>
        </div>
      </div>
      <div class="pe-result" id="evalResult">
        <div id="evalResultContent"></div>
        <div style="margin-top:14px;display:flex;gap:10px;">
          <button class="btn-gold btn-sm" onclick="showToast('বিস্তারিত রিপোর্ট তৈরি হচ্ছে...')">বিস্তারিত রিপোর্ট ডাউনলোড</button>
          <button class="btn-outline btn-sm" onclick="showToast('কনসালট্যান্ট বুকিং খুলছে...')">কনসালট্যান্টের সাথে কথা বলুন</button>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- APPLICATION TRACKER -->
<section class="hs-sec-light">
  <div class="wrap">
    <div class="sec-hd">
      <div><div class="sec-lbl">Dashboard Feature</div><h2 class="sec-ttl">Application Tracker</h2></div>
      <button class="btn-gold btn-sm" onclick="openAddApp()">+ নতুন বিশ্ববিদ্যালয় যোগ করুন</button>
    </div>

    <!-- Add Application Modal -->
    <div id="addAppModal" style="display:none;background:var(--card);border:1.5px solid var(--border2);border-radius:var(--r2);padding:24px;margin-bottom:24px;box-shadow:var(--shadow-md);">
      <h4 style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:700;margin-bottom:16px;">নতুন আবেদন যোগ করুন</h4>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;margin-bottom:14px;">
        <div><label style="font-size:.72rem;font-weight:600;color:var(--text3);display:block;margin-bottom:4px;">বিশ্ববিদ্যালয়</label><input id="appUni" placeholder="যেমন: MIT" style="width:100%;padding:8px 12px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Outfit',sans-serif;font-size:.83rem;color:var(--text);background:var(--void);outline:none;"></div>
        <div><label style="font-size:.72rem;font-weight:600;color:var(--text3);display:block;margin-bottom:4px;">প্রোগ্রাম</label><input id="appProg" placeholder="যেমন: PhD — CS" style="width:100%;padding:8px 12px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Outfit',sans-serif;font-size:.83rem;color:var(--text);background:var(--void);outline:none;"></div>
        <div><label style="font-size:.72rem;font-weight:600;color:var(--text3);display:block;margin-bottom:4px;">ডেডলাইন</label><input id="appDL" type="date" style="width:100%;padding:8px 12px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Outfit',sans-serif;font-size:.83rem;color:var(--text);background:var(--void);outline:none;"></div>
        <div><label style="font-size:.72rem;font-weight:600;color:var(--text3);display:block;margin-bottom:4px;">স্ট্যাটাস</label>
          <select id="appStatus" style="width:100%;padding:8px 12px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Outfit',sans-serif;font-size:.83rem;color:var(--text);background:var(--void);outline:none;">
            <option value="plan">প্রস্তুতি চলছে</option>
            <option value="sop">SOP লেখা হচ্ছে</option>
            <option value="applied">আবেদন করা হয়েছে</option>
            <option value="interview">ইন্টারভিউ</option>
            <option value="offer">অফার পাওয়া ✅</option>
          </select>
        </div>
      </div>
      <div style="display:flex;gap:10px;">
        <button class="btn-gold btn-sm" onclick="saveApp()">✅ সংরক্ষণ করুন</button>
        <button class="btn-outline btn-sm" onclick="document.getElementById('addAppModal').style.display='none'">বাতিল</button>
      </div>
    </div>

    <div class="tracker-board" id="trackerBoard">
      <!-- Populated by JS -->
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="hs-sec-deep">
  <div class="wrap">
    <div class="sec-hd" style="margin-bottom:48px;">
      <div><div class="sec-lbl">প্রক্রিয়া</div><h2 class="sec-ttl">কীভাবে কাজ করে?</h2></div>
    </div>
    <div class="apply-flow">
      <div class="af-step af-1"><div class="af-num">১</div><div class="af-icon">📋</div><div class="af-title">প্রোফাইল তৈরি</div><div class="af-desc">CGPA, স্কোর ও লক্ষ্য দিন। AI আপনার জন্য সেরা স্কলারশিপ বের করবে।</div></div>
      <div class="af-step af-2"><div class="af-num">২</div><div class="af-icon">🔍</div><div class="af-title">কনসালট্যান্ট বেছে নিন</div><div class="af-desc">ভেরিফায়েড মেন্টর খুঁজুন। রেটিং, বিশ্ববিদ্যালয় ও বিষয় অনুযায়ী ফিল্টার করুন।</div></div>
      <div class="af-step af-3"><div class="af-num">৩</div><div class="af-icon">📅</div><div class="af-title">সেশন বুক করুন</div><div class="af-desc">ক্যালেন্ডার থেকে ফ্রি স্লট দেখুন। Zoom/Meet-এ ভিডিও সেশন নিশ্চিত করুন।</div></div>
      <div class="af-step af-4"><div class="af-num">৪</div><div class="af-icon">🔒</div><div class="af-title">Escrow পেমেন্ট</div><div class="af-desc">Gold Coin বা ক্যাশে পেমেন্ট করুন। কাজ না হলে ১০০% রিফান্ড গ্যারান্টি।</div></div>
      <div class="af-step af-5"><div class="af-num">৫</div><div class="af-icon">🎓</div><div class="af-title">সাফল্য উদযাপন</div><div class="af-desc">Offer Letter পান। EduHub Tribe-এ সাফল্যের গল্প শেয়ার করুন!</div></div>
    </div>

    <!-- Escrow Flow -->
    <div style="margin-top:40px;">
      <h4 style="font-family:'Cormorant Garamond',serif;font-size:1.15rem;font-weight:700;margin-bottom:14px;text-align:center;color:var(--text2);">💳 এসক্রো পেমেন্ট সিস্টেম — আপনার অর্থ সম্পূর্ণ সুরক্ষিত</h4>
      <div class="escrow-flow">
        <div class="ef-node ef-mid"><div class="ef-icon">👨‍🎓</div><div class="ef-label">শিক্ষার্থী</div><div class="ef-sub">পেমেন্ট করলেন</div></div>
        <div class="ef-node" style="background:#FFF8E8;border-color:rgba(184,109,5,.2);"><div class="ef-icon">🔒</div><div class="ef-label">Escrow Hold</div><div class="ef-sub">Effective EduHub-এ লক</div></div>
        <div class="ef-node" style="background:#F0FDF5;border-color:rgba(26,138,82,.15);"><div class="ef-icon">✅</div><div class="ef-label">সার্ভিস ডেলিভারি</div><div class="ef-sub">কনসালট্যান্ট দিলেন</div></div>
        <div class="ef-node" style="background:#EEF4FF;border-color:rgba(11,69,168,.15);"><div class="ef-icon">⭐</div><div class="ef-label">রিভিউ দিলেন</div><div class="ef-sub">শিক্ষার্থী নিশ্চিত করলেন</div></div>
        <div class="ef-node" style="background:#F0FDF5;border-color:rgba(26,138,82,.15);"><div class="ef-icon">💰</div><div class="ef-label">পেমেন্ট রিলিজ</div><div class="ef-sub">কনসালট্যান্ট পেলেন (৮৫%)</div></div>
      </div>
    </div>
  </div>
</section>

