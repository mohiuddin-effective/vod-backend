<!-- ══ RESULTS & AI ANALYSIS PANEL ══ -->
<div class="ex-panel" id="exp-result" style="display:none;">
  <div style="max-width:1100px;margin:0 auto;padding:40px 52px;">
    <div class="sec-hd"><div><div class="sec-lbl">AI Academic Evaluator</div><div class="sec-ttl">আপনার <span class="bn">পারফরম্যান্স</span></div></div></div>

    <!-- Performance summary -->
    <div class="perf-summary-grid">
      <div class="perf-card"><div class="perf-card-n" style="color:var(--indigo);">৮৫%</div><div class="perf-card-l">গড় স্কোর</div><div class="perf-card-sub">শেষ ১০টি পরীক্ষা</div></div>
      <div class="perf-card"><div class="perf-card-n" style="color:var(--green);">২৩</div><div class="perf-card-l">পরীক্ষা সম্পন্ন</div><div class="perf-card-sub">এই মাসে</div></div>
      <div class="perf-card"><div class="perf-card-n" style="color:var(--gold);">২</div><div class="perf-card-l">সার্টিফিকেট</div><div class="perf-card-sub">অর্জিত</div></div>
      <div class="perf-card"><div class="perf-card-n" style="color:var(--teal);">শীর্ষ ৮%</div><div class="perf-card-l">Rank</div><div class="perf-card-sub">BCS বিভাগে</div></div>
    </div>

    <!-- AI Weakness Analyzer -->
    <div class="ai-weakness-box">
      <div class="ai-wb-hd">🤖 AI দুর্বলতা বিশ্লেষক</div>
      <div class="ai-wb-sub">আপনার সাম্প্রতিক পরীক্ষার ভিত্তিতে AI আপনার দুর্বল বিষয়গুলো চিহ্নিত করেছে:</div>
      <div class="ai-wb-chips">
        <div class="ai-wb-chip weak">😰 বাংলাদেশের মুক্তিযুদ্ধ (৪৫%)</div>
        <div class="ai-wb-chip medium">😐 আন্তর্জাতিক সংস্থা (৬২%)</div>
        <div class="ai-wb-chip weak">😰 সংবিধান সংশোধনী (৪৮%)</div>
        <div class="ai-wb-chip strong">💪 বিজ্ঞান ও প্রযুক্তি (৮৮%)</div>
        <div class="ai-wb-chip strong">💪 English Grammar (৮৫%)</div>
        <div class="ai-wb-chip medium">😐 ভূগোল (৬৮%)</div>
      </div>
      <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;">
        <button class="btn-gold" onclick="exRunAIAnalysis()">🤖 সম্পূর্ণ AI বিশ্লেষণ নিন</button>
        <button class="btn-outline" onclick="go('academy')">🎓 দুর্বল বিষয়ে কোর্স করুন</button>
      </div>
      <div id="aiAnalysisResult" style="display:none;margin-top:16px;" class="ai-analysis-box"></div>
    </div>

    <!-- Recent exam history -->
    <div style="margin-top:32px;">
      <div class="sec-lbl" style="margin-bottom:12px;">সাম্প্রতিক পরীক্ষার ইতিহাস</div>
      <div class="exam-history-table">
        <div class="eht-row header"><span>পরীক্ষা</span><span>তারিখ</span><span>স্কোর</span><span>Rank</span><span>Action</span></div>
