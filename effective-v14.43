<section style="background:var(--void);">
  <div class="wrap">
    <div class="sec-hd"><div><div class="sec-lbl" style="color:var(--rose);">📢 Community Feed</div><h2 class="sec-ttl">গ্রুপ <span class="bn">পোস্ট ও আলোচনা</span></h2></div></div>
    <div class="comm-feed-layout">
      <!-- LEFT: Feed -->
      <div>
        <!-- Compose box -->
        <div class="comm-compose">
          <div class="comm-compose-row">
            <div class="comm-av" id="commUserAv">আ</div>
            <input class="comm-compose-input" id="commComposeInput" placeholder="কিছু শেয়ার করুন, প্রশ্ন করুন বা পোস্ট দিন…" onclick="this.focus()">
          </div>
          <input type="file" id="commPhotoFileInput" accept="image/*" style="display:none;" onchange="commHandlePhotoFile(this)">
          <div class="comm-pending-chips" id="commPendingChips" style="display:none;"></div>
          <div class="comm-compose-actions">
            <button class="comm-compose-btn" onclick="commAddPhoto()">📷 ছবি</button>
            <button class="comm-compose-btn" onclick="commAddVideo()">🎥 ভিডিও</button>
            <button class="comm-compose-btn" onclick="commAddMusic()">🎵 গান</button>
            <button class="comm-compose-btn" onclick="commAddFeeling()">😊 ফিলিং</button>
            <button class="comm-compose-btn" onclick="commAddEvent()">📅 ইভেন্ট</button>
            <button class="comm-compose-btn" onclick="commGoLive()">🔴 লাইভ</button>
            <button class="comm-compose-btn" onclick="commAddLocation()">📍 লোকেশন</button>
            <button class="comm-compose-btn" onclick="commAddGif()">🎊 GIF</button>
            <button class="comm-compose-btn" onclick="commAddTag()">🏷️ ট্যাগ</button>
            <button class="comm-compose-btn" onclick="commCompose('question')">❓ প্রশ্ন</button>
            <button class="comm-compose-btn" onclick="commCompose('poll')">📊 পোল</button>
            <button class="comm-compose-btn" style="margin-left:auto;background:var(--rose);color:#fff;" onclick="commSubmitPost()">পোস্ট করুন →</button>
          </div>
        </div>
        <!-- Feed (dynamically rendered) -->
        <div id="commFeed"></div>
      </div>
      <!-- RIGHT: Groups sidebar -->
      <div class="comm-groups-sidebar comm-groups">
        <div class="comm-group-card">
          <div class="comm-group-hd">📚 আপনার গ্রুপসমূহ</div>
          <div id="commGroupList"></div>
        </div>
        <div class="comm-group-card">
          <div class="comm-group-hd">🔍 গ্রুপ খোঁজুন</div>
          <input class="comm-compose-input" placeholder="গ্রুপের নাম লিখুন…" oninput="filterGroups(this.value)" style="width:100%;margin-bottom:8px;">
          <div id="commGroupSearch"></div>
        </div>
        <div class="comm-group-card">
          <div class="comm-group-hd">🔥 ট্রেন্ডিং হ্যাশট্যাগ</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <span onclick="commFilterByTag('BCS')" style="cursor:pointer;background:rgba(0,175,200,.1);color:var(--teal);border:1px solid rgba(0,175,200,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#BCS</span>
            <span onclick="commFilterByTag('IELTS')" style="cursor:pointer;background:rgba(11,69,168,.1);color:var(--indigo);border:1px solid rgba(11,69,168,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#IELTS</span>
            <span onclick="commFilterByTag('HSC')" style="cursor:pointer;background:rgba(192,48,106,.1);color:var(--rose);border:1px solid rgba(192,48,106,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#HSC</span>
            <span onclick="commFilterByTag('ব্যাংক')" style="cursor:pointer;background:rgba(184,109,5,.1);color:var(--gold);border:1px solid rgba(184,109,5,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#ব্যাংক</span>
            <span onclick="commFilterByTag('গণিত')" style="cursor:pointer;background:rgba(26,138,82,.1);color:var(--green);border:1px solid rgba(26,138,82,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#গণিত</span>
            <span onclick="commFilterByTag('SSC')" style="cursor:pointer;background:rgba(224,48,48,.1);color:var(--red);border:1px solid rgba(224,48,48,.2);border-radius:14px;padding:3px 10px;font-size:.7rem;font-weight:600;">#SSC</span>
            <span onclick="commFilterTag=null;renderCommFeed()" style="cursor:pointer;background:var(--deep);color:var(--text3);border-radius:14px;padding:3px 10px;font-size:.7rem;">সব দেখুন</span>
          </div>
        </div>
      </div>
    </div>
  </div>
