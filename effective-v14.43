  <section style="background:var(--deep);">
    <div class="wrap">
      <div class="sec-hd"><div><div class="sec-lbl">রেজিস্ট্রেশন</div><div class="sec-ttl">টিচার হিসেবে <span class="bn">যোগ দিন আজই</span></div></div></div>
      <div class="form-card">
        <div class="form-title">Teacher Registration Form</div>
        <div class="form-sub">ফর্মটি পূরণ করুন। আমাদের টিম ২৪ ঘণ্টার মধ্যে যোগাযোগ করবে।</div>
        <div class="form-grid">
          <div class="form-group"><label class="form-label">পুরো নাম *</label><input class="form-input" id="t-reg-name" placeholder="আপনার নাম লিখুন"></div>
          <div class="form-group"><label class="form-label">মোবাইল নম্বর *</label><input class="form-input" id="t-reg-phone" placeholder="01XXXXXXXXX"></div>
          <div class="form-group"><label class="form-label">ইমেইল *</label><input class="form-input" id="t-reg-email" placeholder="email@example.com"></div>
          <div class="form-group"><label class="form-label">বিষয় / বিশেষত্ব *</label><input class="form-input" id="t-reg-subject" placeholder="যেমন: BCS গণিত, ইংরেজি"></div>
          <div class="form-group"><label class="form-label">শিক্ষাগত যোগ্যতা *</label><select class="form-select" id="t-reg-edu"><option>নির্বাচন করুন</option><option>স্নাতক</option><option>স্নাতকোত্তর</option><option>পিএইচডি</option></select></div>
          <div class="form-group"><label class="form-label">অভিজ্ঞতা</label><select class="form-select" id="t-reg-exp"><option>নির্বাচন করুন</option><option>১-২ বছর</option><option>৩-৫ বছর</option><option>৫+ বছর</option></select></div>
          <div class="form-group full"><label class="form-label">সংক্ষিপ্ত পরিচিতি *</label><textarea class="form-textarea" id="t-reg-bio" placeholder="আপনার সম্পর্কে লিখুন..."></textarea></div>
          <div class="form-group full"><label class="form-label">NID / পাসপোর্ট আপলোড *</label><div class="upload-box"><div class="ub-icon">📄</div><p>ফাইল ড্র্যাগ করুন বা ক্লিক করুন (JPG, PDF)</p></div></div>
          <div class="form-group full"><div class="form-check"><input type="checkbox" id="agreeT"><label for="agreeT">আমি Effective Teachers-এর শর্তাবলি পড়েছি এবং সম্মত হচ্ছি।</label></div></div>
        </div>
        <button class="btn-gold" style="margin-top:20px;width:100%;justify-content:center;" onclick="(function(){
          var name=document.getElementById('t-reg-name').value.trim();
          var phone=document.getElementById('t-reg-phone').value.trim();
          var email=document.getElementById('t-reg-email').value.trim();
          var subject=document.getElementById('t-reg-subject').value.trim();
          var edu=document.getElementById('t-reg-edu').value;
          var exp=document.getElementById('t-reg-exp').value;
          var bio=document.getElementById('t-reg-bio').value.trim();
          var agree=document.getElementById('agreeT').checked;
          if(!name||!phone||!email||!subject){showToast('⚠️ সব তারকা (*) চিহ্নিত ঘর পূরণ করুন');return;}
          if(!agree){showToast('⚠️ শর্তাবলিতে সম্মতি দিন');return;}
          var msg='*Effective Teachers Registration*%0A%0Aনামঃ '+name+'%0Aফোনঃ '+phone+'%0Aইমেইলঃ '+email+'%0Aবিষয়ঃ '+subject+'%0Aশিক্ষাগত যোগ্যতাঃ '+edu+'%0Aঅভিজ্ঞতাঃ '+exp+'%0Aপরিচিতিঃ '+encodeURIComponent(bio);
          window.open('https://wa.me/8801337008899?text='+msg,'_blank');
          showToast('✅ রেজিস্ট্রেশন তথ্য WhatsApp-এ পাঠানো হচ্ছে!');
        })()">রেজিস্ট্রেশন সম্পন্ন করুন →</button>
      </div>
    </div>
  </section>
