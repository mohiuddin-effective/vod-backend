</div>

<!-- ── PHASE PANELS ── -->
<div style="max-width:1400px;margin:0 auto;padding:48px 52px;">

  <!-- PHASE 1 -->
  <div class="bp-panel" id="bpp-1">
    <div class="bp-phase-header">
      <div class="bp-phase-num" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">1</div>
      <div>
        <div class="bp-phase-label">Weeks 1–4</div>
        <h2 class="bp-phase-title">Database Setup &amp; Core Marketplaces</h2>
      </div>
    </div>
    <div class="bp-two-col">
      <!-- Schema -->
      <div>
        <div class="bp-section-lbl">🗄️ PostgreSQL — Hybrid Relational Schema</div>
        <p class="bp-desc">Core user schema with academic reputation, gamification tracking, consultant profiles, and Mart e-commerce tables. Stores availability as JSONB and currency in integer cents to avoid IEEE float errors.</p>
        <div class="bp-code-block" id="code-schema">
          <div class="bp-code-header">
            <span class="bp-lang-badge">SQL</span>
            <span class="bp-filename">schema/core.sql</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-schema')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code><span class="bp-kw">CREATE TABLE</span> users (
    id          <span class="bp-ty">UUID</span> <span class="bp-kw">PRIMARY KEY DEFAULT</span> gen_random_uuid(),
    email       <span class="bp-ty">VARCHAR(255)</span> <span class="bp-kw">UNIQUE NOT NULL</span>,
    full_name   <span class="bp-ty">VARCHAR(255)</span> <span class="bp-kw">NOT NULL</span>,
    reputation_score <span class="bp-ty">INT</span> <span class="bp-kw">DEFAULT</span> <span class="bp-num">100</span>,
    current_streak   <span class="bp-ty">INT</span> <span class="bp-kw">DEFAULT</span> <span class="bp-num">0</span>,
    total_xp         <span class="bp-ty">INT</span> <span class="bp-kw">DEFAULT</span> <span class="bp-num">0</span>,
    last_active_date <span class="bp-ty">DATE</span> <span class="bp-kw">DEFAULT</span> CURRENT_DATE,
    created_at  <span class="bp-ty">TIMESTAMP</span> <span class="bp-kw">DEFAULT</span> CURRENT_TIMESTAMP
);

<span class="bp-cm">-- Consultant Profile Integration</span>
<span class="bp-kw">CREATE TABLE</span> consultants (
    id           <span class="bp-ty">UUID</span> <span class="bp-kw">PRIMARY KEY DEFAULT</span> gen_random_uuid(),
    user_id      <span class="bp-ty">UUID</span> <span class="bp-kw">REFERENCES</span> users(id) <span class="bp-kw">ON DELETE CASCADE</span>,
    bio          <span class="bp-ty">TEXT</span>,
    hourly_rate  <span class="bp-ty">NUMERIC(10,2)</span> <span class="bp-kw">NOT NULL</span>,
    availability_slots <span class="bp-ty">JSONB</span>,
    rating_cache <span class="bp-ty">NUMERIC(3,2)</span> <span class="bp-kw">DEFAULT</span> <span class="bp-num">5.0</span>
);

<span class="bp-cm">-- Effective Mart E-Commerce Core</span>
<span class="bp-kw">CREATE TABLE</span> products (
    id          <span class="bp-ty">UUID</span> <span class="bp-kw">PRIMARY KEY DEFAULT</span> gen_random_uuid(),
    title       <span class="bp-ty">VARCHAR(255)</span> <span class="bp-kw">NOT NULL</span>,
    type        <span class="bp-ty">VARCHAR(50)</span> <span class="bp-kw">CHECK</span> (type <span class="bp-kw">IN</span> (<span class="bp-str">'book'</span>, <span class="bp-str">'course'</span>, <span class="bp-str">'resource'</span>)),
    price       <span class="bp-ty">NUMERIC(10,2)</span> <span class="bp-kw">NOT NULL</span>,
    stock_count <span class="bp-ty">INT</span> <span class="bp-kw">DEFAULT</span> <span class="bp-num">0</span>,
    metadata    <span class="bp-ty">JSONB</span>
);</code></pre>
        </div>
      </div>
      <!-- Gamification -->
      <div>
        <div class="bp-section-lbl">🎮 Redis — Gamification Engine</div>
        <p class="bp-desc">Lightweight cron/middleware worker that fires on every user engagement event. Maintains streak integrity, awards XP per daily activity, and resets to 1 on a missed day — never to 0, preserving motivation.</p>
        <div class="bp-code-block" id="code-gamify">
          <div class="bp-code-header">
            <span class="bp-lang-badge" style="background:rgba(196,32,32,.2);color:#FCA5A5;">TypeScript</span>
            <span class="bp-filename">workers/gamification.ts</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-gamify')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code><span class="bp-kw">async function</span> <span class="bp-fn">handleUserDailyActivity</span>(userId: <span class="bp-ty">string</span>) {
  <span class="bp-kw">const</span> today     = <span class="bp-kw">new</span> Date().toISOString().split(<span class="bp-str">'T'</span>)[<span class="bp-num">0</span>];
  <span class="bp-kw">const</span> yesterday = <span class="bp-kw">new</span> Date(Date.now() - <span class="bp-num">86400000</span>)
                      .toISOString().split(<span class="bp-str">'T'</span>)[<span class="bp-num">0</span>];
  
  <span class="bp-kw">const</span> lastActive = <span class="bp-kw">await</span> redis.<span class="bp-fn">get</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:last_active`</span>);
  
  <span class="bp-kw">if</span> (lastActive === yesterday) {
    <span class="bp-cm">// Streak continues — award streak XP</span>
    <span class="bp-kw">await</span> redis.<span class="bp-fn">incr</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:streak`</span>);
    <span class="bp-kw">await</span> redis.<span class="bp-fn">incrby</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:xp`</span>, <span class="bp-num">50</span>);
  } <span class="bp-kw">else if</span> (lastActive !== today) {
    <span class="bp-cm">// Streak broken — reset to 1</span>
    <span class="bp-kw">await</span> redis.<span class="bp-fn">set</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:streak`</span>, <span class="bp-num">1</span>);
    <span class="bp-kw">await</span> redis.<span class="bp-fn">incrby</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:xp`</span>, <span class="bp-num">10</span>);
  }
  <span class="bp-kw">await</span> redis.<span class="bp-fn">set</span>(<span class="bp-str">`user:<span class="bp-tpl">${userId}</span>:last_active`</span>, today);
}</code></pre>
        </div>
        <!-- Metric callouts -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;">
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--violet);">50 XP</div><div class="bp-metric-lbl">প্রতিটি streak দিনে</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--green);">10 XP</div><div class="bp-metric-lbl">সাধারণ লগইনে</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--indigo);">Redis O(1)</div><div class="bp-metric-lbl">সব অপারেশন</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--gold);">JSONB</div><div class="bp-metric-lbl">ক্যালেন্ডার স্টোরেজ</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- PHASE 2 -->
  <div class="bp-panel" id="bpp-2" style="display:none;">
    <div class="bp-phase-header">
      <div class="bp-phase-num" style="background:linear-gradient(135deg,#0F766E,#0891B2);">2</div>
      <div>
        <div class="bp-phase-label">Weeks 5–8</div>
        <h2 class="bp-phase-title">Forums, Video Streaming &amp; Real-Time Sync</h2>
      </div>
    </div>
    <div class="bp-two-col">
      <!-- Forum voting -->
      <div>
        <div class="bp-section-lbl">🗳️ Express.js — Reddit-Style Voting API</div>
        <p class="bp-desc">Atomic Prisma transaction ensures vote logging, post score update, and author reputation change happen together or not at all. One upvote = +5 reputation points, creating meaningful academic credibility.</p>
        <div class="bp-code-block" id="code-vote">
          <div class="bp-code-header">
            <span class="bp-lang-badge" style="background:rgba(196,32,32,.2);color:#FCA5A5;">TypeScript</span>
            <span class="bp-filename">api/forum/vote.ts</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-vote')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code>app.<span class="bp-fn">post</span>(<span class="bp-str">'/api/forum/vote'</span>, <span class="bp-kw">async</span> (req, res) => {
  <span class="bp-kw">const</span> { userId, postId, voteType } = req.body;
  <span class="bp-kw">const</span> voteValue = voteType === <span class="bp-str">'upvote'</span> ? <span class="bp-num">1</span> : <span class="bp-num">-1</span>;

  <span class="bp-kw">try</span> {
    <span class="bp-kw">await</span> prisma.<span class="bp-fn">$transaction</span>([
      <span class="bp-cm">// 1. Log or toggle the vote</span>
      prisma.postVote.<span class="bp-fn">upsert</span>({
        where: { userId_postId: { userId, postId } },
        update: { type: voteType },
        create: { userId, postId, type: voteType }
      }),
      <span class="bp-cm">// 2. Adjust post net score</span>
      prisma.forumPost.<span class="bp-fn">update</span>({
        where: { id: postId },
        data: { score: { increment: voteValue } }
      }),
      <span class="bp-cm">// 3. Author reputation +5 per upvote</span>
      prisma.users.<span class="bp-fn">update</span>({
        where: { id: req.body.postAuthorId },
        data: { reputation_score: { increment: voteValue * <span class="bp-num">5</span> } }
      })
    ]);
    <span class="bp-kw">return</span> res.<span class="bp-fn">status</span>(<span class="bp-num">200</span>).<span class="bp-fn">json</span>({ success: <span class="bp-kw">true</span> });
  } <span class="bp-kw">catch</span> (error) {
    <span class="bp-kw">return</span> res.<span class="bp-fn">status</span>(<span class="bp-num">500</span>).<span class="bp-fn">json</span>({ error: <span class="bp-str">"Transaction failed"</span> });
  }
});</code></pre>
        </div>
      </div>
      <!-- WebSockets -->
      <div>
        <div class="bp-section-lbl">⚡ Socket.io — Real-Time Study Rooms</div>
        <p class="bp-desc">Discord-style WebSocket gateway powering live text channels and WebRTC peer discovery for study rooms. Doc-update events relay collaborative cursor/text deltas to all room participants in &lt;50ms.</p>
        <div class="bp-code-block" id="code-socket">
          <div class="bp-code-header">
            <span class="bp-lang-badge" style="background:rgba(26,138,82,.2);color:#86EFAC;">TypeScript</span>
            <span class="bp-filename">realtime/gateway.ts</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-socket')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code><span class="bp-kw">import</span> { Server } <span class="bp-kw">from</span> <span class="bp-str">"socket.io"</span>;

<span class="bp-kw">const</span> io = <span class="bp-kw">new</span> <span class="bp-fn">Server</span>(<span class="bp-num">8080</span>, { cors: { origin: <span class="bp-str">"*"</span> } });

io.<span class="bp-fn">on</span>(<span class="bp-str">"connection"</span>, (socket) => {
  <span class="bp-cm">// Study room voice/text channels</span>
  socket.<span class="bp-fn">on</span>(<span class="bp-str">"join-room"</span>, (roomId, userId) => {
    socket.<span class="bp-fn">join</span>(roomId);
    socket.<span class="bp-fn">to</span>(roomId).<span class="bp-fn">emit</span>(<span class="bp-str">"user-connected"</span>, userId);
    
    socket.<span class="bp-fn">on</span>(<span class="bp-str">"disconnect"</span>, () => {
      socket.<span class="bp-fn">to</span>(roomId).<span class="bp-fn">emit</span>(<span class="bp-str">"user-disconnected"</span>, userId);
    });
  });

  <span class="bp-cm">// Collaborative doc — live cursor relay</span>
  socket.<span class="bp-fn">on</span>(<span class="bp-str">"doc-update"</span>, (roomId, delta) => {
    socket.<span class="bp-fn">to</span>(roomId).<span class="bp-fn">emit</span>(<span class="bp-str">"receive-doc-update"</span>, delta);
  });
});</code></pre>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;">
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--teal);">&lt;50ms</div><div class="bp-metric-lbl">ডক আপডেট লেটেন্সি</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--green);">WebRTC</div><div class="bp-metric-lbl">P2P ভয়েস/ভিডিও</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--indigo);">Prisma</div><div class="bp-metric-lbl">টাইপ-সেফ ORM</div></div>
          <div class="bp-metric"><div class="bp-metric-val" style="color:var(--amber);">Atomic</div><div class="bp-metric-lbl">ট্রানজ্যাকশন গ্যারান্টি</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- PHASE 3 -->
  <div class="bp-panel" id="bpp-3" style="display:none;">
    <div class="bp-phase-header">
      <div class="bp-phase-num" style="background:linear-gradient(135deg,#B45309,#D97706);">3</div>
      <div>
        <div class="bp-phase-label">Weeks 9–12</div>
        <h2 class="bp-phase-title">AI Architecture &amp; Knowledge Graphs</h2>
      </div>
    </div>
    <div class="bp-two-col">
      <!-- RAG Tutor -->
      <div>
        <div class="bp-section-lbl">🧠 FastAPI + pgvector — RAG AI Tutor</div>
        <p class="bp-desc">Hallucination-free AI interface anchored to Effective EduHub' verified research, textbooks, and QA knowledge base. Three-step pipeline: embed question → cosine similarity retrieval → GPT-4o synthesis with mandatory citations.</p>
        <div class="bp-code-block" id="code-rag">
          <div class="bp-code-header">
            <span class="bp-lang-badge" style="background:rgba(0,122,148,.2);color:#67E8F9;">Python</span>
            <span class="bp-filename">ai/tutor_endpoint.py</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-rag')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code><span class="bp-kw">from</span> fastapi <span class="bp-kw">import</span> FastAPI
<span class="bp-kw">from</span> pydantic <span class="bp-kw">import</span> BaseModel
<span class="bp-kw">import</span> openai, pgvector

app = <span class="bp-fn">FastAPI</span>()

<span class="bp-kw">class</span> <span class="bp-ty">QueryRequest</span>(BaseModel):
    user_id: <span class="bp-ty">str</span>
    question: <span class="bp-ty">str</span>

<span class="bp-kw">@app.post</span>(<span class="bp-str">"/api/ai/tutor"</span>)
<span class="bp-kw">async def</span> <span class="bp-fn">ask_ai_tutor</span>(request: QueryRequest):
    <span class="bp-cm"># 1. Embed the question</span>
    embed = openai.Embedding.<span class="bp-fn">create</span>(
        input=request.question,
        model=<span class="bp-str">"text-embedding-3-small"</span>
    )
    vec = embed[<span class="bp-str">'data'</span>][<span class="bp-num">0</span>][<span class="bp-str">'embedding'</span>]

    <span class="bp-cm"># 2. Cosine similarity retrieval from pgvector</span>
    docs = db.<span class="bp-fn">execute</span>(
        <span class="bp-str">"SELECT content FROM academic_kb
         ORDER BY embedding <=> %s LIMIT 3"</span>, (vec,)
    )

    <span class="bp-cm"># 3. Synthesize with strict source grounding</span>
    system = (<span class="bp-str">"You are Effective AI Tutor. Use only the papers below. "</span>
              <span class="bp-str">"Cite as (Author, Year)."</span>)
    resp = openai.ChatCompletion.<span class="bp-fn">create</span>(
        model=<span class="bp-str">"gpt-4o"</span>,
        messages=[
            {<span class="bp-str">"role"</span>: <span class="bp-str">"system"</span>, <span class="bp-str">"content"</span>: system},
            {<span class="bp-str">"role"</span>: <span class="bp-str">"user"</span>,   <span class="bp-str">"content"</span>: <span class="bp-str">f"Context: {docs}\nQ: {request.question}"</span>}
        ]
    )
    <span class="bp-kw">return</span> {<span class="bp-str">"answer"</span>: resp.choices[<span class="bp-num">0</span>].message.content}</code></pre>
        </div>
      </div>
      <!-- Neo4j -->
      <div>
        <div class="bp-section-lbl">🕸️ Neo4j — Unified Knowledge Graph</div>
        <p class="bp-desc">The platform's intelligence backbone. Graph relationships map students to courses, courses to recommended books, and learning gaps to targeted interventions — powering AI personalization across all wings.</p>
        <div class="bp-code-block" id="code-neo4j">
          <div class="bp-code-header">
            <span class="bp-lang-badge" style="background:rgba(91,53,181,.2);color:#C4B5FD;">Cypher</span>
            <span class="bp-filename">graph/schema_init.cypher</span>
            <button class="bp-copy-btn" onclick="bpCopy('code-neo4j')">⎘ Copy</button>
          </div>
          <pre class="bp-pre"><code><span class="bp-cm">// Uniqueness constraints</span>
<span class="bp-kw">CREATE CONSTRAINT FOR</span> (u:User) <span class="bp-kw">REQUIRE</span> u.id <span class="bp-kw">IS UNIQUE</span>;
<span class="bp-kw">CREATE CONSTRAINT FOR</span> (c:Course) <span class="bp-kw">REQUIRE</span> c.id <span class="bp-kw">IS UNIQUE</span>;
<span class="bp-kw">CREATE CONSTRAINT FOR</span> (b:Book) <span class="bp-kw">REQUIRE</span> b.id <span class="bp-kw">IS UNIQUE</span>;

<span class="bp-cm">// Enrollment relationship with progress tracking</span>
<span class="bp-kw">MATCH</span> (u:User {id: <span class="bp-str">"user-123"</span>}),
      (c:Course {id: <span class="bp-str">"linear-algebra"</span>})
<span class="bp-kw">CREATE</span> (u)-[:ENROLLED_IN {progress: <span class="bp-num">45</span>}]->(c);

<span class="bp-cm">// Course → Resource recommendation</span>
<span class="bp-kw">MATCH</span> (c:Course {id: <span class="bp-str">"linear-algebra"</span>}),
      (b:Book {id: <span class="bp-str">"strang-math-book"</span>})
<span class="bp-kw">CREATE</span> (c)-[:RECOMMENDS_RESOURCE]->(b);

<span class="bp-cm">// Find all resources for a struggling student</span>
<span class="bp-kw">MATCH</span> (u:User)-[:ENROLLED_IN {progress: p}]->(c:Course)
      -[:RECOMMENDS_RESOURCE]->(r)
<span class="bp-kw">WHERE</span> p &lt; <span class="bp-num">50</span>
<span class="bp-kw">RETURN</span> u.id, c.id, r <span class="bp-kw">LIMIT</span> <span class="bp-num">10</span>;</code></pre>
        </div>
        <div class="bp-info-box" style="margin-top:16px;">
          <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--violet);margin-bottom:8px;">🕸️ গ্রাফ রিলেশনশিপ ম্যাপ</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;font-size:.72rem;font-family:'Outfit',sans-serif;">
            <span class="bp-rel-tag">User → ENROLLED_IN → Course</span>
            <span class="bp-rel-tag">Course → RECOMMENDS_RESOURCE → Book</span>
            <span class="bp-rel-tag">User → AUTHORED → Publication</span>
            <span class="bp-rel-tag">News → RELATED_TO → Course</span>
            <span class="bp-rel-tag">User → MENTORED_BY → Consultant</span>
            <span class="bp-rel-tag">Research → CITES → Research</span>
          </div>
        </div>
      </div>
    </div>
  </div>

