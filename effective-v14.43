<!-- BECOME A CONSULTANT -->
<div class="become-con">
  <div class="bc-in">
    <div>
      <div class="bc-badge">💼 Consultant Program</div>
      <h2 class="bc-title">বিদেশ থেকে <span>আয় করুন</span>,<br>দেশের শিক্ষার্থীদের<br>পথ দেখান</h2>
      <p class="bc-sub">PhD গবেষক, বিদেশি বিশ্ববিদ্যালয়ের শিক্ষার্থী বা অভিজ্ঞ পেশাদার — আপনার জ্ঞান শেয়ার করুন এবং প্রতি মাসে উল্লেখযোগ্য আয় করুন।</p>
      <ul class="bc-benefits">
        <li>নিজের সার্ভিস ফি নিজেই নির্ধারণ করুন</li>
        <li>এসক্রো সিস্টেমে ১০০% পেমেন্ট নিরাপত্তা</li>
        <li>Verified Badge পেয়ে বিশ্বাসযোগ্যতা বাড়ান</li>
        <li>ক্যালেন্ডার ম্যানেজমেন্টে সম্পূর্ণ স্বাধীনতা</li>
        <li>প্রতি সার্ভিসে ৮৫% রেভিনিউ আপনার</li>
      </ul>
      <div class="bc-earn">
        <div class="bc-earn-title">সেরা কনসালট্যান্টদের মাসিক আয়</div>
        <div class="bc-earn-n">৳৫০,০০০+</div>
        <div class="bc-earn-l">টাকা / মাস (পার্ট-টাইম)</div>
        <div style="display:flex;gap:12px;font-size:.78rem;color:rgba(255,255,255,.7);margin-top:6px;">
          <span>প্রতি ঘণ্টা: ৳২০০–৳৩৫০</span>
          <span>·</span>
          <span>গড় ২৫–৩০ সেশন/মাস</span>
        </div>
      </div>
    </div>
    <div>
      <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--r2);padding:28px;">
