  <div id="newsModal" style="display:none;position:fixed;inset:0;z-index:9000;background:rgba(15,10,5,.72);backdrop-filter:blur(10px);padding:20px;overflow-y:auto;" onclick="if(event.target===this)closeArticle()">
    <div style="max-width:780px;margin:0 auto;background:var(--card);border-radius:var(--r2);overflow:hidden;box-shadow:var(--shadow-lg);">
      <div style="background:linear-gradient(135deg,#0F1B2D,#1A2A40);padding:18px 28px;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:10px;">
