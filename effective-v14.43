              <div style="font-family:'Noto Serif Bengali',serif;font-size:.72rem;color:var(--text3);">যেকোনো শিক্ষা বিষয়ে তাজা AI-লেখা সংবাদ সারসংক্ষেপ পান</div>
            </div>
          </div>
          <div style="display:flex;gap:8px;">
            <input id="newsAiTopic" placeholder="বিষয় লিখুন — যেমন: IELTS 2026 বা BCS প্রস্তুতি…" style="flex:1;padding:9px 14px;border:1.5px solid var(--border2);border-radius:8px;font-family:'Noto Serif Bengali',serif;font-size:.83rem;color:var(--text);background:var(--card);outline:none;" onfocus="this.style.borderColor='var(--indigo)'" onblur="this.style.borderColor='var(--border2)'">
            <button class="btn-gold" id="newsAiBtn" onclick="generateAINewsBrief()" style="padding:9px 18px;white-space:nowrap;">✨ Brief তৈরি করুন</button>
          </div>
          <div id="newsAiLoading" style="display:none;margin-top:12px;display:none;align-items:center;gap:8px;">
            <div class="eval-spinner"></div>
            <span style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--indigo);">AI সংবাদ সারসংক্ষেপ তৈরি করছে…</span>
          </div>
          <div id="newsAiResult" style="display:none;margin-top:14px;background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px;font-family:'Noto Serif Bengali',serif;font-size:.83rem;color:var(--text);line-height:1.85;"></div>
        </div>

        <!-- Section title -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
          <div><div style="font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:4px;">সর্বশেষ সংবাদ</div><h2 style="font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:700;">আজকের <em>শিরোনাম</em></h2></div>
          <div style="display:flex;gap:6px;">
            <button style="background:transparent;border:1px solid var(--border2);border-radius:6px;padding:5px 12px;font-size:.72rem;color:var(--text2);" onclick="showToast('সর্বশেষ সংবাদ লোড হচ্ছে...')">🔄 রিফ্রেশ</button>
          </div>
        </div>

        <!-- Article grid -->
        <div id="newsArticleGrid" style="display:flex;flex-direction:column;gap:0;">
          <!-- Articles injected by renderNewsArticles() -->
        </div>

        <div style="text-align:center;margin-top:28px;">
          <button class="btn-outline" onclick="loadMoreNews()" id="newsLoadMoreBtn">আরও সংবাদ দেখুন →</button>
        </div>
      </div>

      <!-- Right sidebar -->
      <div style="position:sticky;top:120px;display:flex;flex-direction:column;gap:18px;">

        <!-- Search -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r2);padding:16px;">
          <div style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1rem;margin-bottom:10px;">🔍 সংবাদ খুঁজুন</div>
          <div style="display:flex;gap:6px;">
            <input id="newsSearchInput" placeholder="কীওয়ার্ড লিখুন…" style="flex:1;padding:7px 11px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--text);background:var(--void);outline:none;" onfocus="this.style.borderColor='var(--red)'" onblur="this.style.borderColor='var(--border2)'" onkeydown="if(event.key==='Enter')newsSearch()">
            <button style="background:var(--red);border:none;border-radius:7px;padding:7px 12px;color:#fff;font-size:.8rem;" onclick="newsSearch()">→</button>
          </div>
        </div>

        <!-- Trending -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r2);padding:18px;">
          <div style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1rem;margin-bottom:14px;display:flex;align-items:center;gap:6px;">🔥 ট্রেন্ডিং</div>
          <div id="newsTrendingList" style="display:flex;flex-direction:column;gap:0;"></div>
        </div>

        <!-- Newsletter CTA -->
        <div style="background:linear-gradient(135deg,#0F1B2D,#1C2A40);border-radius:var(--r2);padding:20px;text-align:center;">
          <div style="font-size:1.6rem;margin-bottom:8px;">📧</div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:6px;">Daily News Digest</div>
          <div style="font-family:'Noto Serif Bengali',serif;font-size:.75rem;color:rgba(255,255,255,.55);margin-bottom:14px;">প্রতিদিন সকালে সেরা শিক্ষা সংবাদ আপনার ইনবক্সে</div>
          <input id="newsEmailInput" placeholder="আপনার ইমেইল…" style="width:100%;padding:8px 12px;border:1px solid rgba(255,255,255,.15);border-radius:7px;background:rgba(255,255,255,.08);color:#fff;font-family:'Outfit',sans-serif;font-size:.8rem;margin-bottom:8px;outline:none;">
          <button style="width:100%;padding:9px;background:var(--red);border:none;border-radius:7px;color:#fff;font-weight:700;font-size:.82rem;" onclick="(function(){var e=document.getElementById('newsEmailInput').value.trim();if(!e||!e.includes('@')){showToast('সঠিক ইমেইল লিখুন');return;}window.open('mailto:effectiveeducationhub@gmail.com?subject=Daily News Digest Subscription&body=আমি Daily News Digest সাবস্ক্রাইব করতে চাই। আমার ইমেইল: '+e,'_blank');showToast('✅ সাবস্ক্রিপশন সম্পন্ন! শীঘ্রই নিশ্চিত করা হবে।');})()">সাবস্ক্রাইব করুন</button>
          <div style="font-size:.66rem;color:rgba(255,255,255,.3);margin-top:6px;">৪৮,০০০+ সাবস্ক্রাইবার</div>
        </div>

        <!-- Tags cloud -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r2);padding:18px;">
          <div style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1rem;margin-bottom:12px;">🏷️ জনপ্রিয় ট্যাগ</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;" id="newsTagCloud"></div>
        </div>

        <!-- Partner Desks -->
        <div style="background:var(--deep);border:1px solid var(--border);border-radius:var(--r2);padding:18px;">
          <div style="font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1rem;margin-bottom:12px;">🗂️ সম্পাদকীয় ডেস্ক</div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <div class="news-desk-item" onclick="newsFilter(document.querySelector('.fpill'),'research')">🔬 Research Desk</div>
            <div class="news-desk-item" onclick="newsFilter(document.querySelector('.fpill'),'tech')">💻 Technology Desk</div>
