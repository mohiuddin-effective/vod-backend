        <div class="eco-link-card" onclick="go('teachers')">
          <div class="elc-icon" style="background:var(--amber-dim);">👩‍🏫</div>
          <div>
            <div class="elc-label" style="color:var(--amber);">Teachers → News</div>
            <div class="elc-title">শিক্ষকরা Effective News-এ কলামিস্ট হোন</div>
            <div class="elc-desc">Effective Teachers প্ল্যাটফর্মের শিক্ষকরা বিশ্লেষক ও অবদানকারী।</div>
          </div>
