    el.textContent = bn;
  }, 3000);
})();





// ══════════════════════════════════════════════════════
// 📱 MOBILE UX IMPROVEMENTS
// ══════════════════════════════════════════════════════

(function() {

// ── Swipe gestures for horizontal tab bars ──
function addSwipeScroll(el) {
  if (!el) return;
  let startX = 0, startScroll = 0, dragging = false;
  el.addEventListener('touchstart', e => {
    startX = e.touches[0].clientX;
    startScroll = el.scrollLeft;
    dragging = true;
  }, { passive: true });
  el.addEventListener('touchmove', e => {
    if (!dragging) return;
    const dx = startX - e.touches[0].clientX;
    el.scrollLeft = startScroll + dx;
  }, { passive: true });
  el.addEventListener('touchend', () => { dragging = false; }, { passive: true });
}

// Apply swipe scroll to all horizontal bars
['awTabs','martTabs','exCatTabs'].forEach(id => addSwipeScroll(document.getElementById(id)));
document.querySelectorAll('.cross-link-bar, .ex-type-bar, .aw-tabs').forEach(el => addSwipeScroll(el));

// ── Active tab scroll-into-view ──
function scrollTabIntoView(tab) {
  if (!tab || window.innerWidth > 768) return;
  tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}

// Patch awSwitch to also scroll tab into view
const _origAwSwitch = typeof awSwitch !== 'undefined' ? awSwitch : null;
if (_origAwSwitch) {
  window.awSwitch = function(el, wing) {
    _origAwSwitch(el, wing);
    scrollTabIntoView(el);
  };
}

// Patch exTypeSwitch similarly
const _origExType = typeof exTypeSwitch !== 'undefined' ? exTypeSwitch : null;
if (_origExType) {
  window.exTypeSwitch = function(el, type) {
    _origExType(el, type);
    if (el) scrollTabIntoView(el);
    // Scroll to top of panel on mobile
    if (window.innerWidth <= 768) {
      setTimeout(() => {
        const bar = document.querySelector('.ex-type-bar');
        if (bar) bar.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
  };
}

// ── Long-press ripple on buttons ──
function ripple(el, e) {
  const rect = el.getBoundingClientRect();
  const touch = e.touches ? e.touches[0] : e;
  const x = (touch.clientX - rect.left);
  const y = (touch.clientY - rect.top);
  const size = Math.max(rect.width, rect.height) * 2;
  const div = document.createElement('div');
  div.style.cssText = `position:absolute;width:${size}px;height:${size}px;left:${x - size/2}px;top:${y - size/2}px;border-radius:50%;background:rgba(255,255,255,.18);transform:scale(0);animation:rippleAnim .5s ease-out;pointer-events:none;`;
  el.style.position = 'relative';
  el.style.overflow = 'hidden';
  el.appendChild(div);
  setTimeout(() => div.remove(), 520);
}

document.addEventListener('pointerdown', e => {
  const btn = e.target.closest('.btn-gold,.ex-start-btn,.mcq-opt,.jn-btn-submit,.jn-btn-next,.app-tab,.cl-chip,.aw-chip');
  if (btn) ripple(btn, e);
}, { passive: true });

// ── Sticky exam type tab highlight on scroll ──
if (window.innerWidth <= 768) {
  const typeBar = document.querySelector('.ex-type-bar');
  if (typeBar) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        typeBar.classList.toggle('scrolled', !e.isIntersecting);
      });
    }, { rootMargin: '-56px 0px 0px 0px' });
    const hero = document.querySelector('.ex-hero');
    if (hero) observer.observe(hero);
  }
}

// ── Double-tap to zoom prevention on buttons (keep single-tap fast) ──
let lastTap = 0;
document.addEventListener('touchend', e => {
  const now = Date.now();
  if (now - lastTap < 300 && e.target.closest('button, .cl-chip, .aw-chip')) {
    e.preventDefault();
  }
  lastTap = now;
}, { passive: false });

// ── Snap active AWing tab to center on mobile ──
document.querySelectorAll('#awTabs .aw-tab').forEach(tab => {
  tab.addEventListener('click', function() {
    scrollTabIntoView(this);
  });
});

// ── Auto-resize textarea on mobile ──
document.querySelectorAll('.written-textarea').forEach(ta => {
  ta.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.max(160, this.scrollHeight) + 'px';
  });
});

// ── Viewport height fix for mobile browsers (address bar) ──
function setVH() {
  document.documentElement.style.setProperty('--vh', `${window.innerHeight * 0.01}px`);
}
setVH();
window.addEventListener('resize', setVH, { passive: true });

// ── Prevent body scroll when overlays are open ──
const _origOpenSearch  = typeof openSearch  !== 'undefined' ? openSearch  : null;
const _origCloseSearch = typeof closeSearch !== 'undefined' ? closeSearch : null;
const _origOpenNotif   = typeof openNotif   !== 'undefined' ? openNotif   : null;
const _origCloseNotif  = typeof closeNotif  !== 'undefined' ? closeNotif  : null;

if (_origOpenSearch)  window.openSearch  = () => { _origOpenSearch();  document.body.style.overflow = 'hidden'; };
if (_origCloseSearch) window.closeSearch = () => { _origCloseSearch(); document.body.style.overflow = ''; };
if (_origOpenNotif)   window.openNotif   = () => { _origOpenNotif();   document.body.style.overflow = 'hidden'; };
if (_origCloseNotif)  window.closeNotif  = () => { _origCloseNotif();  document.body.style.overflow = ''; };

// ── Focus management: scroll input into view on keyboard open ── 
document.querySelectorAll('input, textarea, select').forEach(el => {
  el.addEventListener('focus', function() {
    if (window.innerWidth <= 768) {
      setTimeout(() => this.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
    }
  }, { passive: true });
});

// ── MCQ: swipe left/right between questions on mobile ──
(function mcqSwipe() {
  const livePanel = document.getElementById('exp-mcq-live');
  if (!livePanel) return;
  let sx = 0;
  livePanel.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
  livePanel.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 60) {
      if (dx < 0 && typeof mcqNext !== 'undefined') mcqNext();
      if (dx > 0 && typeof mcqPrev !== 'undefined') mcqPrev();
    }
  }, { passive: true });
})();

})(); // end IIFE

</script>
<!-- ══════════════════════════════════════════════════════════════
     ACADEMY CONTENT HUB (ACH) v1 — upload · approval · monetise
     · Admin-approved IDs only can publish
     · Everything is branded "Effective Academy" (no personal names)
     · Free content = public · Paid content = buyers only
     · Wing-wise + interest-feed distribution
     · Copy / download protection with role-based settings
     · Facebook-style composer: text, photo/video, music,
       feeling/activity, event, live, location, get-message, tag
══════════════════════════════════════════════════════════════ -->
<style>
html{overflow-x:clip;}
.ach-wrap{max-width:1180px;margin:0 auto;padding:0 var(--page-px,20px);}
.ach-sec{background:var(--card);border-top:1px solid var(--border);padding:34px 0 44px;}
.ach-bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:18px;}
.ach-btn{min-height:44px;padding:0 16px;border-radius:12px;border:1px solid var(--border);background:var(--void);color:var(--text);font-size:.82rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:8px;}
.ach-btn:hover{border-color:var(--teal);}
.ach-btn.primary{background:var(--teal);border-color:var(--teal);color:#04222a;}
.ach-btn.ghost{background:transparent;}
.ach-btn.sm{min-height:36px;padding:0 12px;font-size:.74rem;}
.ach-chip{min-height:36px;padding:0 13px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:.74rem;font-weight:600;cursor:pointer;}
.ach-chip.on{background:var(--teal-dim,rgba(0,175,200,.12));border-color:var(--teal);color:var(--teal);}
.ach-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.ach-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));}
.ach-card{background:var(--void);border:1px solid var(--border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;}
.ach-card-hd{display:flex;gap:10px;align-items:center;padding:14px 14px 0;}
.ach-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--teal),#0b6);display:grid;place-items:center;font-size:1rem;flex:0 0 auto;}
.ach-brand{font-weight:700;font-size:.85rem;color:var(--text);}
.ach-meta{font-size:.68rem;color:var(--text3);}
.ach-body{padding:12px 14px;font-family:'Noto Serif Bengali',serif;font-size:.86rem;line-height:1.85;color:var(--text2);white-space:pre-wrap;word-break:break-word;}
.ach-media{position:relative;background:#000;}
.ach-media img,.ach-media video{width:100%;display:block;max-height:340px;object-fit:cover;}
.ach-mark{position:absolute;inset:0;pointer-events:none;display:grid;place-items:center;font-size:.72rem;color:rgba(255,255,255,.30);letter-spacing:.18em;text-transform:uppercase;transform:rotate(-18deg);}
.ach-tags{display:flex;flex-wrap:wrap;gap:6px;padding:0 14px 10px;}
.ach-tag{font-size:.66rem;padding:3px 9px;border-radius:20px;background:var(--teal-dim,rgba(0,175,200,.12));color:var(--teal);}
.ach-foot{margin-top:auto;display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;padding:10px 14px 14px;border-top:1px solid var(--border);}
.ach-price{font-weight:800;font-size:.86rem;color:var(--amber,#c8981e);}
.ach-free{color:var(--emerald,#10b981);}
.ach-lock{padding:26px 14px;text-align:center;}
.ach-lock-blur{filter:blur(6px);opacity:.5;user-select:none;pointer-events:none;max-height:90px;overflow:hidden;}
.ach-badge{font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:20px;border:1px solid var(--border);color:var(--text3);}
.ach-badge.live{border-color:#ef4444;color:#ef4444;}
.ach-badge.pend{border-color:#c8981e;color:#c8981e;}
.ach-badge.ok{border-color:#10b981;color:#10b981;}
/* copy / download protection */
.ach-protect{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;}
.ach-protect img,.ach-protect video{-webkit-user-drag:none;user-drag:none;pointer-events:auto;}
.ach-copyable{-webkit-user-select:text;user-select:text;}
@media print{.ach-protect{display:none!important;}}
/* modal */
.ach-modal{position:fixed;inset:0;background:rgba(0,0,0,.68);z-index:9000;display:none;align-items:flex-start;justify-content:center;padding:24px 14px;overflow-y:auto;}
.ach-modal.on{display:flex;}
.ach-sheet{width:100%;max-width:640px;background:var(--card);border:1px solid var(--border);border-radius:18px;padding:18px;}
.ach-sheet h3{font-family:'Cormorant Garamond',serif;font-size:1.35rem;margin-bottom:4px;}
.ach-lbl{display:block;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);margin:12px 0 6px;}
.ach-in,.ach-sel,.ach-ta{width:100%;min-height:44px;padding:10px 12px;border-radius:11px;border:1px solid var(--border);background:var(--void);color:var(--text);font-size:.86rem;font-family:inherit;}
.ach-ta{min-height:110px;resize:vertical;font-family:'Noto Serif Bengali',serif;line-height:1.8;}
.ach-row{display:flex;gap:10px;flex-wrap:wrap;}
.ach-row>*{flex:1 1 160px;}
.ach-att{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;}
.ach-att button{min-height:40px;}
.ach-note{font-size:.72rem;color:var(--text3);line-height:1.7;margin-top:8px;}
.ach-admin-row{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:10px;border:1px solid var(--border);border-radius:12px;margin-bottom:8px;flex-wrap:wrap;}
.ach-switch{display:flex;align-items:center;gap:8px;font-size:.78rem;color:var(--text2);min-height:44px;}
.ach-empty{padding:26px;text-align:center;color:var(--text3);font-size:.82rem;border:1px dashed var(--border);border-radius:14px;}
</style>

<div class="ach-modal" id="achModal" role="dialog" aria-modal="true" aria-labelledby="achModalTitle">
  <div class="ach-sheet" id="achSheet"></div>
</div>

<script>
/* ACADEMY CONTENT HUB — self-contained, localStorage-backed */
(function(){
  "use strict";
  var KEY='eeh_ach_v1';
  var BRAND='Effective Academy';
  var WINGS=[
    {k:'school',l:'🏫 School'},{k:'college',l:'🎒 College'},{k:'english',l:'🗣️ English'},
    {k:'ict',l:'💻 ICT & AI'},{k:'admission',l:'🎯 Admission'},{k:'job',l:'🏛️ Job'},
    {k:'higher',l:'🌐 Higher Study'},{k:'professional',l:'💼 Professional'}
  ];
  var KINDS=[
    {k:'text',l:'📝 Text'},{k:'media',l:'🖼️ Photo/Video'},{k:'music',l:'🎵 Music'},
    {k:'event',l:'📅 Event'},{k:'live',l:'🔴 Live'}
  ];
  var FEELINGS=['😊 আনন্দিত','💪 উদ্যমী','📚 পড়ছি','🎯 মনোযোগী','🙏 কৃতজ্ঞ','🔥 অনুপ্রাণিত'];

  var DEF={
    settings:{ adminPin:'2580', allowTextCopy:false, allowImageDownload:false,
               copyRoles:{buyer:false,creator:false,admin:true}, watermark:true, autoApprove:false },
    creators:[
      {id:'c_demo1',name:'Rezwana Karim',role:'teacher',email:'teacher@demo',status:'approved'},
      {id:'c_demo2',name:'Shakib Hasan',role:'blogger',email:'blogger@demo',status:'pending'}
    ],
    contents:[],
    purchases:[],
    session:{creatorId:null,admin:false},
    interests:['job','ict']
  };

  var db;
  function load(){
    try{ db=JSON.parse(localStorage.getItem(KEY)||'null'); }catch(e){ db=null; }
    if(!db) db=JSON.parse(JSON.stringify(DEF));
    ['settings','creators','contents','purchases','session'].forEach(function(k){
      if(db[k]==null) db[k]=JSON.parse(JSON.stringify(DEF[k]));
    });
    if(!Array.isArray(db.interests)) db.interests=DEF.interests.slice();
    if(!db.settings.copyRoles) db.settings.copyRoles=JSON.parse(JSON.stringify(DEF.settings.copyRoles));
    if(!db.contents.length) db.contents=seed();
  }
  function save(){ try{ localStorage.setItem(KEY,JSON.stringify(db)); }catch(e){} }
  function uid(p){ return (p||'x')+'_'+Math.random().toString(36).slice(2,9)+Date.now().toString(36); }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function toast(m){ if(typeof window.showToast==='function') window.showToast(m); else console.log(m); }

  function seed(){
    var now=Date.now();
    return [
      {id:uid('ct'),wing:'job',kind:'text',title:'BCS প্রিলি: বাংলা সাহিত্য ৫০ প্রশ্ন',
       body:'বিগত ১০ বছরের BCS প্রিলিমিনারি পরীক্ষায় বাংলা সাহিত্য থেকে বারবার আসা প্রশ্নগুলো একত্রে সাজানো হয়েছে। প্রতিটি প্রশ্নের সাথে সংক্ষিপ্ত ব্যাখ্যা যুক্ত আছে।',
       price:0,tags:['bcs','বাংলা'],status:'approved',ts:now-864e5,creatorId:'c_demo1',feeling:'',
       location:'',eventAt:'',live:false,getMessage:true,tagged:[],media:[]},
      {id:uid('ct'),wing:'ict',kind:'media',title:'Python Crash Course — Module 1',
       body:'Variable, loop, function ও list comprehension — শূন্য থেকে শুরু করে প্রথম প্রজেক্ট পর্যন্ত। প্রিমিয়াম শিক্ষার্থীদের জন্য সম্পূর্ণ ভিডিও ও নোট।',
       price:490,tags:['python','coding'],status:'approved',ts:now-3600e3,creatorId:'c_demo1',feeling:'💪 উদ্যমী',
       location:'Dhaka',eventAt:'',live:false,getMessage:true,tagged:[],media:[]},
      {id:uid('ct'),wing:'english',kind:'live',title:'IELTS Speaking Live Clinic',
       body:'সরাসরি লাইভ ক্লাসে Speaking Part 2 cue card practice। প্রশ্ন করার সুযোগ থাকবে।',
       price:0,tags:['ielts','speaking'],status:'approved',ts:now-7200e3,creatorId:'c_demo2',feeling:'',
       location:'Online',eventAt:'',live:true,getMessage:false,tagged:[],media:[]}
    ];
  }

  /* ── role helpers ───────────────────────────────── */
  function me(){ return db.creators.filter(function(c){return c.id===db.session.creatorId;})[0]||null; }
  function isAdmin(){ return !!db.session.admin; }
  function isApproved(){ var m=me(); return !!(m&&m.status==='approved'); }
  function bought(id){ return db.purchases.indexOf(id)>-1; }
  function canView(c){ return c.price===0 || bought(c.id) || isAdmin(); }
  function myRoleKey(){ return isAdmin()?'admin':(isApproved()?'creator':'buyer'); }
  function canCopy(c){
    if(isAdmin()) return true;
    if(!db.settings.allowTextCopy) return false;
    return !!db.settings.copyRoles[myRoleKey()];
  }
  function canDownload(){
    if(isAdmin()) return true;
    return !!db.settings.allowImageDownload && !!db.settings.copyRoles[myRoleKey()];
  }

  /* ── protection layer ───────────────────────────── */
  function guard(root){
    root.addEventListener('contextmenu',function(e){
      if(e.target.closest('.ach-protect') && !canDownload()){ e.preventDefault(); toast('🔒 এই কনটেন্ট সুরক্ষিত — ডাউনলোড/সেভ বন্ধ।'); }
    });
    root.addEventListener('dragstart',function(e){
      if(e.target.closest('.ach-protect') && !canDownload()) e.preventDefault();
    });
    root.addEventListener('copy',function(e){
      var n=e.target&&e.target.closest?e.target.closest('.ach-protect'):null;
      var sel=document.getSelection();
      if(!n && sel && sel.anchorNode){
        var an=sel.anchorNode.nodeType===1?sel.anchorNode:sel.anchorNode.parentElement;
        n=an&&an.closest?an.closest('.ach-protect'):null;
      }
      if(n && !n.classList.contains('ach-copyable')){ e.preventDefault(); toast('🔒 টেক্সট কপি অনুমোদিত নয়।'); }
    });
  }

  /* ── rendering ──────────────────────────────────── */
  var filterWing='all';
  function visible(){
    return db.contents.filter(function(c){
      if(c.status!=='approved' && !isAdmin() && c.creatorId!==db.session.creatorId) return false;
      return true;
    }).sort(function(a,b){ return b.ts-a.ts; });
  }
  function wingLabel(k){ var w=WINGS.filter(function(x){return x.k===k;})[0]; return w?w.l:k; }
  function tk(n){ return '৳'+n; }

  function cardHTML(c){
    var open=canView(c), copyOk=canCopy(c);
    var head=''+
      '<div class="ach-card-hd"><div class="ach-avatar">🎓</div><div style="min-width:0">'+
      '<div class="ach-brand">'+esc(BRAND)+' <span class="ach-badge ok" style="margin-left:4px">Verified</span></div>'+
      '<div class="ach-meta">'+esc(wingLabel(c.wing))+' · '+new Date(c.ts).toLocaleString('bn-BD')+
      (c.location?' · 📍'+esc(c.location):'')+(c.feeling?' · '+esc(c.feeling):'')+'</div>'+
      '</div></div>';
    var badges='<div style="padding:8px 14px 0;display:flex;gap:6px;flex-wrap:wrap">'+
      (c.live?'<span class="ach-badge live">🔴 Live</span>':'')+
      (c.eventAt?'<span class="ach-badge">📅 '+esc(c.eventAt)+'</span>':'')+
      (c.status!=='approved'?'<span class="ach-badge pend">অনুমোদনের অপেক্ষায়</span>':'')+
      '<span class="ach-badge">'+esc((KINDS.filter(function(k){return k.k===c.kind;})[0]||{l:c.kind}).l)+'</span></div>';

    var media='';
    if(open){
      media=(c.media||[]).map(function(m){
        if(m.type==='video') return '<div class="ach-media"><video src="'+esc(m.src)+'" controls controlsList="nodownload" playsinline></video>'+(db.settings.watermark?'<div class="ach-mark">Effective Academy</div>':'')+'</div>';
        if(m.type==='audio') return '<div style="padding:10px 14px"><audio src="'+esc(m.src)+'" controls controlsList="nodownload" style="width:100%"></audio></div>';
        return '<div class="ach-media"><img src="'+esc(m.src)+'" alt="'+esc(c.title)+'">'+(db.settings.watermark?'<div class="ach-mark">Effective Academy</div>':'')+'</div>';
      }).join('');
    }

    var bodyBlock = open
      ? '<div class="ach-body'+(copyOk?' ach-copyable':'')+'">'+esc(c.body)+'</div>'
      : '<div class="ach-lock"><div class="ach-body ach-lock-blur">'+esc(c.body)+'</div>'+
        '<div style="margin-top:12px;font-size:.82rem;color:var(--text2)">🔒 এই প্রিমিয়াম কনটেন্টটি শুধুমাত্র ক্রেতারা দেখতে পাবেন।</div>'+
        '<button class="ach-btn primary" style="margin-top:12px" data-ach="buy" data-id="'+esc(c.id)+'">'+tk(c.price)+' — কিনুন</button></div>';

    var foot='<div class="ach-foot">'+
      '<span class="ach-price'+(c.price===0?' ach-free':'')+'">'+(c.price===0?'ফ্রি':tk(c.price))+'</span>'+
      '<span style="display:flex;gap:8px;flex-wrap:wrap">'+
      (c.getMessage?'<button class="ach-btn sm" data-ach="msg" data-id="'+esc(c.id)+'">✉️ Get Message</button>':'')+
      ((isAdmin()||c.creatorId===db.session.creatorId)?
        '<button class="ach-btn sm" data-ach="toggleprice" data-id="'+esc(c.id)+'">'+(c.price===0?'💰 পেইড করুন':'🎁 ফ্রি করুন')+'</button>':'')+
      (isAdmin()?
        (c.status!=='approved'?'<button class="ach-btn sm primary" data-ach="approve" data-id="'+esc(c.id)+'">✅ অনুমোদন</button>':'')+
        '<button class="ach-btn sm" data-ach="del" data-id="'+esc(c.id)+'">🗑️</button>':'')+
      '</span></div>';

    var tags=(c.tags&&c.tags.length)?'<div class="ach-tags">'+c.tags.map(function(t){return '<span class="ach-tag">#'+esc(t)+'</span>';}).join('')+'</div>':'';
    return '<article class="ach-card ach-protect'+(copyOk?' ach-copyable':'')+'">'+head+badges+
           '<div style="padding:10px 14px 0;font-weight:700;font-size:.95rem">'+esc(c.title)+'</div>'+
           media+bodyBlock+tags+foot+'</article>';
  }

  function renderFeed(){
    var host=document.getElementById('achFeed'); if(!host) return;
    var list=visible().filter(function(c){ return filterWing==='all'||c.wing===filterWing; });
    host.innerHTML = list.length ? list.map(cardHTML).join('') : '<div class="ach-empty">এই উইং-এ এখনো কনটেন্ট নেই।</div>';
    var iv=document.getElementById('achInterest');
    if(iv){
      var mine=visible().filter(function(c){ return db.interests.indexOf(c.wing)>-1; }).slice(0,6);
      iv.innerHTML = mine.length ? mine.map(cardHTML).join('') : '<div class="ach-empty">আগ্রহের বিষয় নির্বাচন করলে এখানে কনটেন্ট দেখাবে।</div>';
    }
    var st=document.getElementById('achStatus');
    if(st){
      var m=me();
      st.innerHTML = isAdmin()? '🔑 Admin হিসেবে লগইন'
        : m ? ('👤 '+esc(m.name)+' · '+esc(m.role)+' · '+(m.status==='approved'?'<span style="color:var(--emerald,#10b981)">Approved ID</span>':'<span style="color:#c8981e">Pending approval</span>'))
        : 'লগইন করা নেই — ফ্রি কনটেন্ট দেখতে পারবেন।';
    }
  }

  /* ── modals ─────────────────────────────────────── */
  var modal, sheet;
  function openModal(html){ sheet.innerHTML=html; modal.classList.add('on'); }
  function closeModal(){ modal.classList.remove('on'); sheet.innerHTML=''; }

  function loginModal(){
    openModal(
      '<h3 id="achModalTitle">Publisher / Admin Login</h3>'+
      '<p class="ach-note">শুধুমাত্র অ্যাডমিন প্যানেল কর্তৃক অনুমোদিত আইডি থেকেই কনটেন্ট আপলোড করা যাবে।</p>'+
      '<label class="ach-lbl">অনুমোদিত আইডি নির্বাচন</label>'+
      '<select class="ach-sel" id="achLoginId">'+db.creators.map(function(c){
        return '<option value="'+esc(c.id)+'">'+esc(c.name)+' — '+esc(c.role)+' ('+esc(c.status)+')</option>';}).join('')+'</select>'+
      '<div class="ach-row" style="margin-top:12px">'+
      '<button class="ach-btn primary" data-ach="dologin">লগইন</button>'+
      '<button class="ach-btn" data-ach="register">নতুন আইডির আবেদন</button>'+
      '</div>'+
      '<label class="ach-lbl">Admin PIN</label>'+
      '<div class="ach-row"><input class="ach-in" id="achPin" type="password" placeholder="Admin PIN" autocomplete="off">'+
      '<button class="ach-btn" data-ach="adminlogin">🔑 Admin</button></div>'+
      '<div class="ach-row" style="margin-top:12px"><button class="ach-btn ghost" data-ach="logout">লগআউট</button>'+
      '<button class="ach-btn ghost" data-ach="close">বন্ধ</button></div>');
  }

  function registerModal(){
    openModal('<h3>নতুন Publisher আবেদন</h3>'+
      '<p class="ach-note">Teacher, Blogger ও Community সদস্যরা আবেদন করতে পারবেন। অ্যাডমিন অনুমোদনের পরেই আপলোড সক্রিয় হবে।</p>'+
      '<label class="ach-lbl">নাম</label><input class="ach-in" id="achRegName" placeholder="আপনার নাম">'+
      '<label class="ach-lbl">ভূমিকা</label><select class="ach-sel" id="achRegRole">'+
      '<option value="teacher">Teacher</option><option value="blogger">Blogger</option><option value="community">Community Member</option></select>'+
      '<label class="ach-lbl">ইমেইল</label><input class="ach-in" id="achRegMail" type="email" placeholder="mail@example.com">'+
      '<div class="ach-row" style="margin-top:14px"><button class="ach-btn primary" data-ach="doregister">আবেদন পাঠান</button>'+
      '<button class="ach-btn ghost" data-ach="close">বাতিল</button></div>');
  }

  function composerModal(){
    if(!isApproved() && !isAdmin()){ toast('🔒 অনুমোদিত আইডি ছাড়া আপলোড করা যাবে না।'); return loginModal(); }
    openModal('<h3>নতুন কনটেন্ট — Effective Academy</h3>'+
      '<p class="ach-note">প্রকাশ হবে <b>Effective Academy</b> নামে; কোনো ব্যক্তির নাম দেখানো হবে না।</p>'+
      '<label class="ach-lbl">শিরোনাম</label><input class="ach-in" id="achTitle" placeholder="কনটেন্টের শিরোনাম">'+
      '<label class="ach-lbl">টেক্সট</label><textarea class="ach-ta" id="achBody" placeholder="আপনার লেখা, নোট বা কোর্স বিবরণ..."></textarea>'+
      '<div class="ach-att">'+
        '<button class="ach-btn sm" data-ach="pick" data-accept="image/*,video/*">🖼️ Photo/Video</button>'+
        '<button class="ach-btn sm" data-ach="pick" data-accept="audio/*">🎵 Music</button>'+
        '<button class="ach-btn sm" data-ach="feeling">😊 Feeling/Activity</button>'+
        '<button class="ach-btn sm" data-ach="live">🔴 Live</button>'+
      '</div>'+
      '<input type="file" id="achFile" accept="image/*,video/*" multiple style="display:none">'+
      '<div id="achAttInfo" class="ach-note"></div>'+
      '<div class="ach-row" style="margin-top:6px">'+
        '<div><label class="ach-lbl">Wing</label><select class="ach-sel" id="achWing">'+WINGS.map(function(w){return '<option value="'+w.k+'">'+esc(w.l)+'</option>';}).join('')+'</select></div>'+
        '<div><label class="ach-lbl">ধরন</label><select class="ach-sel" id="achKind">'+KINDS.map(function(k){return '<option value="'+k.k+'">'+esc(k.l)+'</option>';}).join('')+'</select></div>'+
      '</div>'+
      '<div class="ach-row">'+
        '<div><label class="ach-lbl">📅 Event (তারিখ/সময়)</label><input class="ach-in" id="achEvent" placeholder="১০ সেপ্টেম্বর, রাত ৯টা"></div>'+
        '<div><label class="ach-lbl">📍 Location</label><input class="ach-in" id="achLoc" placeholder="Dhaka / Online"></div>'+
      '</div>'+
      '<div class="ach-row">'+
        '<div><label class="ach-lbl">🏷️ Tag (কমা দিয়ে)</label><input class="ach-in" id="achTags" placeholder="bcs, বাংলা"></div>'+
        '<div><label class="ach-lbl">👥 Tag People</label><input class="ach-in" id="achPeople" placeholder="@rahim, @karim"></div>'+
      '</div>'+
      '<div class="ach-row">'+
        '<div><label class="ach-lbl">মূল্য (৳, ০ = ফ্রি)</label><input class="ach-in" id="achPrice" type="number" min="0" value="0"></div>'+
        '<div><label class="ach-lbl">Get Message বাটন</label><select class="ach-sel" id="achMsg"><option value="1">চালু</option><option value="0">বন্ধ</option></select></div>'+
      '</div>'+
      '<div class="ach-row" style="margin-top:14px"><button class="ach-btn primary" data-ach="publish">প্রকাশ করুন</button>'+
      '<button class="ach-btn ghost" data-ach="close">বাতিল</button></div>');
    draft={media:[],feeling:'',live:false};
  }

  var draft={media:[],feeling:'',live:false};

  function adminModal(){
    if(!isAdmin()){ toast('🔑 Admin লগইন প্রয়োজন।'); return loginModal(); }
    var s=db.settings;
    openModal('<h3>Admin Panel — Academy Content</h3>'+
      '<label class="ach-lbl">Publisher আইডি অনুমোদন</label>'+
      db.creators.map(function(c){
        return '<div class="ach-admin-row"><span>'+esc(c.name)+' <span class="ach-badge '+(c.status==='approved'?'ok':'pend')+'">'+esc(c.status)+'</span><br><span class="ach-meta">'+esc(c.role)+' · '+esc(c.email||'')+'</span></span>'+
          '<span style="display:flex;gap:6px"><button class="ach-btn sm" data-ach="capprove" data-id="'+esc(c.id)+'">'+(c.status==='approved'?'⛔ Revoke':'✅ Approve')+'</button>'+
          '<button class="ach-btn sm" data-ach="cdel" data-id="'+esc(c.id)+'">🗑️</button></span></div>';
      }).join('')+
      '<label class="ach-lbl">অনুমোদনের অপেক্ষায় থাকা কনটেন্ট</label>'+
      (db.contents.filter(function(c){return c.status!=='approved';}).map(function(c){
        return '<div class="ach-admin-row"><span>'+esc(c.title)+'<br><span class="ach-meta">'+esc(wingLabel(c.wing))+'</span></span>'+
          '<span style="display:flex;gap:6px"><button class="ach-btn sm primary" data-ach="approve" data-id="'+esc(c.id)+'">✅</button>'+
          '<button class="ach-btn sm" data-ach="del" data-id="'+esc(c.id)+'">🗑️</button></span></div>';
      }).join('')||'<div class="ach-empty">কোনো পেন্ডিং কনটেন্ট নেই।</div>')+
      '<label class="ach-lbl">কপি / ডাউনলোড সেটিংস</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achSetText" '+(s.allowTextCopy?'checked':'')+'> টেক্সট কপি অনুমোদিত</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achSetImg" '+(s.allowImageDownload?'checked':'')+'> ইমেজ/মিডিয়া ডাউনলোড অনুমোদিত</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achSetWm" '+(s.watermark?'checked':'')+'> ওয়াটারমার্ক দেখাও</label>'+
      '<label class="ach-lbl">কারা কপি/ডাউনলোড করতে পারবে</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achRoleBuyer" '+(s.copyRoles.buyer?'checked':'')+'> ক্রেতা / শিক্ষার্থী</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achRoleCreator" '+(s.copyRoles.creator?'checked':'')+'> অনুমোদিত Publisher</label>'+
      '<label class="ach-switch"><input type="checkbox" id="achRoleAdmin" checked disabled> Admin (সর্বদা)</label>'+
      '<div class="ach-row" style="margin-top:14px"><button class="ach-btn primary" data-ach="savesettings">সেটিংস সংরক্ষণ</button>'+
      '<button class="ach-btn ghost" data-ach="close">বন্ধ</button></div>');
  }

  function interestModal(){
    openModal('<h3>আপনার আগ্রহের বিষয়</h3><p class="ach-note">নির্বাচিত উইং-এর কনটেন্ট আপনার ফিডে দেখাবে।</p>'+
      WINGS.map(function(w){ return '<label class="ach-switch"><input type="checkbox" class="achInt" value="'+w.k+'" '+(db.interests.indexOf(w.k)>-1?'checked':'')+'> '+esc(w.l)+'</label>'; }).join('')+
      '<div class="ach-row" style="margin-top:12px"><button class="ach-btn primary" data-ach="saveint">সংরক্ষণ</button>'+
      '<button class="ach-btn ghost" data-ach="close">বন্ধ</button></div>');
  }

  /* ── actions ────────────────────────────────────── */
  function readFiles(files){
    Array.prototype.slice.call(files).slice(0,4).forEach(function(f){
      if(f.size>4*1024*1024){ toast('⚠️ ফাইল বড় (৪MB+) — শুধু রেফারেন্স যুক্ত হলো।'); return; }
      var r=new FileReader();
      r.onload=function(){
        var t=f.type.indexOf('video')===0?'video':(f.type.indexOf('audio')===0?'audio':'image');
        draft.media.push({type:t,src:r.result});
        var info=document.getElementById('achAttInfo');
        if(info) info.textContent='সংযুক্ত: '+draft.media.length+'টি ফাইল'+(draft.feeling?' · '+draft.feeling:'')+(draft.live?' · 🔴 Live':'');
      };
      r.readAsDataURL(f);
    });
  }

  function publish(){
    var title=(document.getElementById('achTitle')||{}).value||'';
    var body=(document.getElementById('achBody')||{}).value||'';
    if(!title.trim()){ toast('⚠️ শিরোনাম দিন।'); return; }
    var price=parseInt((document.getElementById('achPrice')||{}).value||'0',10); if(isNaN(price)||price<0) price=0;
    var c={
      id:uid('ct'),
      wing:(document.getElementById('achWing')||{}).value||'school',
      kind:(document.getElementById('achKind')||{}).value||'text',
      title:title.trim(), body:body.trim(), price:price,
      tags:((document.getElementById('achTags')||{}).value||'').split(',').map(function(t){return t.trim();}).filter(Boolean),
      tagged:((document.getElementById('achPeople')||{}).value||'').split(',').map(function(t){return t.trim();}).filter(Boolean),
      eventAt:((document.getElementById('achEvent')||{}).value||'').trim(),
      location:((document.getElementById('achLoc')||{}).value||'').trim(),
      getMessage:((document.getElementById('achMsg')||{}).value||'1')==='1',
      feeling:draft.feeling, live:draft.live, media:draft.media.slice(),
      status:(isAdmin()||db.settings.autoApprove)?'approved':'pending',
      creatorId:db.session.creatorId||'admin', ts:Date.now()
    };
    db.contents.unshift(c); save(); closeModal(); renderFeed();
    toast(c.status==='approved'?'✅ প্রকাশিত হয়েছে — Effective Academy':'📤 জমা হয়েছে, অ্যাডমিন অনুমোদনের অপেক্ষায়।');
  }

  function byId(id){ return db.contents.filter(function(c){return c.id===id;})[0]; }

  function handle(act,el){
    var id=el.getAttribute('data-id');
    switch(act){
      case 'close': closeModal(); break;
      case 'login': loginModal(); break;
      case 'register': registerModal(); break;
      case 'doregister': {
        var n=(document.getElementById('achRegName')||{}).value||'';
        if(!n.trim()){ toast('⚠️ নাম দিন।'); return; }
        db.creators.push({id:uid('c'),name:n.trim(),role:(document.getElementById('achRegRole')||{}).value,
          email:(document.getElementById('achRegMail')||{}).value||'',status:db.settings.autoApprove?'approved':'pending'});
        save(); closeModal(); renderFeed(); toast('📨 আবেদন পাঠানো হয়েছে — অ্যাডমিন অনুমোদনের অপেক্ষায়।'); break; }
      case 'dologin': {
        db.session.creatorId=(document.getElementById('achLoginId')||{}).value; db.session.admin=false;
        save(); closeModal(); renderFeed();
        toast(isApproved()?'✅ লগইন সম্পন্ন — আপলোড সক্রিয়।':'⏳ আইডি এখনো অনুমোদিত নয়।'); break; }
      case 'adminlogin': {
        var pin=(document.getElementById('achPin')||{}).value||'';
        if(pin===db.settings.adminPin){ db.session.admin=true; save(); closeModal(); renderFeed(); adminModal(); toast('🔑 Admin লগইন সফল।'); }
        else toast('❌ ভুল PIN।');
        break; }
      case 'logout': db.session={creatorId:null,admin:false}; save(); closeModal(); renderFeed(); toast('লগআউট হয়েছে।'); break;
      case 'compose': composerModal(); break;
      case 'admin': adminModal(); break;
      case 'interest': interestModal(); break;
      case 'saveint': {
        db.interests=Array.prototype.slice.call(document.querySelectorAll('.achInt:checked')).map(function(i){return i.value;});
        save(); closeModal(); renderFeed(); toast('✅ আগ্রহ সংরক্ষিত।'); break; }
      case 'pick': {
        var f=document.getElementById('achFile'); if(!f) return;
        f.setAttribute('accept', el.getAttribute('data-accept')||'image/*'); f.value=''; f.click(); break; }
      case 'feeling': {
        var cur=FEELINGS.indexOf(draft.feeling);
        draft.feeling=FEELINGS[(cur+1)%FEELINGS.length];
        var i1=document.getElementById('achAttInfo');
        if(i1) i1.textContent='সংযুক্ত: '+draft.media.length+'টি ফাইল · '+draft.feeling+(draft.live?' · 🔴 Live':'');
        break; }
      case 'live': {
        draft.live=!draft.live;
        var i2=document.getElementById('achAttInfo');
        if(i2) i2.textContent='সংযুক্ত: '+draft.media.length+'টি ফাইল'+(draft.feeling?' · '+draft.feeling:'')+(draft.live?' · 🔴 Live চালু':' · Live বন্ধ');
        break; }
      case 'publish': publish(); break;
      case 'buy': {
        var c1=byId(id); if(!c1) return;
        if(!confirm(c1.title+' — '+tk(c1.price)+' দিয়ে কিনতে চান?')) return;
        db.purchases.push(id); save(); renderFeed(); toast('✅ কেনা সম্পন্ন — এখন সম্পূর্ণ কনটেন্ট দেখতে পারবেন।'); break; }
      case 'toggleprice': {
        var c2=byId(id); if(!c2) return;
        if(c2.price===0){ var p=prompt('নতুন মূল্য (৳):','490'); var v=parseInt(p||'0',10); if(!v||v<0) return; c2.price=v; toast('💰 পেইড কনটেন্টে রূপান্তরিত।'); }
        else { c2.price=0; toast('🎁 ফ্রি করে দেওয়া হয়েছে।'); }
        save(); renderFeed(); if(modal.classList.contains('on')) adminModal(); break; }
      case 'approve': { var c3=byId(id); if(c3){ c3.status='approved'; save(); renderFeed(); if(modal.classList.contains('on')) adminModal(); toast('✅ অনুমোদিত।'); } break; }
      case 'del': { db.contents=db.contents.filter(function(x){return x.id!==id;}); save(); renderFeed(); if(modal.classList.contains('on')) adminModal(); toast('🗑️ মুছে ফেলা হয়েছে।'); break; }
      case 'capprove': {
        var cr=db.creators.filter(function(x){return x.id===id;})[0]; if(!cr) return;
        cr.status = cr.status==='approved'?'pending':'approved'; save(); adminModal(); renderFeed(); break; }
      case 'cdel': { db.creators=db.creators.filter(function(x){return x.id!==id;}); if(db.session.creatorId===id) db.session.creatorId=null; save(); adminModal(); renderFeed(); break; }
      case 'savesettings': {
        db.settings.allowTextCopy=!!(document.getElementById('achSetText')||{}).checked;
        db.settings.allowImageDownload=!!(document.getElementById('achSetImg')||{}).checked;
        db.settings.watermark=!!(document.getElementById('achSetWm')||{}).checked;
        db.settings.copyRoles={buyer:!!(document.getElementById('achRoleBuyer')||{}).checked,
                               creator:!!(document.getElementById('achRoleCreator')||{}).checked, admin:true};
        save(); closeModal(); renderFeed(); toast('✅ সেটিংস সংরক্ষিত।'); break; }
      case 'msg': {
        var c4=byId(id);
        openModal('<h3>✉️ Message — Effective Academy</h3><p class="ach-note">'+esc(c4?c4.title:'')+' সম্পর্কে প্রশ্ন পাঠান। উত্তর দেবে Academy সাপোর্ট টিম।</p>'+
          '<textarea class="ach-ta" id="achMsgBody" placeholder="আপনার প্রশ্ন..."></textarea>'+
          '<div class="ach-row" style="margin-top:12px"><button class="ach-btn primary" data-ach="sendmsg">পাঠান</button>'+
          '<button class="ach-btn ghost" data-ach="close">বাতিল</button></div>'); break; }
      case 'sendmsg': closeModal(); toast('✅ বার্তা পাঠানো হয়েছে।'); break;
      case 'wing': {
        filterWing=el.getAttribute('data-wing');
        Array.prototype.slice.call(document.querySelectorAll('#achWingChips .ach-chip')).forEach(function(b){
          b.classList.toggle('on', b.getAttribute('data-wing')===filterWing); });
        renderFeed(); break; }
    }
  }

  /* ── mount ──────────────────────────────────────── */
  function mount(){
    load();
    modal=document.getElementById('achModal'); sheet=document.getElementById('achSheet');
    var page=document.getElementById('page-academy');
    if(!page) return;
    var sec=document.createElement('section');
    sec.className='ach-sec'; sec.id='achSection';
    sec.innerHTML='<div class="ach-wrap">'+
      '<div class="sec-hd"><div><div class="sec-lbl">📤 Academy Content Hub</div>'+
      '<div class="sec-ttl">অনুমোদিত আইডি থেকে <span class="bn">কনটেন্ট আপলোড</span></div></div></div>'+
      '<div class="ach-bar"><div id="achStatus" class="ach-meta"></div>'+
      '<div style="display:flex;gap:8px;flex-wrap:wrap">'+
      '<button class="ach-btn primary" data-ach="compose">➕ কনটেন্ট আপলোড</button>'+
      '<button class="ach-btn" data-ach="login">👤 Publisher Login</button>'+
      '<button class="ach-btn" data-ach="admin">🔑 Admin Panel</button>'+
      '<button class="ach-btn" data-ach="interest">🎯 আগ্রহ</button>'+
      '</div></div>'+
      '<div class="ach-chips" id="achWingChips"><button class="ach-chip on" data-ach="wing" data-wing="all">সব উইং</button>'+
      WINGS.map(function(w){return '<button class="ach-chip" data-ach="wing" data-wing="'+w.k+'">'+esc(w.l)+'</button>';}).join('')+'</div>'+
      '<div class="ach-grid" id="achFeed"></div>'+
      '<div class="sec-hd" style="margin-top:34px"><div><div class="sec-lbl">🎯 আপনার ফিড</div>'+
      '<div class="sec-ttl">আগ্রহ অনুযায়ী <span class="bn">কনটেন্ট</span></div></div></div>'+
      '<div class="ach-grid" id="achInterest"></div>'+
      '</div>';
    page.appendChild(sec);

    document.addEventListener('click',function(e){
      var t=e.target.closest?e.target.closest('[data-ach]'):null;
      if(!t) { if(e.target===modal) closeModal(); return; }
      e.preventDefault(); handle(t.getAttribute('data-ach'), t);
    });
    document.addEventListener('change',function(e){
      if(e.target && e.target.id==='achFile' && e.target.files && e.target.files.length) readFiles(e.target.files);
    });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeModal(); });
    guard(document);
    renderFeed();
    window.EEH_ACH={render:renderFeed,data:function(){return db;}};
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',mount);
  else mount();
})();
</script>

</body>
</html>
