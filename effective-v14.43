<!-- ══ FORM SHELL ══ -->
<div class="jn-shell" id="jnShell">

  <!-- Left: Step sidebar -->
  <div class="jn-sidebar" id="jnSidebar">
    <div class="jn-sb-role" id="jnSbRole">🎓 Learner</div>
    <div class="jn-sb-steps" id="jnSbSteps"></div>
    <div class="jn-sb-summary" id="jnSbSummary">
      <div class="jn-sb-sum-title">📋 আপনার তথ্য</div>
      <div id="jnSumContent" class="jn-sb-sum-body">ফর্ম পূরণ করার সাথে সাথে এখানে দেখা যাবে।</div>
    </div>
    <!-- Trust badges -->
    <div class="jn-trust">
      <div class="jn-trust-item">🔒 SSL সুরক্ষিত</div>
      <div class="jn-trust-item">✅ সম্পূর্ণ বিনামূল্যে</div>
      <div class="jn-trust-item">🤖 AI-পার্সোনালাইজড</div>
      <div class="jn-trust-item">📱 মোবাইল-বান্ধব</div>
    </div>
  </div>

  <!-- Right: Active form panel -->
  <div class="jn-form-area" id="jnFormArea">
    <!-- Progress bar top -->
    <div class="jn-prog-wrap">
      <div class="jn-prog-track"><div class="jn-prog-fill" id="jnProgFill"></div></div>
      <span class="jn-prog-txt" id="jnProgTxt">ধাপ ১</span>
    </div>

    <!-- ══ LEARNER STEPS ══ -->
    <div id="jnf-learner" class="jnf-role-wrap">

      <!-- Step 1: Basic Info -->
      <div class="jn-step active" id="jn-learner-1" data-title="মৌলিক তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>ব্যক্তিগত তথ্য</span></div>

        <!-- Photo upload -->
        <div class="jn-photo-row">
          <div class="jn-photo-wrap" id="jnPhotoWrap" onclick="document.getElementById('jnPhotoInput').click()">
            <div class="jn-photo-placeholder" id="jnPhotoPlaceholder">📷<br><span>ছবি আপলোড</span></div>
            <img id="jnPhotoPreview" class="jn-photo-preview" style="display:none;" alt="Profile">
          </div>
          <input type="file" id="jnPhotoInput" accept="image/*" style="display:none;" onchange="jnPhotoPreview(this)">
          <div class="jn-photo-hint">প্রোফাইল ছবি (ঐচ্ছিক)<br><span>JPG/PNG · সর্বোচ্চ ৫MB</span></div>
        </div>

        <div class="jn-grid2">
          <div class="jnf" id="v-l-name">
            <label class="jnl">পূর্ণ নাম <span class="req">*</span></label>
            <input class="jni" id="l-name" placeholder="আপনার সম্পূর্ণ নাম" oninput="jnValidate(this,'name')" onblur="jnValidate(this,'name')">
            <span class="jn-err" id="e-l-name"></span>
          </div>
          <div class="jnf" id="v-l-gender">
            <label class="jnl">লিঙ্গ</label>
            <div class="jn-chip-row">
              <button class="jnchip" onclick="jnChipSingle(this,'l-gender')">পুরুষ</button>
              <button class="jnchip" onclick="jnChipSingle(this,'l-gender')">মহিলা</button>
              <button class="jnchip" onclick="jnChipSingle(this,'l-gender')">অন্যান্য</button>
            </div>
          </div>
          <div class="jnf" id="v-l-dob">
            <label class="jnl">জন্ম তারিখ</label>
            <input class="jni" id="l-dob" type="date" onchange="jnCalcAge(this)" max="2015-01-01">
            <span class="jn-hint" id="l-dob-age"></span>
          </div>
          <div class="jnf" id="v-l-phone">
            <label class="jnl">ফোন নম্বর <span class="req">*</span></label>
            <div class="jni-group">
              <span class="jni-prefix">🇧🇩 +880</span>
              <input class="jni jni-with-prefix" id="l-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)" onblur="jnValidate(this,'phone')">
            </div>
            <span class="jn-err" id="e-l-phone"></span>
          </div>
          <div class="jnf" id="v-l-email">
            <label class="jnl">ইমেইল</label>
            <input class="jni" id="l-email" type="email" placeholder="example@gmail.com" oninput="jnValidate(this,'email')" onblur="jnValidate(this,'email')">
            <span class="jn-err" id="e-l-email"></span>
          </div>
          <div class="jnf" id="v-l-pass">
            <label class="jnl">পাসওয়ার্ড <span class="req">*</span></label>
            <div class="jni-group">
              <input class="jni jni-pass" id="l-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর" oninput="jnPassStrength(this)" onblur="jnValidate(this,'pass')">
              <button class="jni-eye" onclick="jnTogglePass('l-pass',this)" type="button">👁</button>
            </div>
            <div class="jn-pass-bar" id="jn-pass-bar"><div id="jn-pass-fill"></div></div>
            <span class="jn-hint" id="jn-pass-hint">অক্ষর, সংখ্যা ও চিহ্ন ব্যবহার করুন</span>
            <span class="jn-err" id="e-l-pass"></span>
          </div>
        </div>
        <div class="jn-nav"><button class="jn-btn-next" onclick="jnNext('learner',1)">পরবর্তী →</button></div>
      </div>

      <!-- Step 2: Academic -->
      <div class="jn-step" id="jn-learner-2" data-title="শিক্ষাগত তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">২</span><span>শিক্ষাগত তথ্য ও অবস্থান</span></div>
        <div class="jnf">
          <label class="jnl">বর্তমান শিক্ষার স্তর <span class="req">*</span></label>
          <div class="jn-chip-row wrap" id="l-level">
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">প্রি-স্কুল</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Class 1–5</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Class 6–8</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Class 9–10</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">SSC Candidate</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Class 11–12</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">HSC Candidate</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Admission Candidate</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Diploma</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Bachelor</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Masters</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Job Seeker</button>
            <button class="jnchip" onclick="jnChipSingle(this,'l-level')">Open Learner</button>
          </div>
          <span class="jn-err" id="e-l-level"></span>
        </div>
        <div class="jn-grid2">
          <div class="jnf">
            <label class="jnl">প্রতিষ্ঠানের নাম</label>
            <input class="jni" id="l-inst" placeholder="স্কুল / কলেজ / বিশ্ববিদ্যালয়">
          </div>
          <div class="jnf">
            <label class="jnl">শাখা / গ্রুপ</label>
            <select class="jni" id="l-group">
              <option value="">নির্বাচন করুন</option>
              <option>বিজ্ঞান</option><option>ব্যবসায় শিক্ষা</option>
              <option>মানবিক</option><option>অন্যান্য</option>
            </select>
          </div>
          <div class="jnf">
            <label class="jnl">বিভাগ <span class="req">*</span></label>
            <select class="jni" id="l-div" onchange="jnLoadDistricts(this.value,'l-dist')">
              <option value="">নির্বাচন করুন</option>
              <option>ঢাকা</option><option>চট্টগ্রাম</option><option>রাজশাহী</option>
              <option>খুলনা</option><option>বরিশাল</option><option>সিলেট</option>
              <option>ময়মনসিংহ</option><option>রংপুর</option>
            </select>
            <span class="jn-err" id="e-l-div"></span>
          </div>
          <div class="jnf">
            <label class="jnl">জেলা</label>
            <input class="jni" id="l-dist" placeholder="আপনার জেলার নাম" list="districtList">
            <datalist id="districtList"></datalist>
          </div>
          <div class="jnf">
            <label class="jnl">উপজেলা</label>
            <input class="jni" id="l-upa" placeholder="উপজেলার নাম">
          </div>
          <div class="jnf">
            <label class="jnl">গ্রাম / এলাকা</label>
            <input class="jni" id="l-village" placeholder="গ্রাম বা এলাকার নাম">
          </div>
        </div>
        <div class="jnf" style="margin-top:16px;">
          <label class="jnl">পছন্দের বিষয়সমূহ (একাধিক নির্বাচন করুন)</label>
          <div class="jn-chip-row wrap" id="l-subjects">
            <button class="jnchip" onclick="jnChipMulti(this)">গণিত</button>
            <button class="jnchip" onclick="jnChipMulti(this)">ইংরেজি</button>
            <button class="jnchip" onclick="jnChipMulti(this)">পদার্থবিজ্ঞান</button>
            <button class="jnchip" onclick="jnChipMulti(this)">রসায়ন</button>
            <button class="jnchip" onclick="jnChipMulti(this)">জীববিজ্ঞান</button>
            <button class="jnchip" onclick="jnChipMulti(this)">ICT</button>
            <button class="jnchip" onclick="jnChipMulti(this)">Programming</button>
            <button class="jnchip" onclick="jnChipMulti(this)">বাংলা</button>
            <button class="jnchip" onclick="jnChipMulti(this)">ব্যবসায় শিক্ষা</button>
            <button class="jnchip" onclick="jnChipMulti(this)">ইসলাম শিক্ষা</button>
          </div>
        </div>
        <div class="jn-nav">
          <button class="jn-btn-back" onclick="jnBack('learner',2)">← পূর্ববর্তী</button>
          <button class="jn-btn-next" onclick="jnNext('learner',2)">পরবর্তী →</button>
        </div>
      </div>

      <!-- Step 3: Preferences & AI -->
      <div class="jn-step" id="jn-learner-3" data-title="শেখার পছন্দ">
        <div class="jn-step-hd"><span class="jn-step-num">৩</span><span>শেখার পছন্দ ও ক্যারিয়ার লক্ষ্য</span></div>
        <div class="jn-grid2">
          <div class="jnf">
            <label class="jnl">শেখার পদ্ধতি</label>
            <div class="jn-chip-row" id="l-mode">
              <button class="jnchip" onclick="jnChipSingle(this,'l-mode')">অনলাইন</button>
              <button class="jnchip" onclick="jnChipSingle(this,'l-mode')">অফলাইন</button>
              <button class="jnchip on" onclick="jnChipSingle(this,'l-mode')">হাইব্রিড</button>
            </div>
          </div>
          <div class="jnf">
            <label class="jnl">সাপ্তাহিক পড়ার সময়</label>
            <select class="jni" id="l-hours">
              <option>১–৫ ঘণ্টা</option><option>৫–১০ ঘণ্টা</option>
              <option>১০–২০ ঘণ্টা</option><option>২০+ ঘণ্টা</option>
            </select>
          </div>
          <div class="jnf">
            <label class="jnl">পছন্দের ভাষা</label>
            <div class="jn-chip-row" id="l-lang">
              <button class="jnchip on" onclick="jnChipSingle(this,'l-lang')">বাংলা</button>
              <button class="jnchip" onclick="jnChipSingle(this,'l-lang')">English</button>
              <button class="jnchip" onclick="jnChipSingle(this,'l-lang')">বাংলা + English</button>
            </div>
          </div>
          <div class="jnf">
            <label class="jnl">পছন্দের শেখার ধরন</label>
            <select class="jni" id="l-style">
              <option>ভিডিও লেকচার</option><option>পাঠ্য + নোটস</option>
              <option>অনুশীলন প্রশ্ন</option><option>লাইভ ক্লাস</option><option>মিশ্রিত</option>
            </select>
          </div>
        </div>
        <div class="jnf" style="margin-top:14px;">
          <label class="jnl">ক্যারিয়ার আগ্রহ (একাধিক)</label>
          <div class="jn-chip-row wrap" id="l-career">
            <button class="jnchip" onclick="jnChipMulti(this)">Medical / MBBS</button>
            <button class="jnchip" onclick="jnChipMulti(this)">Engineering / BUET</button>
            <button class="jnchip" onclick="jnChipMulti(this)">BCS / সরকারি চাকরি</button>
            <button class="jnchip" onclick="jnChipMulti(this)">বিশ্ববিদ্যালয় ভর্তি</button>
            <button class="jnchip" onclick="jnChipMulti(this)">IT / Software</button>
            <button class="jnchip" onclick="jnChipMulti(this)">Business / MBA</button>
            <button class="jnchip" onclick="jnChipMulti(this)">Teaching</button>
            <button class="jnchip" onclick="jnChipMulti(this)">Research / PhD</button>
            <button class="jnchip" onclick="jnChipMulti(this)">উদ্যোক্তা</button>
            <button class="jnchip" onclick="jnChipMulti(this)">AI / Data Science</button>
          </div>
        </div>
        <!-- AI Questions box -->
        <div class="jn-ai-box">
          <div class="jn-ai-hd">🤖 AI Personalization — ৩টি দ্রুত প্রশ্ন</div>
          <p class="jn-ai-sub">এই উত্তরগুলো Effective AI ব্যবহার করে আপনার জন্য একটি কাস্টম শিক্ষাপথ তৈরি করবে।</p>
          <div class="jnf">
            <label class="jnl">আপনার সবচেয়ে বড় শেখার চ্যালেঞ্জ কী?</label>
            <input class="jni" id="l-challenge" placeholder="যেমন: মনোযোগ ধরে রাখা কঠিন, সময়ের অভাব…">
          </div>
          <div class="jnf" style="margin-top:10px;">
            <label class="jnl">আপনার মূল শিক্ষার লক্ষ্য কী?</label>
            <input class="jni" id="l-goal" placeholder="যেমন: BCS ক্যাডার হওয়া, বিদেশে Masters করা…">
          </div>
          <div class="jnf" style="margin-top:10px;">
            <label class="jnl">কোন বিষয়ে আপনি সবচেয়ে বেশি সংগ্রাম করেন?</label>
            <input class="jni" id="l-struggle" placeholder="যেমন: Mathematics, English Writing…">
          </div>
        </div>
        <div class="jn-nav">
          <button class="jn-btn-back" onclick="jnBack('learner',3)">← পূর্ববর্তী</button>
          <button class="jn-btn-submit" onclick="jnSubmit('learner')">✦ যোগ দিন ও AI Path পান</button>
        </div>
      </div>
    </div><!-- /learner -->

    <!-- ══ TEACHER STEPS ══ -->
    <div id="jnf-teacher" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-teacher-1" data-title="ব্যক্তিগত তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>ব্যক্তিগত ও যোগাযোগের তথ্য</span></div>
        <div class="jn-photo-row">
          <div class="jn-photo-wrap" onclick="document.getElementById('jnPhotoInput').click()">
            <div class="jn-photo-placeholder">📷<br><span>ছবি আপলোড</span></div>
          </div>
          <div class="jn-photo-hint">প্রোফাইল ছবি আপলোড করুন<br><span>শিক্ষার্থীরা আপনাকে চিনতে পারবেন</span></div>
        </div>
        <div class="jn-grid2">
          <div class="jnf" id="v-t-name"><label class="jnl">পূর্ণ নাম <span class="req">*</span></label><input class="jni" id="t-name" placeholder="আপনার সম্পূর্ণ নাম" oninput="jnValidate(this,'name')" onblur="jnValidate(this,'name')"><span class="jn-err" id="e-t-name"></span></div>
          <div class="jnf" id="v-t-phone"><label class="jnl">ফোন <span class="req">*</span></label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="t-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)" onblur="jnValidate(this,'phone')"></div><span class="jn-err" id="e-t-phone"></span></div>
          <div class="jnf" id="v-t-email"><label class="jnl">ইমেইল <span class="req">*</span></label><input class="jni" id="t-email" type="email" placeholder="teacher@email.com" oninput="jnValidate(this,'email')" onblur="jnValidate(this,'email')"><span class="jn-err" id="e-t-email"></span></div>
          <div class="jnf" id="v-t-pass"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="t-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর" oninput="jnPassStrength(this)" onblur="jnValidate(this,'pass')"><button class="jni-eye" onclick="jnTogglePass('t-pass',this)" type="button">👁</button></div><div class="jn-pass-bar" id="jn-pass-bar-t"><div id="jn-pass-fill-t"></div></div><span class="jn-err" id="e-t-pass"></span></div>
          <div class="jnf"><label class="jnl">জেলা <span class="req">*</span></label><input class="jni" id="t-dist" placeholder="আপনার জেলা"></div>
          <div class="jnf"><label class="jnl">উপজেলা</label><input class="jni" id="t-upa" placeholder="উপজেলার নাম"></div>
          <div class="jnf jn-span2"><label class="jnl">বাড়ির ঠিকানা</label><input class="jni" id="t-addr" placeholder="বিস্তারিত ঠিকানা"></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-next" onclick="jnNext('teacher',1)">পরবর্তী →</button></div>
      </div>

      <div class="jn-step" id="jn-teacher-2" data-title="শিক্ষাগত যোগ্যতা">
        <div class="jn-step-hd"><span class="jn-step-num">২</span><span>শিক্ষাগত যোগ্যতা ও বিশেষজ্ঞতা</span></div>
        <div class="jn-grid2">
          <div class="jnf"><label class="jnl">সর্বোচ্চ ডিগ্রি <span class="req">*</span></label><select class="jni" id="t-degree"><option value="">নির্বাচন করুন</option><option>SSC</option><option>HSC</option><option>Diploma</option><option>Bachelor</option><option>Masters</option><option>PhD</option></select></div>
          <div class="jnf"><label class="jnl">প্রতিষ্ঠান</label><input class="jni" id="t-uni" placeholder="বিশ্ববিদ্যালয় / কলেজ"></div>
          <div class="jnf"><label class="jnl">বিষয় / বিভাগ</label><input class="jni" id="t-dept" placeholder="যেমন: Mathematics, CSE"></div>
          <div class="jnf"><label class="jnl">পাসের বছর</label><input class="jni" id="t-pyear" type="number" placeholder="২০২০" min="1990" max="2030"></div>
          <div class="jnf"><label class="jnl">শিক্ষণ অভিজ্ঞতা <span class="req">*</span></label><select class="jni" id="t-exp"><option value="">নির্বাচন করুন</option><option>১ বছরের কম</option><option>১–৩ বছর</option><option>৩–৫ বছর</option><option>৫–১০ বছর</option><option>১০+ বছর</option></select></div>
          <div class="jnf"><label class="jnl">পাঠদানের পদ্ধতি</label><div class="jn-chip-row" id="t-mode"><button class="jnchip" onclick="jnChipSingle(this,'t-mode')">অনলাইন</button><button class="jnchip" onclick="jnChipSingle(this,'t-mode')">অফলাইন</button><button class="jnchip on" onclick="jnChipSingle(this,'t-mode')">উভয়</button></div></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">দক্ষতার ক্ষেত্র (একাধিক) <span class="req">*</span></label>
          <div class="jn-chip-row wrap" id="t-expertise">
            <button class="jnchip" onclick="jnChipMulti(this)">Mathematics</button><button class="jnchip" onclick="jnChipMulti(this)">Physics</button><button class="jnchip" onclick="jnChipMulti(this)">Chemistry</button><button class="jnchip" onclick="jnChipMulti(this)">Biology</button><button class="jnchip" onclick="jnChipMulti(this)">English</button><button class="jnchip" onclick="jnChipMulti(this)">Bangla</button><button class="jnchip" onclick="jnChipMulti(this)">ICT</button><button class="jnchip" onclick="jnChipMulti(this)">Programming</button><button class="jnchip" onclick="jnChipMulti(this)">BCS Prep</button><button class="jnchip" onclick="jnChipMulti(this)">IELTS</button><button class="jnchip" onclick="jnChipMulti(this)">Admission Coaching</button><button class="jnchip" onclick="jnChipMulti(this)">Spoken English</button><button class="jnchip" onclick="jnChipMulti(this)">Primary</button>
          </div><span class="jn-err" id="e-t-expertise"></span>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">পছন্দের শিক্ষার্থী স্তর</label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">প্রাইমারি</button><button class="jnchip" onclick="jnChipMulti(this)">মাধ্যমিক</button><button class="jnchip" onclick="jnChipMulti(this)">উচ্চমাধ্যমিক</button><button class="jnchip" onclick="jnChipMulti(this)">ভর্তি পরীক্ষা</button><button class="jnchip" onclick="jnChipMulti(this)">বিশ্ববিদ্যালয়</button><button class="jnchip" onclick="jnChipMulti(this)">পেশাদার</button></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">উপলব্ধ সময়</label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">সকাল ৬–১২</button><button class="jnchip" onclick="jnChipMulti(this)">দুপুর ১২–৫</button><button class="jnchip" onclick="jnChipMulti(this)">সন্ধ্যা ৫–১০</button><button class="jnchip" onclick="jnChipMulti(this)">সাপ্তাহিক ছুটি</button></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-back" onclick="jnBack('teacher',2)">← পূর্ববর্তী</button><button class="jn-btn-next" onclick="jnNext('teacher',2)">পরবর্তী →</button></div>
      </div>

      <div class="jn-step" id="jn-teacher-3" data-title="যাচাই ও পেমেন্ট">
        <div class="jn-step-hd"><span class="jn-step-num">৩</span><span>যাচাই, পেমেন্ট ও AI প্রশ্ন</span></div>
        <div class="jn-upload-grid">
          <div class="jn-upload-box" onclick="showToast('NID আপলোড — Backend সংযুক্তির পর কাজ করবে')"><div class="jn-up-ico">🪪</div><div class="jn-up-lbl">NID / পাসপোর্ট</div><div class="jn-up-sub">ঐচ্ছিক</div></div>
          <div class="jn-upload-box" onclick="showToast('Certificate আপলোড — Backend সংযুক্তির পর')"><div class="jn-up-ico">📜</div><div class="jn-up-lbl">একাডেমিক সার্টিফিকেট</div><div class="jn-up-sub">PDF / JPG</div></div>
          <div class="jn-upload-box" onclick="showToast('CV আপলোড — Backend সংযুক্তির পর')"><div class="jn-up-ico">📄</div><div class="jn-up-lbl">CV / Resume</div><div class="jn-up-sub">PDF প্রস্তাবিত</div></div>
        </div>
        <div class="jn-grid2" style="margin-top:16px;">
          <div class="jnf"><label class="jnl">মোবাইল ব্যাংকিং <span class="req">*</span></label><div class="jni-group"><span class="jni-prefix">💳</span><input class="jni jni-with-prefix" id="t-bkash" placeholder="bKash / Nagad নম্বর"></div></div>
          <div class="jnf"><label class="jnl">ব্যাংক অ্যাকাউন্ট</label><input class="jni" id="t-bank" placeholder="ব্যাংক ও অ্যাকাউন্ট নম্বর"></div>
          <div class="jnf"><label class="jnl">ঘণ্টায় রেট (BDT)</label><input class="jni" id="t-rate" type="number" placeholder="যেমন: 500" min="100"></div>
          <div class="jnf"><label class="jnl">প্রোফাইল লিঙ্কডইন</label><input class="jni" id="t-linkedin" placeholder="linkedin.com/in/..."></div>
        </div>
        <div class="jn-ai-box" style="margin-top:16px;">
          <div class="jn-ai-hd">🤖 AI Teacher Matching Questions</div>
          <p class="jn-ai-sub">এই উত্তর দিয়ে Effective AI সঠিক শিক্ষার্থীদের সাথে আপনাকে ম্যাচ করবে।</p>
          <div class="jnf"><label class="jnl">আপনার শিক্ষণ দর্শন কী?</label><textarea class="jni" id="t-philosophy" rows="2" placeholder="কীভাবে আপনি শিক্ষার্থীদের সাথে কাজ করেন…"></textarea></div>
          <div class="jn-grid2" style="margin-top:10px;">
            <div class="jnf"><label class="jnl">কোন ধরনের শিক্ষার্থীকে সবচেয়ে ভালো পড়ান?</label><input class="jni" id="t-bestfor" placeholder="যেমন: দুর্বল, মেধাবী, BCS প্রার্থী"></div>
            <div class="jnf"><label class="jnl">পছন্দের পাঠদান পদ্ধতি?</label><input class="jni" id="t-method" placeholder="যেমন: সমস্যা সমাধান, গল্পের ছলে"></div>
          </div>
        </div>
        <div class="jn-nav"><button class="jn-btn-back" onclick="jnBack('teacher',3)">← পূর্ববর্তী</button><button class="jn-btn-submit" onclick="jnSubmit('teacher')">✦ Teacher Profile জমা দিন</button></div>
      </div>
    </div><!-- /teacher -->

    <!-- ══ GUARDIAN ══ -->
    <div id="jnf-guardian" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-guardian-1" data-title="অভিভাবকের তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>অভিভাবক ও পরিবারের তথ্য</span></div>
        <div class="jn-grid2">
          <div class="jnf" id="v-g-name"><label class="jnl">পূর্ণ নাম <span class="req">*</span></label><input class="jni" id="g-name" placeholder="অভিভাবকের সম্পূর্ণ নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-g-name"></span></div>
          <div class="jnf" id="v-g-phone"><label class="jnl">ফোন <span class="req">*</span></label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="g-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)"></div><span class="jn-err" id="e-g-phone"></span></div>
          <div class="jnf"><label class="jnl">ইমেইল</label><input class="jni" id="g-email" type="email" placeholder="guardian@email.com"></div>
          <div class="jnf" id="v-g-pass"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="g-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('g-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-g-pass"></span></div>
          <div class="jnf"><label class="jnl">জেলা</label><input class="jni" id="g-dist" placeholder="আপনার জেলা"></div>
          <div class="jnf"><label class="jnl">সন্তানের সংখ্যা</label><select class="jni" id="g-kids" onchange="jnChildCards(this.value)"><option value="1">১</option><option value="2">২</option><option value="3">৩</option><option value="4">৪+</option></select></div>
        </div>
        <div id="jnChildCards" style="margin-top:16px;"><!-- populated by JS --></div>
        <div class="jnf" style="margin-top:16px;"><label class="jnl">আগ্রহী সেবাসমূহ</label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">হোম টিউটর</button><button class="jnchip" onclick="jnChipMulti(this)">অনলাইন ক্লাস</button><button class="jnchip" onclick="jnChipMulti(this)">কোর্স</button><button class="jnchip" onclick="jnChipMulti(this)">ভর্তি কোচিং</button><button class="jnchip" onclick="jnChipMulti(this)">দক্ষতা উন্নয়ন</button><button class="jnchip" onclick="jnChipMulti(this)">অলিম্পিয়াড প্রস্তুতি</button></div>
        </div>
        <div class="jn-info-box" style="margin-top:16px;">
          <div class="jn-ib-hd">📊 Guardian Dashboard-এ যা পাবেন:</div>
          <div class="jn-ib-items"><span>✅ অগ্রগতি মনিটর</span><span>✅ উপস্থিতি ট্র্যাক</span><span>✅ কোর্স সম্পন্নের রিপোর্ট</span><span>✅ শিক্ষকের সাথে যোগাযোগ</span><span>✅ পুশ নোটিফিকেশন</span></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('guardian')">✦ Guardian Account তৈরি করুন</button></div>
      </div>
    </div><!-- /guardian -->

    <!-- ══ INSTITUTION ══ -->
    <div id="jnf-institution" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-institution-1" data-title="প্রতিষ্ঠানের তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>প্রতিষ্ঠানের তথ্য ও যোগাযোগ</span></div>
        <div class="jnf" style="margin-bottom:14px;"><label class="jnl">প্রতিষ্ঠানের ধরন <span class="req">*</span></label>
          <div class="jn-chip-row wrap" id="ins-type"><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">স্কুল</button><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">কলেজ</button><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">বিশ্ববিদ্যালয়</button><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">কোচিং সেন্টার</button><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">Training Institute</button><button class="jnchip" onclick="jnChipSingle(this,'ins-type')">মাদ্রাসা</button></div>
        </div>
        <div class="jn-grid2">
          <div class="jnf" id="v-ins-name"><label class="jnl">প্রতিষ্ঠানের নাম <span class="req">*</span></label><input class="jni" id="ins-name" placeholder="সম্পূর্ণ প্রাতিষ্ঠানিক নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-ins-name"></span></div>
          <div class="jnf" id="v-ins-email"><label class="jnl">যোগাযোগ ইমেইল <span class="req">*</span></label><input class="jni" id="ins-email" type="email" placeholder="contact@institution.edu.bd" oninput="jnValidate(this,'email')"><span class="jn-err" id="e-ins-email"></span></div>
          <div class="jnf"><label class="jnl">ফোন</label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="ins-phone" type="tel" placeholder="2-XXXX-XXXX"></div></div>
          <div class="jnf"><label class="jnl">ওয়েবসাইট</label><input class="jni" id="ins-web" placeholder="https://"></div>
          <div class="jnf"><label class="jnl">জেলা</label><input class="jni" id="ins-dist" placeholder="প্রতিষ্ঠানের অবস্থান"></div>
          <div class="jnf"><label class="jnl">শিক্ষার্থী সংখ্যা</label><input class="jni" id="ins-students" type="number" placeholder="আনুমানিক সংখ্যা"></div>
          <div class="jnf" id="v-ins-pass"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="ins-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('ins-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-ins-pass"></span></div>
          <div class="jnf"><label class="jnl">EIIN নম্বর (যদি থাকে)</label><input class="jni" id="ins-eiin" placeholder="সরকারি EIIN"></div>
        </div>
        <div class="jn-info-box" style="margin-top:14px;">
          <div class="jn-ib-hd">🏫 Institutional Account-এ যা পাবেন:</div>
          <div class="jn-ib-items"><span>✅ LMS অ্যাক্সেস</span><span>✅ ছাত্র ব্যবস্থাপনা</span><span>✅ Teacher Management</span><span>✅ Analytics Dashboard</span><span>✅ কাস্টম ব্র্যান্ডিং</span></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('institution')">✦ Institution Profile জমা দিন</button></div>
      </div>
    </div><!-- /institution -->

    <!-- ══ RESEARCHER ══ -->
    <div id="jnf-researcher" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-researcher-1" data-title="গবেষকের প্রোফাইল">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>একাডেমিক প্রোফাইল</span></div>
        <div class="jn-grid2">
          <div class="jnf" id="v-r-name"><label class="jnl">পূর্ণ নাম <span class="req">*</span></label><input class="jni" id="r-name" placeholder="Dr. / Prof. / নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-r-name"></span></div>
          <div class="jnf" id="v-r-email"><label class="jnl">ইমেইল <span class="req">*</span></label><input class="jni" id="r-email" type="email" placeholder="researcher@university.edu" oninput="jnValidate(this,'email')"><span class="jn-err" id="e-r-email"></span></div>
          <div class="jnf"><label class="jnl">সর্বোচ্চ ডিগ্রি</label><select class="jni" id="r-degree"><option>Masters</option><option>PhD</option><option>Post-Doc</option><option>Professor</option></select></div>
          <div class="jnf"><label class="jnl">প্রতিষ্ঠান</label><input class="jni" id="r-uni" placeholder="বিশ্ববিদ্যালয় / ইনস্টিটিউট"></div>
          <div class="jnf"><label class="jnl">ORCID ID</label><input class="jni" id="r-orcid" placeholder="0000-0000-0000-0000"></div>
          <div class="jnf"><label class="jnl">Google Scholar</label><input class="jni" id="r-scholar" placeholder="scholar.google.com/citations?user=..."></div>
          <div class="jnf"><label class="jnl">ResearchGate</label><input class="jni" id="r-rgate" placeholder="researchgate.net/profile/..."></div>
          <div class="jnf"><label class="jnl">প্রকাশিত পেপার সংখ্যা</label><select class="jni" id="r-pubs"><option>০</option><option>১–৫</option><option>৫–২০</option><option>২০–৫০</option><option>৫০+</option></select></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">গবেষণার ক্ষেত্র (একাধিক) <span class="req">*</span></label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">AI / ML</button><button class="jnchip" onclick="jnChipMulti(this)">Education Technology</button><button class="jnchip" onclick="jnChipMulti(this)">Physics</button><button class="jnchip" onclick="jnChipMulti(this)">Biology / Medicine</button><button class="jnchip" onclick="jnChipMulti(this)">Chemistry</button><button class="jnchip" onclick="jnChipMulti(this)">Economics</button><button class="jnchip" onclick="jnChipMulti(this)">Social Science</button><button class="jnchip" onclick="jnChipMulti(this)">Engineering</button><button class="jnchip" onclick="jnChipMulti(this)">Mathematics</button><button class="jnchip" onclick="jnChipMulti(this)">অন্যান্য</button></div>
        </div>
        <div class="jnf" id="v-r-pass" style="margin-top:14px;"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="r-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('r-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-r-pass"></span></div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('researcher')">✦ Researcher Profile তৈরি করুন</button></div>
      </div>
    </div><!-- /researcher -->

    <!-- ══ AUTHOR ══ -->
    <div id="jnf-author" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-author-1" data-title="লেখকের প্রোফাইল">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>লেখকের পরিচয় ও প্রকাশনার তথ্য</span></div>
        <div class="jn-grid2">
          <div class="jnf" id="v-au-name"><label class="jnl">পূর্ণ নাম <span class="req">*</span></label><input class="jni" id="au-name" placeholder="লেখকের নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-au-name"></span></div>
          <div class="jnf" id="v-au-email"><label class="jnl">ইমেইল <span class="req">*</span></label><input class="jni" id="au-email" type="email" placeholder="author@email.com" oninput="jnValidate(this,'email')"><span class="jn-err" id="e-au-email"></span></div>
          <div class="jnf"><label class="jnl">ফোন</label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="au-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)"></div></div>
          <div class="jnf"><label class="jnl">ওয়েবসাইট / পোর্টফোলিও</label><input class="jni" id="au-web" placeholder="https://yoursite.com"></div>
          <div class="jnf"><label class="jnl">প্রকাশিত বইয়ের সংখ্যা</label><input class="jni" id="au-books" type="number" placeholder="০" min="0"></div>
          <div class="jnf"><label class="jnl">রয়্যালটি পেমেন্ট</label><input class="jni" id="au-payment" placeholder="bKash / ব্যাংক অ্যাকাউন্ট"></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">লেখার ধরন (একাধিক)</label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">শিক্ষামূলক বই</button><button class="jnchip" onclick="jnChipMulti(this)">Research Paper</button><button class="jnchip" onclick="jnChipMulti(this)">নিবন্ধ / Article</button><button class="jnchip" onclick="jnChipMulti(this)">ব্লগ</button><button class="jnchip" onclick="jnChipMulti(this)">পাঠ্যক্রম</button><button class="jnchip" onclick="jnChipMulti(this)">গল্প / উপন্যাস</button></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">Bio / পরিচিতি</label><textarea class="jni" id="au-bio" rows="3" placeholder="নিজের সম্পর্কে সংক্ষেপে লিখুন — এটি আপনার পাবলিক প্রোফাইলে দেখা যাবে…"></textarea></div>
        <div class="jnf" id="v-au-pass" style="margin-top:14px;"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="au-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('au-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-au-pass"></span></div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('author')">✦ Author Account তৈরি করুন</button></div>
      </div>
    </div><!-- /author -->

    <!-- ══ SELLER ══ -->
    <div id="jnf-seller" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-seller-1" data-title="বিক্রেতার তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>Effective Mart — Seller Account</span></div>
        <div class="jn-grid2">
          <div class="jnf" id="v-se-biz"><label class="jnl">ব্যবসার নাম <span class="req">*</span></label><input class="jni" id="se-biz" placeholder="আপনার ব্যবসার নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-se-biz"></span></div>
          <div class="jnf"><label class="jnl">যোগাযোগ ব্যক্তির নাম</label><input class="jni" id="se-name" placeholder="সম্পূর্ণ নাম"></div>
          <div class="jnf" id="v-se-email"><label class="jnl">ইমেইল <span class="req">*</span></label><input class="jni" id="se-email" type="email" placeholder="seller@business.com" oninput="jnValidate(this,'email')"><span class="jn-err" id="e-se-email"></span></div>
          <div class="jnf"><label class="jnl">ফোন <span class="req">*</span></label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="se-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)"></div></div>
          <div class="jnf"><label class="jnl">মোবাইল ব্যাংকিং <span class="req">*</span></label><input class="jni" id="se-bkash" placeholder="bKash / Nagad নম্বর"></div>
          <div class="jnf"><label class="jnl">ব্যাংক অ্যাকাউন্ট</label><input class="jni" id="se-bank" placeholder="ব্যাংক ও অ্যাকাউন্ট নম্বর"></div>
          <div class="jnf" id="v-se-pass"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="se-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('se-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-se-pass"></span></div>
          <div class="jnf"><label class="jnl">ট্রেড লাইসেন্স (ঐচ্ছিক)</label><input class="jni" id="se-trade" placeholder="ট্রেড লাইসেন্স নম্বর"></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">পণ্যের ধরন (একাধিক) <span class="req">*</span></label>
          <div class="jn-chip-row wrap" id="se-cats"><button class="jnchip" onclick="jnChipMulti(this)">শিক্ষামূলক বই</button><button class="jnchip" onclick="jnChipMulti(this)">স্টেশনারি</button><button class="jnchip" onclick="jnChipMulti(this)">ডিজিটাল রিসোর্স</button><button class="jnchip" onclick="jnChipMulti(this)">কোর্স ম্যাটেরিয়াল</button><button class="jnchip" onclick="jnChipMulti(this)">সফটওয়্যার / টুলস</button><button class="jnchip" onclick="jnChipMulti(this)">গৃহস্থালী</button><button class="jnchip" onclick="jnChipMulti(this)">অন্যান্য</button></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('seller')">✦ Seller Account তৈরি করুন</button></div>
      </div>
    </div><!-- /seller -->

    <!-- ══ RECRUITER ══ -->
    <div id="jnf-recruiter" class="jnf-role-wrap" style="display:none;">
      <div class="jn-step active" id="jn-recruiter-1" data-title="নিয়োগকর্তার তথ্য">
        <div class="jn-step-hd"><span class="jn-step-num">১</span><span>Effective Careers — Recruiter Account</span></div>
        <div class="jn-grid2">
          <div class="jnf" id="v-re-org"><label class="jnl">প্রতিষ্ঠানের নাম <span class="req">*</span></label><input class="jni" id="re-org" placeholder="কোম্পানি / প্রতিষ্ঠানের নাম" oninput="jnValidate(this,'name')"><span class="jn-err" id="e-re-org"></span></div>
          <div class="jnf"><label class="jnl">HR / কন্টাক্ট পার্সন</label><input class="jni" id="re-name" placeholder="নাম ও পদবি"></div>
          <div class="jnf" id="v-re-email"><label class="jnl">ইমেইল <span class="req">*</span></label><input class="jni" id="re-email" type="email" placeholder="hr@company.com" oninput="jnValidate(this,'email')"><span class="jn-err" id="e-re-email"></span></div>
          <div class="jnf"><label class="jnl">ফোন</label><div class="jni-group"><span class="jni-prefix">🇧🇩 +880</span><input class="jni jni-with-prefix" id="re-phone" type="tel" placeholder="1X-XXXX-XXXX" maxlength="11" oninput="jnFormatPhone(this)"></div></div>
          <div class="jnf"><label class="jnl">ইন্ডাস্ট্রি</label><select class="jni" id="re-ind"><option>Technology</option><option>Education</option><option>Finance</option><option>Healthcare</option><option>NGO</option><option>Government</option><option>Media</option><option>অন্যান্য</option></select></div>
          <div class="jnf"><label class="jnl">কোম্পানির আকার</label><select class="jni" id="re-size"><option>১–১০</option><option>১০–৫০</option><option>৫০–২০০</option><option>২০০–১০০০</option><option>১০০০+</option></select></div>
          <div class="jnf"><label class="jnl">ওয়েবসাইট</label><input class="jni" id="re-web" placeholder="https://company.com"></div>
          <div class="jnf" id="v-re-pass"><label class="jnl">পাসওয়ার্ড <span class="req">*</span></label><div class="jni-group"><input class="jni jni-pass" id="re-pass" type="password" placeholder="ন্যূনতম ৮ অক্ষর"><button class="jni-eye" onclick="jnTogglePass('re-pass',this)" type="button">👁</button></div><span class="jn-err" id="e-re-pass"></span></div>
        </div>
        <div class="jnf" style="margin-top:14px;"><label class="jnl">নিয়োগের ধরন (একাধিক)</label>
          <div class="jn-chip-row wrap"><button class="jnchip" onclick="jnChipMulti(this)">Full-time</button><button class="jnchip" onclick="jnChipMulti(this)">Part-time</button><button class="jnchip" onclick="jnChipMulti(this)">Remote</button><button class="jnchip" onclick="jnChipMulti(this)">Internship</button><button class="jnchip" onclick="jnChipMulti(this)">Freelance</button><button class="jnchip" onclick="jnChipMulti(this)">Contract</button></div>
        </div>
        <div class="jn-nav"><button class="jn-btn-submit" onclick="jnSubmit('recruiter')">✦ Recruiter Account তৈরি করুন</button></div>
      </div>
    </div><!-- /recruiter -->

  </div><!-- /jnFormArea -->
</div><!-- /jnShell -->

<!-- ══ SUCCESS MODAL ══ -->
<div id="jnModal" class="jn-modal-bg" onclick="if(event.target===this)jnCloseModal()">
  <div class="jn-modal-box">
    <div class="jn-modal-confetti" id="jnConfetti"></div>
    <div class="jn-modal-emoji" id="jnModalEmoji">🎉</div>
