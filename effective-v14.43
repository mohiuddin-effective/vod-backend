      <!-- Tech Stack Summary -->
      <div>
        <div class="bp-section-lbl">🧱 Full Stack Summary</div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div class="bp-stack-row"><span class="bp-stack-layer">Frontend</span><span class="bp-stack-val">Next.js 14 (App Router) · Tailwind CSS · shadcn/ui</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Backend</span><span class="bp-stack-val">Node.js + TypeScript · FastAPI (Python for AI)</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Primary DB</span><span class="bp-stack-val">PostgreSQL + Prisma ORM · pgvector extension</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Cache</span><span class="bp-stack-val">Redis 7 · Session store · Pub/Sub</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Graph DB</span><span class="bp-stack-val">Neo4j Aura · Knowledge Graph · Cypher queries</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">AI</span><span class="bp-stack-val">OpenAI GPT-4o · text-embedding-3-small · Pinecone</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Real-Time</span><span class="bp-stack-val">Socket.io · WebRTC · Nginx sticky sessions</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">DevOps</span><span class="bp-stack-val">Docker · AWS ECS · Cloudflare Workers · CI/CD</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Search</span><span class="bp-stack-val">Elasticsearch 8 · Full-text + semantic hybrid</span></div>
          <div class="bp-stack-row"><span class="bp-stack-layer">Payments</span><span class="bp-stack-val">Stripe + SSLCommerz · Webhook validation</span></div>
        </div>
        <div style="margin-top:14px;display:flex;gap:8px;">
          <button class="btn-gold btn-sm" onclick="showToast('📋 Blueprint PDF তৈরি হচ্ছে...')">📄 PDF Export</button>
          <button class="btn-outline btn-sm" onclick="window.open('https://github.com/mohiuddin-effective/vod-backend','_blank')">⌥ GitHub Repo</button>
        </div>
      </div>
    </div>
  </div>

</div><!-- /blueprint content -->

<!-- Live AI Blueprint Consultant -->
<section style="background:linear-gradient(135deg,#0D0A1A,#150E2E);padding:48px 52px;">
  <div style="max-width:1400px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) min(480px,44%);gap:48px;align-items:start;">
      <div>
        <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.3);border-radius:20px;padding:4px 12px;font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#A78BFA;margin-bottom:14px;">🤖 AI Engineering Consultant</div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.9rem;font-weight:700;color:#fff;margin-bottom:10px;">আপনার টেক প্রশ্নের <em style="color:#A78BFA;">তাৎক্ষণিক উত্তর</em></h2>
        <p style="font-family:'Noto Serif Bengali',serif;font-size:.83rem;color:rgba(255,255,255,.5);line-height:1.8;margin-bottom:20px;">আর্কিটেকচার, ডেটাবেজ ডিজাইন, API স্কিমা, স্কেলিং বা deployment নিয়ে যেকোনো প্রশ্ন করুন — AI সিনিয়র ইঞ্জিনিয়ারের মতো উত্তর দেবে।</p>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
          <button class="bp-q-chip" onclick="setBpQ('PostgreSQL-এ pgvector কীভাবে সেট আপ করব?')">pgvector setup</button>
          <button class="bp-q-chip" onclick="setBpQ('Redis caching strategy for gamification?')">Redis strategy</button>
          <button class="bp-q-chip" onclick="setBpQ('Neo4j vs PostgreSQL — কোনটা বেছে নেব?')">Neo4j vs SQL</button>
          <button class="bp-q-chip" onclick="setBpQ('WebRTC signaling server কীভাবে scale করব?')">WebRTC scaling</button>
          <button class="bp-q-chip" onclick="setBpQ('Docker Compose config for this stack?')">Docker Compose</button>
        </div>
        <div style="display:flex;gap:8px;">
          <input id="bpAiInput" placeholder="আপনার engineering প্রশ্ন লিখুন…" style="flex:1;padding:10px 14px;border:1.5px solid rgba(124,58,237,.3);border-radius:9px;background:rgba(255,255,255,.05);color:#fff;font-family:'Outfit',sans-serif;font-size:.83rem;outline:none;" onfocus="this.style.borderColor='rgba(167,139,250,.6)'" onblur="this.style.borderColor='rgba(124,58,237,.3)'" onkeydown="if(event.key==='Enter')runBpAI()" placeholder="PostgreSQL index strategy for academic search?">
          <button id="bpAiBtn" onclick="runBpAI()" style="background:linear-gradient(135deg,#7C3AED,#4F46E5);border:none;border-radius:9px;padding:10px 20px;color:#fff;font-weight:700;font-size:.82rem;cursor:pointer;white-space:nowrap;">⚡ Ask AI</button>
        </div>
        <div id="bpAiLoading" style="display:none;align-items:center;gap:8px;margin-top:12px;">
          <div class="eval-spinner" style="border-top-color:#A78BFA;"></div>
          <span style="font-family:'Outfit',sans-serif;font-size:.78rem;color:#A78BFA;">Engineering consultant চিন্তা করছে…</span>
        </div>
      </div>
      <!-- Answer panel -->
      <div id="bpAiResult" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:var(--r2);padding:20px;min-height:180px;">
        <div style="font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(167,139,250,.7);margin-bottom:12px;">💬 AI RESPONSE</div>
        <div id="bpAiAnswer" style="font-family:'Outfit',sans-serif;font-size:.83rem;color:rgba(255,255,255,.6);line-height:1.75;">
          <span style="font-family:'Noto Serif Bengali',serif;">উপরে একটি engineering প্রশ্ন লিখুন অথবা quick chip থেকে বেছে নিন। AI আপনাকে সিনিয়র ইঞ্জিনিয়ারের মতো বিস্তারিত উত্তর দেবে।</span>
        </div>
      </div>
    </div>
  </div>
</section>

