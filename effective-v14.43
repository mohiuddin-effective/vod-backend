<div class="page" id="page-media">
<div class="media-hero">
  <div style="max-width:1400px;margin:0 auto;position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) min(420px,40%);gap:clamp(24px,4vw,60px);align-items:center;">
    <div>
      <div class="media-eyebrow">📺 Effective Media</div>
      <h1 class="media-title">শিক্ষার <em>নতুন মাধ্যম</em></h1>
      <p style="font-family:'Noto Serif Bengali',serif;font-size:.94rem;color:rgba(255,255,255,.7);line-height:1.85;margin-bottom:26px;">ভিডিও লেকচার, পডকাস্ট, লাইভ ক্লাস, ডকুমেন্টারি সিরিজ এবং শর্ট-ফর্ম এডুকেশনাল কন্টেন্ট — সব এক জায়গায়।</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px;">
        <button class="btn-gold" onclick="showToast('Media Library খুলছে...')">Media Library →</button>
        <button style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:8px;padding:13px 24px;font-size:.88rem;font-weight:500;cursor:pointer;">Live Schedule দেখুন</button>
      </div>
      <div style="display:flex;gap:24px;flex-wrap:wrap;">
        <div><div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;color:rgba(180,140,255,.9);">৫,০০০+</div><div style="font-size:.68rem;color:rgba(255,255,255,.45);">ভিডিও লেকচার</div></div>
        <div><div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;color:rgba(180,140,255,.9);">২০০+</div><div style="font-size:.68rem;color:rgba(255,255,255,.45);">পডকাস্ট এপিসোড</div></div>
        <div><div style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:700;color:rgba(180,140,255,.9);">দৈনিক</div><div style="font-size:.68rem;color:rgba(255,255,255,.45);">লাইভ ক্লাস</div></div>
      </div>
    </div>
    <!-- Live banner -->
    <div>
      <div class="live-class-banner" onclick="showToast('Live Class-এ যোগ দিচ্ছি...')">
        <div class="lcb-pulse"></div>
        <div class="lcb-body"><div class="lcb-title">🔴 এখন Live: BCS Mathematics Special</div><div class="lcb-meta">শিক্ষক: মোস্তাফিজুর রহমান · ৪৫ মিনিট চলছে</div></div>
        <div class="lcb-viewers">৪,৮২০</div>
