const _pStyle = document.createElement('style');
_pStyle.textContent = '@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}';
document.head.appendChild(_pStyle);

// Initialize news page on go('news')
const _origGo = go;
go = function(id){
  _origGo(id);
  if(id==='news'){
    renderNewsArticles('all',true);
    renderNewsTrending();
    renderNewsTags();
  }
};

document.querySelectorAll('.pc-fill').forEach(bar=>{
  const w = bar.style.width;
  bar.style.width='0%';
  setTimeout(()=>{ bar.style.transition='width 1.2s ease'; bar.style.width=w; }, 400);
});
const cards=document.querySelectorAll('.ccard,.bkcard,.pillar,.ai-card,.mpcard,.blg,.tcard,.res-card,.job-card');
if('IntersectionObserver' in window){
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.style.animationPlayState='running';
        io.unobserve(e.target);
      }
    });
  },{threshold:.1});
  cards.forEach(c=>{ c.style.animationPlayState='paused'; io.observe(c); });
}



// ══════════════════════════════════════════════════════
// 📱 EFFECTIVE APP ENGINE — PWA · Navigation · UI · v13
// ══════════════════════════════════════════════════════
const isMobile = () => window.innerWidth <= 768;

// ── Page title map ──
const PAGE_TITLES = {
  home:'Effective EduHub',academy:'Academy',teachers:'Teachers',publications:'Publications',
  mart:'Mart',blog:'Blogs',ai:'AI Tools',higherstudy:'Higher Study',
  coins:'Gold Coins',institutional:'Institutional',certifications:'Exams & Certificates',
  community:'Community',media:'Media',creator:'Creator',research:'Research',
  careers:'Careers',news:'News',blueprint:'Blueprint',join:'Join Effective EduHub',dashboard:'আমার প্রোফাইল',
  'bcs-prelim':'BCS Preliminary প্রস্তুতি','bank-jobs':'Bank Job প্রস্তুতি','hsc-prep':'HSC প্রস্তুতি','ssc-prep':'SSC প্রস্তুতি','class8-jsc':'Class 8 & JSC প্রস্তুতি',
  'class7-prep':'Class 7 প্রস্তুতি','class6-prep':'Class 6 প্রস্তুতি','class5-psc':'Class 5 & PSC প্রস্তুতি'
};

// ── Nav history ──
let _navHistory = ['home'];

// ── Extend go() ──
const __baseGo = go;
go = function(id, isBack) {
  __baseGo(id);
  if (!isBack && id !== _navHistory[_navHistory.length-1]) {
    _navHistory.push(id);
    if (_navHistory.length > 30) _navHistory.shift();
  }
  if (!isMobile()) return;

  // Header title
  const t = PAGE_TITLES[id] || '';
  const titleEl = document.getElementById('appHdrTitle');
  const brandEl = document.querySelector('.app-hdr-brand');
  if (titleEl && brandEl) {
    if (t && t !== 'Effective EduHub') {
      titleEl.textContent = t; titleEl.style.display = 'block';
      brandEl.style.display = 'none';
    } else {
      titleEl.style.display = 'none'; brandEl.style.display = 'block';
    }
  }

  // Bottom tabs
  ['home','academy','publications','certifications','mart','dashboard'].forEach(tab => {
    document.getElementById('tab-'+tab)?.classList.toggle('active', tab === id);
  });

  // Drawer active
  document.querySelectorAll('.drawer-item').forEach(el => el.classList.remove('dactive'));
  document.querySelector(`.drawer-item[onclick*="go('${id}')"]`)?.classList.add('dactive');

  // Back button
  const bb = document.getElementById('pageBackBtn');
  if (bb) bb.style.opacity = id === 'home' ? '0' : '1';

  if (navigator.vibrate) navigator.vibrate(7);
};

function appTab(page) { go(page); }

function appGoBack() {
  if (_navHistory.length > 1) {
    _navHistory.pop();
    go(_navHistory[_navHistory.length-1], true);
  } else { go('home', true); }
  if (navigator.vibrate) navigator.vibrate(5);
}

// ── Drawer ──
function openDrawer() {
  document.getElementById('appDrawer')?.classList.add('open');
  document.getElementById('drawerBg')?.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeDrawer() {
  document.getElementById('appDrawer')?.classList.remove('open');
  document.getElementById('drawerBg')?.classList.remove('open');
  document.body.style.overflow = '';
}

// ── Search ──
const SEARCH_INDEX = [
  {i:'🎓',n:'Academy',s:'কোর্স, লাইভ ক্লাস, রেকর্ডেড',p:'academy'},
  {i:'🧸',n:'Kids & Baby World',s:'Phonics, CVC, Abacus, Brain Games, ছড়া',p:'kids'},
  {i:'👩‍🏫',n:'Teachers',s:'শিক্ষক, টিউটর, Home Tutor',p:'teachers'},
  {i:'🌐',n:'Higher Study',s:'স্কলারশিপ, SOP Checker, AI Evaluator',p:'higherstudy'},
  {i:'🤖',n:'AI Tools',s:'AI Tutor, Chatbot, Image Gen',p:'ai'},
  {i:'📰',n:'News',s:'শিক্ষা সংবাদ, Fact Check, পডকাস্ট',p:'news'},
  {i:'🛒',n:'Mart',s:'বই, শিক্ষা উপকরণ, স্টেশনারি',p:'mart'},
  {i:'📚',n:'Publications',s:'জার্নাল, বই, গবেষণাপত্র',p:'publications'},
  {i:'✍️',n:'Blogs',s:'নিবন্ধ, অভিজ্ঞতা, Tutorial',p:'blog'},
  {i:'💼',n:'Careers',s:'চাকরি, ইন্টার্নশিপ, Freelance',p:'careers'},
  {i:'🔬',n:'Research',s:'গবেষণাপত্র, প্রকল্প, Publication',p:'research'},
  {i:'🪙',n:'Gold Coins',s:'পুরস্কার, Streak, Leaderboard',p:'coins'},
  {i:'👥',n:'Community',s:'Study Rooms, Q&A, Forum, Events',p:'community'},
  {i:'📺',n:'Media',s:'ভিডিও, পডকাস্ট, Shorts, Livestream',p:'media'},
  {i:'🏫',n:'Institutional',s:'LMS, প্রতিষ্ঠান ব্যবস্থাপনা, Analytics',p:'institutional'},
  {i:'🏅',n:'Exams & Certificates',s:'সার্টিফিকেট, ব্যাজ, যাচাই',p:'certifications'},
  {i:'🎨',n:'Creator',s:'কোর্স তৈরি, Revenue, Monetization',p:'creator'},
  {i:'🛠️',n:'Blueprint',s:'Technical Architecture, Engineering Docs',p:'blueprint'},
  {i:'✦',n:'Join Effective EduHub',s:'নিবন্ধন করুন — সম্পূর্ণ বিনামূল্যে',p:'join'},
  {i:'📊',n:'Dashboard',s:'প্রোফাইল, কোর্স অগ্রগতি, Analytics',p:'dashboard'},
];

function openSearch() {
  document.getElementById('searchOverlay')?.classList.add('open');
  document.body.style.overflow='hidden';
  liveSearch('');
  setTimeout(()=>document.getElementById('searchInput')?.focus(),150);
}
function closeSearch() {
  document.getElementById('searchOverlay')?.classList.remove('open');
  const inp=document.getElementById('searchInput');
  if(inp) inp.value='';
  document.body.style.overflow='';
}
function liveSearch(q) {
  const res=document.getElementById('searchResults');
  if(!res) return;
  const matches=q.trim()
    ? SEARCH_INDEX.filter(p=>(p.n+p.s+p.p).toLowerCase().includes(q.toLowerCase()))
    : SEARCH_INDEX;
  const lbl=q.trim()?`${matches.length}টি ফলাফল`:'সব বিভাগ';
  res.innerHTML=`<div style="padding:10px 16px 5px;font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);">${lbl}</div>`
    +(matches.length
      ? matches.map(p=>`<div class="search-result-item" onclick="go('${p.p}');closeSearch()"><div class="sri-icon">${p.i}</div><div><div class="sri-name">${p.n}</div><div class="sri-sub">${p.s}</div></div></div>`).join('')
      : `<div style="text-align:center;padding:32px;color:var(--text3);font-family:'Noto Serif Bengali',serif;font-size:.83rem;">কোনো ফলাফল পাওয়া যায়নি</div>`);
}

// ── Notifications ──
function openNotif() {
  document.getElementById('notifPanel')?.classList.add('open');
  document.body.style.overflow='hidden';
}
function closeNotif() {
  document.getElementById('notifPanel')?.classList.remove('open');
  document.body.style.overflow='';
}

// ── Dark mode ──
function toggleDarkMode() {
  document.body.classList.toggle('dark-mode');
  const dark=document.body.classList.contains('dark-mode');
  localStorage.setItem('rgDark',dark?'1':'0');
  const lbl=document.getElementById('darkModeLabel');
  if(lbl) lbl.textContent=dark?'Light Mode':'Dark Mode';
  document.getElementById('metaThemeColor')?.setAttribute('content',dark?'#0F0C07':'#B86D05');
  showToast(dark?'🌙 Dark Mode চালু':'☀️ Light Mode চালু');
}
if(localStorage.getItem('rgDark')==='1'){
  document.body.classList.add('dark-mode');
  const lbl=document.getElementById('darkModeLabel');
  if(lbl) lbl.textContent='Light Mode';
}

// ── Scroll effect ──
window.addEventListener('scroll',()=>{
  document.getElementById('appHeaderBar')?.classList.toggle('scrolled',window.scrollY>8);
},{passive:true});

// ── Pull-to-refresh ──
let _ptrY=0,_ptrPull=false;
document.addEventListener('touchstart',e=>{if(window.scrollY===0)_ptrY=e.touches[0].clientY;},{passive:true});
document.addEventListener('touchmove',e=>{
  if(!isMobile()) return;
  if(e.touches[0].clientY-_ptrY>72&&window.scrollY===0&&!_ptrPull){
    _ptrPull=true;document.getElementById('ptrIndicator')?.classList.add('visible');
  }
},{passive:true});
document.addEventListener('touchend',()=>{
  if(_ptrPull){_ptrPull=false;setTimeout(()=>{document.getElementById('ptrIndicator')?.classList.remove('visible');showToast('✅ পেজ রিফ্রেশ হয়েছে');},900);}
  _ptrY=0;
},{passive:true});

// ── Left-edge swipe back ──
let _swipeX=0;
document.addEventListener('touchstart',e=>{_swipeX=e.touches[0].clientX;},{passive:true});
document.addEventListener('touchend',e=>{
  if(!isMobile()) return;
  if(_swipeX<28&&e.changedTouches[0].clientX-_swipeX>70) appGoBack();
},{passive:true});

// PWA Manifest — generated once (a duplicate second generator was removed;
// see "Update PWA manifest" below for the version that's actually kept)

// ── Install prompt ──
let _prompt;
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();_prompt=e;if(isMobile())setTimeout(()=>{
  if(sessionStorage.getItem('installOff')||document.getElementById('installBanner')) return;
  const b=document.createElement('div');b.id='installBanner';b.className='install-banner';
  b.innerHTML=`<div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#B86D05,#D4840E);display:flex;align-items:center;justify-content:center;font-family:serif;font-size:1.3rem;font-weight:700;color:#fff;flex-shrink:0;">R</div><div style="flex:1;min-width:0;"><div style="font-weight:700;font-size:.82rem;color:var(--text);">Effective EduHub App ইনস্টল করুন</div><div style="font-family:'Noto Serif Bengali',serif;font-size:.69rem;color:var(--text3);">হোম স্ক্রিনে যোগ করুন · অফলাইন অ্যাক্সেস</div></div><button onclick="if(_prompt){_prompt.prompt();_prompt.userChoice.then(r=>{if(r.outcome==='accepted')showToast('🎉 Installing!');_prompt=null;});}else{showToast('Browser → Add to Home Screen');}document.getElementById('installBanner')?.remove();" style="background:var(--gold);border:none;border-radius:8px;padding:6px 12px;font-weight:700;font-size:.74rem;color:#fff;cursor:pointer;flex-shrink:0;">ইনস্টল</button><button onclick="sessionStorage.setItem('installOff','1');this.parentElement.remove();" style="background:none;border:none;font-size:.9rem;color:var(--text3);cursor:pointer;padding:3px 6px;">✕</button>`;
  document.body.appendChild(b);
},12000);});

// ── Keyboard shortcuts ──
document.addEventListener('keydown',e=>{
  if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();openSearch();}
  if(e.key==='Escape'){closeSearch();closeNotif();closeDrawer();}
});

// ── URL param routing ──
const _urlP=new URLSearchParams(location.search).get('p');
if(_urlP&&document.getElementById('page-'+_urlP)) go(_urlP);

// ── Splash hide on load ──
window.addEventListener('load',()=>{
  // Splash must hide on ALL devices — desktop and mobile
  const s=document.getElementById('appSplash');
  if(!s) return;
  if(isMobile()){
    s.style.display='flex';
    liveSearch('');
  }
  setTimeout(()=>{
    s.classList.add('hide');
    setTimeout(()=>s.style.display='none',560);
  },1800);
});



// ══ PERFORMANCE & UX IMPROVEMENTS ══

// Debounce live search
(function(){
  if(typeof liveSearch==='undefined') return;
  const orig = liveSearch;
  let t;
  liveSearch = function(q){ clearTimeout(t); t = setTimeout(()=>orig(q), 150); };
})();

// Network status awareness
window.addEventListener('online',  ()=>showToast('✅ ইন্টারনেট পুনরুদ্ধার হয়েছে'));
window.addEventListener('offline', ()=>showToast('📵 ইন্টারনেট সংযোগ নেই'));

// Global error boundary for unhandled promise rejections
window.addEventListener('unhandledrejection', function(e){
  if(e.reason && (e.reason.name==='TypeError' || String(e.reason.message||'').includes('fetch'))){
    showToast('⚠️ নেটওয়ার্ক সংযোগ পরীক্ষা করুন');
    e.preventDefault();
  }
});

// Pause marquee animations when tab is hidden
document.addEventListener('visibilitychange', function(){
  var ps = document.hidden ? 'paused' : 'running';
  ['navTrack','ecoMarquee'].forEach(function(id){
    var el = document.getElementById(id);
    if(el) el.style.animationPlayState = ps;
  });
});

// Wrap go() to save last page
(function(){
  var _orig = go;
  go = function(id, back){
    _orig(id, back);
    try{ sessionStorage.setItem('eeh_lp', id); }catch(e){}
  };
})();

// ── SEO: reflect current page in the URL + browser title ──
(function(){
  var _orig = go;
  var BASE_TITLE = 'Effective EduHub — Bangladesh\'s #1 EdTech Platform';
  go = function(id, back){
    _orig(id, back);
    try{
      // Update browser tab title per page
      var t = (typeof PAGE_TITLES !== 'undefined' && PAGE_TITLES[id]) ? PAGE_TITLES[id] : '';
      document.title = (t && id !== 'home') ? (t + ' — Effective EduHub') : BASE_TITLE;
      // Update the address bar without a full reload (skip re-push on popstate-triggered calls)
      if(!back){
        var newUrl = (id === 'home') ? location.pathname : ('?p=' + encodeURIComponent(id));
        var current = new URLSearchParams(location.search).get('p') || 'home';
        if(current !== id){
          history.pushState({page:id}, '', newUrl);
        }
      }
    }catch(e){}
  };
  // Handle browser Back/Forward buttons
  window.addEventListener('popstate', function(e){
    var pid = (e.state && e.state.page) ? e.state.page : (new URLSearchParams(location.search).get('p') || 'home');
    if(document.getElementById('page-'+pid)){
      go(pid, true);
    }
  });
})();

// Session storage: restore last visited page
(function(){
  try{
    var lp = sessionStorage.getItem('eeh_lp');
    var urlP = new URLSearchParams(location.search).get('p');
    if(urlP && document.getElementById('page-'+urlP)){
      go(urlP, true);
    } else if(!urlP && lp && lp !== 'home' && document.getElementById('page-'+lp)){
      go(lp);
    }
  }catch(e){}
})();

// Form autosave (learner draft)
setInterval(function(){
  try{
    var n = document.getElementById('l-name');
    var p = document.getElementById('l-phone');
    if((n&&n.value)||(p&&p.value)){
      localStorage.setItem('eeh_draft', JSON.stringify({
        name: n ? n.value : '',
        phone: p ? p.value : '',
        ts: Date.now()
      }));
    }
  }catch(e){}
}, 30000);

// Restore saved draft
(function(){
  try{
    var d = JSON.parse(localStorage.getItem('eeh_draft')||'{}');
    if(d.ts && Date.now()-d.ts < 3600000){
      var n = document.getElementById('l-name');
      var p = document.getElementById('l-phone');
      if(n && !n.value && d.name)  n.value = d.name;
      if(p && !p.value && d.phone) p.value = d.phone;
    }
  }catch(e){}
})();

