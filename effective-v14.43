function bpTab(n){
  [1,2,3,4].forEach(i=>{
    document.getElementById('bptab-'+i)?.classList.toggle('on', i===n);
    const p = document.getElementById('bpp-'+i);
    if(p) p.style.display = i===n ? 'block' : 'none';
  });
}

function bpCopy(blockId){
  const block = document.getElementById(blockId);
  if(!block) return;
  const code = block.querySelector('code');
  if(!code) return;
  const text = code.innerText;
  navigator.clipboard.writeText(text).then(()=>{
    showToast('✅ কোড কপি হয়েছে!');
    const btn = block.querySelector('.bp-copy-btn');
    if(btn){ btn.textContent='✓ Copied'; setTimeout(()=>{ btn.textContent='⎘ Copy'; },1800); }
  }).catch(()=> showToast('কোড কপি করুন: Ctrl+A, Ctrl+C'));
}

// Deployment checklist with progress bar
function bpToggleCheck(el){
  el.classList.toggle('done');
  const bck = el.querySelector('.bpck');
  if(bck) bck.textContent = el.classList.contains('done') ? '☑' : '☐';
  const all = document.querySelectorAll('#bpChecklist .bp-check-item');
  const done = document.querySelectorAll('#bpChecklist .bp-check-item.done');
  const pct = Math.round((done.length/all.length)*100);
  const bar = document.getElementById('bpProgressBar');
  const lbl = document.getElementById('bpProgressLabel');
  if(bar) bar.style.width = pct+'%';
  if(lbl) lbl.textContent = done.length+'/'+all.length;
  if(done.length === all.length) showToast('🎉 সমস্ত চেকলিস্ট সম্পন্ন! প্রোডাকশনে যাওয়ার জন্য প্রস্তুত।');
}

function setBpQ(q){
  const el = document.getElementById('bpAiInput');
  if(el){ el.value=q; el.focus(); }
}

async function runBpAI(){
  const q = document.getElementById('bpAiInput')?.value.trim();
  if(!q){ showToast('⚠️ একটি engineering প্রশ্ন লিখুন'); return; }

  const btn = document.getElementById('bpAiBtn');
  const loading = document.getElementById('bpAiLoading');
  const answer = document.getElementById('bpAiAnswer');

  btn.disabled=true; btn.textContent='⏳ চিন্তা করছে…';
  loading.style.display='flex'; answer.innerHTML='<span style="color:rgba(255,255,255,.3);">বিশ্লেষণ চলছে…</span>';

  try {
    const resp = await fetch((window.VOD_API_BASE||'')+'/ai/ask',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514', max_tokens:1000,
        messages:[{role:'user', content:`You are a senior software architect for the Effective EduHub platform — a large EdTech ecosystem built on Next.js, PostgreSQL, Redis, Neo4j, pgvector, FastAPI, and Socket.io. Answer the following engineering or architecture question concisely but thoroughly. Use code examples where relevant. Mix English technical terms with Bengali explanations where helpful. Keep the answer under 300 words.\n\nQuestion: ${q}`}]
      })
    });
    if(!resp.ok) throw new Error('AI service returned ' + resp.status);
    const data = await resp.json();
    const text = data?.content?.map(i=>i.text||'').join('') || '';
    if(!text) throw new Error('Empty response');
    // Format: convert markdown-ish code blocks to styled spans (escape first — AI output is untrusted)
    const html = escapeHtml(text)
      .replace(/```(\w+)?\n?([\s\S]*?)```/g, '<div style="background:#13111F;border-radius:6px;padding:10px 12px;margin:8px 0;font-family:monospace;font-size:.75rem;color:#86EFAC;white-space:pre-wrap;overflow-x:auto;">$2</div>')
      .replace(/\*\*(.*?)\*\*/g,'<strong style="color:rgba(255,255,255,.9);">$1</strong>')
      .replace(/`(.*?)`/g,'<code style="background:rgba(124,58,237,.2);color:#C4B5FD;padding:1px 5px;border-radius:3px;font-family:monospace;font-size:.78em;">$1</code>')
      .replace(/\n\n/g,'</p><p style="margin-top:10px;">')
      .replace(/\n/g,'<br>');
    answer.innerHTML = '<p style="color:rgba(255,255,255,.75);">' + html + '</p>';
  } catch(e){
    console.warn('AI engineering consultant unavailable:', e.message);
    answer.innerHTML = `<p style="color:rgba(255,255,255,.6);">⚠️ AI কনসালট্যান্ট এই মুহূর্তে সংযোগের বাইরে (নেটওয়ার্ক সমস্যা)। আপনার প্রশ্নটি <strong style="color:#C4B5FD;">"${escapeHtml(q.slice(0,80))}"</strong> নিয়ে আমাদের ডকুমেন্টেশন বা GitHub Discussions-এ খুঁজে দেখতে পারেন, অথবা কিছুক্ষণ পর আবার চেষ্টা করুন।</p>`;
  } finally {
    btn.disabled=false; btn.textContent='⚡ Ask AI';
    loading.style.display='none';
  }
}

