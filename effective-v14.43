        <!-- 1. School Academy -->
        <div class="aw-panel on" id="aw-school">
          <div class="aw-panel-hd"><div class="aw-panel-icon" style="background:var(--teal-dim);color:var(--teal);">🏫</div><div><div class="aw-panel-title">Effective School Academy</div><div class="aw-panel-sub">Class 6–8 ও SSC (৯–১০) — বাংলা মাধ্যম সম্পূর্ণ কারিকুলাম</div></div></div>
          <div class="aw-grp-grid">
