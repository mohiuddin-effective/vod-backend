// 🌐 ECOSYSTEM — sector/sub-sector taxonomy with interest checkboxes.
// Sector headers map to preferred_wings (wing-level, ×5.0 in /feed scoring);
// sub-items map to interests (fine-grained tags, ×3.0 in /feed scoring).
// Every link below points to a real, existing page — nothing fabricated.
// ══════════════════════════════════════════════════════
const ECO_TAXONOMY = [
  {sector:'Kids', link:'kids', items:[
