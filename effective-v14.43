      <div class="sec-hd">
        <div><div class="sec-lbl">সম্পূর্ণ ইকোসিস্টেম</div><div class="sec-ttl">১২টি <span class="bn">Academy Wing</span></div></div>
        <div style="font-family:'Noto Serif Bengali',serif;font-size:.78rem;color:var(--text3);max-width:340px;text-align:right;">Class 6 থেকে BCS, IELTS ও Higher Study পর্যন্ত — একটি মাত্র ইকোসিস্টেমে।</div>
      </div>

      <!-- Wing tab selector -->
      <div class="aw-tabs" id="awTabs">
        <button class="aw-tab on" onclick="awSwitch(this,'school')">🏫 School</button>
        <button class="aw-tab" onclick="awSwitch(this,'college')">🎒 College</button>
        <button class="aw-tab" onclick="awSwitch(this,'english')">🗣️ English</button>
        <button class="aw-tab" onclick="awSwitch(this,'ict')">💻 ICT &amp; AI</button>
        <button class="aw-tab" onclick="awSwitch(this,'admission')">🎯 Admission</button>
        <button class="aw-tab" onclick="awSwitch(this,'job')">🏛️ Job</button>
        <button class="aw-tab" onclick="awSwitch(this,'higher')">🌐 Higher Study</button>
        <button class="aw-tab" onclick="awSwitch(this,'professional')">💼 Professional</button>
      </div>

      <!-- Wing panels -->
