  changeTip(currentTip);
},7000);

// ── Live Count Simulation ──
function updateLiveCount(){
  const base=3200;
  const variation=Math.floor(Math.random()*150)-75;
  const count=base+variation;
  const bn=count.toLocaleString('bn-BD');
  const el=document.getElementById('liveCount');
  if(el) el.textContent=bn;
}
setInterval(updateLiveCount,8000);

// ── Real-time Clock ──
function updateClock(){
  const now=new Date();
  const h=String(now.getHours()).padStart(2,'0');
  const m=String(now.getMinutes()).padStart(2,'0');
  const el=document.getElementById('currentTime');
  if(el) el.textContent=h+':'+m;
}
updateClock();
setInterval(updateClock,30000);

