          <div style="flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden;"><div class="bp-progress-fill" id="bpProgressBar" style="width:0%;height:100%;background:linear-gradient(90deg,var(--green),var(--teal));border-radius:3px;transition:width .3s;"></div></div>
