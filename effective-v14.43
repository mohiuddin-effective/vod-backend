<!-- ════ JAVASCRIPT ════ -->
<script>
const pages=['home','academy','teachers','publications','mart','blog','ai','higherstudy','coins','institutional','certifications','community','media','creator','research','careers','news','blueprint','join','dashboard','kids','feed','bcs-prelim','bank-jobs','hsc-prep','ssc-prep','class8-jsc','class7-prep','class6-prep','class5-psc'];
// ══════════════════════════════════════════════════════
// 🏦 APP STATE — coins, cart, streak (localStorage-backed,
//    cross-tab synced via storage event)
// ══════════════════════════════════════════════════════
const AppState = (function(){
  const KEY = 'eeh_state';
  const STREAK_KEY = 'eeh_streak';
  let state;
  try{ state = JSON.parse(localStorage.getItem(KEY)||'{}'); }catch(e){ state={}; }
  if(!state.coins) state.coins = 385;
  if(!state.cart)  state.cart  = [];

  function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }

  function updateUI(){
    const coinEl = document.getElementById('appHdrCoins');
    if(coinEl) coinEl.textContent = state.coins;
    const cartEl = document.getElementById('cartN');
    if(cartEl) cartEl.textContent = state.cart.length;
  }

  function get(k){ return state[k]; }
  function set(k,v){ state[k]=v; save(); updateUI(); }
  function addCoin(n){ state.coins = (state.coins||0)+n; save(); updateUI(); }
  function addCartItem(name){
    state.cart = state.cart||[];
    state.cart.push({name, addedAt: Date.now()});
    save(); updateUI();
  }
  function getCart(){ return state.cart||[]; }

  // Cross-tab sync
  window.addEventListener('storage', function(e){
    if(e.key===KEY){ try{ state=JSON.parse(e.newValue||'{}'); updateUI(); }catch(e2){} }
  });

  // Daily streak tracking
  function checkStreak(){
    try{
      const today = new Date().toDateString();
      const d = JSON.parse(localStorage.getItem(STREAK_KEY)||'{"days":0,"last":""}');
      const yesterday = new Date(Date.now()-86400000).toDateString();
      if(d.last===today) return d.days;
      if(d.last===yesterday){ d.days++; } else { d.days=1; }
      d.last=today;
      localStorage.setItem(STREAK_KEY, JSON.stringify(d));
      if(d.days>0){ addCoin(10); } // +10 coins per login day
      return d.days;
    }catch(e){ return 0; }
  }

  document.addEventListener('DOMContentLoaded', function(){
    updateUI();
    const streak = checkStreak();
    const streakEls = document.querySelectorAll('.gm-streak-text');
    streakEls.forEach(el=>{ el.textContent = streak+'🔥'; });
  });

  return { get, set, addCoin, addCartItem, getCart, updateUI };
})();

let cart=AppState.getCart().length;

// ══════════════════════════════════════════════════════
// 🧸 KIDS LEARNING WING — module logic, progress tracking
//    (progress stored via AppState under the 'kidsProgress' key —
//    same single-source-of-truth store as coins/cart)
// ══════════════════════════════════════════════════════
function kidsProgress(){
  return AppState.get('kidsProgress') || {};
}
function kidsTotalStars(){
  const p = kidsProgress();
  return Object.values(p).reduce((a,b)=>a+b, 0);
}
function kwUpdateStarsUI(){
  const total = kidsTotalStars();
  const headerEl = document.getElementById('kwStarsCount');
  if(headerEl) headerEl.textContent = total;
  const parentEl = document.getElementById('kwParentStars');
  if(parentEl) parentEl.textContent = total;
  const p = kidsProgress();
  Object.keys(p).forEach(moduleId=>{
    const badge = document.getElementById('kwStar-'+moduleId);
    if(badge) badge.textContent = '⭐'.repeat(Math.min(p[moduleId], 3));
  });
}
function kidsMarkDone(moduleId, label){
  const p = kidsProgress();
  p[moduleId] = (p[moduleId]||0) + 1;
  AppState.set('kidsProgress', p);
  AppState.addCoin(5);
  kwUpdateStarsUI();
  showToast('⭐ চমৎকার! +৫ Gold Coin অর্জন করেছো — '+escapeHtml(label));
}

function toggleKidsPlayMode(){
  const hero = document.getElementById('kwHero');
  const btn = document.getElementById('kwPlayModeBtn');
  if(!hero||!btn) return;
  const on = hero.classList.toggle('kw-play-mode');
  btn.textContent = on ? '✅ Play Mode চালু' : (KIDS_I18N[kwCurrentLang]?.hero_btn || 'Play & Learn Mode 🎮');
  if(on) showToast('🎮 Play & Learn Mode চালু হয়েছে!');
}

function filterKidsAge(age, btnEl){
  document.querySelectorAll('.kw-age-tab').forEach(t=>t.classList.remove('on'));
  if(btnEl) btnEl.classList.add('on');
  document.querySelectorAll('#kwModuleGrid .kw-card').forEach(card=>{
    const cardAge = card.getAttribute('data-age');
    card.style.display = (age==='all' || cardAge==='all' || cardAge===age) ? '' : 'none';
  });
}

