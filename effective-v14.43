<!-- HERO -->
<div class="hs-wing-hero">
  <div class="hs-hero-in">
    <div>
      <div class="hs-eyebrow">🌐 নতুন উইং — Effective Higher Study</div>
      <h1 class="hs-wing-title">বিশ্ব জয় করুন<br><em>সঠিক গাইডেন্সে</em></h1>
      <p class="hs-wing-sub">SAT থেকে PhD — স্কলারশিপ খোঁজা, SOP লেখা, প্রফেসর ইমেইল, ভিসা ফাইল — সবকিছু এক প্ল্যাটফর্মে। বিশ্বজুড়ে ভেরিফায়েড কনসালট্যান্ট, AI টুল ও কমিউনিটি।</p>
      <div class="smart-search">
        <span style="font-size:1.1rem;">🔍</span>
        <input type="text" placeholder="কোন বিশয়ে পড়তে চান? যেমন: Computer Science, MBA, Public Health...">
        <div class="ss-divider"></div>
        <div class="ss-country">
          <select>
            <option>🌍 যেকোনো দেশ</option>
            <option>🇺🇸 USA</option>
            <option>🇨🇦 Canada</option>
            <option>🇬🇧 UK</option>
            <option>🇩🇪 Germany</option>
            <option>🇦🇺 Australia</option>
            <option>🇯🇵 Japan</option>
