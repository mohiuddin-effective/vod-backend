          <button style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.7);border-radius:5px;padding:4px 10px;font-size:.7rem;" onclick="showToast('সংরক্ষিত হয়েছে!')">🔖</button>
          <button onclick="closeArticle()" style="background:rgba(196,32,32,.7);border:none;color:#fff;border-radius:5px;padding:4px 12px;font-size:.75rem;">✕</button>
        </div>
