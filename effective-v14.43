// ── AI Profile Evaluator ──
async function runAIEvaluation(){
  const cgpa = document.getElementById('evalCgpa').value;
  const ielts = document.getElementById('evalIelts').value;
  const gre = document.getElementById('evalGre').value;
  const degree = document.getElementById('evalDegree').value;
  const subject = document.getElementById('evalSubject').value;
  const country = document.getElementById('evalCountry').value;

  if(!cgpa || !ielts){
    showToast('⚠️ CGPA এবং IELTS স্কোর অবশ্যই দিতে হবে');
    return;
  }

  const btn = document.getElementById('evalBtn');
  const loading = document.getElementById('evalLoading');
  const result = document.getElementById('evalResult');
  btn.disabled = true;
  btn.textContent = '⏳ বিশ্লেষণ চলছে…';
  loading.style.display = 'block';
  result.classList.remove('show');

  const prompt = `You are a scholarship matching expert for Bangladeshi students. Analyze this student profile and return ONLY valid JSON (no markdown, no extra text).

Profile:
- CGPA: ${cgpa}/4.0
- IELTS: ${ielts}/9.0
- GRE: ${gre || 'Not taken'}
- Target Degree: ${degree}
- Subject/Field: ${subject || 'Not specified'}
- Preferred Country: ${country}

Return this exact JSON structure:
{
  "overallScore": <number 0-100>,
  "profileStrength": "<Excellent|Good|Average|Needs Improvement>",
  "scholarships": [
    {"name":"<name>","country":"<flag+country>","type":"<Full Funded|Partial|Government>","matchPct":<number>,"deadline":"<deadline>","note":"<short tip in Bengali>"},
    ... (5-6 scholarships ranked by match)
  ],
  "strengths": ["<strength in Bengali>", ...],
  "improvements": ["<improvement tip in Bengali>", ...],
  "nextStep": "<one concrete next action in Bengali>"
}`;

  try {
    const response = await fetch((window.VOD_API_BASE||'')+'/ai/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    if (!response.ok) throw new Error('AI service returned ' + response.status);
    const data = await response.json();
    const raw = data?.content?.map(i=>i.text||'').join('') || '';
    const clean = raw.replace(/```json|```/g,'').trim();
    const res = JSON.parse(clean);
    renderEvalResult(res);
  } catch(err) {
    console.warn('AI evaluation unavailable, using offline scoring engine:', err.message);
    renderEvalResult(offlineEvalScore(cgpa, ielts, gre, degree, subject, country));
    showToast('ℹ️ অফলাইন স্কোরিং ইঞ্জিন ব্যবহার করা হয়েছে');
  } finally {
    btn.disabled = false;
    btn.textContent = '🔍 AI দিয়ে স্কলারশিপ ম্যাচ বিশ্লেষণ করুন';
    loading.style.display = 'none';
  }
}

// ── Offline deterministic fallback scoring (used when AI API is unreachable) ──
function offlineEvalScore(cgpa, ielts, gre, degree, subject, country){
  const cgpaScore  = Math.min((parseFloat(cgpa)||0) / 4.0 * 50, 50);
  const ieltsScore = Math.min((parseFloat(ielts)||0) / 9.0 * 35, 35);
  const greBonus   = gre ? Math.min((parseFloat(gre)||0) / 340 * 15, 15) : 5;
  const overallScore = Math.round(Math.min(cgpaScore + ieltsScore + greBonus, 100));
  const profileStrength = overallScore>=85?'Excellent':overallScore>=70?'Good':overallScore>=55?'Average':'Needs Improvement';

  const pool = [
    {name:'Fulbright Foreign Student Program', country:'🇺🇸 USA', type:'Full Funded', deadline:'বার্ষিক — মে', note:'গবেষণা প্রস্তাবনা শক্তিশালী করুন'},
    {name:'Chevening Scholarship', country:'🇬🇧 UK', type:'Full Funded', deadline:'নভেম্বর', note:'নেতৃত্বের অভিজ্ঞতা উল্লেখ করুন'},
    {name:'DAAD Scholarship', country:'🇩🇪 Germany', type:'Full Funded', deadline:'অক্টোবর', note:'গবেষণাপত্র প্রস্তুত রাখুন'},
    {name:'Erasmus Mundus', country:'🇪🇺 EU', type:'Full Funded', deadline:'জানুয়ারি', note:'একাধিক বিশ্ববিদ্যালয়ে আবেদন করুন'},
    {name:'Commonwealth Scholarship', country:'🇬🇧 UK', type:'Full Funded', deadline:'ডিসেম্বর', note:'IELTS স্কোর অগ্রাধিকার পায়'},
    {name:'MEXT Scholarship', country:'🇯🇵 Japan', type:'Government', deadline:'মে', note:'জাপানি ভাষা শেখা শুরু করুন'},
  ];
  const scholarships = pool.map((s,i)=>({...s, matchPct: Math.max(50, overallScore - i*4 + (Math.random()*6-3|0))}))
                            .sort((a,b)=>b.matchPct-a.matchPct).slice(0,5);

  return {
    overallScore, profileStrength,
    scholarships,
    strengths: [
      parseFloat(cgpa)>=3.5 ? 'আপনার একাডেমিক রেজাল্ট প্রতিযোগিতামূলক' : 'আপনার একাডেমিক ভিত্তি স্থিতিশীল',
      parseFloat(ielts)>=7 ? 'IELTS স্কোর স্কলারশিপের জন্য যথেষ্ট ভালো' : 'ভাষাগত যোগ্যতা গ্রহণযোগ্য পর্যায়ে',
      'সঠিক দেশ ও বিষয় নির্বাচন করেছেন',
    ],
    improvements: [
      parseFloat(ielts)<7 ? 'IELTS স্কোর ৭.০+ করার চেষ্টা করুন' : 'GRE/GMAT স্কোর যুক্ত করলে প্রোফাইল আরও শক্তিশালী হবে',
      'SOP-তে নির্দিষ্ট গবেষণা আগ্রহ উল্লেখ করুন',
      'রেফারেন্স লেটারের জন্য এখনই অনুরোধ করুন',
    ],
    nextStep: 'উপরের তালিকার সর্বোচ্চ-ম্যাচ স্কলারশিপের ডেডলাইন অনুযায়ী SOP লেখা শুরু করুন।',
  };
}

function renderEvalResult(res){
  const scoreColor = res.overallScore >= 80 ? 'var(--green)' : res.overallScore >= 60 ? 'var(--gold)' : 'var(--red)';
  const scholarshipHTML = (res.scholarships||[]).map(s=>{
    const pct = s.matchPct;
    const cls = pct>=80?'hi':pct>=65?'md':'lo';
    return `<div class="smatch"><span class="smatch-score ${cls}">${pct}%</span><div class="smatch-name">${s.name}</div><div class="smatch-info">${s.country} · ${s.type} · ${s.deadline}</div><div style="font-family:'Noto Serif Bengali',serif;font-size:.71rem;color:var(--text3);margin-top:3px;">💡 ${s.note}</div></div>`;
  }).join('');

  const strengthsHTML = (res.strengths||[]).map(s=>`<div class="ai-reco-item">✅ ${s}</div>`).join('');
  const improvHTML = (res.improvements||[]).map(s=>`<div class="ai-reco-item">🔧 ${s}</div>`).join('');

  document.getElementById('evalResultContent').innerHTML = `
    <div style="display:flex;align-items:center;gap:20px;margin-bottom:18px;padding:16px;background:var(--deep);border-radius:12px;">
      <div style="text-align:center;min-width:80px;">
        <div style="font-family:'Cormorant Garamond',serif;font-size:2.8rem;font-weight:700;color:${scoreColor};line-height:1;">${res.overallScore}</div>
        <div style="font-size:.67rem;color:var(--text3);font-weight:600;letter-spacing:.1em;text-transform:uppercase;">/ 100</div>
      </div>
      <div>
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:700;color:var(--text);">প্রোফাইল শক্তি: <span style="color:${scoreColor};">${res.profileStrength}</span></div>
        <div style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--text2);margin-top:4px;">📌 পরবর্তী পদক্ষেপ: ${res.nextStep||''}</div>
      </div>
    </div>
    <div class="pe-match-title">🎯 আপনার জন্য সেরা ${(res.scholarships||[]).length}টি স্কলারশিপ ম্যাচ</div>
    <div class="scholar-match-grid">${scholarshipHTML}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
      <div><div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--green);margin-bottom:6px;">💪 আপনার শক্তি</div>${strengthsHTML}</div>
      <div><div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;">🎯 উন্নতির সুযোগ</div>${improvHTML}</div>
    </div>`;

  const result = document.getElementById('evalResult');
  result.classList.add('show');
  result.scrollIntoView({behavior:'smooth',block:'nearest'});
  showToast('🎯 AI বিশ্লেষণ সম্পন্ন!');
}

// ── AI SOP Checker ──
async function runAISopCheck(){
  const text = document.getElementById('sopText').value.trim();
  if(text.length < 100){
    showToast('⚠️ অনুগ্রহ করে কমপক্ষে ১০০ শব্দের পাঠ্য দিন');
    return;
  }

  const typeLabel = currentSopType === 'cv' ? 'CV/Resume' : currentSopType === 'lor' ? 'Letter of Recommendation' : 'Statement of Purpose';
  const btn = document.getElementById('sopBtn');
  const loading = document.getElementById('sopLoading');
  const result = document.getElementById('sopResult');
  btn.disabled = true;
  btn.textContent = '⏳ বিশ্লেষণ চলছে…';
  loading.style.display = 'block';
  result.classList.remove('show');

  const prompt = `You are an expert academic document reviewer specializing in graduate school applications for students from Bangladesh. Analyze the following ${typeLabel} and return ONLY valid JSON (no markdown, no extra text).

Document text:
---
${text.substring(0, 3000)}
---

Return this exact JSON structure:
{
  "atsScore": <number 0-100>,
  "verdict": "<Strong|Good|Needs Work|Weak>",
  "metrics": {
    "grammar": <number 0-100>,
    "structure": <number 0-100>,
    "clarity": <number 0-100>,
    "keywords": <number 0-100>,
    "tone": <number 0-100>
  },
  "strengths": ["<specific strength observed>", ...],
  "issues": [{"location":"<where>","problem":"<what>","fix":"<how to fix>"},...],
  "topRecommendation": "<single most impactful improvement in Bengali>",
  "wordCount": <estimated word count>
}`;

  try {
    const response = await fetch((window.VOD_API_BASE||'')+'/ai/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    if (!response.ok) throw new Error('AI service returned ' + response.status);
    const data = await response.json();
    const raw = data?.content?.map(i=>i.text||'').join('') || '';
    const clean = raw.replace(/```json|```/g,'').trim();
    const res = JSON.parse(clean);
    renderSopResult(res, typeLabel);
  } catch(err) {
    console.warn('AI SOP analysis unavailable, using offline heuristic engine:', err.message);
    renderSopResult(offlineSopScore(text, typeLabel), typeLabel);
    showToast('ℹ️ অফলাইন বিশ্লেষণ ইঞ্জিন ব্যবহার করা হয়েছে');
  } finally {
    btn.disabled = false;
    btn.textContent = '🤖 AI দিয়ে বিশ্লেষণ করুন';
    loading.style.display = 'none';
  }
}

// ── Offline heuristic SOP/CV scoring (used when AI API is unreachable) ──
function offlineSopScore(text, typeLabel){
  const words = text.trim().split(/\s+/).filter(Boolean);
  const wordCount = words.length;
  const sentences = text.split(/[.!?]+/).filter(s=>s.trim().length>0);
  const avgSentenceLen = sentences.length ? wordCount / sentences.length : 0;
  const longWords = words.filter(w=>w.length>8).length;

  // Heuristic scoring — not as smart as the AI, but deterministic and useful
  const lengthScore   = wordCount>=150 && wordCount<=600 ? 90 : wordCount>80 ? 70 : 45;
  const structureScore= sentences.length>=5 ? 85 : 60;
  const clarityScore  = avgSentenceLen>8 && avgSentenceLen<25 ? 88 : 65;
  const grammarScore  = 75; // can't truly check grammar offline — neutral estimate
  const toneScore     = 80;
  const keywordScore  = longWords > wordCount*0.05 ? 78 : 60;

  const atsScore = Math.round((lengthScore+structureScore+clarityScore+grammarScore+toneScore+keywordScore)/6);
  const verdict = atsScore>=80?'Strong':atsScore>=65?'Good':atsScore>=50?'Needs Work':'Weak';

  const issues = [];
  if (wordCount<150) issues.push({location:'সম্পূর্ণ লেখা', problem:'লেখাটি বেশ সংক্ষিপ্ত', fix:'কমপক্ষে ২০০ শব্দে বিস্তারিত লিখুন'});
  if (avgSentenceLen>25) issues.push({location:'বাক্য গঠন', problem:'বাক্যগুলো অনেক দীর্ঘ', fix:'বাক্য ছোট করে স্পষ্টতা বাড়ান'});
  if (sentences.length<5) issues.push({location:'কাঠামো', problem:'অনুচ্ছেদ বিভাজন প্রয়োজন', fix:'ভূমিকা, মূল বিষয়, উপসংহার আলাদা করুন'});

  return {
    atsScore, verdict,
    metrics:{grammar:grammarScore, structure:structureScore, clarity:clarityScore, keywords:keywordScore, tone:toneScore},
    strengths:[
      wordCount>=150 ? 'পর্যাপ্ত বিস্তারিত তথ্য রয়েছে' : 'মূল বক্তব্য স্পষ্ট',
      'লেখার ধরন ' + typeLabel + '-এর জন্য উপযুক্ত',
    ],
    issues,
    topRecommendation: 'নির্দিষ্ট উদাহরণ ও পরিমাণগত তথ্য (যেমন স্কোর, সংখ্যা) যুক্ত করলে লেখাটি আরও শক্তিশালী হবে।',
    wordCount,
  };
}

function renderSopResult(res, typeLabel){
  // BUG-03 FIX: sanitize score — parseFloat with fallback 0, then clamp 0-100
  const score = Math.min(100, Math.max(0, Math.round(parseFloat(res.atsScore) || 0)));
  const scoreColor = score>=80?'var(--green)':score>=60?'var(--gold)':'var(--red)';
  const verdictColor = res.verdict==='Strong'?'var(--green)':res.verdict==='Good'?'var(--teal)':res.verdict==='Needs Work'?'var(--gold)':'var(--red)';

  const m = res.metrics||{};
  const bars = [
    {label:'ব্যাকরণ', val:m.grammar||0},
    {label:'কাঠামো', val:m.structure||0},
    {label:'স্পষ্টতা', val:m.clarity||0},
    {label:'কীওয়ার্ড', val:m.keywords||0},
    {label:'টোন', val:m.tone||0},
  ].map(b=>{
    const c = b.val>=80?'var(--green)':b.val>=60?'var(--gold)':'var(--red)';
    return `<div class="sbar-row"><span class="sbar-label">${b.label}</span><div class="sbar-track"><div class="sbar-fill" style="width:${b.val}%;background:${c};"></div></div><span class="sbar-pct" style="color:${c}">${b.val}%</span></div>`;
  }).join('');

  const issuesHTML = (res.issues||[]).slice(0,3).map(i=>`
    <div style="background:var(--red-dim);border:1px solid rgba(196,32,32,.12);border-radius:8px;padding:10px 12px;margin-bottom:8px;">
      <div style="font-size:.74rem;font-weight:700;color:var(--red);margin-bottom:3px;">📍 ${i.location}</div>
      <div style="font-family:'Noto Serif Bengali',serif;font-size:.79rem;color:var(--text2);margin-bottom:4px;">⚠️ ${i.problem}</div>
      <div style="font-family:'Noto Serif Bengali',serif;font-size:.79rem;color:var(--green);">✅ সমাধান: ${i.fix}</div>
    </div>`).join('');

  const strengthsHTML = (res.strengths||[]).map(s=>`<div style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--text2);padding:6px 0;border-bottom:1px solid var(--border);">✅ ${s}</div>`).join('');

  document.getElementById('sopResultContent').innerHTML = `
    <div class="score-ring-wrap" style="margin-bottom:16px;">
      <div class="score-ring" style="--ring-color:${scoreColor};--ring-pct:${score}%;">
        <div class="score-inner"><div class="score-n" style="color:${scoreColor};">${score}</div><div class="score-l">/ ১০০</div></div>
      </div>
      <div class="score-details">
        <div class="score-title">ATS Score: <span style="color:${verdictColor};font-weight:700;">${res.verdict}</span> — ${typeLabel}</div>
        <div style="font-size:.72rem;color:var(--text3);margin-bottom:8px;">আনুমানিক শব্দ সংখ্যা: ${res.wordCount||'N/A'}</div>
        <div class="score-bars">${bars}</div>
      </div>
    </div>
    ${issuesHTML ? `<div style="margin-bottom:12px;"><div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:8px;">🔍 পাওয়া সমস্যা</div>${issuesHTML}</div>` : ''}
    ${strengthsHTML ? `<div style="margin-bottom:12px;"><div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--green);margin-bottom:6px;">💪 আপনার ডকুমেন্টের শক্তি</div>${strengthsHTML}</div>` : ''}
    ${res.topRecommendation ? `<div style="padding:12px;background:var(--gold-dim);border-radius:8px;border-left:3px solid var(--gold);"><p style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--text);">💡 <strong>সবচেয়ে গুরুত্বপূর্ণ পরামর্শ:</strong> ${res.topRecommendation}</p></div>` : ''}`;

  const result = document.getElementById('sopResult');
  result.classList.add('show');
  result.scrollIntoView({behavior:'smooth',block:'nearest'});
  showToast(`✅ ${typeLabel} বিশ্লেষণ সম্পন্ন! ATS Score: ${score}/100`);
}

// ── Country pills ──
document.querySelectorAll('.cpill').forEach(p=>{
  p.addEventListener('click',function(){
    this.closest('.country-pills').querySelectorAll('.cpill').forEach(c=>c.classList.remove('on'));
    this.classList.add('on');
  });
});

