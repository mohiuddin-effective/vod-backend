<!-- ── HERO ── -->
<div style="background:linear-gradient(160deg,#0D0A1A 0%,#150E2E 45%,#1A0F38 100%);padding:64px 52px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle at 20% 50%,rgba(124,58,237,.12) 0%,transparent 50%),radial-gradient(circle at 80% 20%,rgba(11,69,168,.1) 0%,transparent 45%);pointer-events:none;"></div>
  <!-- Animated grid lines -->
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(124,58,237,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,.05) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;"></div>
  <div style="max-width:1400px;margin:0 auto;position:relative;z-index:2;">
    <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(124,58,237,.15);border:1px solid rgba(124,58,237,.3);border-radius:20px;padding:5px 14px;font-size:.62rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(167,139,250,.9);margin-bottom:18px;">⚙️ Engineering · Architecture · Deployment</div>
    <div style="display:grid;grid-template-columns:minmax(0,1fr) min(480px,44%);gap:clamp(32px,5vw,72px);align-items:center;padding-bottom:48px;">
      <div>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,4vw,3.4rem);font-weight:700;color:#fff;line-height:1.15;margin-bottom:16px;">Effective EduHub Ecosystem<br><em style="color:#A78BFA;">Technical Blueprint</em></h1>
        <p style="font-family:'Noto Serif Bengali',serif;font-size:.88rem;color:rgba(255,255,255,.55);line-height:1.85;margin-bottom:24px;">Event-Driven Microservices · Graph-Based AI Core · PostgreSQL + Redis + Neo4j + pgvector — হ্যান্ড-অফ রেডি ইঞ্জিনিয়ারিং রোডম্যাপ।</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <div class="bp-tech-badge" style="--bc:rgba(124,58,237,.4);--bg:rgba(124,58,237,.1);">Next.js 14+</div>
          <div class="bp-tech-badge" style="--bc:rgba(26,85,200,.4);--bg:rgba(26,85,200,.1);">TypeScript</div>
          <div class="bp-tech-badge" style="--bc:rgba(26,138,82,.4);--bg:rgba(26,138,82,.1);">PostgreSQL</div>
          <div class="bp-tech-badge" style="--bc:rgba(196,32,32,.4);--bg:rgba(196,32,32,.1);">Redis</div>
          <div class="bp-tech-badge" style="--bc:rgba(0,122,148,.4);--bg:rgba(0,122,148,.1);">Neo4j</div>
          <div class="bp-tech-badge" style="--bc:rgba(217,119,6,.4);--bg:rgba(217,119,6,.1);">FastAPI</div>
          <div class="bp-tech-badge" style="--bc:rgba(5,150,105,.4);--bg:rgba(5,150,105,.1);">pgvector</div>
          <div class="bp-tech-badge" style="--bc:rgba(234,88,12,.4);--bg:rgba(234,88,12,.1);">AWS / Docker</div>
        </div>
      </div>
      <!-- Architecture mini-diagram -->
      <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.09);border-radius:var(--r2);padding:24px;font-family:'Outfit',monospace;font-size:.72rem;line-height:1.9;color:rgba(255,255,255,.7);">
        <div style="color:#A78BFA;font-weight:700;margin-bottom:8px;letter-spacing:.08em;">ARCHITECTURE OVERVIEW</div>
        <div style="color:rgba(255,255,255,.9);">[ Next.js Client (UI) ]</div>
        <div style="padding-left:8px;color:rgba(255,255,255,.4);">│  WebSocket / GraphQL / REST</div>
        <div style="padding-left:8px;color:rgba(255,255,255,.4);">▼</div>
        <div style="color:#67E8F9;">[ API Gateway — Nginx/Envoy ]</div>
        <div style="padding-left:8px;color:rgba(255,255,255,.4);">├──────────┬──────────┐</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin:4px 0;">
          <div style="background:rgba(11,69,168,.2);border:1px solid rgba(11,69,168,.3);border-radius:5px;padding:4px 6px;text-align:center;color:#93C5FD;font-size:.65rem;">Core Engine<br><span style="opacity:.6;">PostgreSQL+Redis</span></div>
          <div style="background:rgba(26,138,82,.2);border:1px solid rgba(26,138,82,.3);border-radius:5px;padding:4px 6px;text-align:center;color:#86EFAC;font-size:.65rem;">Real-Time<br><span style="opacity:.6;">Socket.io/WebRTC</span></div>
          <div style="background:rgba(124,58,237,.2);border:1px solid rgba(124,58,237,.3);border-radius:5px;padding:4px 6px;text-align:center;color:#C4B5FD;font-size:.65rem;">AI+RAG<br><span style="opacity:.6;">FastAPI+pgvector</span></div>
        </div>
        <div style="padding-left:8px;color:rgba(255,255,255,.4);">└──────────┴──────────┘</div>
        <div style="padding-left:8px;color:rgba(255,255,255,.4);">▼</div>
        <div style="color:#FDE68A;">[ Neo4j Knowledge Graph ]</div>
      </div>
    </div>
    <!-- Phase milestone nav -->
    <div style="display:flex;gap:0;border-top:1px solid rgba(255,255,255,.08);">
      <button class="bp-phase-tab on" id="bptab-1" onclick="bpTab(1)">📍 Phase 1 · Database</button>
      <button class="bp-phase-tab" id="bptab-2" onclick="bpTab(2)">📍 Phase 2 · Real-Time</button>
      <button class="bp-phase-tab" id="bptab-3" onclick="bpTab(3)">📍 Phase 3 · AI &amp; Graph</button>
      <button class="bp-phase-tab" id="bptab-4" onclick="bpTab(4)">🚀 Deployment</button>
