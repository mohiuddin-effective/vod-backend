            <div class="metric"><div class="metric-top"><span class="metric-icon">⭐</span></div><div class="metric-num">৪.৮</div><div class="metric-lbl">গড় রেটিং</div></div>
          </div>
          <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:14px;">
