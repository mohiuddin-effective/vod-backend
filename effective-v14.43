(function animateLiveCount() {
  const el = document.getElementById('exLiveCount');
  if (!el) return;
  setInterval(() => {
    const base = 3472;
    const variation = Math.floor(Math.random() * 40) - 20;
    const count = base + variation;
    // Convert to Bengali numerals
