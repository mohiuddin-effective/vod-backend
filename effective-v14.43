// 👥 COMMUNITY FEED ENGINE — Supabase Real-time Multi-user
// All posts, comments & likes sync across all users live.
// Falls back to localStorage if Supabase is unreachable.
// ══════════════════════════════════════════════════════
const SUPABASE_URL = 'https://gsxcdefaidagtnjhipjb.supabase.co';
const SUPABASE_KEY = 'sb_publishable_mIG6p9XGqzEAeOi5oFuKZA_4Ylcm6Oe';

// Lightweight Supabase REST client (no SDK needed)
const SB = {
  async req(method, path, body){
    try{
      const res = await fetch(SUPABASE_URL + '/rest/v1/' + path, {
        method,
        headers:{
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          'Prefer': method==='POST' ? 'return=representation' : '',
        },
        body: body ? JSON.stringify(body) : undefined
      });
      if(!res.ok){ const e=await res.text(); throw new Error(e); }
      return res.status===204 ? null : await res.json();
    }catch(e){ console.warn('Supabase error:', e); return null; }
  },
  get(table, query=''){  return SB.req('GET', table + '?' + query); },
  post(table, body){     return SB.req('POST', table, body); },
  patch(table, query, body){ return SB.req('PATCH', table + '?' + query, body); },
  delete(table, query){ return SB.req('DELETE', table + '?' + query); },

  // Real-time via Supabase Realtime WebSocket channel
  channel: null,
  subscribe(table, cb){
    if(typeof WebSocket === 'undefined') return;
    if(SB.channel){ SB.channel.close(); }
    const wsUrl = SUPABASE_URL.replace('https','wss') + '/realtime/v1/websocket?vsn=1.0.0&apikey=' + SUPABASE_KEY;
    const ws = new WebSocket(wsUrl);
    SB.channel = ws;
    ws.onopen = () => {
      ws.send(JSON.stringify({topic:'realtime:*',event:'phx_join',payload:{},ref:1}));
    };
    ws.onmessage = (e) => {
      try{
        const msg = JSON.parse(e.data);
        if(msg.payload?.data?.table === table) cb(msg.payload.data);
      }catch(err){}
    };
    ws.onerror = () => console.warn('Realtime WS error');
  }
};

// Anonymous user key (stable per browser)
function getOrCreateUserKey(){
  let k = localStorage.getItem('eeh_user_key');
  if(!k){ k = 'u_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36); localStorage.setItem('eeh_user_key',k); }
  return k;
}
const MY_KEY = getOrCreateUserKey();
const MY_NAME = localStorage.getItem('eeh_display_name') || 'আমি';
const MY_AV   = MY_NAME[0] || 'আ';

const COMM_GROUPS_MASTER = [
  {id:'g-bcs',    ico:'🏛️', bg:'rgba(0,175,200,.12)',  name:'BCS Study Community',      members:18420, desc:'BCS প্রিলি, রিটেন ও ভাইভার প্রস্তুতি'},
