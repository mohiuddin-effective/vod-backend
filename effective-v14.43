function verifyCertificate() {
  const id = document.getElementById('certVerifyInput').value.trim();
  const result = document.getElementById('certVerifyResult');
  if (!id) { showToast('⚠️ Certificate ID দিন'); return; }
  // ⚠️ DEMO ONLY — this only checks the ID's prefix format, it does NOT check
  // any real issued-certificate record. Do not present this as genuine
  // blockchain verification until it's backed by a real database lookup.
  if (id.startsWith('EEH-')) {
    result.innerHTML = `<div style="background:var(--gold-dim);border:1.5px solid rgba(184,109,5,.3);border-radius:10px;padding:14px;font-family:'Noto Serif Bengali',serif;font-size:.82rem;">
      <div style="font-weight:700;color:var(--gold);margin-bottom:6px;">🚧 ডেমো ফিচার — Certificate ID Format সঠিক</div>
      <div><strong>Certificate ID:</strong> ${escapeHtml(id)}</div>
      <div style="margin-top:8px;font-size:.72rem;color:var(--text3);">এই ফিচারটি এখনো ডেমো পর্যায়ে — এটি শুধু ID-র ফরম্যাট যাচাই করে, প্রকৃত ইস্যুকৃত সার্টিফিকেট ডাটাবেজের সাথে যাচাই করে না। প্রকৃত ভেরিফিকেশন সিস্টেম শীঘ্রই যুক্ত হবে।</div>
    </div>`;
  } else {
    result.innerHTML = `<div style="background:var(--red-dim);border:1.5px solid rgba(196,32,32,.2);border-radius:10px;padding:14px;font-size:.82rem;color:var(--red);">
      ❌ এই Certificate ID টি সঠিক ফরম্যাটে নেই। অনুগ্রহ করে সঠিক ID দিন (EEH- দিয়ে শুরু)।</div>`;
  }
}

