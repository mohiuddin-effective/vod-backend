let currentTip=0;

function changeTip(idx){
  currentTip=idx;
  document.getElementById('tipText').innerHTML=tips[idx].text;
  document.getElementById('tipBar').querySelector('.tip-badge').textContent=tips[idx].label;
  document.querySelectorAll('.tip-dot').forEach((d,i)=>{
    d.classList.toggle('on',i===idx);
  });
}

