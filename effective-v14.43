];

let commPosts = [];
let commGroups = {};
let commFilterTag = null;
let commMyLikes = new Set();

// ── Load & Save (localStorage fallback) ──────────────
function commSaveGroups(){ try{ localStorage.setItem('eeh_comm_groups', JSON.stringify(commGroups)); }catch(e){} }
function commLoadGroups(){ try{ const g=localStorage.getItem('eeh_comm_groups'); if(g) commGroups=JSON.parse(g); }catch(e){} }

// ── Helpers ───────────────────────────────────────────
function timeAgo(ts){
  const diff = Math.floor((Date.now() - new Date(ts).getTime())/1000);
  if(diff<60) return 'এইমাত্র';
  if(diff<3600) return Math.floor(diff/60)+' মিনিট আগে';
  if(diff<86400) return Math.floor(diff/3600)+' ঘণ্টা আগে';
  return Math.floor(diff/86400)+' দিন আগে';
}
function getTagColor(tag){
  const m={'BCS':'var(--teal)','IELTS':'var(--indigo)','HSC':'var(--rose)','ব্যাংক':'var(--gold)','SSC':'var(--red)','গণিত':'var(--green)'};
  return m[tag]||'var(--text3)';
}

// ── Fetch posts from Supabase ─────────────────────────
async function commFetchPosts(){
  const rows = await SB.get('comm_posts','order=created_at.desc&limit=40');

  // If Supabase unreachable (null) OR tables not created yet ([]) — use seed posts
  if(!rows || rows.length === 0){
    if(!rows) commShowOfflineWarning(); // show soft warning but still render seed data
    const seedPosts = [
      {id:'seed1', author:'মাহমুদ হাসান', av:'মা', group_id:'g-bcs', tag:'BCS', created_at:new Date(Date.now()-7200000).toISOString(), text:'BCS 47th প্রিলিমিনারির জন্য বাংলাদেশের মুক্তিযুদ্ধ থেকে কতটি প্রশ্ন আসতে পারে? গত ৫ বছরের প্যাটার্ন দেখলে মনে হচ্ছে ১৫-২০টির মতো আসে। কারো কাছে ডেটা আছে? #BCS'},
      {id:'seed2', author:'ফারহানা বেগম', av:'ফা', group_id:'g-ielts', tag:'IELTS', created_at:new Date(Date.now()-18000000).toISOString(), text:'IELTS Writing Task 2-এ "discuss both views" টাইপ প্রশ্নে কীভাবে structure করব? আমার thesis statement ঠিকমতো লিখতে পারছি না। কেউ সাহায্য করুন। #IELTS'},
      {id:'seed3', author:'রাহেলা রহমান', av:'রা', group_id:'g-bank', tag:'ব্যাংক', created_at:new Date(Date.now()-86400000).toISOString(), text:'ব্যাংক নিয়োগে গণিত অংশে সবচেয়ে বেশি কোন কোন টপিক থেকে প্রশ্ন আসে? আমি শতকরা, মুনাফা-ক্ষতি আর সময়-কাজ এই তিনটায় বেশি focus দিচ্ছি। #ব্যাংক'},
      {id:'seed4', author:'তানভীর আহমেদ', av:'তা', group_id:'g-hsc', tag:'HSC', created_at:new Date(Date.now()-172800000).toISOString(), text:'HSC পদার্থবিজ্ঞানে তড়িৎ বিষয়টা অনেক কঠিন লাগছে। কেউ কি ভালো shortcut বা explanation দিতে পারবেন? বিশেষ করে Ohm\'s law এর application। #HSC'},
    ];
    commPosts = seedPosts;
    commMyLikes = new Set();
    renderCommFeed();
    return;
  }

  // Supabase returned real data
  const [likeCounts, myLikes] = await Promise.all([
    SB.get('comm_likes', 'select=post_id'),
    SB.get('comm_likes', `user_key=eq.${MY_KEY}&select=post_id`)
  ]);
  const likeMap = {};
  (likeCounts||[]).forEach(r=>{ likeMap[r.post_id]=(likeMap[r.post_id]||0)+1; });
  commMyLikes = new Set((myLikes||[]).map(r=>r.post_id));

  commPosts = rows.map(r=>({
    ...r,
    likes: likeMap[r.id]||0,
    likedByMe: commMyLikes.has(r.id),
    comments: []
  }));
  renderCommFeed();
}

function commShowOfflineWarning(){
  // Soft warning — still render seed data below
  console.warn('Supabase unreachable — showing seed content. Run the SQL setup and check your connection.');
}

// ── Fetch comments for a post ──────────────────────────
async function commFetchComments(postId){
  const rows = await SB.get('comm_comments', `post_id=eq.${postId}&order=created_at.asc`);
  return rows||[];
}

// ── Render feed ───────────────────────────────────────
function renderCommFeed(){
  const feed = document.getElementById('commFeed');
  if(!feed) return;
  let posts = commFilterTag ? commPosts.filter(p=>p.tag===commFilterTag) : commPosts;
  if(!posts.length){
    feed.innerHTML = `<div style="text-align:center;padding:40px;color:var(--text3);font-family:'Noto Serif Bengali',serif;">
      ${commFilterTag ? '#'+commFilterTag+' তে কোনো পোস্ট নেই' : 'প্রথম পোস্ট করুন!'}
    </div>`;
    return;
  }
  feed.innerHTML = '';
  posts.forEach(post=>{
    const el = document.createElement('div');
    el.className = 'comm-post';
    el.id = 'comm-post-'+post.id;
    renderCommPost(post, el);
    feed.appendChild(el);
  });
}

// ══════════════════════════════════════════════════════
// 🌐 UNIVERSAL REACTION STRIP — attaches to all content cards
// Targets: .ccard, .bkcard, .mpcard, .blg, .room-card, .forum-item
// ══════════════════════════════════════════════════════
const CARD_SELECTORS = [
  {sel:'.ccard',      type:'course',   idFn: el => 'c_'+(el.querySelector('.ccard-title')?.textContent.slice(0,15).replace(/\s+/g,'_')||Math.random().toString(36).slice(2))},
  {sel:'.bkcard',     type:'book',     idFn: el => 'b_'+(el.querySelector('.bk-title')?.textContent.slice(0,15).replace(/\s+/g,'_')||Math.random().toString(36).slice(2))},
  {sel:'.mpcard',     type:'product',  idFn: el => 'p_'+(el.querySelector('.mp-name')?.textContent.slice(0,15).replace(/\s+/g,'_')||Math.random().toString(36).slice(2))},
  {sel:'.blg',        type:'blog',     idFn: el => 'bl_'+(el.querySelector('.blg-title')?.textContent.slice(0,15).replace(/\s+/g,'_')||Math.random().toString(36).slice(2))},
  {sel:'.room-card',  type:'room',     idFn: el => 'r_'+(el.querySelector('.rc-name')?.textContent.slice(0,12).replace(/\s+/g,'_')||Math.random().toString(36).slice(2))},
];

function buildCardRxnStrip(itemType, itemId, cardEl){
  if(cardEl.querySelector('.rxn-strip')) return; // already attached
  // BUG-02 FIX: set position:relative (not overflow:visible on card)
  // The panel uses position:absolute relative to .rxn-strip-wrap which already
  // has position:relative — no need to alter the card's overflow
  cardEl.style.position='relative';

  const strip = document.createElement('div');
  strip.className='rxn-strip';
  strip.id=`rxn-strip-${itemType}-${itemId}`;
  strip.innerHTML=`
    <div class="rxn-strip-actions">
      <div class="rxn-strip-wrap">
        <button class="rxn-strip-action" id="rxn-sb-${itemType}-${itemId}">😊 React</button>
        <div class="rxn-strip-panel">
          ${REACTIONS.map(r=>`<span style="font-size:1.4rem;cursor:pointer;transition:transform .12s;" title="${r.label}"
            onmouseover="this.style.transform='scale(1.3) translateY(-3px)'"
            onmouseout="this.style.transform=''"
            onclick="cardRxnToggle('${itemType}','${itemId}','${r.id}',this.closest('.rxn-strip-wrap').previousElementSibling||this.closest('.rxn-strip').querySelector('.rxn-strip-action'))">${r.emoji}</span>`).join('')}
        </div>
      </div>
      <button class="rxn-strip-action" onclick="cardToggleComments('${itemType}','${itemId}')">💬 <span id="rxn-cc-${itemType}-${itemId}">0</span></button>
      <button class="rxn-strip-action" onclick="openShareModal('${itemType}','${itemId}','')">🔗 শেয়ার</button>
    </div>
    <div class="rxn-strip-summary" id="rxn-ss-${itemType}-${itemId}">প্রথম প্রতিক্রিয়া জানান</div>`;

  const commentSection = document.createElement('div');
  commentSection.className='rxn-inline-comment';
  commentSection.id=`rxn-ic-${itemType}-${itemId}`;
  commentSection.innerHTML=`
    <div class="rxn-inline-comment-list" id="rxn-icl-${itemType}-${itemId}"></div>
    <div class="rxn-comment-inp-row">
      <div class="comm-av" style="width:24px;height:24px;font-size:.6rem;flex-shrink:0;">${MY_AV}</div>
      <input class="rxn-comment-inp" placeholder="মন্তব্য লিখুন…" id="rxn-ci-${itemType}-${itemId}"
        onkeydown="if(event.key==='Enter')cardAddComment('${itemType}','${itemId}')">
      <button onclick="cardAddComment('${itemType}','${itemId}')"
        style="background:var(--rose);color:#fff;border:none;border-radius:7px;padding:4px 10px;font-size:.68rem;font-weight:600;cursor:pointer;">→</button>
    </div>`;

  // Append to card's innermost container if possible
  const body = cardEl.querySelector('.ccard-body,.bk-body,.mp-body,.blg-body') || cardEl;
  body.appendChild(strip);
  body.appendChild(commentSection);

  cardRxnUpdateSummary(itemType, itemId);
  cardCommentsUpdateCount(itemType, itemId);
}

function cardRxnToggle(itemType, itemId, rxnId, triggerBtn){
  rxnToggle(itemType, itemId, rxnId);
  const state = rxnLoad(itemType, itemId);
  const myRxn = state[MY_KEY];
  if(triggerBtn){
    triggerBtn.textContent = (myRxn ? REACTIONS.find(r=>r.id===myRxn)?.emoji : '😊') + ' React';
  }
  cardRxnUpdateSummary(itemType, itemId);
  AppState.addCoin(1);
}

function cardRxnUpdateSummary(itemType, itemId){
  const el = document.getElementById(`rxn-ss-${itemType}-${itemId}`);
  if(!el) return;
  const state = rxnLoad(itemType, itemId);
  const counts = state.counts||{};
  const total = state.total||0;
  if(!total){ el.textContent='প্রথম প্রতিক্রিয়া জানান'; return; }
  let ws=0; REACTIONS.forEach(r=>{ ws+=(counts[r.id]||0)*r.rating; });
  const avg=(ws/total).toFixed(1);
  const top=REACTIONS.filter(r=>counts[r.id]>0).sort((a,b)=>(counts[b.id]||0)-(counts[a.id]||0)).slice(0,2);
  el.innerHTML=top.map(r=>`${r.emoji}${counts[r.id]}`).join(' ')+` · ${total} জন · ★${avg}`;
}

function cardToggleComments(itemType, itemId){
  const el=document.getElementById(`rxn-ic-${itemType}-${itemId}`);
  if(!el) return;
  el.classList.toggle('open');
  if(el.classList.contains('open')) cardRenderComments(itemType, itemId);
}

function cardAddComment(itemType, itemId){
  const inp=document.getElementById(`rxn-ci-${itemType}-${itemId}`);
  if(!inp||!inp.value.trim()) return;
  const key=`eeh_card_comments_${itemType}_${itemId}`;
  let comments=[];
  try{ comments=JSON.parse(localStorage.getItem(key)||'[]'); }catch(e){}
  comments.push({av:MY_AV, name:MY_NAME, text:inp.value.trim(), ts:Date.now()});
  try{ localStorage.setItem(key, JSON.stringify(comments)); }catch(e){}
  inp.value='';
  cardRenderComments(itemType, itemId);
  cardCommentsUpdateCount(itemType, itemId);
  AppState.addCoin(3);
  showToast('+3 🪙 মন্তব্যের জন্য');
}

function cardRenderComments(itemType, itemId){
  const el=document.getElementById(`rxn-icl-${itemType}-${itemId}`);
  if(!el) return;
  const key=`eeh_card_comments_${itemType}_${itemId}`;
  let comments=[];
  try{ comments=JSON.parse(localStorage.getItem(key)||'[]'); }catch(e){}
  el.innerHTML=comments.length
    ? comments.map(c=>`<div class="rxn-comment-row">
        <div class="comm-av" style="width:22px;height:22px;font-size:.58rem;flex-shrink:0;">${c.av}</div>
        <div class="rxn-comment-bubble"><strong style="font-size:.65rem;">${c.name}</strong><br>${c.text}</div>
      </div>`).join('')
    : '<div style="color:var(--text3);font-size:.7rem;padding:4px;">এখনো মন্তব্য নেই</div>';
  el.scrollTop=el.scrollHeight;
}

function cardCommentsUpdateCount(itemType, itemId){
  const el=document.getElementById(`rxn-cc-${itemType}-${itemId}`);
  if(!el) return;
  const key=`eeh_card_comments_${itemType}_${itemId}`;
  try{ el.textContent=JSON.parse(localStorage.getItem(key)||'[]').length; }catch(e){ el.textContent=0; }
}

function attachAllCardReactions(){
  CARD_SELECTORS.forEach(({sel, type, idFn})=>{
    document.querySelectorAll(sel+':not([data-rxn])').forEach(card=>{
      const id = idFn(card);
      card.setAttribute('data-rxn', id);
      buildCardRxnStrip(type, id, card);
    });
  });
}

// Run on page load and whenever go() navigates
document.addEventListener('DOMContentLoaded', ()=>setTimeout(attachAllCardReactions, 200));
const _rxnBaseGo=go;
go=function(id,back){
  _rxnBaseGo(id,back);
  setTimeout(attachAllCardReactions, 250);
};
// ══════════════════════════════════════════════════════
const REACTIONS = [
  {id:'love',     emoji:'❤️',  label:'Love',     rating:10},
  {id:'care',     emoji:'🤗',  label:'Care',     rating:9},
  {id:'haha',     emoji:'😂',  label:'Haha',     rating:8},
  {id:'happy',    emoji:'😊',  label:'Happy',    rating:7},
  {id:'surprise', emoji:'😮',  label:'Surprise', rating:6},
  {id:'like',     emoji:'👍',  label:'Like',     rating:5},
  {id:'fear',     emoji:'😨',  label:'Fear',     rating:4},
  {id:'sad',      emoji:'😢',  label:'Sad',      rating:3},
  {id:'anger',    emoji:'😠',  label:'Anger',    rating:2},
  {id:'disgust',  emoji:'🤢',  label:'Disgust',  rating:1},
];

// Per-item reaction state keyed by "type:id"
function rxnKey(itemType, itemId){ return `rxn_${itemType}_${itemId}`; }
function rxnLoad(itemType, itemId){
  try{ return JSON.parse(localStorage.getItem(rxnKey(itemType,itemId))||'{}'); }catch(e){ return {}; }
}
function rxnSave(itemType, itemId, state){
  try{ localStorage.setItem(rxnKey(itemType,itemId), JSON.stringify(state)); }catch(e){}
}

function rxnToggle(itemType, itemId, rxnId){
  const state = rxnLoad(itemType, itemId);
  // state = { [userId]: rxnId, counts:{rxnId:n}, total:n }
  const prev = state[MY_KEY];
  const counts = state.counts||{};
  if(prev === rxnId){
    // withdraw
    delete state[MY_KEY];
    counts[rxnId] = Math.max(0,(counts[rxnId]||1)-1);
  } else {
    if(prev){ counts[prev] = Math.max(0,(counts[prev]||1)-1); }
    state[MY_KEY] = rxnId;
    counts[rxnId] = (counts[rxnId]||0)+1;
  }
  state.counts = counts;
  state.total = Object.values(counts).reduce((a,b)=>a+b,0);
  rxnSave(itemType, itemId, state);
  rxnRenderSummary(itemType, itemId);
  rxnRenderGraph(itemType, itemId);

  // Also update Supabase if available (best-effort)
  if(state[MY_KEY]){
    SB.post('comm_likes', {post_id:itemId, user_key:MY_KEY+'_'+rxnId}).catch(()=>{});
  }
  AppState.addCoin(1);
}

function rxnStars(avgRating){
  const full = Math.floor(avgRating/2);
  const half = (avgRating%2)>=1?1:0;
  return '★'.repeat(full) + (half?'½':'') + '☆'.repeat(5-full-half);
}

function rxnRenderSummary(itemType, itemId){
  const el = document.getElementById(`rxn-summary-${itemType}-${itemId}`);
  if(!el) return;
  const state = rxnLoad(itemType, itemId);
  const counts = state.counts||{};
  const total = state.total||0;
  const myRxn = state[MY_KEY];
  if(!total){ el.innerHTML='<span style="color:var(--text3);font-size:.7rem;">প্রথম প্রতিক্রিয়া জানান</span>'; return; }
  // Weighted average rating
  let weightedSum=0;
  REACTIONS.forEach(r=>{ weightedSum += (counts[r.id]||0)*r.rating; });
  const avg = total>0 ? (weightedSum/total).toFixed(1) : 0;
  // Top 3 reactions
  const top = REACTIONS.filter(r=>counts[r.id]>0).sort((a,b)=>(counts[b.id]||0)-(counts[a.id]||0)).slice(0,3);
  el.innerHTML = `
    ${top.map(r=>`<span class="rxn-pill">${r.emoji} ${counts[r.id]}</span>`).join('')}
    <span style="color:var(--text3);font-size:.7rem;">${total} জন</span>
    <span class="rxn-stars">${rxnStars(parseFloat(avg))}</span>
    <span style="color:var(--gold);font-size:.7rem;font-weight:700;">${avg}/10</span>
    ${myRxn?`<span style="color:var(--rose);font-size:.68rem;"> · আপনি ${REACTIONS.find(r=>r.id===myRxn)?.emoji||''} দিয়েছেন</span>`:''}`;
}

function rxnToggleGraph(itemType, itemId){
  const el=document.getElementById(`rxn-graph-${itemType}-${itemId}`);
  if(el) el.classList.toggle('open');
}

function rxnRenderGraph(itemType, itemId){
  const el=document.getElementById(`rxn-graph-${itemType}-${itemId}`);
  if(!el) return;
  const state=rxnLoad(itemType,itemId);
  const counts=state.counts||{};
  const max=Math.max(...REACTIONS.map(r=>counts[r.id]||0),1);
  el.innerHTML=REACTIONS.map(r=>`
    <div class="rxn-bar-item">
      <span style="width:28px;text-align:center;">${r.emoji}</span>
      <span style="width:52px;color:var(--text3);">${r.label}</span>
      <div class="rxn-bar-track"><div class="rxn-bar-fill" style="width:${Math.round(((counts[r.id]||0)/max)*100)}%"></div></div>
      <span style="width:22px;text-align:right;font-weight:700;">${counts[r.id]||0}</span>
    </div>`).join('');
}

function rxnPanelHTML(itemType, itemId){
  return `
    <div class="rxn-btn-wrap" style="position:relative;">
      <button class="comm-post-action" id="rxn-trigger-${itemType}-${itemId}" style="gap:4px;">
        <span id="rxn-my-${itemType}-${itemId}">😊</span> প্রতিক্রিয়া
      </button>
      <div class="rxn-panel">
        ${REACTIONS.map(r=>`<span class="rxn-emoji" title="${r.label}" onclick="rxnToggle('${itemType}','${itemId}','${r.id}');updateRxnTrigger('${itemType}','${itemId}')">${r.emoji}</span>`).join('')}
      </div>
    </div>`;
}

function updateRxnTrigger(itemType, itemId){
  const el=document.getElementById(`rxn-my-${itemType}-${itemId}`);
  if(!el) return;
  const state=rxnLoad(itemType,itemId);
  const myRxn=state[MY_KEY];
  el.textContent=myRxn?REACTIONS.find(r=>r.id===myRxn)?.emoji||'😊':'😊';
  rxnRenderSummary(itemType, itemId);
}

// ══════════════════════════════════════════════════════
// RECURSIVE NESTED COMMENT SYSTEM
// ══════════════════════════════════════════════════════
let _commThreadState = {}; // { [postId]: [commentTree] }

function threadLoad(postId){
  if(_commThreadState[postId]) return _commThreadState[postId];
  try{
    const s=localStorage.getItem('eeh_thread_'+postId);
    _commThreadState[postId] = s?JSON.parse(s):[];
  }catch(e){ _commThreadState[postId]=[]; }
  return _commThreadState[postId];
}
function threadSave(postId){
  try{ localStorage.setItem('eeh_thread_'+postId, JSON.stringify(_commThreadState[postId]||[])); }catch(e){}
}

function injectReply(nodes, parentId, newNode){
  // Recursive: find parent and push child
  for(const node of nodes){
    if(node.id===parentId){ node.children.push(newNode); return true; }
    if(node.children && injectReply(node.children, parentId, newNode)) return true;
  }
  return false;
}

function renderCommentNode(node, depth){
  const indent = Math.min(depth, 4) * 14;
  const childrenHtml = (node.children||[]).map(c=>renderCommentNode(c, depth+1)).join('');
  return `
    <div class="comm-node" style="margin-left:${indent}px;" id="cnode-${node.id}">
      <div class="comm-av" style="width:28px;height:28px;font-size:.68rem;flex-shrink:0;">${escapeHtml(node.av)}</div>
      <div class="comm-node-body">
        <div class="comm-bubble">
          <span class="comm-node-name">${escapeHtml(node.name)}</span>
          ${escapeHtml(node.text)}
        </div>
        <div class="comm-node-actions">
          <span class="comm-node-action" onclick="threadToggleLike('${node.id}',this)">👍 ${node.likes||0}</span>
          <span class="comm-node-action" onclick="threadShowReply('${node.id}')">↩ উত্তর দিন</span>
          <span class="comm-node-action" style="color:var(--text3);">${timeAgo(node.ts)}</span>
        </div>
        <div class="comm-reply-box" id="reply-box-${node.id}">
          <div class="comm-av" style="width:24px;height:24px;font-size:.62rem;flex-shrink:0;">${MY_AV}</div>
          <input class="comm-comment-input" style="font-size:.74rem;" placeholder="উত্তর লিখুন…" id="reply-inp-${node.id}" onkeydown="if(event.key==='Enter')threadAddReply('${node.id}')">
          <button onclick="threadAddReply('${node.id}')" style="background:var(--rose);color:#fff;border:none;border-radius:7px;padding:5px 10px;font-size:.7rem;font-weight:600;cursor:pointer;flex-shrink:0;">পাঠান</button>
        </div>
        <div class="comm-node-replies" ${!childrenHtml?'style="display:none"':''}>
          ${childrenHtml}
        </div>
      </div>
    </div>`;
}

function renderThread(postId){
  const el = document.getElementById(`thread-${postId}`);
  if(!el) return;
  const nodes = threadLoad(postId);
  el.innerHTML = nodes.length
    ? nodes.map(n=>renderCommentNode(n,0)).join('')
    : '<div style="color:var(--text3);font-size:.72rem;padding:4px 0;">এখনো কোনো মন্তব্য নেই — প্রথম মন্তব্য করুন!</div>';
}

function threadShowReply(nodeId){
  const el=document.getElementById(`reply-box-${nodeId}`);
  if(el){ el.classList.toggle('open'); el.querySelector('input')?.focus(); }
}

function threadAddReply(parentNodeId, postId){
  // Find which post this node belongs to by scanning all thread states
  if(!postId){
    for(const pid of Object.keys(_commThreadState)){
      if(findNode(_commThreadState[pid], parentNodeId)){ postId=pid; break; }
    }
  }
  if(!postId) return;
  const inp=document.getElementById(`reply-inp-${parentNodeId}`);
  if(!inp||!inp.value.trim()) return;
  const newNode={id:'n'+Date.now(), name:MY_NAME, av:MY_AV, text:inp.value.trim(), ts:Date.now(), likes:0, children:[]};
  inp.value='';
  const nodes=threadLoad(postId);
  if(!injectReply(nodes, parentNodeId, newNode)){ nodes.push(newNode); }
  threadSave(postId);
  renderThread(postId);
  AppState.addCoin(5);
  showToast('+5 🪙 উত্তর দেওয়ার জন্য');
  // Also save to Supabase
  SB.post('comm_comments',{post_id:postId, author:MY_NAME, av:MY_AV, text:'↩ '+newNode.text}).catch(()=>{});
}

function threadAddRoot(postId){
  const inp=document.getElementById(`thread-inp-${postId}`);
  if(!inp||!inp.value.trim()) return;
  const newNode={id:'n'+Date.now(), name:MY_NAME, av:MY_AV, text:inp.value.trim(), ts:Date.now(), likes:0, children:[]};
  inp.value='';
  const nodes=threadLoad(postId);
  nodes.unshift(newNode);
  threadSave(postId);
  renderThread(postId);
  AppState.addCoin(5);
  showToast('+5 🪙 মন্তব্যের জন্য');
  SB.post('comm_comments',{post_id:postId, author:MY_NAME, av:MY_AV, text:newNode.text}).catch(()=>{});
}

function findNode(nodes, id){
  for(const n of nodes){
    if(n.id===id) return n;
    const f=findNode(n.children||[], id);
    if(f) return f;
  }
  return null;
}

function threadToggleLike(nodeId, btn){
  for(const pid of Object.keys(_commThreadState)){
    const node=findNode(_commThreadState[pid], nodeId);
    if(node){
      node.likes=(node.likes||0)+1;
      btn.textContent='👍 '+node.likes;
      threadSave(pid);
      break;
    }
  }
}

// ══════════════════════════════════════════════════════
// SHARE MODAL
// ══════════════════════════════════════════════════════
let _shareUrl='';
function openShareModal(itemType, itemId, title){
  const base = 'https://effectiveeducationhub.com/';
  const paths={post:'?p=community&post=',book:'?p=publications&book=',course:'?p=academy&course=',product:'?p=mart&product='};
  _shareUrl = base + (paths[itemType]||'?id=') + itemId;
  const inp=document.getElementById('shareUrlInput');
  if(inp) inp.value=_shareUrl;
  document.getElementById('shareModal').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeShareModal(){
  document.getElementById('shareModal').classList.remove('open');
  document.body.style.overflow='';
}
function copyShareUrl(){
  navigator.clipboard?.writeText(_shareUrl).then(()=>showToast('লিংক কপি হয়েছে!')).catch(()=>{
    const inp=document.getElementById('shareUrlInput');
    inp?.select(); document.execCommand('copy'); showToast('লিংক কপি হয়েছে!');
  });
}
function shareToPlat(plat){
  const enc=encodeURIComponent(_shareUrl);
  const t=encodeURIComponent('Effective Education Hub থেকে শেয়ার করা হয়েছে');
  const urls={
    facebook:`https://www.facebook.com/sharer/sharer.php?u=${enc}`,
    whatsapp:`https://wa.me/?text=${t}%20${enc}`,
    twitter:`https://x.com/intent/tweet?url=${enc}&text=${t}`,
    linkedin:`https://www.linkedin.com/sharing/share-offsite/?url=${enc}`,
    telegram:`https://t.me/share/url?url=${enc}&text=${t}`,
    imo:`https://s.imoim.net/lE9CA1`,
  };
  if(urls[plat]) window.open(urls[plat],'_blank','noopener');
  closeShareModal();
}
function shareNative(){
  if(navigator.share){ navigator.share({title:'Effective Education Hub', url:_shareUrl}); closeShareModal(); }
  else copyShareUrl();
}

function renderCommPost(post, el){
  const groupName = COMM_GROUPS_MASTER.find(g=>g.id===post.group_id)?.name||'Effective Community';
  const threads = threadLoad(post.id);
  const threadHtml = threads.map(n=>renderCommentNode(n,0)).join('');
  const parsed = commParseAttachments(post.text||'');
  const attachHtml = commRenderAttachments(parsed);

  el.innerHTML = `
    <div class="comm-post-hd">
      <div class="comm-av">${escapeHtml(post.av||'আ')}</div>
      <div style="flex:1;min-width:0;">
        <div class="comm-post-name">${escapeHtml(post.author)}${parsed.feeling?` <span class="comm-feeling-inline">— অনুভব করছেন ${escapeHtml(parsed.feeling)}</span>`:''}</div>
        <div class="comm-post-meta">${timeAgo(post.created_at||post.ts||Date.now())} · ${escapeHtml(groupName)}${parsed.loc?` · 📍 ${escapeHtml(parsed.loc)}`:''}</div>
      </div>
    </div>
    <div class="comm-post-body">
      <span class="comm-post-tag" style="background:${getTagColor(post.tag)}22;color:${getTagColor(post.tag)};">#${escapeHtml(post.tag||'সাধারণ')}</span><br>
      ${escapeHtml(parsed.clean).replace(/\n/g,'<br>')}
    </div>
    ${attachHtml}
    <!-- Reaction summary row -->
    <div class="rxn-bar">
      <div class="rxn-summary" id="rxn-summary-post-${post.id}">
        <span style="color:var(--text3);font-size:.7rem;">প্রথম প্রতিক্রিয়া জানান</span>
      </div>
      <span onclick="rxnToggleGraph('post','${post.id}')" style="margin-left:auto;font-size:.68rem;color:var(--text3);cursor:pointer;">📊</span>
    </div>
    <!-- Reaction graph (collapsible) -->
    <div class="rxn-graph" id="rxn-graph-post-${post.id}" style="padding:0 16px 10px;"></div>
    <!-- Action bar -->
    <div class="comm-post-actions">
      ${rxnPanelHTML('post', post.id)}
      <button class="comm-post-action" onclick="threadTogglePanel('${post.id}')">💬 মন্তব্য</button>
      <button class="comm-post-action" onclick="openShareModal('post','${post.id}','${post.text.slice(0,30).replace(/'/g,"\\'")}')">🔗 শেয়ার</button>
    </div>
    <!-- Nested comment thread -->
    <div class="comm-thread" id="comm-thread-${post.id}">
      <div id="thread-${post.id}">
        ${threadHtml||'<div style="color:var(--text3);font-size:.72rem;padding:4px 0;">এখনো কোনো মন্তব্য নেই — প্রথম মন্তব্য করুন!</div>'}
      </div>
      <div class="comm-comment-input-row" style="margin-top:10px;">
        <div class="comm-av" style="width:28px;height:28px;font-size:.68rem;flex-shrink:0;">${MY_AV}</div>
        <input class="comm-comment-input" placeholder="মন্তব্য লিখুন…" id="thread-inp-${post.id}" onkeydown="if(event.key==='Enter')threadAddRoot('${post.id}')">
        <button onclick="threadAddRoot('${post.id}')" style="background:var(--rose);color:#fff;border:none;border-radius:8px;padding:7px 12px;font-size:.72rem;font-weight:600;cursor:pointer;flex-shrink:0;">পাঠান</button>
      </div>
    </div>`;

  // Initialize reaction summary
  rxnRenderSummary('post', post.id);
  updateRxnTrigger('post', post.id);
}

function threadTogglePanel(postId){
  const el=document.getElementById(`comm-thread-${postId}`);
  if(el) el.classList.toggle('open');
}


// ── Toggle comments (lazy load) ───────────────────────
async function commToggleComments(postId){
  const el = document.getElementById('comm-comments-'+postId);
  if(!el) return;
  if(el.style.display==='none'){
    el.style.display='block';
    const rows = await commFetchComments(postId);
    const listEl = document.getElementById('comm-comment-list-'+postId);
    if(listEl){
      listEl.innerHTML = rows.length
        ? rows.map(c=>`<div class="comm-comment">
            <div class="comm-av" style="width:28px;height:28px;font-size:.68rem;flex-shrink:0;">${c.av||'আ'}</div>
            <div class="comm-comment-bubble"><span class="comm-comment-name">${c.author}</span>${c.text}</div>
          </div>`).join('')
        : '<div style="color:var(--text3);font-size:.72rem;padding:4px 0;">এখনো কোনো মন্তব্য নেই — প্রথম মন্তব্য করুন!</div>';
    }
  } else {
    el.style.display='none';
  }
}

// ── Add comment ───────────────────────────────────────
async function commAddComment(postId){
  const inp = document.getElementById('comm-inp-'+postId);
  if(!inp||!inp.value.trim()) return;
  const text = inp.value.trim();
  inp.value='';
  const res = await SB.post('comm_comments', {post_id:postId, author:MY_NAME, av:MY_AV, text});
  if(res){
    const listEl = document.getElementById('comm-comment-list-'+postId);
    if(listEl){
      const newEl = document.createElement('div');
      newEl.className='comm-comment';
      newEl.innerHTML=`<div class="comm-av" style="width:28px;height:28px;font-size:.68rem;flex-shrink:0;">${MY_AV}</div>
        <div class="comm-comment-bubble"><span class="comm-comment-name">${MY_NAME}</span>${text}</div>`;
      listEl.querySelector('div[style*="এখনো"]')?.remove();
      listEl.appendChild(newEl);
    }
    AppState.addCoin(5);
    showToast('+5 🪙 মন্তব্যের জন্য');
  } else {
    showToast('মন্তব্য পাঠানো যায়নি — আবার চেষ্টা করুন');
  }
}

// ── Submit new post ───────────────────────────────────
// ══════════════════════════════════════════════════════
// 📮 Facebook-style post composer — Text, Photo/Video, Music,
// Feeling/Activity, Event, Live, Location, GIF/Sticker, Tag.
//
// The comm_posts table (Supabase) only has a plain `text` column, so
// attachments are encoded as ⟦key:value⟧ markers appended to the text and
// parsed back out at render time — NEVER as raw HTML. commParseAttachments
// strips the markers out first; only the leftover plain text goes through
// escapeHtml(). Each attachment then renders via a fixed, safe template
// with escapeHtml() applied to whatever the user typed. This keeps the
// XSS protections intact — nothing user-supplied is ever inserted as raw
// HTML, including inside the img/YouTube embeds (those validate strictly
// against a regex before use, not just escape).
// ══════════════════════════════════════════════════════
function commParseAttachments(raw){
  let text = String(raw||'');
  const out = {feeling:null, loc:null, tag:null, music:null, event:null, img:null, yt:null, gif:null};
  text = text.replace(/⟦feeling:([^⟧]*)⟧/, (m,v)=>{out.feeling=v; return '';});
  text = text.replace(/⟦loc:([^⟧]*)⟧/, (m,v)=>{out.loc=v; return '';});
  text = text.replace(/⟦tag:([^⟧]*)⟧/, (m,v)=>{out.tag=v; return '';});
  text = text.replace(/⟦music:([^⟧]*)⟧/, (m,v)=>{out.music=v; return '';});
  text = text.replace(/⟦event:([^⟧]*)⟧/, (m,v)=>{out.event=v; return '';});
  text = text.replace(/⟦img:([^⟧]*)⟧/, (m,v)=>{out.img=v; return '';});
  text = text.replace(/⟦yt:([^⟧]*)⟧/, (m,v)=>{out.yt=v; return '';});
  text = text.replace(/⟦gif:([^⟧]*)⟧/, (m,v)=>{out.gif=v; return '';});
  return {clean: text.trim(), ...out};
}
function commRenderAttachments(a){
  let html = '';
  if(a.music) html += `<div class="comm-attach-chip">🎵 ${escapeHtml(a.music)}</div>`;
  if(a.tag) html += `<div class="comm-attach-chip">🏷️ সাথে আছেন: ${escapeHtml(a.tag)}</div>`;
  if(a.event){
    const [name,date] = a.event.split('|');
    html += `<div class="comm-event-card">📅 <strong>${escapeHtml(name||'')}</strong>${date?' — '+escapeHtml(date):''}</div>`;
  }
  // Only a strictly-validated small base64 image data-URL is ever used as
  // an <img src> — anything not matching this exact shape is dropped.
  if(a.img && /^data:image\/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=]+$/.test(a.img) && a.img.length < 400000){
    html += `<img src="${a.img}" class="comm-post-img" alt="পোস্ট ছবি">`;
  }
  // YouTube: we extract just the 11-char video ID ourselves (see
  // commAddVideo) and validate it here again before building the embed URL
  // — the user's pasted URL is never used directly as a src.
  if(a.yt && /^[A-Za-z0-9_-]{6,20}$/.test(a.yt)){
    html += `<div class="comm-yt-embed"><iframe src="https://www.youtube.com/embed/${a.yt}" title="YouTube video" frameborder="0" allow="encrypted-media" allowfullscreen loading="lazy"></iframe></div>`;
  }
  if(a.gif && COMM_GIF_SET.includes(a.gif)) html += `<div class="comm-gif-sticker">${a.gif}</div>`;
  return html;
}

const COMM_FEELINGS = ['😊 ভালো আছি','🥳 উদযাপন করছি','😴 ক্লান্ত','💪 অনুপ্রাণিত','😢 মন খারাপ','🤔 চিন্তিত','📚 পড়াশোনা করছি','🎯 লক্ষ্যে অবিচল'];
const COMM_GIF_SET = ['🎉🎊✨','😂🤣','👏👏👏','❤️❤️❤️','🔥🔥🔥','👍😊'];
let commPending = {};

function commRenderPendingChips(){
  const wrap = document.getElementById('commPendingChips');
  if(!wrap) return;
  const entries = Object.entries(commPending).filter(([k,v])=>v);
  if(!entries.length){ wrap.innerHTML=''; wrap.style.display='none'; return; }
  wrap.style.display='flex';
  const labels = {img:'📷 ছবি সংযুক্ত', yt:'🎥 ভিডিও লিংক', music:'🎵', feeling:'😊', event:'📅', loc:'📍', tag:'🏷️', gif:'স্টিকার'};
  wrap.innerHTML = entries.map(([k,v])=>
    `<span class="comm-pending-chip">${labels[k]||k}${k!=='img'&&k!=='yt'?': '+escapeHtml(String(v).slice(0,24)):''} <button onclick="commRemovePending('${k}')" aria-label="সরান">✕</button></span>`
  ).join('');
}
function commRemovePending(key){ delete commPending[key]; commRenderPendingChips(); }

function commAddPhoto(){
  const inp = document.getElementById('commPhotoFileInput');
  if(inp) inp.click();
}
function commHandlePhotoFile(fileInput){
  const file = fileInput.files && fileInput.files[0];
  fileInput.value = '';
  if(!file) return;
  if(!file.type.startsWith('image/')){ showToast('শুধু ছবি ফাইল দিন'); return; }
  if(file.size > 280*1024){ showToast('⚠️ ছবিটি অনেক বড় — ২৮০KB-এর কম সাইজের ছবি দিন'); return; }
  const reader = new FileReader();
  reader.onload = () => { commPending.img = reader.result; commRenderPendingChips(); showToast('📷 ছবি যুক্ত হয়েছে'); };
  reader.readAsDataURL(file);
}
function commAddVideo(){
  const url = prompt('YouTube ভিডিও লিংক পেস্ট করুন:');
  if(!url) return;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{6,20})/);
  if(!m){ showToast('সঠিক YouTube লিংক দিন'); return; }
  commPending.yt = m[1];
  commRenderPendingChips();
  showToast('🎥 ভিডিও যুক্ত হয়েছে');
}
function commAddMusic(){
  const song = prompt('গানের নাম লিখুন:');
  if(!song || !song.trim()) return;
  commPending.music = song.trim().slice(0,80);
  commRenderPendingChips();
}
function commAddFeeling(){
  const list = COMM_FEELINGS.map((f,i)=>`${i+1}. ${f}`).join('\n');
  const choice = prompt('একটি অনুভূতি/কার্যক্রম বেছে নিন (নম্বর লিখুন):\n'+list);
  const idx = parseInt(choice,10)-1;
  if(!COMM_FEELINGS[idx]) return;
  commPending.feeling = COMM_FEELINGS[idx];
  commRenderPendingChips();
}
function commAddEvent(){
  const name = prompt('ইভেন্টের নাম:');
  if(!name || !name.trim()) return;
  const date = prompt('তারিখ (ঐচ্ছিক, যেমন: ১৫ সেপ্টেম্বর, ২০২৬):') || '';
  commPending.event = name.trim().slice(0,60) + '|' + date.trim().slice(0,40);
  commRenderPendingChips();
}
function commAddLocation(){
  const loc = prompt('আপনি কোথায় আছেন?');
  if(!loc || !loc.trim()) return;
  commPending.loc = loc.trim().slice(0,60);
  commRenderPendingChips();
}
function commAddTag(){
  const names = prompt('কাদের ট্যাগ করতে চান? (কমা দিয়ে আলাদা করুন):');
  if(!names || !names.trim()) return;
  commPending.tag = names.trim().slice(0,100);
  commRenderPendingChips();
}
function commAddGif(){
  const list = COMM_GIF_SET.map((g,i)=>`${i+1}. ${g}`).join('\n');
  const choice = prompt('একটি স্টিকার বেছে নিন (নম্বর লিখুন):\n'+list);
  const idx = parseInt(choice,10)-1;
  if(!COMM_GIF_SET[idx]) return;
  commPending.gif = COMM_GIF_SET[idx];
  commRenderPendingChips();
}
function commGoLive(){
  showToast('🔴 লাইভ ভিডিও শীঘ্রই আসছে — এই মুহূর্তে এই ফিচারটি প্রস্তুত নয়');
}

async function commSubmitPost(){
  const inp = document.getElementById('commComposeInput');
  const typedText = inp ? inp.value.trim() : '';
  const hasAttachment = Object.values(commPending).some(v=>v);
  if(!typedText && !hasAttachment){ showToast('কিছু লিখুন অথবা কিছু যুক্ত করুন'); return; }

  let fullText = typedText;
  if(commPending.feeling) fullText += `⟦feeling:${commPending.feeling}⟧`;
  if(commPending.loc) fullText += `⟦loc:${commPending.loc}⟧`;
  if(commPending.tag) fullText += `⟦tag:${commPending.tag}⟧`;
  if(commPending.music) fullText += `⟦music:${commPending.music}⟧`;
  if(commPending.event) fullText += `⟦event:${commPending.event}⟧`;
  if(commPending.img) fullText += `⟦img:${commPending.img}⟧`;
  if(commPending.yt) fullText += `⟦yt:${commPending.yt}⟧`;
  if(commPending.gif) fullText += `⟦gif:${commPending.gif}⟧`;

  const tag = (typedText.match(/#(\S+)/)||[])[1]||'সাধারণ';
  const btn = document.querySelector('[onclick="commSubmitPost()"]');
  if(btn){ btn.textContent='পোস্ট হচ্ছে…'; btn.disabled=true; }
  const res = await SB.post('comm_posts', {
    id: 'p'+Date.now(),
    author: MY_NAME,
    av: MY_AV,
    group_id: 'g-bcs',
    tag,
    text: fullText,
    user_key: MY_KEY
  });
  if(btn){ btn.textContent='পোস্ট করুন →'; btn.disabled=false; }
  if(res){
    if(inp) inp.value='';
    commPending = {};
    commRenderPendingChips();
    commFilterTag=null;
    AppState.addCoin(10);
    showToast('+10 🪙 পোস্ট করার জন্য! সবাই দেখতে পাচ্ছে');
    await commFetchPosts();
  } else {
    showToast('পোস্ট করা যায়নি — আবার চেষ্টা করুন');
  }
}

function commCompose(type){
  const inp=document.getElementById('commComposeInput');
  if(!inp) return;
  const h={photo:'📷 ছবি: ',question:'❓ প্রশ্ন: ',resource:'📎 রিসোর্স: ',poll:'📊 পোল: '};
  inp.value=h[type]||''; inp.focus();
}

function commFilterByTag(tag){ commFilterTag=tag; renderCommFeed(); }

function commShowOffline(){
  const feed=document.getElementById('commFeed');
  if(feed) feed.innerHTML=`<div style="text-align:center;padding:32px;color:var(--text3);font-family:'Noto Serif Bengali',serif;">
    ⚠️ সংযোগ পাওয়া যাচ্ছে না। ইন্টারনেট চেক করুন এবং পেজ রিফ্রেশ করুন।</div>`;
}

// ── Groups sidebar ────────────────────────────────────
function renderCommGroups(){
  commLoadGroups();
  const el=document.getElementById('commGroupList');
  const search=document.getElementById('commGroupSearch');
  if(el) el.innerHTML=COMM_GROUPS_MASTER.slice(0,5).map(g=>{
    const joined=commGroups[g.id];
    return `<div class="comm-group-item">
      <div class="comm-group-ico" style="background:${g.bg};">${g.ico}</div>
      <div class="comm-group-info"><div class="comm-group-name">${g.name}</div><div class="comm-group-members">${g.members.toLocaleString()} সদস্য</div></div>
      <button class="comm-group-join ${joined?'joined':''}" onclick="commToggleGroup('${g.id}',this)">${joined?'✓ যুক্ত':'যোগ দিন'}</button>
    </div>`;
  }).join('');
  if(search) renderGroupSearch('');
}

function renderGroupSearch(q){
  const el=document.getElementById('commGroupSearch');
  if(!el) return;
  const results=q?COMM_GROUPS_MASTER.filter(g=>g.name.toLowerCase().includes(q.toLowerCase())):COMM_GROUPS_MASTER.slice(5);
  el.innerHTML=results.slice(0,4).map(g=>{
    const joined=commGroups[g.id];
    return `<div class="comm-group-item">
      <div class="comm-group-ico" style="background:${g.bg};">${g.ico}</div>
      <div class="comm-group-info"><div class="comm-group-name">${g.name}</div><div class="comm-group-members">${g.desc}</div></div>
      <button class="comm-group-join ${joined?'joined':''}" onclick="commToggleGroup('${g.id}',this)">${joined?'✓ যুক্ত':'যোগ দিন'}</button>
    </div>`;
  }).join('');
}

function filterGroups(q){ renderGroupSearch(q); }

function commToggleGroup(gid,btn){
  commGroups[gid]=!commGroups[gid];
  commSaveGroups();
  btn.textContent=commGroups[gid]?'✓ যুক্ত':'যোগ দিন';
  btn.classList.toggle('joined',commGroups[gid]);
  if(commGroups[gid]){
    const g=COMM_GROUPS_MASTER.find(x=>x.id===gid);
    AppState.addCoin(15);
    showToast(`✅ ${g?.name||'গ্রুপে'} যোগ দেওয়া হয়েছে! +15 🪙`);
    renderCommGroups();
  }
}

// ── Init (called when community page opens) ───────────
async function initCommunity(){
  renderCommGroups();
  const feed=document.getElementById('commFeed');
  if(feed) feed.innerHTML=`<div style="text-align:center;padding:32px;color:var(--text3);">⏳ পোস্ট লোড হচ্ছে…</div>`;
  await commFetchPosts();

  // Real-time: reload feed on any new post/comment
  SB.subscribe('comm_posts', async ()=>{
    await commFetchPosts();
    showToast('🔔 নতুন পোস্ট এসেছে!');
  });
}

const _commBaseGo=go;
go=function(id,back){
  _commBaseGo(id,back);
  if(id==='community') setTimeout(initCommunity,80);
};
if(document.getElementById('page-community')?.classList.contains('active')) initCommunity();

function openArticle(id){
  const art = NEWS_ARTICLES.find(a=>a.id===id);
  const content = document.getElementById('newsModalContent');
  const modal = document.getElementById('newsModal');
  if(!modal||!content) return;
  if(art){
    content.innerHTML = `<div class="modal-article">${art.body}<div style="margin-top:28px;padding-top:16px;border-top:1px solid var(--border);display:flex;gap:8px;"><button class="btn-gold btn-sm" onclick="showToast('শেয়ার লিঙ্ক কপি হয়েছে!')">🔗 শেয়ার করুন</button><button class="btn-outline btn-sm" onclick="showToast('সংরক্ষিত হয়েছে!')">🔖 সংরক্ষণ</button><button class="btn-outline btn-sm" onclick="showToast('রিপোর্ট পাঠানো হয়েছে')">⚑ রিপোর্ট</button></div></div>`;
  } else {
    content.innerHTML = `<div class="modal-article"><h2>সম্পূর্ণ নিবন্ধ শীঘ্রই আসছে</h2><p>এই সংবাদটি প্রকাশনার প্রক্রিয়ায় রয়েছে। Effective News-এর সম্পাদকীয় দল এটি যাচাই করছেন।</p></div>`;
  }
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
}

function closeArticle(){
  const modal = document.getElementById('newsModal');
  if(modal){ modal.style.display='none'; document.body.style.overflow=''; }
}

// AI News Brief Generator
async function generateAINewsBrief(){
  const topic = document.getElementById('newsAiTopic').value.trim();
  if(!topic){ showToast('⚠️ একটি বিষয় লিখুন'); return; }

  const btn = document.getElementById('newsAiBtn');
  const loading = document.getElementById('newsAiLoading');
  const result = document.getElementById('newsAiResult');

  btn.disabled = true; btn.textContent = '⏳ তৈরি হচ্ছে…';
  loading.style.display = 'flex'; result.style.display = 'none';

  try {
    const resp = await fetch((window.VOD_API_BASE||'')+'/ai/ask',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-20250514', max_tokens:1000,
        messages:[{role:'user', content:`আপনি Effective News-এর একজন অভিজ্ঞ সাংবাদিক। নিচের বিষয়ে একটি সংক্ষিপ্ত কিন্তু তথ্যসমৃদ্ধ সংবাদ সারসংক্ষেপ বাংলায় লিখুন। সারসংক্ষেপটি হবে ৩-৪ অনুচ্ছেদের, মোট ১৫০-২০০ শব্দের। বস্তুনিষ্ঠ, তথ্যভিত্তিক এবং পাঠকবান্ধব ভাষায় লিখুন। শেষে দুটি গুরুত্বপূর্ণ তথ্যসূত্র বা পরবর্তী পদক্ষেপ উল্লেখ করুন।\n\nবিষয়: ${topic}`}]
      })
    });
    if(!resp.ok) throw new Error('AI service returned ' + resp.status);
    const data = await resp.json();
    const text = data?.content?.map(i=>i.text||'').join('') || '';
    if(!text) throw new Error('Empty response');
    result.innerHTML = escapeHtml(text).replace(/\n\n/g,'</p><p style="margin-top:12px;">').replace(/\n/g,'<br>');
    result.innerHTML = '<p>' + result.innerHTML + '</p>';
    result.style.display = 'block';
    showToast('✅ AI News Brief তৈরি হয়েছে!');
  } catch(e){
    console.warn('AI news brief unavailable:', e.message);
    // Honest fallback — we can't fabricate real news, so explain clearly
    result.innerHTML = `<p style="color:var(--text3);font-style:italic;">⚠️ এই মুহূর্তে AI সংবাদ সারসংক্ষেপ তৈরি করা সম্ভব হচ্ছে না (সংযোগ সমস্যা)। অনুগ্রহ করে নিচের সংবাদ ফিড থেকে "${escapeHtml(topic)}"-সম্পর্কিত প্রবন্ধ খুঁজুন, অথবা কিছুক্ষণ পর আবার চেষ্টা করুন।</p>`;
    result.style.display = 'block';
    showToast('ℹ️ AI সংযোগ পাওয়া যায়নি — অনুগ্রহ করে পরে চেষ্টা করুন');
  } finally {
    btn.disabled=false; btn.textContent='✨ Brief তৈরি করুন';
    loading.style.display='none';
  }
}

