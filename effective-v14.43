          </div>
        </div>
      </div>
      <div class="ex-card" data-cat="bank">
        <div class="ex-card-top" style="background:linear-gradient(135deg,#1C1917,#57534E);">
          <div class="ex-card-ico">🏦</div>
          <div class="ex-card-badge free">Free</div>
        </div>
        <div class="ex-card-body">
          <div class="ex-card-title">Bank Job — গণিত ও মানসিক দক্ষতা</div>
          <div class="ex-card-meta"><span>📝 ৭০ MCQ</span><span>⏱ ৪৫ মিনিট</span><span>🏆 পূর্ণমান ৭০</span></div>
          <div class="ex-card-tags"><span class="ex-tag">Sonali Bank Pattern</span><span class="ex-tag">২০২৫ আপডেট</span></div>
          <div class="ex-card-footer">
            <span class="ex-card-taken">৩৩,১২৩ জন দিয়েছেন</span>
            <button class="ex-start-btn" onclick="exLaunchMCQ('bank-math','Bank Math')">শুরু করুন →</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ MCQ EXAM INTERFACE ══ -->
<div class="ex-panel" id="exp-mcq-live" style="display:none;">
  <div style="max-width:900px;margin:0 auto;padding:40px 52px;">
    <div class="mcq-exam-shell">
      <!-- Exam header -->
      <div class="mcq-hd">
        <div>
          <div class="mcq-hd-title" id="mcqExamTitle">BCS Preliminary — বাংলাদেশ বিষয়াবলি</div>
          <div class="mcq-hd-meta"><span id="mcqProgress">প্রশ্ন ১ / ১০</span> · <span id="mcqScore">স্কোর: ০</span></div>
        </div>
        <div class="mcq-timer" id="mcqTimer">৬০:০০</div>
        <button class="mcq-exit-btn" onclick="exExitExam()">✕ বের হন</button>
      </div>
      <!-- Progress bar -->
      <div class="mcq-prog-track"><div class="mcq-prog-fill" id="mcqProgFill" style="width:10%"></div></div>
      <!-- Question area -->
      <div class="mcq-q-area" id="mcqQArea">
        <div class="mcq-q-num" id="mcqQNum">প্রশ্ন ১</div>
        <div class="mcq-q-text" id="mcqQText">বাংলাদেশের সংবিধান কত সালে গৃহীত হয়?</div>
        <div class="mcq-options" id="mcqOptions">
          <button class="mcq-opt" onclick="mcqSelect(this,'a')"><span class="mcq-opt-lbl">ক</span><span>১৯৭১ সালে</span></button>
          <button class="mcq-opt" onclick="mcqSelect(this,'b')"><span class="mcq-opt-lbl">খ</span><span>১৯৭২ সালে</span></button>
          <button class="mcq-opt" onclick="mcqSelect(this,'c')"><span class="mcq-opt-lbl">গ</span><span>১৯৭৩ সালে</span></button>
          <button class="mcq-opt" onclick="mcqSelect(this,'d')"><span class="mcq-opt-lbl">ঘ</span><span>১৯৭৪ সালে</span></button>
        </div>
      </div>
      <!-- Nav -->
      <div class="mcq-nav">
        <button class="mcq-btn-prev" id="mcqPrev" onclick="mcqPrev()" style="opacity:.4" disabled>← পূর্ববর্তী</button>
        <div class="mcq-dot-row" id="mcqDots"></div>
        <button class="mcq-btn-next" id="mcqNext" onclick="mcqNext()">পরবর্তী →</button>
      </div>
    </div>
  </div>
</div>

<!-- ══ MCQ RESULT PANEL (Free vs Premium) ══ -->
<div class="ex-panel" id="exp-mcq-result" style="display:none;">
  <div style="max-width:900px;margin:0 auto;padding:40px 52px;">
    <div class="mcq-result-shell">
      <div class="mcq-res-hd">
        <div class="mcq-res-emoji" id="mcqResEmoji">🎉</div>
        <div class="mcq-res-title" id="mcqResTitle">পরীক্ষা সম্পন্ন!</div>
        <div class="mcq-res-score" id="mcqResScore">৭/১০</div>
        <div class="mcq-res-pct" id="mcqResPct">৭০% সঠিক</div>
      </div>
      <!-- Free tier result -->
      <div id="mcqResFree" class="mcq-res-tier">
        <div class="mcq-res-tier-hd">📋 বিনামূল্যে ফলাফল</div>
        <div id="mcqResFreeContent" class="mcq-res-answers"></div>
        <!-- Premium upsell -->
        <div class="mcq-premium-cta">
          <div class="mcq-premium-hd">🔒 Premium-এ আনলক করুন</div>
          <div class="mcq-premium-grid">
            <div class="mcq-prem-item">🤖 প্রতিটি প্রশ্নের বিস্তারিত AI ব্যাখ্যা</div>
            <div class="mcq-prem-item">🎯 Distractor Analysis — কেন অন্য উত্তরগুলো ভুল</div>
            <div class="mcq-prem-item">📚 সম্পর্কিত বই (Mart থেকে)</div>
            <div class="mcq-prem-item">📝 সম্পর্কিত Blog পোস্ট</div>
            <div class="mcq-prem-item">🎓 সম্পূর্ণ কোর্সের লিংক</div>
            <div class="mcq-prem-item">📥 PDF রিপোর্ট ডাউনলোড</div>
          </div>
          <button class="btn-gold" style="margin-top:16px;width:100%;" onclick="showToast('🪙 Gold Coins দিয়ে Premium আনলক করুন!')">✦ Premium আনলক করুন — ৫০ Coins</button>
        </div>
      </div>
      <!-- Premium tier result (hidden by default) -->
      <div id="mcqResPremium" class="mcq-res-tier" style="display:none;">
        <div class="mcq-res-tier-hd" style="color:var(--gold);">✨ Premium AI বিশ্লেষণ</div>
        <div id="mcqResPremiumContent"></div>
      </div>
      <div style="display:flex;gap:10px;margin-top:20px;flex-wrap:wrap;">
        <button class="btn-gold" onclick="exTypeSwitch(document.getElementById('ext-mcq'),'mcq')">🔄 আবার পরীক্ষা দিন</button>
        <button class="btn-outline" onclick="exTypeSwitch(document.getElementById('ext-cert'),'cert')">🏅 Certificate দেখুন</button>
        <button class="btn-outline" onclick="go('academy')">🎓 কোর্সে ভর্তি হন</button>
      </div>
    </div>
  </div>
</div>

<!-- ══ WRITTEN EXAM PANEL ══ -->
<div class="ex-panel" id="exp-written" style="display:none;">
  <div style="max-width:1100px;margin:0 auto;padding:40px 52px;">
    <div class="sec-hd"><div><div class="sec-lbl">AI ও Teacher দ্বারা গ্রেডিং</div><div class="sec-ttl">Written <span class="bn">পরীক্ষা</span></div></div></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:16px;margin-bottom:28px;">
      <div class="written-exam-card" onclick="exLaunchWritten('bcs-written-bangla','BCS Written — বাংলা')">
        <div class="wec-ico" style="background:linear-gradient(135deg,#1E3A5F,#2563EB);">✍</div>
        <div class="wec-title">BCS Written — বাংলা</div>
        <div class="wec-meta">৩ ঘণ্টা · AI + Teacher গ্রেডিং · সর্বোচ্চ ২০০ নম্বর</div>
        <div class="wec-tags"><span class="ex-tag">AI Feedback JSON</span><span class="ex-tag premium-tag">Premium</span></div>
      </div>
      <div class="written-exam-card" onclick="exLaunchWritten('bcs-written-english','BCS Written — English')">
        <div class="wec-ico" style="background:linear-gradient(135deg,#065F46,#059669);">🖊</div>
        <div class="wec-title">BCS Written — English</div>
        <div class="wec-meta">৩ ঘণ্টা · AI + Teacher গ্রেডিং · সর্বোচ্চ ২০০ নম্বর</div>
        <div class="wec-tags"><span class="ex-tag">Grammar Check</span><span class="ex-tag premium-tag">Premium</span></div>
      </div>
      <div class="written-exam-card" onclick="exLaunchWritten('ielts-writing','IELTS Writing — Task 1 & 2')">
        <div class="wec-ico" style="background:linear-gradient(135deg,#0C4A6E,#0369A1);">🌐</div>
        <div class="wec-title">IELTS Writing — Task 1 & 2</div>
        <div class="wec-meta">৬০ মিনিট · AI Band Scoring · IELTS 9-band scale</div>
        <div class="wec-tags"><span class="ex-tag">Band Prediction</span><span class="ex-tag premium-tag">Premium</span></div>
      </div>
      <div class="written-exam-card" onclick="exLaunchWritten('hsc-bangla','HSC বাংলা — রচনামূলক')">
        <div class="wec-ico" style="background:linear-gradient(135deg,#7C3AED,#6D28D9);">📜</div>
        <div class="wec-title">HSC বাংলা — রচনামূলক</div>
        <div class="wec-meta">৩ ঘণ্টা · AI গ্রেডিং · সর্বোচ্চ ৭০ নম্বর</div>
        <div class="wec-tags"><span class="ex-tag">NCTB Rubric</span><span class="ex-tag free-tag">Free</span></div>
      </div>
    </div>

    <!-- AI Written Exam Interface -->
    <div id="writtenExamBox" style="display:none;" class="written-exam-box">
      <div class="mcq-hd">
        <div><div class="mcq-hd-title" id="writtenExamTitle">Written Exam</div><div class="mcq-hd-meta">AI গ্রেডিং সক্রিয়</div></div>
        <div class="mcq-timer" id="writtenTimer">৩:০০:০০</div>
        <button class="mcq-exit-btn" onclick="exitWrittenExam()">✕</button>
      </div>
      <div class="written-q-area">
        <div class="written-q-text" id="writtenQText"></div>
        <div class="written-q-sub">Model Answer-এর ভিত্তিতে AI আপনার উত্তর মূল্যায়ন করবে।</div>
        <!-- OCR upload or text area -->
        <div class="written-input-toggle">
          <button class="wit-btn on" id="witText" onclick="toggleWrittenInput('text')">⌨ টাইপ করুন</button>
          <button class="wit-btn" id="witOCR" onclick="toggleWrittenInput('ocr')">📸 ছবি আপলোড (OCR)</button>
        </div>
        <textarea id="writtenAnswer" class="written-textarea" placeholder="এখানে আপনার উত্তর লিখুন..."></textarea>
        <div id="ocrUploadArea" style="display:none;" class="ocr-upload-area" onclick="showToast('OCR Backend সংযুক্তির পর কাজ করবে')">
          <div class="ocr-icon">📸</div>
          <div>হস্তলিখিত উত্তরের ছবি আপলোড করুন</div>
          <div style="font-size:.75rem;color:var(--text3);">JPG/PNG · সর্বোচ্চ 10MB · OCR দ্বারা পাঠ্যে রূপান্তরিত হবে</div>
        </div>
      </div>
      <div style="display:flex;gap:10px;justify-content:space-between;margin-top:16px;flex-wrap:wrap;">
        <div style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--text3);">
          শব্দ সংখ্যা: <span id="wordCount">০</span>
        </div>
        <button class="btn-gold" id="submitWrittenBtn" onclick="submitWrittenExam()">🤖 AI দিয়ে গ্রেড করুন</button>
      </div>
      <!-- AI Result Area -->
      <div id="writtenAIResult" style="display:none;" class="written-ai-result">
        <div class="wair-hd"><div class="eval-spinner" id="writtenSpinner"></div><span id="writtenResultTitle">AI মূল্যায়ন চলছে…</span></div>
        <div id="writtenResultContent"></div>
      </div>
    </div>
  </div>
</div>

