  <!-- ══════════════════════════════════════════════════
       SECTION 5: EDITORIAL TEAM & PHASE ROADMAP
  ══════════════════════════════════════════════════ -->
  <section style="padding:48px 52px;">
    <div style="max-width:1400px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">

        <!-- Editorial Team -->
        <div>
          <div style="font-size:.63rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--indigo);margin-bottom:8px;">সম্পাদকীয় দল</div>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:700;margin-bottom:20px;">Effective News <em>Newsroom</em></h2>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <div class="author-card">
              <div class="author-avatar" style="background:linear-gradient(135deg,var(--indigo),#1A55C8);">RE</div>
              <div>
                <div class="author-name">Effective EduHub Editorial Board</div>
                <div class="author-role">Editor-in-Chief · Managing Editor</div>
