    <div id="jnModalChips" class="jn-modal-chips"></div>
    <div id="jnAiWelcome" class="jn-ai-welcome" style="display:none;">
      <div class="jn-ai-w-hd"><div class="eval-spinner" style="width:16px;height:16px;border-top-color:#A78BFA;"></div> AI আপনার জন্য একটি ব্যক্তিগত পথ তৈরি করছে…</div>
      <div id="jnAiWelcomeText" style="display:none;"></div>
    </div>
    <div class="jn-modal-actions" id="jnModalActions"></div>
  </div>
</div>

</div><!-- /page-join -->


<div class="page" id="page-dashboard">
  <div class="breadcrumb"><a onclick="go('home')">হোম</a><span>›</span><span>Dashboard Hub</span></div>
  <div style="background:linear-gradient(120deg,var(--void),#EEF4FF,#E4ECFF);padding:48px 52px;border-bottom:1px solid var(--border);">
    <div style="max-width:1400px;margin:0 auto;">
      <div style="display:inline-flex;align-items:center;gap:7px;background:var(--gold-dim);border:1px solid rgba(200,152,30,.3);border-radius:20px;padding:4px 13px;font-size:.67rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;">📊 Dashboard Hub</div>
      <div style="font-family:'Cormorant Garamond',serif;font-size:2.6rem;font-weight:700;margin-bottom:10px;line-height:1.1;">আপনার <em style="font-style:normal;background:linear-gradient(135deg,var(--gold),var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">ব্যক্তিগত ড্যাশবোর্ড</em></div>
