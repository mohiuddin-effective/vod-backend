// 📺 MULTIMEDIA TAB SWITCHER
// ══════════════════════════════════════════════════════
function switchNewsMedia(tab){
  ['tv','podcast','docs','events'].forEach(t=>{
    document.getElementById('nmtab-'+t)?.classList.toggle('on', t===tab);
    const p = document.getElementById('nmedia-'+t);
    if(p) p.style.display = t===tab ? 'block' : 'none';
  });
}

// ══════════════════════════════════════════════════════
// ✅ AI FACT CHECK DESK
// ══════════════════════════════════════════════════════
function setFactCheck(txt){
  const el = document.getElementById('factCheckInput');
  if(el){ el.value = txt; el.focus(); }
}

async function runFactCheck(){
  const claim = document.getElementById('factCheckInput')?.value.trim();
  if(!claim){ showToast('⚠️ একটি দাবি বা তথ্য লিখুন'); return; }

  const btn = document.getElementById('factCheckBtn');
  const loading = document.getElementById('factCheckLoading');
  const result = document.getElementById('factCheckResult');

  btn.disabled = true; btn.textContent = '⏳ যাচাই হচ্ছে…';
  loading.style.display = 'flex'; result.style.display = 'none';

  try {
    const resp = await fetch((window.VOD_API_BASE||'')+'/ai/ask',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514', max_tokens:1000,
        messages:[{role:'user', content:`You are Effective News Fact Check Desk — an expert on Bangladeshi education, scholarships, government exams (BCS, Bank), university admissions, and global higher education. Analyze the following claim and return ONLY valid JSON, no markdown, no extra text.

Claim: "${claim}"

Return exactly this structure:
{
  "verdict": "TRUE" | "FALSE" | "PARTIALLY TRUE" | "UNVERIFIABLE",
  "confidence": <number 0-100>,
  "explanation": "<2-3 sentences in Bengali explaining the analysis>",
  "correctInfo": "<the accurate information in Bengali, if claim was false or partial>",
  "sources": ["<authoritative source 1>", "<authoritative source 2>"]
}`}]
      })
    });
    if(!resp.ok) throw new Error('AI service returned ' + resp.status);
    const data = await resp.json();
    const raw = data?.content?.map(i=>i.text||'').join('') || '';
    if(!raw) throw new Error('Empty response');
    const json = JSON.parse(raw.replace(/```json|```/g,'').trim());
    renderFactCheckResult(json);
  } catch(e){
    console.warn('AI fact-check unavailable:', e.message);
    // IMPORTANT: never fabricate TRUE/FALSE offline — that would risk spreading
    // misinformation. Always return an honest "service unavailable" verdict.
    renderFactCheckResult({
      verdict: 'UNVERIFIABLE',
      confidence: 0,
      explanation: 'এই মুহূর্তে AI ফ্যাক্ট-চেক সার্ভিসের সাথে সংযোগ স্থাপন করা যায়নি, তাই এই দাবিটি স্বয়ংক্রিয়ভাবে যাচাই করা সম্ভব হয়নি। অনুগ্রহ করে কিছুক্ষণ পর আবার চেষ্টা করুন বা নির্ভরযোগ্য উৎস থেকে সরাসরি যাচাই করুন।',
      correctInfo: '',
      sources: [],
    });
    showToast('ℹ️ ফ্যাক্ট-চেক সার্ভিস এই মুহূর্তে অনুপলব্ধ');
  } finally {
    btn.disabled=false; btn.textContent='✅ তথ্য যাচাই করুন';
    loading.style.display='none';
  }
}

function renderFactCheckResult(r){
  const verdictMap = {
    'TRUE':           {cls:'true',      icon:'✅', label:'সত্য',           labelColor:'var(--green)'},
    'FALSE':          {cls:'false',     icon:'❌', label:'মিথ্যা',         labelColor:'var(--red)'},
    'PARTIALLY TRUE': {cls:'partial',   icon:'⚠️', label:'আংশিক সত্য',   labelColor:'var(--gold)'},
    'UNVERIFIABLE':   {cls:'uncertain', icon:'❓', label:'যাচাইযোগ্য নয়', labelColor:'var(--text3)'},
  };
  const m = verdictMap[r.verdict] || verdictMap['UNVERIFIABLE'];
  const confColor = r.confidence>=80?'var(--green)':r.confidence>=50?'var(--gold)':'var(--red)';
  const sourcesHTML = (r.sources||[]).map(s=>`<li style="font-size:.73rem;color:var(--text3);margin-bottom:3px;">${escapeHtml(s)}</li>`).join('');

  document.getElementById('factCheckResult').innerHTML = `
    <div class="fc-verdict ${m.cls}">
      <div class="fc-label" style="color:${m.labelColor};">${m.icon} রায়: ${m.label} &nbsp;·&nbsp; <span style="color:${confColor};">আস্থা ${Number(r.confidence)||0}%</span></div>
      <div class="fc-exp">${escapeHtml(r.explanation)}</div>
    </div>
    ${r.correctInfo ? `
    <div style="background:var(--indigo-dim);border:1px solid rgba(11,69,168,.15);border-radius:var(--r);padding:12px 14px;margin-bottom:10px;">
      <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;color:var(--indigo);margin-bottom:5px;">📌 সঠিক তথ্য:</div>
      <div class="fc-exp" style="color:var(--text);">${escapeHtml(r.correctInfo)}</div>
    </div>` : ''}
    ${sourcesHTML ? `
    <div style="font-size:.65rem;font-weight:700;letter-spacing:.1em;color:var(--text3);margin-bottom:5px;text-transform:uppercase;">📚 তথ্যসূত্র:</div>
    <ul style="padding-left:16px;margin:0 0 4px;">${sourcesHTML}</ul>` : ''}
    <div style="margin-top:10px;display:flex;gap:6px;">
      <button class="btn-outline btn-sm" onclick="showToast('শেয়ার লিঙ্ক কপি হয়েছে!')">🔗 শেয়ার করুন</button>
      <button class="btn-outline btn-sm" onclick="showToast('ফ্যাক্ট চেক রিপোর্ট সংরক্ষিত হয়েছে!')">💾 সংরক্ষণ</button>
    </div>`;

  document.getElementById('factCheckResult').style.display = 'block';
  showToast(`${m.icon} ফ্যাক্ট চেক সম্পন্ন: ${m.label}`);
}

// ══════════════════════════════════════════════════════
// 💬 COMMENTS SYSTEM
// ══════════════════════════════════════════════════════
const articleComments = {
  default: [
    {author:'আরিফুর রহমান', text:'অত্যন্ত গুরুত্বপূর্ণ তথ্য। ধন্যবাদ Effective News-কে!', time:'৩ মিনিট আগে', likes:4},
    {author:'সামিয়া আক্তার', text:'এই বিষয়ে আরও বিস্তারিত জানতে চাই। পরবর্তী লেখার অপেক্ষায় রইলাম।', time:'১২ মিনিট আগে', likes:2},
  ]
};
let currentArticleId = null;

function postComment(){
  const input = document.getElementById('commentInput');
  if(!input) return;
  const txt = input.value.trim();
  if(!txt){ showToast('⚠️ মন্তব্য লিখুন'); return; }
  if(!articleComments[currentArticleId]) articleComments[currentArticleId] = [...articleComments.default];
  articleComments[currentArticleId].unshift({author:'আপনি', text:txt, time:'এইমাত্র', likes:0});
  renderComments(currentArticleId);
  input.value = '';
  showToast('✅ মন্তব্য প্রকাশিত হয়েছে!');
}

function renderComments(id){
  const list = document.getElementById('newsComments');
  if(!list) return;
  const comments = articleComments[id] || articleComments.default;
  list.innerHTML = comments.slice(0,6).map((c,i)=>`
    <div class="news-comment">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px;">
        <div class="nc-author">${c.author}</div>
        <button style="background:none;border:none;font-size:.7rem;color:var(--text3);cursor:pointer;" onclick="likeComment(${i},'${id}')">👍 ${c.likes||0}</button>
      </div>
      <div class="nc-text">${c.text}</div>
      <div class="nc-time">${c.time}</div>
    </div>`).join('');
}

function likeComment(idx, articleId){
  const id = articleId || 'default';
  const list = articleComments[id] || articleComments.default;
  if(list[idx]) list[idx].likes = (list[idx].likes||0) + 1;
  renderComments(id);
}

