          <input id="commentInput" placeholder="আপনার মন্তব্য লিখুন…" style="flex:1;padding:8px 12px;border:1.5px solid var(--border2);border-radius:7px;font-family:'Noto Serif Bengali',serif;font-size:.82rem;color:var(--text);background:var(--card);outline:none;" onfocus="this.style.borderColor='var(--red)'" onblur="this.style.borderColor='var(--border2)'" onkeydown="if(event.key==='Enter')postComment()">
          <button style="background:var(--red);border:none;border-radius:7px;padding:8px 16px;color:#fff;font-weight:700;font-size:.8rem;" onclick="postComment()">পাঠান</button>
        </div>
      </div>
    </div>
  </div>
