    resultDiv.innerHTML = `<strong style="color:var(--indigo);">🤖 AI স্টাডি প্ল্যান:</strong><br><br>${escapeHtml(text).replace(/\n/g,'<br>')}`;
  } catch(e) {
    resultDiv.innerHTML = `<strong>📚 ৩০-দিনের স্টাডি প্ল্যান:</strong><br><br>
১. প্রতিদিন মুক্তিযুদ্ধ বিষয়ক ১টি বই পড়ুন<br>
২. আন্তর্জাতিক সংস্থার নাম ও কাজ মুখস্থ করুন<br>
৩. সংবিধানের সকল সংশোধনী একটি তালিকায় লিখুন<br>
৪. প্রতিদিন ৫০টি MCQ প্র্যাকটিস করুন<br>
৫. দুর্বল বিষয়ে কোর্স করুন — Effective Academy-তে বিনামূল্যে পাবেন`;
  }
  if (btn) btn.disabled = false;
}

