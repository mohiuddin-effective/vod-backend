  ]},
  {sector:'Academic', link:'academy', items:[
    {label:'Class 5', link:'class5-psc'}, {label:'Class 6', link:'class6-prep'}, {label:'Class 7', link:'class7-prep'},
    {label:'Class 8 ও JSC', link:'class8-jsc'}, {label:'Class 9,10 ও SSC', link:'ssc-prep'},
    {label:'Class 11,12, HSC', link:'hsc-prep'}, {label:'Admission', link:'academy'}
  ]},
  {sector:'Admission', link:'academy', items:[
