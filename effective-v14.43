    {label:'Non Cadre Jobs', link:'careers'}, {label:'Jobs Circulars', link:'careers'},
    {label:'1st Class', link:'careers'}, {label:'2nd Class', link:'careers'}, {label:'3rd Class', link:'careers'},
    {label:'4th Class', link:'careers'}, {label:'Departmental Exam', link:'careers'}
  ]},
  {sector:'Jobs (বেসরকারি)', link:'careers', items:[
    {label:'Private Jobs', link:'careers'}, {label:'Banks', link:'bank-jobs'}, {label:'Multi National', link:'careers'},
    {label:'Job Circular', link:'careers'}, {label:'CV', link:'careers'}, {label:'One Click Apply', link:'careers'},
    {label:'Job Fair', link:'careers'}
  ]},
  {sector:'Study Abroad', link:'higherstudy', items:[
    {label:'Undergraduate', link:'higherstudy'}, {label:'Masters/MBA', link:'higherstudy'}, {label:'MPhil', link:'higherstudy'},
    {label:'PhD', link:'higherstudy'}, {label:'Post Doctoral', link:'higherstudy'}, {label:'IELTS', link:'higherstudy'},
    {label:'TOEFL', link:'higherstudy'}, {label:'SAT', link:'higherstudy'}, {label:'GRE', link:'higherstudy'},
    {label:'GMAT', link:'higherstudy'}, {label:'PTE', link:'higherstudy'}, {label:'DET', link:'higherstudy'},
    {label:'MCAT', link:'higherstudy'}, {label:'LSAT', link:'higherstudy'}, {label:'USMLE', link:'higherstudy'},
    {label:'JLPT', link:'higherstudy'}, {label:'TOPIK', link:'higherstudy'}
  ]}
];
function ecoSlug(label){ return label.toLowerCase().replace(/[^a-z0-9\u0980-\u09ff]+/g,'-').replace(/(^-|-$)/g,''); }

let ecoMyInterests = [];
async function renderEcoTaxonomy(){
  const grid = document.getElementById('ecoTaxGrid');
  if(!grid || grid.dataset.loaded) return; // render once per page load
  if(fdToken()){
    try{ const me = await fdApiFetch('/auth/me'); ecoMyInterests = me.user.interests || []; }
    catch(e){ ecoMyInterests = []; }
  }
  grid.innerHTML = ECO_TAXONOMY.map(col => `
    <div class="eco-tax-col">
      <div class="eco-tax-hd" onclick="go('${col.link}')">${escapeHtml(col.sector)}</div>
      ${col.items.map(it => {
        const slug = ecoSlug(it.label);
        const checked = ecoMyInterests.includes(slug) ? 'checked' : '';
        return `<div class="eco-tax-item">
          <span class="eco-tax-item-label" onclick="go('${it.link}')">${escapeHtml(it.label)}</span>
          <input type="checkbox" ${checked} title="ফিডে দেখান" onchange="ecoToggleInterest('${slug}',this.checked)">
        </div>`;
      }).join('')}
    </div>`).join('');
  grid.dataset.loaded = '1';
}

async function ecoToggleInterest(slug, isChecked){
  if(!fdToken()){
    showToast('আগ্রহ সেভ করতে আগে রেজিস্ট্রেশন/লগইন করুন');
    openFeedAuth();
    return;
  }
  ecoMyInterests = isChecked ? [...new Set([...ecoMyInterests, slug])] : ecoMyInterests.filter(t=>t!==slug);
  try{
    await fdApiFetch('/auth/me/preferences', {method:'PUT', body:JSON.stringify({interests: ecoMyInterests})});
    showToast(isChecked ? '✅ আপনার ফিডে যোগ হলো' : 'ফিড থেকে সরানো হলো');
  } catch(err){ showToast('সংরক্ষণ ব্যর্থ হয়েছে'); }
}
document.addEventListener('DOMContentLoaded', hwpAppInit);

// ══════════════════════════════════════════════════════
// 🚪 App entry: first-visit quick registration + default landing page
// (uses the same site-wide session as the Feed page — FEED_TOKEN_KEY)
// ══════════════════════════════════════════════════════
function qrCanSkip(){ return true; } // click-outside always allowed to dismiss — "এখন না" is always an option, never forced
function qrSkip(){
  try{ localStorage.setItem('eeh_visited','1'); }catch(e){}
  document.getElementById('qrModal').classList.remove('open');
  document.body.style.overflow = '';
}
async function qrSubmit(){
  const name = document.getElementById('qrNameInput').value.trim();
  const contact = document.getElementById('qrContactInput').value.trim();
  const errEl = document.getElementById('qrError');
  const btn = document.getElementById('qrSubmitBtn');
  errEl.style.display='none';
  if(!name || !contact){ errEl.textContent='নাম ও ফোন/Email দুটোই দিন'; errEl.style.display='block'; return; }
  const isEmail = contact.includes('@');
  btn.disabled=true; btn.textContent='অপেক্ষা করুন…';
  try{
    const base = window.VOD_API_BASE || '';
    const res = await fetch(base+'/auth/quick-register', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({name, [isEmail?'email':'phone']: contact})
    });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error||'failed');
    localStorage.setItem(FEED_TOKEN_KEY, data.token);
    localStorage.setItem(FEED_NAME_KEY, data.user.name);
    try{ localStorage.setItem('eeh_visited','1'); }catch(e){}
    document.getElementById('qrModal').classList.remove('open');
    document.body.style.overflow = '';
    showToast(`🎉 স্বাগতম, ${data.user.name}! এখন আপনার ফিড দেখুন`);
    go('feed'); // registration complete → feed becomes the landing page, as requested
  } catch(err){
    const msgs = {already_registered:'এই ফোন/Email দিয়ে আগেই অ্যাকাউন্ট আছে — হোমপেজে লগইন করুন', email_or_phone_required:'ফোন নম্বর অথবা Email দিন'};
    errEl.textContent = msgs[err.message] || 'রেজিস্ট্রেশন ব্যর্থ হয়েছে — আবার চেষ্টা করুন';
    errEl.style.display='block';
  } finally { btn.disabled=false; btn.textContent='শুরু করুন 🚀'; }
}

function hwpAppInit(){
  // Returning, logged-in visitor → Feed is the default landing page.
  // First-time visitor with no session → show the quick-registration modal.
  let visited = false;
  try{ visited = localStorage.getItem('eeh_visited') === '1'; }catch(e){}

  if(fdToken()){
    go('feed'); // skip rendering the ecosystem taxonomy — we're navigating away immediately
    return;
  }
  renderEcoTaxonomy();
  if(!visited){
    const modal = document.getElementById('qrModal');
    if(modal){ modal.classList.add('open'); document.body.style.overflow = 'hidden'; }
  }
}

function addCart(e,name){
  e.stopPropagation();
  AppState.addCartItem(name);
  cart = AppState.getCart().length;
  showToast('"'+name+'" কার্টে যোগ হয়েছে');
}

function showToast(msg){
  const tm=document.getElementById('toastMsg');
  const t=document.getElementById('toast');
  if(!t||!tm) return;
  tm.textContent=msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3000);
}

// ══════════════════════════════════════════════════════
// 🛡️ escapeHtml — sanitize any text before it goes into innerHTML.
//    Applied to AI-generated text below since it's the one place on
//    this site where the text shown to a user wasn't written by us.
// ══════════════════════════════════════════════════════
function escapeHtml(str){
  if(str===null || str===undefined) return '';
  return String(str)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#39;');
}

// ══════════════════════════════════════════════════════
// 🔒 SAFE AI CALL HELPER — calls our own backend's /ai/ask proxy
//    (routes/ai.js in vod-backend), which holds the real Anthropic
//    API key server-side. Falls back gracefully if the backend
//    isn't configured yet (no ANTHROPIC_API_KEY) or is unreachable.
// ══════════════════════════════════════════════════════
async function safeAICall(prompt, fallbackFn){
  try{
    const resp = await fetch((window.VOD_API_BASE||'')+'/ai/ask',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:1000,
        messages:[{role:'user', content:prompt}]
      })
    });
    if(!resp.ok) throw new Error('AI service unavailable: '+resp.status);
    const data = await resp.json();
    const text = data?.content?.map(i=>i.text||'').join('') || '';
    if(!text) throw new Error('Empty AI response');
    return { ok:true, text };
  }catch(err){
    console.warn('AI call failed, using offline fallback:', err.message);
    return { ok:false, text: fallbackFn ? fallbackFn() : '' };
  }
}

// ══════════════════════════════════════════════════════
// 🎓 ACADEMY WINGS EXPLORER
// ══════════════════════════════════════════════════════
const AW_WINGS = ['school','college','english','ict','admission','job','higher','professional'];

function awSwitch(el, wing){
  AW_WINGS.forEach(w=>{
    document.getElementById('aw-'+w)?.classList.toggle('on', w===wing);
  });
  document.querySelectorAll('#awTabs .aw-tab').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');
  document.getElementById('aw-'+wing)?.scrollIntoView({behavior:'smooth', block:'nearest'});
}

function awGo(subject){
  showToast(`🔍 "${subject}" বিষয়ের কোর্স খোঁজা হচ্ছে...`);
  // Filter the course grid below by scrolling to it
  setTimeout(()=>{
    document.querySelector('#page-academy .course-grid')?.scrollIntoView({behavior:'smooth', block:'start'});
  }, 400);
}

// ── Mart category explorer ──
const MART_CATS = ['books','stationery','digital','learning','edtech','merch'];
function martSwitch(el, cat){
  MART_CATS.forEach(c=>{
    document.getElementById('mart-'+c)?.classList.toggle('on', c===cat);
  });
  document.querySelectorAll('#martTabs .aw-tab').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');
}

function go(id){
  pages.forEach(p=>{
    const el=document.getElementById('page-'+p);
    if(el) el.classList.remove('active');
    const nv=document.getElementById('nv-'+p);
    if(nv) nv.classList.remove('on');
  });
  const pg=document.getElementById('page-'+id);
  if(pg) pg.classList.add('active');
  const nv=document.getElementById('nv-'+id);
  if(nv){
    nv.classList.add('on');
    // Temporarily pause nav animation and scroll active item into view
    const track = document.getElementById('navTrack');
    if(track){
      track.style.animationPlayState = 'paused';
      nv.scrollIntoView({behavior:'smooth', block:'nearest', inline:'center'});
      setTimeout(()=>{ track.style.animationPlayState = ''; }, 1800);
    }
  }
  window.scrollTo({top:0,behavior:'smooth'});
  // Show vision band on home
  const vb=document.getElementById('platformVision');
  if(vb) vb.style.display = (id==='home') ? 'block' : 'none';
  // update eco strip active
  document.querySelectorAll('.eco-item').forEach(e=>e.classList.remove('on'));
  // Kids Wing: restore saved language + refresh star display each time it's opened
  if(id==='kids'){
    let savedLang = 'bn';
    try{ savedLang = localStorage.getItem('eeh_kids_lang') || 'bn'; }catch(e){}
    setKidsLang(savedLang);
    kwUpdateStarsUI();
  }
  // Feed: (re)initialize each time the page is opened
  if(id==='feed'){
    initFeedPage();
  }
}

function fp(el){
  const fr=el.closest('.fr-inner');
  if(fr) fr.querySelectorAll('.fpill').forEach(p=>p.classList.remove('on'));
  el.classList.add('on');
}

function dt(btn,panelId){
  const row=btn.closest('.dtab-row');
  row.querySelectorAll('.dtab').forEach(t=>t.classList.remove('on'));
  btn.classList.add('on');
  const pg=row.parentElement;
  pg.querySelectorAll('.dtab-panel').forEach(p=>p.classList.remove('on'));
  const target=document.getElementById(panelId);
  if(target) target.classList.add('on');
}

// ══════════════════════════════════════════════════════
// 📰 FEED CONTENT ADMIN — publish/manage /feed content
// (routes/admin.js: GET/POST /admin/contents, PATCH/DELETE /admin/contents/:id)
// Self-contained login — the rest of the Admin Dashboard around this tab
// is still static demo data; only this tab is wired to a real backend.
// ══════════════════════════════════════════════════════
const FC_TOKEN_KEY = 'eeh_fc_admin_token';
function fcToken(){ return localStorage.getItem(FC_TOKEN_KEY); }

async function fcApiFetch(path, opts={}){
  const base = window.VOD_API_BASE || '';
  const token = fcToken();
  const res = await fetch(base + path, {
    ...opts,
    headers: {'Content-Type':'application/json', ...(token?{'Authorization':'Bearer '+token}:{}), ...(opts.headers||{})}
  });
  if(res.status===401 || res.status===403){
    localStorage.removeItem(FC_TOKEN_KEY);
    fcInit();
    throw new Error('unauthorized');
  }
  const data = await res.json().catch(()=>({}));
  if(!res.ok) throw new Error(data.error||'request_failed');
  return data;
}

function fcInit(){
  const gate = document.getElementById('fcLoginGate');
  const content = document.getElementById('fcContent');
  if(!gate||!content) return;
  if(fcToken()){
    gate.style.display='none';
    content.style.display='block';
    fcLoadContents();
  } else {
    gate.style.display='block';
    content.style.display='none';
  }
}

async function fcLogin(){
  const email = document.getElementById('fcEmailInput').value.trim();
  const pass = document.getElementById('fcPassInput').value;
  const errEl = document.getElementById('fcLoginError');
  const btn = document.getElementById('fcLoginBtn');
  errEl.style.display='none';
  if(!email||!pass){ errEl.textContent='Email ও Password দিন'; errEl.style.display='block'; return; }
  btn.disabled=true; btn.textContent='লগইন হচ্ছে…';
  try{
    const base = window.VOD_API_BASE||'';
    const res = await fetch(base+'/auth/login', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email,password:pass})});
    const data = await res.json();
    if(!res.ok||!data.token) throw new Error(data.error||'login_failed');
    if(data.user && data.user.role!=='admin') throw new Error('not_admin');
    localStorage.setItem(FC_TOKEN_KEY, data.token);
    fcInit();
  } catch(err){
    const msgs = {invalid_credentials:'ভুল Email অথবা Password', not_admin:'এই অ্যাকাউন্টের Admin অ্যাক্সেস নেই'};
    errEl.textContent = msgs[err.message] || 'লগইন ব্যর্থ হয়েছে';
    errEl.style.display='block';
  } finally { btn.disabled=false; btn.textContent='লগইন করুন'; }
}

async function fcLoadContents(){
  const tbody = document.getElementById('fcContentTbody');
  try{
    const data = await fcApiFetch('/admin/contents');
    const wingSelect = document.getElementById('fcWingSelect');
    if(wingSelect && !wingSelect.dataset.loaded){
      wingSelect.innerHTML = data.wings.map(w=>`<option value="${w.wing_key}">${w.icon_symbol} ${escapeHtml(w.title_bn)}</option>`).join('');
      wingSelect.dataset.loaded = '1';
    }
    if(!data.contents.length){
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text3);">এখনো কোনো কনটেন্ট নেই</td></tr>';
      return;
    }
    tbody.innerHTML = data.contents.map(c=>`<tr>
      <td><strong>${escapeHtml(c.title)}</strong></td>
      <td><span class="status-chip sc-blue">${escapeHtml(c.wing_type)}</span></td>
      <td>${escapeHtml(c.content_kind)}</td>
      <td>👍${c.like_count} · 👁️${c.view_count}</td>
      <td>${c.is_published ? '<span class="status-chip sc-green">প্রকাশিত</span>' : '<span class="status-chip sc-yellow">অপ্রকাশিত</span>'}</td>
      <td>
        <button class="btn-sm" style="background:var(--gold-dim);border:1px solid rgba(184,109,5,.3);border-radius:6px;color:var(--gold);padding:5px 10px;font-size:.7rem;font-weight:600;" onclick="fcTogglePublish(${c.id},${c.is_published})">${c.is_published?'⏸ আনপাবলিশ':'▶ পাবলিশ'}</button>
        <button class="btn-sm" style="background:var(--red-dim);border:1px solid rgba(196,32,32,.25);border-radius:6px;color:var(--red);padding:5px 10px;font-size:.7rem;font-weight:600;" onclick="fcDeleteContent(${c.id})">🗑</button>
      </td>
    </tr>`).join('');
  } catch(err){
    if(err.message!=='unauthorized') tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--red);">লোড ব্যর্থ হয়েছে</td></tr>';
  }
}

async function fcCreateContent(){
  const wing_type = document.getElementById('fcWingSelect').value;
  const content_kind = document.getElementById('fcKindSelect').value;
  const category_key = document.getElementById('fcCategoryInput').value.trim();
  const title = document.getElementById('fcTitleInput').value.trim();
  const body = document.getElementById('fcBodyInput').value.trim();
  const tags = document.getElementById('fcTagsInput').value.split(',').map(t=>t.trim()).filter(Boolean);
  const btn = document.getElementById('fcCreateBtn');
  if(!wing_type || !category_key || !title){ showToast('উইং, ক্যাটাগরি ও শিরোনাম আবশ্যক'); return; }
  btn.disabled=true; btn.textContent='পাবলিশ হচ্ছে…';
  try{
    await fcApiFetch('/admin/contents', {method:'POST', body:JSON.stringify({wing_type, category_key, content_kind, title, body, tags})});
    showToast('✅ কনটেন্ট পাবলিশ হয়েছে');
    document.getElementById('fcCategoryInput').value='';
    document.getElementById('fcTitleInput').value='';
    document.getElementById('fcBodyInput').value='';
    document.getElementById('fcTagsInput').value='';
    fcLoadContents();
  } catch(err){
    if(err.message!=='unauthorized') showToast('পাবলিশ ব্যর্থ হয়েছে');
  } finally { btn.disabled=false; btn.textContent='📤 পাবলিশ করুন'; }
}

async function fcTogglePublish(id, currentlyPublished){
  try{
    await fcApiFetch(`/admin/contents/${id}`, {method:'PATCH', body:JSON.stringify({is_published: !currentlyPublished})});
    showToast(currentlyPublished ? 'আনপাবলিশ করা হয়েছে' : 'পাবলিশ করা হয়েছে');
    fcLoadContents();
  } catch(err){ if(err.message!=='unauthorized') showToast('ব্যর্থ হয়েছে'); }
}

async function fcDeleteContent(id){
  try{
    await fcApiFetch(`/admin/contents/${id}`, {method:'DELETE'});
    showToast('মুছে ফেলা হয়েছে');
    fcLoadContents();
  } catch(err){ if(err.message!=='unauthorized') showToast('ব্যর্থ হয়েছে'); }
}

function showDash(role){
  go('dashboard');
  ['student','teacher','publisher','seller','admin'].forEach(r=>{
    const el=document.getElementById('hub-'+r);
    if(el) el.style.display='none';
    const btn=document.getElementById('dhub-'+r);
    if(btn) btn.classList.remove('on');
  });
  const t=document.getElementById('hub-'+role);
  if(t) t.style.display='block';
  const b=document.getElementById('dhub-'+role);
  if(b) b.classList.add('on');
  if(role==='teacher') setTimeout(renderTeacherDashboard, 80); // IMPROVEMENT 6
}

// ══════════════════════════════════════════════════════
// 👩‍🏫 IMPROVEMENT 6: Teacher Income & Payout System
// ══════════════════════════════════════════════════════
const TeacherLedger=(function(){
  const KEY='eeh_teacher_ledger';
  function load(){try{return JSON.parse(localStorage.getItem(KEY)||'{"earned":24500,"withdrawn":5000,"students":12,"courses":3,"transactions":[]}');}catch(e){return{earned:24500,withdrawn:5000,students:12,courses:3,transactions:[]};}}
  function save(d){try{localStorage.setItem(KEY,JSON.stringify(d));}catch(e){}}
  return{
    get(){return load();},
    addTransaction(tx){const d=load();d.transactions.unshift({...tx,ts:Date.now()});if(d.transactions.length>20)d.transactions.pop();save(d);},
    withdraw(amount){const d=load();d.withdrawn=(d.withdrawn||0)+amount;save(d);}
  };
})();

function renderTeacherDashboard(){
  const d=TeacherLedger.get();
  const pending=Math.max(0,(d.earned||0)-(d.withdrawn||0));
  const fmt=n=>'৳'+Number(n||0).toLocaleString();
  const el=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  el('t-total-earned',fmt(d.earned));
  el('t-pending',fmt(pending));
  el('t-students',d.students);
  el('t-courses',d.courses);
  const list=document.getElementById('t-tx-list');
  if(!list)return;
  const seeds=[
    {type:'income',label:'BCS Batch — ৩০ জন ভর্তি',amount:9000,ts:Date.now()-86400000*2},
    {type:'income',label:'ব্যাংক মাস্টারক্লাস — ১৫ জন',amount:5250,ts:Date.now()-86400000*5},
    {type:'payout',label:'বিকাশ পেআউট',amount:-5000,ts:Date.now()-86400000*8},
  ];
  const all=[...(d.transactions||[]),...seeds].sort((a,b)=>b.ts-a.ts).slice(0,8);
  list.innerHTML=all.map(tx=>`
    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);">
      <div><div style="font-weight:600;font-size:.78rem;">${tx.label}</div><div style="font-size:.66rem;color:var(--text3);">${new Date(tx.ts).toLocaleDateString()}</div></div>
      <div style="font-weight:700;color:${tx.amount>0?'var(--green)':'var(--red)'};">${tx.amount>0?'+':''}৳${Math.abs(tx.amount).toLocaleString()}</div>
    </div>`).join('')||'<div style="color:var(--text3);">কোনো লেনদেন নেই</div>';
}

function teacherRequestPayout(){
  const method=document.getElementById('t-payout-method')?.value;
  const account=document.getElementById('t-account')?.value?.trim();
  const amount=parseFloat(document.getElementById('t-amount')?.value||'0');
  if(!account){showToast('একাউন্ট নম্বর দিন');return;}
  if(amount<500){showToast('সর্বনিম্ন পেআউট পরিমাণ ৳৫০০');return;}
  const label={bkash:'বিকাশ',nagad:'নগদ',bank:'ব্যাংক',rocket:'রকেট'}[method]||method;
  TeacherLedger.addTransaction({type:'payout',label:`${label} পেআউট (${account})`,amount:-amount});
  TeacherLedger.withdraw(amount);
  document.getElementById('t-amount').value='';
  document.getElementById('t-account').value='';
  renderTeacherDashboard();
  showToast(`✅ ৳${amount.toLocaleString()} পেআউট অনুরোধ পাঠানো হয়েছে — ${label}-এ ৩-৫ কার্যদিবসে পাবেন`);
}

// ══════════════════════════════════════════════════════
// 🤖 IMPROVEMENT 7: Gemini AI Tutor Integration
// Falls back to rule-based response if API key not set
// ══════════════════════════════════════════════════════
const GEMINI_API_KEY = window.GEMINI_API_KEY || ''; // set GEMINI_API_KEY on window before this script loads
const GEMINI_MODEL   = 'gemini-1.5-flash';

async function geminiAsk(userMsg, systemPrompt=''){
  if(!GEMINI_API_KEY) return null; // fall through to rule-based
  try{
    const res = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`,
      { method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          systemInstruction: systemPrompt ? {parts:[{text:systemPrompt}]} : undefined,
          contents:[{role:'user',parts:[{text:userMsg}]}],
          generationConfig:{maxOutputTokens:800, temperature:0.7}
        })
      }
    );
    const data = await res.json();
    return data?.candidates?.[0]?.content?.parts?.[0]?.text || null;
  }catch(e){ console.warn('Gemini error:',e); return null; }
}

// Wrap the existing AI Tutor send function to use Gemini when available
(function(){
  const SYSTEM_PROMPT = `তুমি Effective Education Hub-এর AI Tutor। বাংলা ও ইংরেজি উভয় ভাষায় সাহায্য কর। BCS, Bank Job, HSC, SSC, IELTS এবং উচ্চশিক্ষার প্রশ্নের স্পষ্ট, ব্যাখ্যাসহ উত্তর দাও। উত্তর সংক্ষিপ্ত কিন্তু সম্পূর্ণ রাখো।`;

  // Hook into any existing aiSend / sendAIMessage function
  const _origAISend = window.aiSend || window.sendAIMessage || null;
  window.geminiEnhancedAISend = async function(msg, outputElId){
    const out = document.getElementById(outputElId);
    if(out) out.innerHTML = '<span style="color:var(--text3);">⏳ উত্তর তৈরি হচ্ছে…</span>';
    const reply = await geminiAsk(msg, SYSTEM_PROMPT);
    if(reply){
      if(out) out.innerHTML = escapeHtml(reply).replace(/\n/g,'<br>');
      return reply;
    }
    // Fallback: call original rule-based function
    if(_origAISend) return _origAISend(msg, outputElId);
    if(out) out.innerHTML = 'AI Tutor সক্রিয় করতে GEMINI_API_KEY সেট করুন।';
  };
})();
