// ══════════════════════════════════════════════════════
// 📱 IMPROVEMENT 2: IndexedDB Offline Exam State
// Saves exam answers every 5s — survives page reload,
// network loss, browser crash. Auto-restores on next visit.
// ══════════════════════════════════════════════════════
const ExamIDB = (function(){
  const DB_NAME = 'eeh_exam_offline', DB_VER = 1, STORE = 'exam_state';
  let db = null;

  function open(){
    return new Promise((res, rej) => {
      if(db){ res(db); return; }
      const req = indexedDB.open(DB_NAME, DB_VER);
      req.onupgradeneeded = e => e.target.result.createObjectStore(STORE, {keyPath:'id'});
      req.onsuccess = e => { db = e.target.result; res(db); };
      req.onerror   = () => rej(req.error);
    });
  }

  async function save(state){
    try{
      const d = await open();
      const tx = d.transaction(STORE,'readwrite');
      tx.objectStore(STORE).put({
        id: 'current',
        examId: state.examId,
        examTitle: state.examTitle,
        current: state.current,
        answers: state.answers,
        timeLeft: state.timeLeft,
        savedAt: Date.now()
      });
    }catch(e){ console.warn('ExamIDB save error', e); }
  }

  async function restore(){
    try{
      const d = await open();
      return new Promise(res => {
        const tx  = d.transaction(STORE,'readonly');
        const req = tx.objectStore(STORE).get('current');
        req.onsuccess = () => res(req.result || null);
        req.onerror   = () => res(null);
      });
    }catch(e){ return null; }
  }

  async function clear(){
    try{
      const d = await open();
      const tx = d.transaction(STORE,'readwrite');
      tx.objectStore(STORE).delete('current');
    }catch(e){}
  }

  return { save, restore, clear };
})();

// Auto-save exam state to IndexedDB every 5 seconds during an active exam
let _examAutoSaveInterval = null;
function examStartAutoSave(){
  if(_examAutoSaveInterval) clearInterval(_examAutoSaveInterval);
  _examAutoSaveInterval = setInterval(()=>{
    if(exState && exState.started) ExamIDB.save(exState);
  }, 5000);
}
function examStopAutoSave(){ if(_examAutoSaveInterval){ clearInterval(_examAutoSaveInterval); _examAutoSaveInterval=null; } ExamIDB.clear(); }

// On page load: check for a saved unfinished exam and offer to restore it
(async function(){
  const saved = await ExamIDB.restore();
  if(!saved) return;
  const age = (Date.now() - saved.savedAt) / 60000; // minutes
  if(age > 120) { ExamIDB.clear(); return; } // older than 2h — discard
  const answered = Object.keys(saved.answers).length;
  if(answered < 1) { ExamIDB.clear(); return; }
  const min = String(Math.floor((saved.timeLeft||0)/60)).padStart(2,'0');
  const sec = String((saved.timeLeft||0)%60).padStart(2,'0');
  setTimeout(()=>{
    if(confirm(`আপনার "${saved.examTitle||saved.examId}" পরীক্ষার অসমাপ্ত অংশ (${answered}টি উত্তর দেওয়া, বাকি সময়: ${min}:${sec}) সংরক্ষিত আছে। ✅ OK = পরীক্ষা চালিয়ে যান | ❌ Cancel = বাতিল করুন`)){
      go('certifications');
      exLaunchMCQ(saved.examId, saved.examTitle);
      setTimeout(()=>{
        exState.answers  = saved.answers;
        exState.current  = saved.current;
        exState.timeLeft = saved.timeLeft;
        exRenderQuestion();
        examStartAutoSave();
        showToast('✅ অসমাপ্ত পরীক্ষা পুনরুদ্ধার করা হয়েছে');
      }, 400);
    } else { ExamIDB.clear(); }
  }, 1500);
})();

// ── Exam state ──
let exState = {
  current: 0,
  questions: [],
  answers: {},
  examId: '',
  examTitle: '',
  timerInterval: null,
  timeLeft: 3600,
  started: false
};

// ── Type switcher ──
function exTypeSwitch(el, type) {
  // Hide all panels
  ['mcq','mcq-live','mcq-result','written','cert','result'].forEach(p => {
    const panel = document.getElementById('exp-'+p);
    if (panel) panel.style.display = 'none';
  });
  // Show correct panel
  const target = document.getElementById('exp-'+type);
  if (target) target.style.display = 'block';
  // Update tabs
  document.querySelectorAll('.ex-type-tab').forEach(t => t.classList.remove('on'));
  if (el) el.classList.add('on');
  // Ensure MCQ tab maps to mcq panel
  if (type === 'mcq') {
    document.getElementById('exp-mcq').style.display = 'block';
  }
}

// ── Category switcher ──
function exCatSwitch(el, cat) {
  document.querySelectorAll('#exCatTabs .aw-tab').forEach(t => t.classList.remove('on'));
  el.classList.add('on');
  // Filter cards
  document.querySelectorAll('#exCardGrid .ex-card').forEach(card => {
    const show = !cat || card.dataset.cat === cat || cat === 'all';
    card.style.display = show ? 'block' : 'none';
  });
}

// ── Launch MCQ ──
function exLaunchMCQ(examId, title) {
  // BUG-01 FIX: clear any running timer before starting a new exam session
  if (window._exState && window._exState.timerInterval) {
    clearInterval(window._exState.timerInterval);
  }
  const questions = EX_QUESTIONS[examId] || EX_QUESTIONS['bcs-bangladesh'];
  exState = { current:0, questions, answers:{}, examId, examTitle:title,
               timerInterval:null, timeLeft:600, started:true };
  window._exState = exState; // expose for guard above
  examStartAutoSave(); // IMPROVEMENT 2: begin IndexedDB auto-save

  document.getElementById('mcqExamTitle').textContent = title;
  // Hide card grid, show live exam
  document.getElementById('exp-mcq').style.display = 'none';
  document.getElementById('exp-mcq-result').style.display = 'none';
  document.getElementById('exp-mcq-live').style.display = 'block';

  exRenderQuestion();
  exBuildDots();
  exStartTimer();
  window.scrollTo({top:0, behavior:'smooth'});
}

function exRenderQuestion() {
  const q = exState.questions[exState.current];
  if (!q) return;
  const total = exState.questions.length;
  const idx   = exState.current;

  document.getElementById('mcqQNum').textContent = `প্রশ্ন ${idx+1}`;
  document.getElementById('mcqQText').textContent = q.q;
  document.getElementById('mcqProgress').textContent = `প্রশ্ন ${idx+1} / ${total}`;
  document.getElementById('mcqProgFill').style.width = `${((idx+1)/total)*100}%`;

  const correct = Object.values(exState.answers).filter(a => {
    const qi = exState.questions.indexOf(exState.questions.find((_,i)=>i===a.qIdx));
    return a.correct;
  }).length;
  document.getElementById('mcqScore').textContent = `সঠিক: ${Object.values(exState.answers).filter(a=>a.correct).length}`;

  // Render options
  const opts = document.getElementById('mcqOptions');
  const labels = ['ক','খ','গ','ঘ'];
  opts.innerHTML = q.opts.map((opt, i) => {
    let cls = 'mcq-opt';
    const saved = exState.answers[idx];
    if (saved !== undefined) {
      if (i === q.ans)      cls += ' correct';
      else if (i === saved.choice) cls += ' wrong';
    }
    return `<button class="${cls}" onclick="mcqSelect(this,${i})" ${saved!==undefined?'disabled':''}><span class="mcq-opt-lbl">${labels[i]}</span><span>${opt}</span></button>`;
  }).join('');

  // Nav buttons
  const prev = document.getElementById('mcqPrev');
  const next = document.getElementById('mcqNext');
  prev.disabled = idx === 0;
  prev.style.opacity = idx === 0 ? '.4' : '1';
  const isLast = idx === total - 1;
  next.textContent = isLast ? '📊 ফলাফল দেখুন' : 'পরবর্তী →';
  next.onclick = isLast ? exShowResult : mcqNext;

  exUpdateDots();
}

function mcqSelect(btn, choiceIdx) {
  const q   = exState.questions[exState.current];
  const idx = exState.current;
  if (exState.answers[idx] !== undefined) return; // already answered

  const correct = choiceIdx === q.ans;
  exState.answers[idx] = { choice: choiceIdx, correct, qIdx: idx };

  // BUG-05 FIX: remove .selected from all sibling options before applying state
  const opts = document.querySelectorAll('#mcqOptions .mcq-opt');
  opts.forEach(b => b.classList.remove('selected'));

  // Update buttons with correct/wrong state
  opts.forEach((b, i) => {
    b.disabled = true;
    if (i === q.ans)       b.classList.add('correct');
    else if (i === choiceIdx) b.classList.add('wrong');
  });

  exUpdateDots();
  if (navigator.vibrate) navigator.vibrate(correct ? [30] : [60, 30, 60]);
}

function mcqNext() {
  if (exState.current < exState.questions.length - 1) {
    exState.current++;
    exRenderQuestion();
  }
}
function mcqPrev() {
  if (exState.current > 0) {
    exState.current--;
    exRenderQuestion();
  }
}

function exBuildDots() {
  const dots = document.getElementById('mcqDots');
  dots.innerHTML = exState.questions.map((_, i) =>
    `<div class="mcq-dot ${i===0?'current':''}" id="dot-${i}" onclick="exState.current=${i};exRenderQuestion()"></div>`
  ).join('');
}

function exUpdateDots() {
  exState.questions.forEach((_, i) => {
    const dot = document.getElementById('dot-'+i);
    if (!dot) return;
    dot.className = 'mcq-dot';
    if (i === exState.current) dot.classList.add('current');
    const ans = exState.answers[i];
    if (ans) dot.classList.add(ans.correct ? 'correct' : 'wrong');
  });
}

function exStartTimer() {
  clearInterval(exState.timerInterval);
  exState.timeLeft = 600; // 10 min demo
  exState.timerInterval = setInterval(() => {
    exState.timeLeft--;
    const m = Math.floor(exState.timeLeft / 60).toString().padStart(2,'0');
    const s = (exState.timeLeft % 60).toString().padStart(2,'0');
    const el = document.getElementById('mcqTimer');
    if (el) el.textContent = `${m}:${s}`;
    if (exState.timeLeft <= 60 && el) el.style.color = 'var(--red)';
    if (exState.timeLeft <= 0) { clearInterval(exState.timerInterval); exShowResult(); }
  }, 1000);
}

function exExitExam() {
  clearInterval(exState.timerInterval);
  examStopAutoSave(); // IMPROVEMENT 2: clear saved state on exit
  document.getElementById('exp-mcq-live').style.display = 'none';
  document.getElementById('exp-mcq').style.display = 'block';
  showToast('পরীক্ষা থেকে বের হলেন');
}

function exShowResult() {
  clearInterval(exState.timerInterval);
  examStopAutoSave(); // IMPROVEMENT 2: clear saved state on completion
  const total    = exState.questions.length;
  const answered = Object.keys(exState.answers).length;
  const correct  = Object.values(exState.answers).filter(a => a.correct).length;
  const pct      = Math.round((correct / total) * 100);

  document.getElementById('exp-mcq-live').style.display = 'none';
  document.getElementById('exp-mcq-result').style.display = 'block';

  document.getElementById('mcqResEmoji').textContent   = pct >= 80 ? '🎉' : pct >= 60 ? '👍' : '📚';
  document.getElementById('mcqResTitle').textContent   = pct >= 80 ? 'চমৎকার ফলাফল!' : pct >= 60 ? 'ভালো চেষ্টা!' : 'আরও পড়াশোনা করুন!';
  document.getElementById('mcqResScore').textContent   = `${correct}/${total}`;
  document.getElementById('mcqResPct').textContent     = `${pct}% সঠিক`;

  // Build free result
  const freeContent = document.getElementById('mcqResFreeContent');
  freeContent.innerHTML = exState.questions.map((q, i) => {
    const ans = exState.answers[i];
    const isCorrect = ans && ans.correct;
    const chosen = ans !== undefined ? q.opts[ans.choice] : 'উত্তর দেননি';
    return `<div class="mcq-ans-item ${isCorrect?'correct':'wrong'}">
      <div class="mcq-ans-q">${i+1}. ${q.q}</div>
      <div class="mcq-ans-row">
        <span>${isCorrect?'✅':'❌'} আপনার উত্তর: ${chosen}</span>
        ${!isCorrect?`<span>✅ সঠিক উত্তর: ${q.opts[q.ans]}</span>`:''}
      </div>
    </div>`;
  }).join('');

  window.scrollTo({top:0, behavior:'smooth'});
}

// ── Written exam ──
function exLaunchWritten(examId, title) {
  document.querySelectorAll('.written-exam-card').forEach(c=>c.style.opacity='.5');
  const box = document.getElementById('writtenExamBox');
  box.style.display = 'block';
  document.getElementById('writtenExamTitle').textContent = title;
  document.getElementById('writtenAIResult').style.display = 'none';
  document.getElementById('writtenAnswer').value = '';
  document.getElementById('wordCount').textContent = '০';

  const questions = {
    'bcs-written-bangla': 'বাংলাদেশের মুক্তিযুদ্ধে নারীদের ভূমিকা আলোচনা করুন। (২০০-৩০০ শব্দ)',
    'bcs-written-english': 'Write an essay on "The Role of Artificial Intelligence in Modern Education". (200-300 words)',
    'ielts-writing': 'Task 2: Some people believe that universities should focus on providing academic skills rather than preparing students for employment. To what extent do you agree or disagree? (250 words)',
    'hsc-bangla': 'বাংলাদেশের প্রাকৃতিক সৌন্দর্য নিয়ে একটি রচনা লিখুন। (২৫০ শব্দ)',
  };
  document.getElementById('writtenQText').textContent = questions[examId] || questions['bcs-written-bangla'];
  box.scrollIntoView({behavior:'smooth', block:'start'});
}

function toggleWrittenInput(type) {
  document.getElementById('writtenAnswer').style.display = type==='text' ? 'block' : 'none';
  document.getElementById('ocrUploadArea').style.display  = type==='ocr'  ? 'block' : 'none';
  document.getElementById('witText').classList.toggle('on', type==='text');
  document.getElementById('witOCR').classList.toggle('on', type==='ocr');
}

function exitWrittenExam() {
  document.getElementById('writtenExamBox').style.display = 'none';
  document.querySelectorAll('.written-exam-card').forEach(c=>c.style.opacity='1');
}

// Word counter
document.addEventListener('DOMContentLoaded', function() {
  const ta = document.getElementById('writtenAnswer');
  if (ta) ta.addEventListener('input', function() {
    const words = this.value.trim().split(/\s+/).filter(w=>w).length;
    const wc = document.getElementById('wordCount');
    if (wc) wc.textContent = words.toLocaleString('bn-BD');
  });
});

async function submitWrittenExam() {
  const answer = document.getElementById('writtenAnswer').value.trim();
  if (answer.length < 20) { showToast('⚠️ অনুগ্রহ করে আপনার উত্তর লিখুন'); return; }

  const resultBox = document.getElementById('writtenAIResult');
  const spinner   = document.getElementById('writtenSpinner');
  const titleEl   = document.getElementById('writtenResultTitle');
  const content   = document.getElementById('writtenResultContent');
  const btn       = document.getElementById('submitWrittenBtn');

  resultBox.style.display = 'block';
  spinner.style.display   = 'inline-block';
  titleEl.textContent     = 'AI মূল্যায়ন চলছে…';
  content.innerHTML       = '';
  btn.disabled            = true;
  resultBox.scrollIntoView({behavior:'smooth'});

  try {
    const response = await fetch((window.VOD_API_BASE||'')+'/ai/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: `You are the Effective EduHub AI Academic Evaluator. Grade this written exam response.

QUESTION: ${document.getElementById('writtenQText').textContent}

STUDENT ANSWER: ${answer}

Grade out of 100 based on: Accuracy (40%), Structure (30%), Conceptual Understanding (30%).
Output ONLY valid JSON, no markdown:
{"score":number,"strengths":["point1","point2"],"weaknesses":["point1","point2"],"constructive_feedback":"string","suggested_topics_to_review":["topic1","topic2"]}`
        }]
      })
    });

    const data = await response.json();
    const text = data.content?.map(c=>c.text||'').join('') || '';
    let result;
    try { result = JSON.parse(text.replace(/```json|```/g,'').trim()); }
    catch(e) { result = null; }

    spinner.style.display = 'none';

    if (result) {
      const scoreColor = result.score >= 80 ? 'var(--green)' : result.score >= 60 ? 'var(--amber)' : 'var(--red)';
      titleEl.textContent = `AI মূল্যায়ন সম্পন্ন — ${result.score}/১০০`;
      content.innerHTML = `
        <div style="text-align:center;padding:16px 0 20px;border-bottom:1px solid var(--border);margin-bottom:16px;">
          <div style="font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:700;color:${scoreColor};">${result.score}<span style="font-size:1.2rem;color:var(--text3);">/১০০</span></div>
          <div style="font-size:.8rem;color:var(--text3);margin-top:4px;">Accuracy 40% + Structure 30% + Conceptual Understanding 30%</div>
        </div>
        <div style="margin-bottom:14px;">
          <div style="font-weight:700;color:var(--green);margin-bottom:8px;">✅ শক্তিশালী দিক</div>
          ${result.strengths.map(s=>`<div class="ai-reco-item">✓ ${escapeHtml(s)}</div>`).join('')}
        </div>
        <div style="margin-bottom:14px;">
          <div style="font-weight:700;color:var(--red);margin-bottom:8px;">⚠️ উন্নতির সুযোগ</div>
          ${result.weaknesses.map(w=>`<div class="ai-reco-item" style="border-color:rgba(196,32,32,.15);">✗ ${escapeHtml(w)}</div>`).join('')}
        </div>
        <div style="margin-bottom:14px;">
          <div style="font-weight:700;color:var(--text);margin-bottom:8px;">💡 পরামর্শ</div>
          <div class="ai-reco-item">${escapeHtml(result.constructive_feedback)}</div>
        </div>
        <div>
          <div style="font-weight:700;color:var(--indigo);margin-bottom:8px;">📚 পর্যালোচনা করুন</div>
          ${result.suggested_topics_to_review.map(t=>`
            <div class="ai-reco-item" style="display:flex;justify-content:space-between;align-items:center;">
              <span>📖 ${escapeHtml(t)}</span>
              <button style="background:var(--indigo);color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:.68rem;cursor:pointer;" onclick="go('academy')">কোর্স দেখুন</button>
            </div>`).join('')}
        </div>
        <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;">
          <button class="btn-outline btn-sm" onclick="showToast('Teacher Review বুকিং হচ্ছে...')">👩‍🏫 Teacher Review নিন</button>
          <button class="btn-gold btn-sm" onclick="exTypeSwitch(document.getElementById('ext-cert'),'cert')">🏅 Certificate দেখুন</button>
        </div>`;
    } else {
      titleEl.textContent = 'মূল্যায়ন সম্পন্ন';
      content.innerHTML = `<div class="ai-reco-item">আপনার উত্তর গ্রহণ করা হয়েছে। বিস্তারিত মূল্যায়নের জন্য Teacher Review বুক করুন।</div>
        <button class="btn-outline btn-sm" style="margin-top:10px;" onclick="showToast('Teacher Review বুকিং হচ্ছে...')">👩‍🏫 Teacher Review নিন</button>`;
    }
  } catch(err) {
    spinner.style.display = 'none';
    titleEl.textContent = 'মূল্যায়ন প্রক্রিয়াকরণ';
    content.innerHTML = `<div class="ai-reco-item">আপনার উত্তর সংরক্ষিত হয়েছে। AI সংযোগ স্থাপিত হলে মূল্যায়ন সম্পন্ন হবে।<br>
      <strong>বিকল্প:</strong> Teacher Review নিন — ৪৮ ঘণ্টার মধ্যে বিস্তারিত ফিডব্যাক পাবেন।</div>
      <button class="btn-gold btn-sm" style="margin-top:10px;" onclick="showToast('Teacher Review বুকিং হচ্ছে...')">👩‍🏫 Teacher Review বুক করুন</button>`;
  }
  btn.disabled = false;
}

