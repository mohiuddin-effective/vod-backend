<!-- ████ KIDS LEARNING WING (Ages 1–10) ████ -->
<div class="page" id="page-kids">
  <div class="breadcrumb"><a onclick="go('home')">হোম</a><span>›</span><span>Kids & Baby World</span></div>
  <section style="padding-top:20px;">
    <div class="wrap">

      <div class="kw-lang-bar" role="tablist" aria-label="Language">
        <span class="kw-lang-label">🌐</span>
        <button class="kw-lang-btn on" id="kwLangBtn-bn" onclick="setKidsLang('bn')">বাংলা</button>
        <button class="kw-lang-btn" id="kwLangBtn-en" onclick="setKidsLang('en')">English</button>
        <button class="kw-lang-btn" id="kwLangBtn-ar" onclick="setKidsLang('ar')">العربية</button>
        <span class="kw-stars-display" id="kwStarsDisplay" title="মোট অর্জিত স্টার">⭐ <span id="kwStarsCount">0</span></span>
      </div>

      <div class="kw-hero" id="kwHero">
        <div>
          <span class="kw-hero-badge" data-i18n="hero_badge">🌟 Ultimate Early Learning Ecosystem</span>
          <h1 class="kw-hero-title" data-i18n="hero_title">Effective Kids & Baby World</h1>
          <p class="kw-hero-sub" data-i18n="hero_sub">প্লে-গ্রুপ থেকে ৫ম শ্রেণী — Phonics, Tracing, CVC, Math ও নীতিশিক্ষার সবচেয়ে বর্ণিল অভিজ্ঞতা। প্রতিটি অ্যাক্টিভিটি শেষে Gold Coin রিওয়ার্ড!</p>
        </div>
        <button class="btn-kw-primary" onclick="toggleKidsPlayMode()" id="kwPlayModeBtn" data-i18n="hero_btn">Play & Learn Mode 🎮</button>
      </div>

      <div class="kw-age-tabs" role="tablist" aria-label="বয়স অনুযায়ী ফিল্টার">
        <button class="kw-age-tab on" onclick="filterKidsAge('all',this)" data-i18n="age_all">🌈 সব বয়স</button>
        <button class="kw-age-tab" onclick="filterKidsAge('baby',this)" data-i18n="age_baby">👶 Baby (১–৩ বছর)</button>
        <button class="kw-age-tab" onclick="filterKidsAge('pre',this)" data-i18n="age_pre">🧒 Pre-School (৩–৫ বছর)</button>
        <button class="kw-age-tab" onclick="filterKidsAge('primary',this)" data-i18n="age_primary">🎒 Primary (৬–১০ বছর)</button>
      </div>

      <div class="kw-module-grid" id="kwModuleGrid">
        <div class="kw-card kw-red" data-age="pre" onclick="openKidsModule('phonics')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('phonics')">
          <div class="kw-badge">Pre-K & K</div>
          <div class="kw-icon">🔊</div>
          <h3 data-i18n="t_phonics">Phonics & Pronunciation</h3>
          <p data-i18n="d_phonics">Letter Sounds, Blends, Digraphs — ট্যাপ করলেই উচ্চারণ শুনবে।</p>
          <div class="kw-star-badge" id="kwStar-phonics"></div>
        </div>
        <div class="kw-card kw-blue" data-age="pre" onclick="openKidsModule('tracing')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('tracing')">
          <div class="kw-badge">Ages ২–৬</div>
          <div class="kw-icon">✍️</div>
          <h3 data-i18n="t_tracing">Alphabet & Tracing</h3>
          <p data-i18n="d_tracing">বাংলা ও ইংরেজি বর্ণমালা চেনা এবং টাচ ট্রেসিং চর্চা।</p>
          <div class="kw-star-badge" id="kwStar-tracing"></div>
        </div>
        <div class="kw-card kw-green" data-age="pre" onclick="openKidsModule('cvc')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('cvc')">
          <div class="kw-badge">K & Class 1</div>
          <div class="kw-icon">🧩</div>
          <h3 data-i18n="t_cvc">CVC & Sight Words</h3>
          <p data-i18n="d_cvc">৩-অক্ষরের শব্দ বানান, স্বরবর্ণ ও পঠন দক্ষতা।</p>
          <div class="kw-star-badge" id="kwStar-cvc"></div>
        </div>
        <div class="kw-card kw-orange" data-age="primary" onclick="openKidsModule('math')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('math')">
          <div class="kw-badge">Ages ৩–১০</div>
          <div class="kw-icon">🔢</div>
          <h3 data-i18n="t_math">Numbers & Math Fun</h3>
          <p data-i18n="d_math">১-১০০ গণনা, নামতা, যোগ-বিয়োগ ও শেপস গেম।</p>
          <div class="kw-star-badge" id="kwStar-math"></div>
        </div>
        <div class="kw-card kw-pink" data-age="baby" onclick="openKidsModule('sensory')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('sensory')">
          <div class="kw-badge">Baby (১–৩ বছর)</div>
          <div class="kw-icon">🎨</div>
          <h3 data-i18n="t_sensory">Colors & Sensory</h3>
          <p data-i18n="d_sensory">পশুপাখির ডাক, রঙ চেনা, শেপস এবং ঘুমপাড়ানি গান।</p>
          <div class="kw-star-badge" id="kwStar-sensory"></div>
        </div>
        <div class="kw-card kw-purple" data-age="primary" onclick="openKidsModule('science')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('science')">
          <div class="kw-badge">Class ১–৫</div>
          <div class="kw-icon">🚀</div>
          <h3 data-i18n="t_science">General Science & World</h3>
          <p data-i18n="d_science">সৌরমণ্ডল, উদ্ভিদ, মানবদেহ ও বিশ্ব পরিচয়ের গল্প।</p>
          <div class="kw-star-badge" id="kwStar-science"></div>
        </div>
        <div class="kw-card kw-yellow" data-age="all" onclick="openKidsModule('rhymes')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('rhymes')">
          <div class="kw-badge">All Ages</div>
          <div class="kw-icon">🎵</div>
          <h3 data-i18n="t_rhymes">Animated Rhymes</h3>
          <p data-i18n="d_rhymes">ইংরেজি ও বাংলা ছড়া, অ্যানিমেটেড কার্টুন ভিডিও।</p>
          <div class="kw-star-badge" id="kwStar-rhymes"></div>
        </div>
        <div class="kw-card kw-teal" data-age="all" onclick="openKidsModule('ethics')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('ethics')">
          <div class="kw-badge">Moral Edu</div>
          <div class="kw-icon">🌙</div>
          <h3 data-i18n="t_ethics">আরবি বর্ণমালা, Ethics & Dua</h3>
          <p data-i18n="d_ethics">হিজায়ি হরফ, আদব-কায়দা ও দৈনন্দিন দোয়া — উচ্চারণসহ।</p>
          <div class="kw-star-badge" id="kwStar-ethics"></div>
        </div>
        <div class="kw-card kw-cyan" data-age="primary" onclick="openKidsModule('abacus')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('abacus')">
          <div class="kw-badge">Ages ৫–১০</div>
          <div class="kw-icon">🧮</div>
          <h3 data-i18n="t_abacus">Abacus & Mental Math</h3>
          <p data-i18n="d_abacus">ডিজিটাল অ্যাবাকাস বিডস দিয়ে দ্রুত গণনা শেখা।</p>
          <div class="kw-star-badge" id="kwStar-abacus"></div>
        </div>
        <div class="kw-card kw-indigo" data-age="primary" onclick="openKidsModule('brain')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('brain')">
          <div class="kw-badge">Ages ৪–১০</div>
          <div class="kw-icon">🧠</div>
          <h3 data-i18n="t_brain">Brain Games & Logic</h3>
          <p data-i18n="d_brain">মেমোরি ম্যাচিং গেম দিয়ে স্মৃতিশক্তি ও লজিক চর্চা।</p>
          <div class="kw-star-badge" id="kwStar-brain"></div>
        </div>
        <div class="kw-card kw-lime" data-age="pre" onclick="openKidsModule('worksheets')" tabindex="0" onkeydown="if(event.key==='Enter')openKidsModule('worksheets')">
          <div class="kw-badge">Printable</div>
          <div class="kw-icon">📝</div>
          <h3 data-i18n="t_worksheets">Printable Worksheets</h3>
          <p data-i18n="d_worksheets">ট্রেসিং শিট প্রিন্ট করে অফলাইনেও অনুশীলন করুন।</p>
          <div class="kw-star-badge" id="kwStar-worksheets"></div>
        </div>
      </div>

      <div class="kw-parent-bar">
        <div>
          <h4 data-i18n="parent_title">🔒 Parent & Guardian Zone</h4>
          <p data-i18n="parent_desc">স্ক্রিন টাইম সেট করুন এবং বাচ্চার অগ্রগতির রিপোর্ট দেখুন।</p>
        </div>
        <button class="btn-kw-parent" onclick="openKidsParentModal()">Parent Dashboard খুলুন</button>
      </div>

    </div>
  </section>

  <div class="cross-link-bar">
    <span class="cl-label">সংশ্লিষ্ট রিসোর্স →</span>
    <div class="cl-chip" onclick="go('class5-psc')">📕 Class 5 & PSC প্রস্তুতি</div>
    <div class="cl-chip" onclick="go('class6-prep')">📒 Class 6 প্রস্তুতি</div>
    <div class="cl-chip" onclick="go('academy')">🎓 সব কোর্স দেখুন</div>
  </div>
</div><!-- /page-kids -->

<!-- Kids module detail modal -->
<div id="kwModuleModal" onclick="if(event.target===this)closeKidsModule()">
  <div class="kw-modal-box" role="dialog" aria-modal="true" aria-labelledby="kwModalTitle">
    <button class="kw-modal-close" onclick="closeKidsModule()" aria-label="বন্ধ করুন">✕</button>
    <div id="kwModalBody"><!-- filled by openKidsModule() --></div>
  </div>
</div>

<!-- Parent dashboard modal -->
<div id="kwParentModal" onclick="if(event.target===this)closeKidsParentModal()">
  <div class="kw-modal-box" role="dialog" aria-modal="true" aria-labelledby="kwParentTitle">
    <button class="kw-modal-close" onclick="closeKidsParentModal()" aria-label="বন্ধ করুন">✕</button>
    <h3 id="kwParentTitle" style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;margin-bottom:14px;">🔒 Parent Dashboard</h3>

    <!-- PIN gate: shown when a PIN is already set and not yet verified this session -->
    <div id="kwPinGate" style="display:none;">
      <p style="font-family:'Noto Serif Bengali',serif;font-size:.82rem;color:var(--text2);margin-bottom:10px;">অভিভাবক এলাকায় ঢুকতে ৪-সংখ্যার PIN দিন:</p>
      <input id="kwPinInput" type="password" inputmode="numeric" maxlength="4" placeholder="● ● ● ●" style="width:100%;padding:12px;text-align:center;letter-spacing:10px;font-size:1.2rem;border:1.5px solid var(--border2);border-radius:8px;background:var(--void);color:var(--text);min-height:44px;" onkeydown="if(event.key==='Enter')kwCheckPin()">
      <div id="kwPinError" style="display:none;color:var(--red);font-size:.75rem;margin-top:8px;text-align:center;">ভুল PIN — আবার চেষ্টা করুন</div>
      <button class="btn-teal btn-sm" style="width:100%;margin-top:12px;" onclick="kwCheckPin()">প্রবেশ করুন</button>
    </div>

    <!-- Dashboard content: shown once no PIN is set, or after correct PIN entry -->
    <div id="kwParentContent" style="display:none;">
      <div id="kwPinSetupPrompt" style="display:none;background:var(--gold-dim);border:1px solid rgba(184,109,5,.2);border-radius:var(--r);padding:12px 14px;margin-bottom:16px;">
        <div style="font-size:.78rem;font-weight:700;color:var(--gold);margin-bottom:8px;">🔐 নিরাপত্তার জন্য একটি ৪-সংখ্যার PIN সেট করুন (ঐচ্ছিক)</div>
        <input id="kwPinSetupInput" type="password" inputmode="numeric" maxlength="4" placeholder="৪-সংখ্যার PIN" style="width:100%;padding:9px 12px;border:1.5px solid var(--border2);border-radius:8px;font-size:.9rem;text-align:center;letter-spacing:6px;background:var(--void);color:var(--text);min-height:40px;">
        <button class="btn-gold btn-sm" style="width:100%;margin-top:8px;" onclick="kwSetPin()">PIN সেট করুন</button>
      </div>
      <div style="margin-bottom:18px;">
        <label style="font-size:.8rem;font-weight:600;color:var(--text2);display:block;margin-bottom:6px;">দৈনিক স্ক্রিন টাইম সীমা</label>
        <select id="kwScreenTimeSelect" onchange="setKidsScreenTime(this.value)" style="width:100%;padding:10px 12px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);min-height:44px;">
          <option value="15">১৫ মিনিট</option>
          <option value="30">৩০ মিনিট</option>
          <option value="45">৪৫ মিনিট</option>
          <option value="60">৬০ মিনিট</option>
          <option value="0">সীমাহীন</option>
        </select>
      </div>
      <div style="background:var(--deep);border-radius:var(--r);padding:14px 16px;margin-bottom:14px;">
        <div style="font-size:.78rem;font-weight:700;color:var(--text2);margin-bottom:6px;">⭐ মোট অর্জিত স্টার</div>
        <div id="kwParentStars" style="font-family:'JetBrains Mono',monospace;font-size:1.3rem;font-weight:700;color:var(--gold);">0</div>
      </div>
      <div style="background:var(--deep);border-radius:var(--r);padding:14px 16px;">
        <div style="font-size:.78rem;font-weight:700;color:var(--text2);margin-bottom:10px;">📊 আজকের অগ্রগতি</div>
        <div id="kwProgressSummary" style="font-family:'Noto Serif Bengali',serif;font-size:.85rem;color:var(--text2);">এখনো কোনো অ্যাক্টিভিটি সম্পন্ন হয়নি।</div>
      </div>
      <button class="btn-outline btn-sm" id="kwChangePinBtn" style="width:100%;margin-top:14px;display:none;" onclick="kwChangePin()">🔐 PIN পরিবর্তন করুন</button>
    </div>
  </div>
</div>

<!-- ████ FEED — personalized multi-wing home feed ████ -->
<div class="page" id="page-feed">
  <div class="breadcrumb"><a onclick="go('home')">হোম</a><span>›</span><span>ফিড</span></div>
  <section style="padding-top:16px;">
    <div class="wrap" style="max-width:640px;">

      <div class="fd-header">
        <div>
          <h1 class="fd-title">🌊 আপনার ফিড</h1>
          <p class="fd-sub" id="fdSubtext">সব উইং জুড়ে আপনার জন্য বাছাই করা কনটেন্ট</p>
        </div>
        <div class="fd-header-actions">
          <button class="btn-outline btn-sm" id="fdPrefBtn" onclick="openFeedPrefs()" style="display:none;">🎯 আগ্রহ</button>
          <button class="btn-outline btn-sm" id="fdAuthBtn" onclick="openFeedAuth()">লগইন</button>
        </div>
      </div>

      <div id="fdList" class="fd-list"></div>
      <div id="fdLoading" style="text-align:center;padding:24px;color:var(--text3);font-size:.85rem;">লোড হচ্ছে…</div>
      <div id="fdEnd" style="display:none;text-align:center;padding:24px;color:var(--text3);font-size:.82rem;">🎉 আপাতত এই পর্যন্তই — নতুন কনটেন্ট এলে আবার দেখাবে!</div>
      <div id="fdSentinel" style="height:4px;"></div>
    </div>
  </section>
</div>

<!-- Feed auth modal: Login / Register tabs -->
<div id="fdAuthModal" onclick="if(event.target===this)closeFeedAuth()">
  <div class="kw-modal-box" role="dialog" aria-modal="true" style="max-width:380px;">
    <button class="kw-modal-close" onclick="closeFeedAuth()" aria-label="বন্ধ করুন">✕</button>
    <div class="fd-auth-tabs">
      <button class="fd-auth-tab on" id="fdTabLogin" onclick="fdSwitchAuthTab('login')">লগইন</button>
      <button class="fd-auth-tab" id="fdTabRegister" onclick="fdSwitchAuthTab('register')">নতুন অ্যাকাউন্ট</button>
    </div>
    <div id="fdAuthError" style="display:none;color:var(--red);font-size:.76rem;margin:10px 0;text-align:center;"></div>

    <div id="fdLoginForm">
      <input id="fdLoginEmail" type="email" placeholder="Email" style="width:100%;padding:10px 13px;margin-top:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);">
      <input id="fdLoginPass" type="password" placeholder="Password" style="width:100%;padding:10px 13px;margin-top:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);" onkeydown="if(event.key==='Enter')fdLogin()">
      <button class="btn-gold" style="width:100%;margin-top:14px;" onclick="fdLogin()" id="fdLoginBtn">লগইন করুন</button>
    </div>

    <div id="fdRegisterForm" style="display:none;">
      <input id="fdRegName" type="text" placeholder="নাম" style="width:100%;padding:10px 13px;margin-top:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);">
      <input id="fdRegEmail" type="email" placeholder="Email" style="width:100%;padding:10px 13px;margin-top:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);">
      <input id="fdRegPass" type="password" placeholder="Password (কমপক্ষে ৬ অক্ষর)" style="width:100%;padding:10px 13px;margin-top:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);" onkeydown="if(event.key==='Enter')fdRegister()">
      <button class="btn-teal" style="width:100%;margin-top:14px;" onclick="fdRegister()" id="fdRegBtn">অ্যাকাউন্ট তৈরি করুন</button>
    </div>
  </div>
</div>

<!-- Feed preferences modal: interests + preferred wings -->
<div id="fdPrefModal" onclick="if(event.target===this)closeFeedPrefs()">
  <div class="kw-modal-box" role="dialog" aria-modal="true" style="max-width:420px;">
    <button class="kw-modal-close" onclick="closeFeedPrefs()" aria-label="বন্ধ করুন">✕</button>
    <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;margin-bottom:6px;">🎯 আপনার আগ্রহ</h3>
    <p style="font-family:'Noto Serif Bengali',serif;font-size:.78rem;color:var(--text3);margin-bottom:14px;">এগুলো অনুযায়ী আপনার ফিড সাজানো হবে।</p>

    <label style="font-size:.78rem;font-weight:600;color:var(--text2);display:block;margin-bottom:6px;">ইন্টারেস্ট ট্যাগ (কমা দিয়ে আলাদা করুন)</label>
    <input id="fdInterestsInput" type="text" placeholder="যেমন: bcs, physics, ielts" style="width:100%;padding:10px 13px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);margin-bottom:14px;">

    <label style="font-size:.78rem;font-weight:600;color:var(--text2);display:block;margin-bottom:8px;">পছন্দের উইং</label>
    <div class="fd-wing-check" id="fdWingChecks">
      <label><input type="checkbox" value="academy">🎓 Academy</label>
      <label><input type="checkbox" value="kids">🧸 Kids</label>
      <label><input type="checkbox" value="news">📰 News</label>
      <label><input type="checkbox" value="community">👥 Community</label>
      <label><input type="checkbox" value="ai">🤖 AI</label>
    </div>
    <button class="btn-gold" style="width:100%;margin-top:16px;" onclick="fdSavePrefs()">সংরক্ষণ করুন</button>
  </div>
</div>

<!-- First-visit quick registration — name + phone/email only, no password step -->
<div id="qrModal" onclick="if(event.target===this && qrCanSkip())qrSkip()">
  <div class="kw-modal-box" role="dialog" aria-modal="true" style="max-width:400px;">
    <div style="text-align:center;margin-bottom:14px;">
      <div style="font-size:2.2rem;">🌟</div>
      <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.35rem;margin-top:6px;">স্বাগতম Effective Education Hub-এ!</h3>
      <p style="font-family:'Noto Serif Bengali',serif;font-size:.82rem;color:var(--text2);margin-top:6px;">নাম ও ফোন/ইমেইল দিয়ে ৫ সেকেন্ডে শুরু করুন — পাসওয়ার্ড লাগবে না।</p>
    </div>
    <div id="qrError" style="display:none;color:var(--red);font-size:.76rem;margin-bottom:8px;text-align:center;"></div>
    <input id="qrNameInput" type="text" placeholder="আপনার নাম" style="width:100%;padding:11px 13px;margin-bottom:10px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);">
    <input id="qrContactInput" type="text" placeholder="ফোন নম্বর অথবা Email" style="width:100%;padding:11px 13px;margin-bottom:14px;border:1.5px solid var(--border2);border-radius:8px;font-size:.85rem;background:var(--void);color:var(--text);" onkeydown="if(event.key==='Enter')qrSubmit()">
    <button class="btn-gold" style="width:100%;" onclick="qrSubmit()" id="qrSubmitBtn">শুরু করুন 🚀</button>
    <button class="btn-outline btn-sm" style="width:100%;margin-top:8px;" onclick="qrSkip()">এখন না, পরে করবো</button>
  </div>
</div>

<div class="page" id="page-academy">
  <div class="breadcrumb"><a onclick="go('home')">হোম</a><span>›</span><span>Effective Academy</span></div>
  <div class="subpage-hero hs-academy">
    <div class="hs-inner">
      <div>
        <div style="display:inline-flex;align-items:center;gap:7px;background:var(--teal-dim);border:1px solid rgba(0,175,200,.3);border-radius:20px;padding:4px 13px;font-size:.67rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal);margin-bottom:18px;">🎓 Effective Academy</div>
        <div class="hs-title">কঠিন পাঠ,<br><em>সহজ সমাধান</em></div>
        <div class="hs-desc">SSC, HSC, BCS, ব্যাংক, বিশ্ববিদ্যালয় ভর্তি — সকল পরীক্ষার জন্য লাইভ ও রেকর্ডেড কোর্স।</div>
        <div class="hs-btns"><button class="btn-gold">সকল কোর্স দেখুন</button><button class="btn-outline" onclick="go('ai')">🤖 AI Tutor</button></div>
      </div>
      <div class="hs-stat-grid">
        <div class="hs-stat-box"><div class="hs-stat-n">৮০+</div><div class="hs-stat-l">কোর্স</div></div>
        <div class="hs-stat-box"><div class="hs-stat-n">৫০,০০০+</div><div class="hs-stat-l">শিক্ষার্থী</div></div>
        <div class="hs-stat-box"><div class="hs-stat-n">৫০০+</div><div class="hs-stat-l">টিচার</div></div>
        <div class="hs-stat-box"><div class="hs-stat-n">৯৫%</div><div class="hs-stat-l">পাসের হার</div></div>
      </div>
    </div>
  </div>
  <!-- ══════════════════════════════════════════════════
       12 ACADEMY WINGS — Full Curriculum Explorer
  ══════════════════════════════════════════════════ -->
  <section style="background:var(--card);border-bottom:1px solid var(--border);padding-top:36px;">
