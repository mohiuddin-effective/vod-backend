// 🔗 PATCH openArticle → wire comments + action bar
// ══════════════════════════════════════════════════════
const _prevOpenArticle = openArticle;
openArticle = function(id){
  currentArticleId = id;
  _prevOpenArticle(id);
  const content = document.getElementById('newsModalContent');
  if(content){
    // Remove stale action row if present
    content.querySelector('.art-actions')?.remove();
    const div = document.createElement('div');
    div.className = 'art-actions';
    div.style.cssText = 'margin-top:28px;padding-top:16px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;';
    div.innerHTML = `
      <button class="btn-gold btn-sm" onclick="showToast('শেয়ার লিঙ্ক কপি হয়েছে!')">🔗 শেয়ার</button>
      <button class="btn-outline btn-sm" onclick="showToast('সংরক্ষিত!')">🔖 সেভ</button>
      <button class="btn-outline btn-sm" onclick="closeArticle();go('academy')">🎓 সংশ্লিষ্ট কোর্স</button>
      <button class="btn-outline btn-sm" onclick="closeArticle();go('careers')">💼 সংশ্লিষ্ট চাকরি</button>`;
    content.appendChild(div);
  }
  setTimeout(()=>renderComments(id), 60);
};

