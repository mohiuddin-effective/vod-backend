    <button class="jn-rc"    id="jrc-teacher"   onclick="jnRole('teacher')">  <span class="jn-rc-ico" style="background:linear-gradient(135deg,#065F46,#059669)">👩‍🏫</span><span class="jn-rc-name">Teacher</span><span class="jn-rc-sub">শিক্ষক / টিউটর</span></button>
    <button class="jn-rc"    id="jrc-guardian"  onclick="jnRole('guardian')"> <span class="jn-rc-ico" style="background:linear-gradient(135deg,#92400E,#D97706)">👨‍👩‍👧</span><span class="jn-rc-name">Guardian</span><span class="jn-rc-sub">অভিভাবক</span></button>
    <button class="jn-rc"    id="jrc-institution" onclick="jnRole('institution')"><span class="jn-rc-ico" style="background:linear-gradient(135deg,#1E40AF,#3B82F6)">🏫</span><span class="jn-rc-name">Institution</span><span class="jn-rc-sub">প্রতিষ্ঠান</span></button>
    <button class="jn-rc"    id="jrc-researcher" onclick="jnRole('researcher')"><span class="jn-rc-ico" style="background:linear-gradient(135deg,#4C1D95,#7C3AED)">🔬</span><span class="jn-rc-name">Researcher</span><span class="jn-rc-sub">গবেষক</span></button>
    <button class="jn-rc"    id="jrc-author"    onclick="jnRole('author')">   <span class="jn-rc-ico" style="background:linear-gradient(135deg,#881337,#E11D48)">✍️</span><span class="jn-rc-name">Author</span><span class="jn-rc-sub">লেখক / প্রকাশক</span></button>
    <button class="jn-rc"    id="jrc-seller"    onclick="jnRole('seller')">   <span class="jn-rc-ico" style="background:linear-gradient(135deg,#78350F,#CA8A04)">🛒</span><span class="jn-rc-name">Seller</span><span class="jn-rc-sub">বিক্রেতা · Mart</span></button>
    <button class="jn-rc"    id="jrc-recruiter" onclick="jnRole('recruiter')"><span class="jn-rc-ico" style="background:linear-gradient(135deg,#064E3B,#0F766E)">💼</span><span class="jn-rc-name">Recruiter</span><span class="jn-rc-sub">নিয়োগকর্তা</span></button>
