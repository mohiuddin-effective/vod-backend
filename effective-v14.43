})();

// ══════════════════════════
// 📋 APPLICATION TRACKER
// ══════════════════════════
const TRACKER_COLS = [
  {key:'plan',   label:'প্রস্তুতি চলছে',      dot:'var(--text3)'},
  {key:'sop',    label:'SOP লেখা হচ্ছে',       dot:'var(--gold)'},
  {key:'applied',label:'আবেদন করা হয়েছে',     dot:'var(--blue)'},
  {key:'interview',label:'ইন্টারভিউ',          dot:'var(--purple)'},
  {key:'offer',  label:'অফার পাওয়া ✅',        dot:'var(--green)'},
];

let trackerApps = [
  {id:1, uni:'MIT',       prog:'PhD — CS',          dl:'2025-12-15', status:'plan'},
  {id:2, uni:'Stanford',  prog:'MS — AI',            dl:'2026-01-05', status:'plan'},
  {id:3, uni:'Oxford',    prog:'MSc — Economics',    dl:'2025-11-30', status:'sop'},
  {id:4, uni:'Toronto',   prog:'MBA',                dl:'',           status:'applied'},
  {id:5, uni:'TU Berlin', prog:'MS — Engineering',   dl:'2025-12-02', status:'interview'},
  {id:6, uni:'NUS',       prog:'PhD — CS',           dl:'',           status:'offer'},
];
let nextAppId = 7;

function renderTracker(){
  const board = document.getElementById('trackerBoard');
  if(!board) return;
  board.innerHTML = TRACKER_COLS.map(col=>{
    const apps = trackerApps.filter(a=>a.status===col.key);
    const cards = apps.map(a=>{
      const isOffer = a.status==='offer';
      const dlHtml = a.status==='applied' ? '<div class="tca-dl safe">✅ Submitted</div>' :
                     a.status==='offer'   ? '<div class="tca-dl" style="color:var(--green);font-weight:700;">🎉 Offer Letter!</div>' :
                     a.dl ? deadlineChip(a.dl) : '';
      return `<div class="tcard-app" style="${isOffer?'border-color:var(--green);background:var(--green-dim);':''}" title="ডিলিট করতে ডাবল ক্লিক করুন" ondblclick="deleteApp(${a.id})">
        <div class="tca-uni">${a.uni}</div><div class="tca-prog">${a.prog}</div>${dlHtml}
        <select onchange="moveApp(${a.id},this.value)" style="margin-top:6px;width:100%;padding:3px 6px;border:1px solid var(--border2);border-radius:5px;font-size:.68rem;font-family:'Outfit',sans-serif;color:var(--text2);background:transparent;cursor:pointer;">
          ${TRACKER_COLS.map(c=>`<option value="${c.key}" ${c.key===a.status?'selected':''}>${c.label}</option>`).join('')}
        </select>
      </div>`;
    }).join('');
    return `<div class="tracker-col">
      <div class="tracker-col-title"><div class="trc-dot" style="background:${col.dot}"></div>${col.label} <span style="margin-left:auto;background:var(--deep);border-radius:10px;padding:1px 7px;font-size:.65rem;font-weight:700;">${apps.length}</span></div>
      ${cards}
    </div>`;
  }).join('');
}

function deadlineChip(dl){
  if(!dl) return '';
  const days = Math.ceil((new Date(dl)-new Date())/(1000*60*60*24));
  if(days<0) return `<div class="tca-dl urgent">⛔ Deadline পার হয়ে গেছে</div>`;
  if(days<=15) return `<div class="tca-dl urgent">⚠️ ${dl} — ${days} দিন বাকি!</div>`;
  return `<div class="tca-dl safe">📅 ${dl}</div>`;
}

function openAddApp(){
  const m = document.getElementById('addAppModal');
  m.style.display = m.style.display==='none' ? 'block' : 'none';
}

function saveApp(){
  const uni = document.getElementById('appUni').value.trim();
  const prog = document.getElementById('appProg').value.trim();
  const dl = document.getElementById('appDL').value;
  const status = document.getElementById('appStatus').value;
  if(!uni || !prog){ showToast('⚠️ বিশ্ববিদ্যালয় ও প্রোগ্রামের নাম দিন'); return; }
  trackerApps.push({id:nextAppId++, uni, prog, dl, status});
  document.getElementById('appUni').value='';
  document.getElementById('appProg').value='';
  document.getElementById('appDL').value='';
  document.getElementById('addAppModal').style.display='none';
  renderTracker();
  showToast(`✅ "${uni}" ট্র্যাকারে যোগ হয়েছে!`);
}

function moveApp(id, newStatus){
  const app = trackerApps.find(a=>a.id===id);
  if(app){ app.status=newStatus; renderTracker(); }
}

function deleteApp(id){
  const app = trackerApps.find(a=>a.id===id);
  if(app && confirm(`"${app.uni}" মুছে ফেলবেন?`)){ trackerApps=trackerApps.filter(a=>a.id!==id); renderTracker(); showToast('🗑️ মুছে ফেলা হয়েছে'); }
}

renderTracker();


