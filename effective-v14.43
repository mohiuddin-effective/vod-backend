const NEWS_TRENDING = [
  {title:'BCS ৪৭তম সিলেবাস PDF ডাউনলোড', cat:'পরীক্ষা'},
  {title:'Fulbright 2026 আবেদন লিঙ্ক ও নির্দেশিকা', cat:'স্কলারশিপ'},
  {title:'IELTS-এ ৭+ পাওয়ার ৫টি কৌশল', cat:'উচ্চশিক্ষা'},
  {title:'বাংলাদেশের সেরা ১০ বিশ্ববিদ্যালয় র‍্যাংকিং ২০২৬', cat:'আন্তর্জাতিক'},
  {title:'AI যুগে চাকরি কোথায় — বিশেষজ্ঞ বিশ্লেষণ', cat:'ক্যারিয়ার'},
];

const NEWS_TAGS = ['BCS','IELTS','Scholarship','PhD','উচ্চশিক্ষা','গবেষণা','AI','EdTech','Fulbright','Erasmus','বিজ্ঞান','পরীক্ষা','ক্যারিয়ার','BUET','ঢাবি'];

let newsCurrentFilter = 'all';
let newsPage = 1;

function renderNewsArticles(filter='all', reset=true){
  const grid = document.getElementById('newsArticleGrid');
  if(!grid) return;
  const filtered = filter==='all' ? NEWS_ARTICLES : NEWS_ARTICLES.filter(a=>a.cat===filter);
  const toShow = filtered.slice(0, newsPage * 5);

  if(reset) grid.innerHTML = '';
  if(filtered.length === 0){
    grid.innerHTML = '<div style="text-align:center;padding:48px;font-family:\'Noto Serif Bengali\',serif;color:var(--text3);">এই বিভাগে কোনো সংবাদ নেই</div>';
    return;
  }

  toShow.forEach(art => {
    const div = document.createElement('div');
    div.className = 'news-article-card';
    div.onclick = () => openArticle(art.id);
    div.innerHTML = `
      <div class="nac-thumb">${art.emoji}</div>
      <div>
        <div class="nac-cat" style="color:${art.catColor};">${art.catLabel}</div>
        <div class="nac-title">${art.title}</div>
        <div class="nac-excerpt">${art.excerpt}</div>
        <div class="nac-meta">
          <span class="nac-author">✍ ${art.author}</span>
          <span>·</span><span>${art.time}</span>
          <span>·</span><span class="nac-read">⏱ ${art.read}</span>
        </div>
      </div>`;
    grid.appendChild(div);
  });

  const btn = document.getElementById('newsLoadMoreBtn');
  if(btn) btn.style.display = toShow.length >= filtered.length ? 'none' : 'inline-block';
}

function renderNewsTrending(){
  const list = document.getElementById('newsTrendingList');
  if(!list) return;
  list.innerHTML = NEWS_TRENDING.map((t,i)=>`
    <div class="news-trending-item" onclick="showToast('\"${t.title}\" লোড হচ্ছে...')">
      <div class="nti-num">${String(i+1).padStart(2,'0')}</div>
      <div><div class="nti-title">${t.title}</div><div style="font-size:.63rem;color:var(--text3);margin-top:2px;">${t.cat}</div></div>
    </div>`).join('');
}

function renderNewsTags(){
  const cloud = document.getElementById('newsTagCloud');
  if(!cloud) return;
  cloud.innerHTML = NEWS_TAGS.map(t=>`<span class="news-tag" onclick="newsTagFilter('${t}')">${t}</span>`).join('');
}

function newsFilter(el, cat){
  newsCurrentFilter = cat;
  newsPage = 1;
  document.querySelectorAll('.fr-bar .fpill').forEach(b=>b.classList.remove('on'));
  if(el) el.classList.add('on');
  renderNewsArticles(cat, true);
}

function newsTagFilter(tag){
  showToast(`🏷️ "${tag}" ট্যাগ ফিল্টার হচ্ছে...`);
}

function loadMoreNews(){
  newsPage++;
  renderNewsArticles(newsCurrentFilter, false);
}

function newsSearch(){
  const q = document.getElementById('newsSearchInput').value.trim();
  if(!q){ showToast('⚠️ কীওয়ার্ড লিখুন'); return; }
  showToast(`🔍 "${q}" খোঁজা হচ্ছে…`);
  setTimeout(()=>{
    const matches = NEWS_ARTICLES.filter(a=> a.title.includes(q)||a.excerpt.includes(q));
    const grid = document.getElementById('newsArticleGrid');
    if(!grid) return;
    if(matches.length){
      newsPage = 1;
      const saved = NEWS_ARTICLES.splice(0);
      renderNewsArticles('all',true);
      // restore but show matches
      grid.innerHTML='';
      matches.forEach(art=>{
        const div=document.createElement('div');div.className='news-article-card';
        div.onclick=()=>openArticle(art.id);
        div.innerHTML=`<div class="nac-thumb">${art.emoji}</div><div><div class="nac-cat" style="color:${art.catColor};">${art.catLabel}</div><div class="nac-title">${art.title}</div><div class="nac-excerpt">${art.excerpt}</div><div class="nac-meta"><span>${art.time}</span><span>·</span><span class="nac-read">⏱ ${art.read}</span></div></div>`;
        grid.appendChild(div);
      });
      showToast(`✅ ${matches.length}টি ফলাফল পাওয়া গেছে`);
    } else {
      showToast('❌ কোনো ফলাফল পাওয়া যায়নি');
    }
  },400);
}

const BLOG_ARTICLES = [
{id:'bcs-prelim-guide',cat:'BCS',title:'৪৭তম BCS পরীক্ষার সম্পূর্ণ গাইডলাইন ও রোডম্যাপ',author:'Mohiuddin স্যার',read:'১০ মিনিট',body:`<h2>৪৭তম বিসিএস প্রিলিমিনারি প্রস্তুতি: সম্পূর্ণ সিলেবাস বিশ্লেষণ ও কৌশল</h2>
<p>বিসিএস প্রিলিমিনারি পরীক্ষা হলো MCQ ভিত্তিক, মোট ২০০ নম্বরের একটি বাছাই পরীক্ষা। প্রতিটি ভুল উত্তরের জন্য নেগেটিভ মার্কিং থাকে, তাই আন্দাজে উত্তর দেওয়া এখানে ঝুঁকিপূর্ণ। প্রিলিমিনারিতে উত্তীর্ণ না হলে লিখিত পরীক্ষায় বসার সুযোগই পাওয়া যায় না।</p>
<h3>বিষয়ভিত্তিক সিলেবাস বিশ্লেষণ</h3>
<p><strong>বাংলা ও ইংরেজি (৭০ নম্বর):</strong> ব্যাকরণ ও rules-based প্রশ্নই বেশি আসে। ইংরেজিতে Grammar rules ও Vocabulary-র উপর জোর দিন।</p>
<p><strong>বাংলাদেশ ও আন্তর্জাতিক বিষয়াবলী (৪০ নম্বর):</strong> সাম্প্রতিক ঘটনাবলী এই অংশে সবচেয়ে গুরুত্বপূর্ণ।</p>
<p><strong>গাণিতিক যুক্তি ও মানসিক দক্ষতা (৩০ নম্বর):</strong> শর্টকাট কৌশল ও নিয়মিত practice জরুরি।</p>
<p><strong>সাধারণ বিজ্ঞান ও কম্পিউটার (৩০ নম্বর):</strong> concept clear করায় জোর দিন।</p>
<p><strong>নৈতিকতা, মূল্যবোধ ও সুশাসন (১৫ নম্বর):</strong> ব্যাখ্যা বোঝাটাই বেশি জরুরি।</p>
<h3>প্রস্তুতির রুটিন</h3>
<p>প্রতি সপ্তাহে ২-৩টি বিষয় নির্দিষ্ট করে পড়ুন। প্রতিদিন আগের দিনের পড়া ১৫-২০ মিনিট রিভাইজ করুন। সপ্তাহে অন্তত ২টি ফুল-লেংথ মডেল টেস্ট দিন, সময় ধরে। প্রতিটি মডেল টেস্টের পর ভুল বিশ্লেষণ করুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>কত মাস প্রস্তুতি নেওয়া উচিত?</strong> সাধারণত ৬-৮ মাসের ধারাবাহিক প্রস্তুতি যথেষ্ট।</p>
<p><strong>নেগেটিভ মার্কিং কীভাবে কাজ করে?</strong> প্রতিটি ভুল উত্তরের জন্য নির্দিষ্ট নম্বর কাটা যায়।</p>
<p><strong>কাজের পাশাপাশি প্রস্তুতি সম্ভব কি?</strong> হ্যাঁ, সঠিক সময় ব্যবস্থাপনার মাধ্যমে সম্ভব।</p>`},
{id:'ssc-guide',cat:'HSC/SSC',title:'ক্লাস ৯-১০ এর জন্য SSC পরীক্ষার সম্পূর্ণ প্রস্তুতি গাইড',author:'ফারহানা বেগম',read:'৭ মিনিট',body:`<h2>ক্লাস ৯-১০ এর জন্য SSC পরীক্ষার সম্পূর্ণ প্রস্তুতি গাইড</h2>
<p>SSC পরীক্ষা মূলত নবম ও দশম শ্রেণির দুই বছরের সিলেবাসের সমন্বয়ে হয়। সৃজনশীল ও বহুনির্বাচনী — দুই ধরনের প্রশ্নের সাথেই পরিচিত হওয়া জরুরি।</p>
<h3>বিষয়ভিত্তিক প্রস্তুতি কৌশল</h3>
<p><strong>বাংলা:</strong> সৃজনশীল প্রশ্নের উত্তর কাঠামো বারবার অনুশীলন করুন।</p>
<p><strong>ইংরেজি:</strong> Grammar rules ও Seen/Unseen Passage-এ প্রতিদিন সময় দিন।</p>
<p><strong>গণিত:</strong> প্রতিটি ধরনের অংক বারবার করে হাত মকশো করুন।</p>
<p><strong>বিজ্ঞান বিষয়সমূহ:</strong> ডায়াগ্রাম ও পরীক্ষামূলক অংশ আলাদাভাবে গুরুত্ব দিন।</p>
<h3>দৈনিক রুটিন</h3>
<p>প্রতিদিন ৩-৪টি বিষয় ভাগ করে পড়ুন। প্রতি সপ্তাহে অন্তত একটি বিষয়ের মডেল টেস্ট দিন।</p>
<h3>পরীক্ষার আগের শেষ প্রস্তুতি</h3>
<p>শেষ ২-৩ সপ্তাহে নতুন কিছু না শিখে রিভিশন করুন। প্রতিটি বিষয়ের সংক্ষিপ্ত নোট তৈরি করে রাখুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>সৃজনশীল ও MCQ-এর জন্য আলাদা প্রস্তুতি দরকার কি?</strong> হ্যাঁ, দুটোর ধরন ভিন্ন।</p>
<p><strong>প্রতিদিন কত ঘণ্টা পড়া উচিত?</strong> প্রতিদিন ৩-৪ ঘণ্টা মনোযোগ দিয়ে পড়াই যথেষ্ট।</p>`},
{id:'bcs-math-shortcuts',cat:'BCS',title:'বিসিএস প্রিলিমিনারি গণিত শর্টকাট কৌশল',author:'রাফি হাসান',read:'৬ মিনিট',body:`<h2>বিসিএস প্রিলিমিনারি গণিত শর্টকাট কৌশল</h2>
<p>প্রিলিমিনারিতে প্রতিটি প্রশ্নের জন্য গড়ে ৩৬ সেকেন্ডেরও কম সময় থাকে। তাই মৌলিক ধারণা ঠিক রেখে দ্রুত সমাধানের কৌশল রপ্ত করা জরুরি।</p>
<h3>সংখ্যাতত্ত্ব ও গড়-সংক্রান্ত শর্টকাট</h3>
<p>গড় নির্ণয়ে "বিচ্যুতি পদ্ধতি" ব্যবহার করলে বড় সংখ্যার হিসাব দ্রুত করা যায়।</p>
<h3>শতকরা ও লাভ-ক্ষতির শর্টকাট</h3>
<p>শতকরা হিসাবে ভগ্নাংশ রূপান্তর (২৫% = ১/৪, ৩৩.৩৩% = ১/৩) মুখস্থ রাখলে দ্রুত উত্তর বের করা যায়।</p>
<h3>সময়-দূরত্ব ও কাজ-সংক্রান্ত শর্টকাট</h3>
<p>দূরত্ব = গতিবেগ × সময় থেকে সরাসরি অনুপাত ব্যবহার করলে জটিল সমীকরণ তৈরির দরকার হয় না।</p>
<h3>অনুশীলনের সঠিক পদ্ধতি</h3>
<p>প্রতিদিন অন্তত ২০-৩০টি মিশ্র অংক সময় ধরে সমাধান করার অভ্যাস করুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>শর্টকাট শেখার আগে মৌলিক নিয়ম জানা কি জরুরি?</strong> হ্যাঁ, মৌলিক ধারণা পরিষ্কার না থাকলে ভুল হওয়ার সম্ভাবনা বেশি।</p>`},
{id:'bank-resources',cat:'ব্যাংক জব',title:'ব্যাংক জব প্রিলিমিনারি প্রস্তুতির জন্য সেরা বই ও রিসোর্স',author:'সাবিনা ইসলাম',read:'৬ মিনিট',body:`<h2>ব্যাংক জব প্রিলিমিনারি প্রস্তুতির জন্য সেরা বই ও রিসোর্স</h2>
<p>সরকারি ও বেসরকারি ব্যাংকের নিয়োগ পরীক্ষা সাধারণত MCQ ভিত্তিক প্রিলিমিনারি ও পরবর্তীতে লিখিত ধাপে হয়ে থাকে।</p>
<h3>বিষয়ভিত্তিক রিসোর্স নির্বাচন</h3>
<p>একাধিক বই না কিনে প্রতিটি বিষয়ের জন্য একটি প্রমাণিত মূল বই বেছে নিন।</p>
<h3>প্রশ্নব্যাংক সমাধানের গুরুত্ব</h3>
<p>গত কয়েক বছরের প্রশ্ন সমাধান করলে প্রশ্নের ধরন সম্পর্কে স্পষ্ট ধারণা পাওয়া যায়।</p>
<h3>সময় ব্যবস্থাপনার কৌশল</h3>
<p>প্রথমে সহজ প্রশ্নগুলো সমাধান করে পরে কঠিন প্রশ্নে ফেরত আসার কৌশল অবলম্বন করুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>ইংরেজি প্রস্তুতি কতটা জরুরি?</strong> অত্যন্ত জরুরি — Grammar ও Vocabulary অংশে নিয়মিত প্রশ্ন আসে।</p>`},
{id:'ielts-writing',cat:'IELTS',title:'IELTS Writing Task 2-এ Band 7 পাওয়ার কৌশল',author:'ফারহানা বেগম',read:'৮ মিনিট',body:`<h2>IELTS Writing Task 2-এ Band 7 পাওয়ার কৌশল</h2>
<p>IELTS Writing Task 2 চারটি মানদণ্ডে মূল্যায়ন করা হয়: Task Response, Coherence and Cohesion, Lexical Resource, এবং Grammatical Range and Accuracy।</p>
<h3>প্রবন্ধের কাঠামো</h3>
<p>ভূমিকা, দুটি মূল অংশ, এবং উপসংহার — এই চার-প্যারাগ্রাফ কাঠামো সবচেয়ে কার্যকর।</p>
<h3>ভাষা ও শব্দভাণ্ডার</h3>
<p>একই শব্দ বারবার ব্যবহার না করে সমার্থক শব্দ ব্যবহার করুন, তবে স্বাভাবিক প্রয়োগে জোর দিন।</p>
<h3>সময় ব্যবস্থাপনা</h3>
<p>৫ মিনিট পরিকল্পনা, ৩০ মিনিট লেখা, ৫ মিনিট revision — এই কাঠামো সবচেয়ে কার্যকর।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>কত শব্দ লেখা উচিত?</strong> কমপক্ষে ২৫০ শব্দ, তবে ২৮০-৩২০ শব্দ সবচেয়ে নিরাপদ।</p>`},
{id:'hsc-guide',cat:'HSC/SSC',title:'HSC পরীক্ষার রুটিন ও সাবজেক্ট অনুযায়ী প্রস্তুতি কৌশল',author:'মোহাম্মদ আলী',read:'৭ মিনিট',body:`<h2>HSC পরীক্ষার রুটিন ও সাবজেক্ট অনুযায়ী প্রস্তুতি কৌশল</h2>
<p>HSC পর্যায়ে বিষয়বস্তুর গভীরতা ও বিশ্লেষণী ক্ষমতার চাহিদা SSC-র তুলনায় বেশি।</p>
<h3>বিজ্ঞান বিভাগের কৌশল</h3>
<p>পদার্থবিজ্ঞান ও রসায়নে সংখ্যাগত সমস্যা নিয়মিত অনুশীলন জরুরি। জীববিজ্ঞানে ডায়াগ্রাম ভালোভাবে বোঝা থাকলে সুবিধা হয়।</p>
<h3>ব্যবসায় শিক্ষা ও মানবিক বিভাগের কৌশল</h3>
<p>ধারণাভিত্তিক ব্যাখ্যা ও উদাহরণ-সহ উত্তর লেখার অভ্যাস গড়ে তুলুন।</p>
<h3>রুটিন পরিকল্পনা</h3>
<p>প্রতিদিন একটি বিজ্ঞান/গণিতভিত্তিক ও একটি তত্ত্বভিত্তিক বিষয় একসাথে রাখুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>HSC-র পাশাপাশি ভর্তি পরীক্ষার প্রস্তুতি সম্ভব কি?</strong> হ্যাঁ, HSC-র গভীর ধারণা ভর্তি পরীক্ষার ভিত্তি হিসেবেও কাজ করে।</p>`},
{id:'bcs-noncadre',cat:'BCS',title:'বিসিএস নন-ক্যাডার নিয়োগ প্রক্রিয়া: A টু Z গাইড',author:'Mohiuddin স্যার',read:'৫ মিনিট',body:`<h2>বিসিএস নন-ক্যাডার নিয়োগ প্রক্রিয়া: A টু Z গাইড</h2>
<p>বিসিএস পরীক্ষায় উত্তীর্ণ হয়েও ক্যাডার পদে সুযোগ না পেলে মেধাক্রম অনুযায়ী প্রার্থীদের বিভিন্ন সরকারি দপ্তরের নন-ক্যাডার পদে সুপারিশ করা হয়।</p>
<h3>আবেদন ও নিয়োগ প্রক্রিয়া</h3>
<p>প্রিলিমিনারি ও লিখিত পরীক্ষায় অংশগ্রহণকারীদের মধ্য থেকেই নন-ক্যাডার পদের জন্য প্রার্থী বাছাই করা হয় — আলাদা আবেদনের প্রয়োজন হয় না।</p>
<h3>প্রস্তুতির কৌশল</h3>
<p>প্রস্তুতির কৌশল মূলত ক্যাডার পদের প্রস্তুতির মতোই।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>আলাদা পরীক্ষা দিতে হয় কি?</strong> না, নিয়মিত পরীক্ষার মাধ্যমেই সুপারিশ করা হয়।</p>`},
{id:'english-grammar',cat:'পাঠ পদ্ধতি',title:'ইংরেজি গ্রামারের বেসিক নিয়মগুলো এক জায়গায়',author:'ফারহানা বেগম',read:'৬ মিনিট',body:`<h2>ইংরেজি গ্রামারের বেসিক নিয়মগুলো এক জায়গায়</h2>
<p>ইংরেজি ব্যাকরণের ভিত্তি হলো Parts of Speech — Noun, Pronoun, Verb, Adjective, Adverb, Preposition, Conjunction, ও Interjection।</p>
<h3>Tense-এর মূল ধারণা</h3>
<p>Present, Past, ও Future — প্রতিটির আবার চারটি করে রূপ থাকে। বাস্তব উদাহরণের মাধ্যমে বুঝলে দীর্ঘমেয়াদে মনে থাকে।</p>
<h3>Subject-Verb Agreement</h3>
<p>বাক্যের Subject Singular না Plural তার উপর Verb-এর রূপ নির্ভর করে।</p>
<h3>সাধারণ ভুলগুলো</h3>
<p>Article ব্যবহারে ভুল, Preposition-এর ভুল প্রয়োগ, এবং Countable/Uncountable Noun গুলিয়ে ফেলা।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>গ্রামার শেখার সবচেয়ে ভালো পদ্ধতি কী?</strong> নিয়ম মুখস্থ করার চেয়ে বাক্যে প্রয়োগ করে অনুশীলন করা বেশি কার্যকর।</p>`},
{id:'scholarship-guide',cat:'IELTS',title:'বিদেশে উচ্চশিক্ষা: স্কলারশিপ খোঁজার সম্পূর্ণ গাইড',author:'মোহাম্মদ আলী',read:'৯ মিনিট',body:`<h2>বিদেশে উচ্চশিক্ষা: স্কলারশিপ খোঁজার সম্পূর্ণ গাইড</h2>
<p>বিদেশে উচ্চশিক্ষার স্কলারশিপ মূলত তিন ধরনের: সম্পূর্ণ বৃত্তি, আংশিক বৃত্তি, এবং টিউশন ফি মওকুফ।</p>
<h3>কোথায় খুঁজবেন</h3>
<p>বিশ্ববিদ্যালয়ের নিজস্ব ওয়েবসাইট, সরকারি বৃত্তি প্রোগ্রাম (Fulbright, Chevening, Erasmus Mundus), এবং International Office।</p>
<h3>আবেদনের প্রস্তুতি</h3>
<p>একটি শক্তিশালী Statement of Purpose (SOP), আপডেটেড CV, এবং ভাষাগত সনদ (IELTS/TOEFL) আগে থেকে প্রস্তুত রাখুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>কখন থেকে প্রস্তুতি শুরু করা উচিত?</strong> ভর্তির লক্ষ্য নির্ধারিত সময়ের অন্তত ১ বছর আগে থেকে।</p>`},
{id:'getting-started',cat:'পাঠ পদ্ধতি',title:'Effective Education Hub-এ কীভাবে ফ্রি ক্লাস শুরু করবেন',author:'Mohiuddin স্যার',read:'৪ মিনিট',body:`<h2>Effective Education Hub-এ কীভাবে ফ্রি ক্লাস শুরু করবেন — নতুনদের গাইড</h2>
<p>Effective Education Hub হলো বাংলাদেশের একটি সম্পূর্ণ শিক্ষা ইকোসিস্টেম, যেখানে ক্লাস ৫ থেকে HSC, বিসিএস, ব্যাংক জব প্রস্তুতি — সবকিছু এক প্ল্যাটফর্মে।</p>
<h3>অ্যাকাউন্ট খোলার ধাপ</h3>
<p>হোমপেজের সাইন-আপ অপশনে গিয়ে মোবাইল নম্বর বা ইমেইল দিয়ে সহজেই অ্যাকাউন্ট তৈরি করা যায়।</p>
<h3>ফ্রি ক্লাসে যোগ দেওয়ার পদ্ধতি</h3>
<p>Academy সেকশনে গিয়ে নিজের ক্লাস বা প্রস্তুতির বিভাগ বেছে নিলে ফ্রি ও পেইড কোর্স দেখা যায়।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>ফ্রি ক্লাসে যোগ দিতে টাকা লাগে কি?</strong> না, ফ্রি কোর্সে কোনো খরচ নেই।</p>`},
{id:'jsc-guide',cat:'HSC/SSC',title:'JSC/JDC পরীক্ষার্থীদের জন্য সহজ পড়াশোনার পরিকল্পনা',author:'রাফি হাসান',read:'৫ মিনিট',body:`<h2>JSC/JDC পরীক্ষার্থীদের জন্য সহজ পড়াশোনার পরিকল্পনা</h2>
<p>JSC/JDC হলো মাধ্যমিক পর্যায়ের প্রথম বড় পরীক্ষা, যা ভবিষ্যতের SSC পরীক্ষার ভিত্তি তৈরি করে।</p>
<h3>বিষয়ভিত্তিক প্রস্তুতি</h3>
<p>পাঠ্যবইয়ের অনুশীলনী ভালোভাবে সমাধান করাই সবচেয়ে বড় প্রস্তুতি।</p>
<h3>সহজ দৈনিক রুটিন</h3>
<p>দিনে ২-৩ ঘণ্টা নির্দিষ্ট সময়ে পড়াশোনা যথেষ্ট। সপ্তাহে একদিন হালকা রিভিশন রাখুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>এই বয়সে কত ঘণ্টা পড়া উচিত?</strong> ২-৩ ঘণ্টা মনোযোগ দিয়ে পড়াই যথেষ্ট।</p>`},
{id:'class5-8-routine',cat:'পাঠ পদ্ধতি',title:'ক্লাস ৫-৮ এর শিক্ষার্থীদের জন্য মাসিক পড়াশোনার রুটিন',author:'ফারহানা বেগম',read:'৫ মিনিট',body:`<h2>ক্লাস ৫-৮ এর শিক্ষার্থীদের জন্য মাসিক পড়াশোনার রুটিন</h2>
<p>এই বয়সে দীর্ঘমেয়াদী চাপের চেয়ে ধারাবাহিক ছোট ছোট লক্ষ্য বেশি কার্যকর।</p>
<h3>সপ্তাহভিত্তিক ভাগ করা</h3>
<p>মাসকে চারটি সপ্তাহে ভাগ করে প্রতি সপ্তাহে একটি বা দুটি নির্দিষ্ট অধ্যায়ের লক্ষ্য রাখুন। শেষ সপ্তাহ রিভিশনের জন্য রাখুন।</p>
<h3>খেলা ও পড়াশোনার ভারসাম্য</h3>
<p>শুধু পড়াশোনায় সীমাবদ্ধ না রেখে খেলাধুলার জন্যও পর্যাপ্ত সময় রাখা জরুরি।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>প্রতিদিন কত সময় পড়া উচিত?</strong> ১.৫-২ ঘণ্টা মনোযোগী পড়াশোনাই যথেষ্ট।</p>`},
{id:'bcs-written',cat:'BCS',title:'বিসিএস রিটেন পরীক্ষার খাতা উপস্থাপনার কৌশল',author:'মোহাম্মদ আলী',read:'৬ মিনিট',body:`<h2>বিসিএস রিটেন পরীক্ষার খাতা উপস্থাপনার কৌশল</h2>
<p>একই মানের জ্ঞান থাকা সত্ত্বেও ভালো উপস্থাপনার কারণে নম্বরে বড় পার্থক্য হতে পারে।</p>
<h3>উত্তরের কাঠামো</h3>
<p>প্রতিটি উত্তরে ভূমিকা, মূল আলোচনা (পয়েন্ট আকারে যেখানে সম্ভব), এবং সংক্ষিপ্ত উপসংহার রাখুন।</p>
<h3>সময় বণ্টন</h3>
<p>প্রতিটি প্রশ্নের জন্য নির্ধারিত সময় মেনে চলুন। খাতা জমার আগে ৫-১০ মিনিট রিভিউ করুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>হাতের লেখা খারাপ হলে সমস্যা হয়?</strong> পরিষ্কার ও পাঠযোগ্য হলেই যথেষ্ট।</p>`},
{id:'bcs-viva',cat:'BCS',title:'বিসিএস ভাইভা বোর্ডে সবচেয়ে বেশি জিজ্ঞাসিত প্রশ্ন ও উত্তর কৌশল',author:'Mohiuddin স্যার',read:'৭ মিনিট',body:`<h2>বিসিএস ভাইভা বোর্ডে সবচেয়ে বেশি জিজ্ঞাসিত প্রশ্ন ও উত্তর কৌশল</h2>
<p>ভাইভা বোর্ড মূলত প্রার্থীর জ্ঞান যাচাইয়ের পাশাপাশি ব্যক্তিত্ব ও আত্মবিশ্বাস মূল্যায়ন করে।</p>
<h3>সাধারণ প্রশ্নের ধরন</h3>
<p>ব্যক্তিগত পরিচিতি, নিজের জেলা, পছন্দের ক্যাডার, সাম্প্রতিক ঘটনা, ও সিদ্ধান্তমূলক পরিস্থিতিভিত্তিক প্রশ্ন।</p>
<h3>উত্তর দেওয়ার কৌশল</h3>
<p>উত্তর না জানলে বিনয়ের সাথে স্বীকার করাই ভালো — অনুমানের ভিত্তিতে ভুল উত্তরের চেয়ে সততা বেশি গুরুত্ব পায়।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>পোশাক-আশাকের গুরুত্ব কতটা?</strong> formal ও পরিপাটি পোশাক প্রথম ধারণা তৈরিতে গুরুত্বপূর্ণ।</p>`},
{id:'bcs-cadre-vs-noncadre',cat:'ক্যারিয়ার',title:'বিসিএস ক্যাডার বনাম নন-ক্যাডার: কোনটি বেছে নেবেন',author:'রাফি হাসান',read:'৫ মিনিট',body:`<h2>বিসিএস ক্যাডার বনাম নন-ক্যাডার: কোনটি বেছে নেবেন</h2>
<p>ক্যাডার পদ সরাসরি নীতিনির্ধারণী ও নির্বাহী দায়িত্বে যুক্ত থাকে, যেখানে নন-ক্যাডার পদগুলো কারিগরি বা প্রশাসনিক সহায়ক ভূমিকায় কাজ করে।</p>
<h3>ক্যারিয়ার গ্রোথের তুলনা</h3>
<p>ক্যাডার পদে সাধারণত পদোন্নতির কাঠামো সুনির্দিষ্ট ও দ্রুত হয়।</p>
<h3>সিদ্ধান্ত নেওয়ার মানদণ্ড</h3>
<p>নিজের আগ্রহ, কর্মস্থলের অবস্থান পছন্দ, এবং দীর্ঘমেয়াদী ক্যারিয়ার লক্ষ্য বিবেচনা করে সিদ্ধান্ত নিন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>নন-ক্যাডার পদ কি সম্মানজনক?</strong> হ্যাঁ, এটিও সরকারি চাকরির স্বীকৃত অংশ।</p>`},
{id:'bank-english',cat:'ব্যাংক জব',title:'ব্যাংক নিয়োগ পরীক্ষার ইংরেজি অংশে ভালো করার উপায়',author:'সাবিনা ইসলাম',read:'৫ মিনিট',body:`<h2>ব্যাংক নিয়োগ পরীক্ষার ইংরেজি অংশে ভালো করার উপায়</h2>
<p>ব্যাংক নিয়োগ পরীক্ষায় ইংরেজি অংশে Grammar, Vocabulary, এবং Comprehension — তিন ধরনের প্রশ্ন থাকে।</p>
<h3>Grammar-ভিত্তিক প্রস্তুতি</h3>
<p>Tense, Subject-Verb Agreement, Preposition, ও Sentence Correction — এই টপিকগুলোতে সবচেয়ে বেশি প্রশ্ন আসে।</p>
<h3>Vocabulary বৃদ্ধির কৌশল</h3>
<p>প্রতিদিন ৫-১০টি নতুন শব্দ শিখে বাক্যে ব্যবহার করার অভ্যাস গড়ে তুলুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>ইংরেজিতে দুর্বল হলে কোথা থেকে শুরু করব?</strong> প্রথমে মৌলিক Grammar rules ঝালাই করুন।</p>`},
{id:'bank-math',cat:'ব্যাংক জব',title:'ব্যাংক জবের গণিত অংশ: সময় বাঁচানোর কৌশল',author:'রাফি হাসান',read:'৫ মিনিট',body:`<h2>ব্যাংক জবের গণিত অংশ: সময় বাঁচানোর কৌশল</h2>
<p>ব্যাংক নিয়োগ পরীক্ষায় গণিত অংশে সাধারণত সময় সবচেয়ে বেশি লাগে।</p>
<h3>দ্রুত হিসাবের কৌশল</h3>
<p>বর্গ ও ঘনের কিছু মৌলিক মান মুখস্থ রাখলে বড় সংখ্যার হিসাব দ্রুত করা যায়।</p>
<h3>অনুশীলনের পদ্ধতি</h3>
<p>প্রতিদিন সময় নির্ধারণ করে ২৫-৩০টি মিশ্র প্রশ্ন সমাধান করুন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>ক্যালকুলেটর ছাড়া দ্রুত হিসাবের উপায় কী?</strong> বর্গ, ঘন ও সাধারণ ভগ্নাংশের মান মুখস্থ রাখা।</p>`},
{id:'math-fear',cat:'পাঠ পদ্ধতি',title:'গণিতের ভীতি দূর করার ৫টি কার্যকর কৌশল',author:'ফারহানা বেগম',read:'৪ মিনিট',body:`<h2>গণিতের ভীতি দূর করার ৫টি কার্যকর কৌশল</h2>
<p>গণিতে একবার কোনো ধারণা অস্পষ্ট থেকে গেলে পরবর্তী প্রতিটি অধ্যায়ে সমস্যা তৈরি হয়, যা ধীরে ধীরে ভীতিতে রূপ নেয়।</p>
<h3>পাঁচটি কার্যকর কৌশল</h3>
<p><strong>১. মৌলিক ধারণায় ফিরে যান।</strong> <strong>২. ছোট ছোট ধাপে অনুশীলন করুন।</strong> <strong>৩. নিয়মিত অল্প সময় দিন।</strong> <strong>৪. ভুল থেকে শিখুন।</strong> <strong>৫. বাস্তব উদাহরণ ব্যবহার করুন।</strong></p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>গণিতভীতি কি সব বয়সেই হতে পারে?</strong> হ্যাঁ, যেকোনো বয়সের মানুষের এটি হতে পারে।</p>`},
{id:'daily-habits',cat:'পাঠ পদ্ধতি',title:'প্রতিদিন কীভাবে পড়াশোনা করলে দ্রুত ফল পাওয়া যায়',author:'মোহাম্মদ আলী',read:'৫ মিনিট',body:`<h2>প্রতিদিন কীভাবে পড়াশোনা করলে দ্রুত ফল পাওয়া যায়</h2>
<p>দীর্ঘ সময় একবারে পড়ার চেয়ে প্রতিদিন অল্প সময় ধারাবাহিকভাবে পড়া মস্তিষ্কে তথ্য দীর্ঘমেয়াদে ধরে রাখতে বেশি সাহায্য করে (Spaced Repetition)।</p>
<h3>কার্যকর দৈনিক অভ্যাস</h3>
<p>পড়া শুরুর আগে লক্ষ্য ঠিক করুন। প্রতি ৪৫-৫০ মিনিট পর ৫-১০ মিনিট বিরতি নিন (Pomodoro পদ্ধতি)।</p>
<h3>মনোযোগ ধরে রাখার কৌশল</h3>
<p>পড়ার সময় মোবাইল ফোন দূরে রাখুন এবং একটি নির্দিষ্ট, শান্ত স্থান বেছে নিন।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>Pomodoro পদ্ধতি কী?</strong> ৪৫-৫০ মিনিট মনোযোগ দিয়ে পড়ে ৫-১০ মিনিট বিরতি নেওয়ার পদ্ধতি।</p>`},
{id:'ielts-listening',cat:'IELTS',title:'IELTS Listening-এ ভালো স্কোর করার সহজ উপায়',author:'ফারহানা বেগম',read:'৫ মিনিট',body:`<h2>IELTS Listening-এ ভালো স্কোর করার সহজ উপায়</h2>
<p>IELTS Listening-এ চারটি অংশ থাকে, ধীরে ধীরে কাঠিন্যের মাত্রা বাড়ে। প্রতিটি অংশ একবারই শোনানো হয়।</p>
<h3>ভালো স্কোরের কৌশল</h3>
<p>অডিও শুরুর আগে প্রশ্নগুলো দ্রুত পড়ে নিন। Keyword-ভিত্তিক শোনার অভ্যাস করুন।</p>
<h3>সাধারণ ভুল যা এড়ানো উচিত</h3>
<p>Spelling ভুল, Word limit অতিক্রম করা, এবং একটি প্রশ্নে আটকে থেকে পরের প্রশ্ন মিস করা।</p>
<h3>প্রায়শই জিজ্ঞাসিত প্রশ্ন</h3>
<p><strong>Listening কতবার শোনানো হয়?</strong> প্রতিটি অংশ একবারই শোনানো হয়।</p>`}
];

function openBlogArticle(id){
  const art = BLOG_ARTICLES.find(a=>a.id===id);
  const content = document.getElementById('blogModalContent');
  const modal = document.getElementById('blogModal');
  if(!modal||!content) return;
  if(art){
    content.innerHTML = `<div class="modal-article">${art.body}<div style="margin-top:28px;padding-top:16px;border-top:1px solid var(--border);display:flex;gap:8px;"><button class="btn-gold btn-sm" onclick="showToast('শেয়ার লিঙ্ক কপি হয়েছে!')">🔗 শেয়ার করুন</button><button class="btn-outline btn-sm" onclick="showToast('সংরক্ষিত হয়েছে!')">🔖 সংরক্ষণ</button></div></div>`;
  } else {
    content.innerHTML = `<div class="modal-article"><h2>নিবন্ধ পাওয়া যায়নি</h2></div>`;
  }
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
}

function closeBlogArticle(){
  const modal = document.getElementById('blogModal');
  if(modal){ modal.style.display='none'; document.body.style.overflow=''; }
}

// ══════════════════════════════════════════════════════
// 🎬 RECORDED CLASS ACCESS CONTROL
// Now wired to the real backend API (see vod-backend/server.js
// implementing the design doc's endpoints exactly). If the API
// isn't deployed/reachable yet, these functions fall back to local
// demo state automatically so the UI still works for preview.
// Set VOD_API_BASE to your deployed backend's URL — currently pointed
// at the live Render deployment. Change this single line if you redeploy elsewhere.
// ══════════════════════════════════════════════════════
const VOD_API_BASE = 'https://effective-education-hub.onrender.com';
const VOD_ACCESS = {
  v1: { access_tier:'batch_only', is_locked:false, unlock_end:null },
  v2: { access_tier:'paid_only',  is_locked:false, unlock_end:null },
  v3: { access_tier:'promo_unlock', is_locked:false, unlock_end:null },
};
let _vodCountdownTimer = null;

// Client-side illustration only — the real check MUST happen server-side
// on every playback-url request. Used as instant UI fallback/preview.
function canAccessDemo(videoId, userBatchId){
  const rule = VOD_ACCESS[videoId];
  if(!rule) return false;
  if(rule.is_locked) return false;
  if(rule.access_tier === 'public') return true;
  if(rule.access_tier === 'promo_unlock'){
    return rule.unlock_end ? (Date.now() < new Date(rule.unlock_end).getTime()) : false;
  }
  if(rule.access_tier === 'batch_only') return userBatchId === rule.access_tier;
  return false; // paid_only would check user_video_access table server-side
}

// Ask the real server whether a student can play a video right now.
// Falls back to canAccessDemo() if the API isn't reachable.
async function checkPlaybackAccess(videoId, userParams){
  if(VOD_API_BASE){
    try{
      const qs = new URLSearchParams(userParams || {}).toString();
      const res = await fetch(`${VOD_API_BASE}/videos/${videoId}/playback-url${qs ? '?'+qs : ''}`);
      const data = await res.json();
      return { allow: res.ok, ...data };
    }catch(e){
      console.warn('VOD API unreachable, using local demo state:', e);
    }
  }
  return { allow: canAccessDemo(videoId, userParams && userParams.batch_id) };
}

async function toggleVideoLock(id){
  const rule = VOD_ACCESS[id];
  if(!rule) return;
  const goingToLock = !rule.is_locked;

  if(VOD_API_BASE){
    try{
      const endpoint = goingToLock ? 'lock' : 'unlock';
      const res = await fetch(`${VOD_API_BASE}/admin/videos/${id}/${endpoint}`, { method:'POST' });
      if(!res.ok) throw new Error('API error');
    }catch(e){
      console.warn('VOD API unreachable, updating local demo state only:', e);
    }
  }

  rule.is_locked = goingToLock;
  const row = document.querySelector(`tr[data-vid="${id}"]`);
  if(row){
    const statusCell = row.querySelector('.vod-status');
    const lockBtn = row.querySelector('button');
    if(rule.is_locked){
      statusCell.textContent = '🔒 লকড';
      lockBtn.textContent = '🔓 আনলক করুন';
      showToast(`ভিডিও ${id} লক করা হয়েছে — সক্রিয় সেশনগুলো তাৎক্ষণিকভাবে বন্ধ হবে (প্রকৃত সিস্টেমে websocket push দিয়ে)`);
    } else {
      statusCell.textContent = '🔓 আনলকড';
      lockBtn.textContent = '🔒 লক করুন';
      showToast(`ভিডিও ${id} আনলক করা হয়েছে`);
    }
  }
  if(id === 'v3') updateNTRCABanner();
}

async function schedulePromo(id){
  const rule = VOD_ACCESS[id];
  if(!rule) return;
  const hours = prompt('কত ঘণ্টার জন্য ফ্রি প্রোমো আনলক রাখতে চান?', '2');
  if(hours === null) return;
  const h = parseFloat(hours) || 2;
  let unlockEnd = new Date(Date.now() + h * 3600000).toISOString();

  if(VOD_API_BASE){
    try{
      const res = await fetch(`${VOD_API_BASE}/admin/videos/${id}/schedule-promo`, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ hours: h })
      });
      const data = await res.json();
      if(res.ok && data.unlock_end) unlockEnd = data.unlock_end; // use server's authoritative timestamp
    }catch(e){
      console.warn('VOD API unreachable, using local demo state only:', e);
    }
  }

  rule.unlock_end = unlockEnd;
  rule.is_locked = false;
  const row = document.querySelector(`tr[data-vid="${id}"]`);
  if(row) row.querySelector('.vod-status').textContent = `⏱ প্রোমো চলছে (${h} ঘণ্টা)`;
  showToast(`প্রোমো শিডিউল হয়েছে — ${h} ঘণ্টার জন্য ফ্রি আনলক (প্রকৃত সিস্টেমে এখানেই re-engagement push/SMS/WhatsApp জব শুরু হতো)`);
  if(id === 'v3') updateNTRCABanner();
}

function updateNTRCABanner(){
  const el = document.getElementById('v3-vod-banner');
  if(!el) return;
  if(_vodCountdownTimer) clearInterval(_vodCountdownTimer);
  const rule = VOD_ACCESS.v3;
  if(rule.is_locked){
    el.innerHTML = `<div style="background:var(--red-dim);border:1px solid rgba(196,32,32,.25);border-radius:8px;padding:8px 10px;margin:8px 0;font-size:.72rem;color:var(--red);font-weight:600;">🔒 এই ক্লাসটি বর্তমানে লকড</div>`;
  } else if(rule.unlock_end && Date.now() < new Date(rule.unlock_end).getTime()){
    el.innerHTML = `<div style="background:var(--gold-dim);border:1px solid rgba(184,109,5,.3);border-radius:8px;padding:8px 10px;margin:8px 0;font-size:.72rem;color:var(--gold);font-weight:700;" id="v3-countdown-txt"></div>`;
    _vodCountdownTimer = renderCountdown(rule.unlock_end, 'v3-countdown-txt');
  } else {
    el.innerHTML = '';
  }
}

// Adapted directly from the design doc's renderCountdown() snippet
function renderCountdown(unlockEndISO, targetElId){
  const target = new Date(unlockEndISO).getTime();
  let timer;
  const tick = () => {
    const diff = target - Date.now();
    const node = document.getElementById(targetElId);
    if(!node) { clearInterval(timer); return; }
    if(diff <= 0){
      node.parentElement.innerHTML = '';
      clearInterval(timer);
      return;
    }
    const h = Math.floor(diff / 3600000), m = Math.floor((diff % 3600000) / 60000);
    node.textContent = `⏱ আর ${h} ঘণ্টা ${m} মিনিট ফ্রি দেখা যাবে — এখনই এনরোল করুন`;
  };
  timer = setInterval(tick, 60000);
  tick();
  return timer;
}

