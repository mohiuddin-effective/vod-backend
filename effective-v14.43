  <!-- ══════════════════════════════════════════════════
       SECTION 3: AI FACT CHECK DESK
  ══════════════════════════════════════════════════ -->
  <section style="background:var(--void);padding:56px 52px;">
    <div style="max-width:1400px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
        <!-- Fact Check Tool -->
        <div>
          <div style="display:inline-flex;align-items:center;gap:6px;background:var(--green-dim);border:1px solid rgba(26,138,82,.2);border-radius:20px;padding:4px 12px;font-size:.63rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:14px;">✅ Phase 4 · Fact Check Unit</div>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:700;margin-bottom:8px;">AI <em>Fact Check</em> Desk</h2>
          <p style="font-family:'Noto Serif Bengali',serif;font-size:.85rem;color:var(--text2);line-height:1.8;margin-bottom:24px;">শিক্ষা বিষয়ক কোনো তথ্য, দাবি বা সংবাদ যাচাই করতে চান? আমাদের AI-সহায়তা ফ্যাক্ট চেক ডেস্ক আপনাকে সঠিক তথ্য দিতে সাহায্য করবে।</p>

          <div style="background:var(--card);border:1.5px solid var(--border2);border-radius:var(--r2);padding:24px;">
            <div style="margin-bottom:14px;">
              <label style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);display:block;margin-bottom:8px;">যাচাই করতে চান এমন দাবি বা তথ্য লিখুন:</label>
              <textarea id="factCheckInput" placeholder="যেমন: 'বাংলাদেশে IELTS ছাড়া কানাডায় পড়া যায়' বা 'BCS প্রিলিমিনারিতে নেগেটিভ মার্কিং আছে'…" style="width:100%;min-height:100px;padding:12px 14px;border:1.5px solid var(--border2);border-radius:var(--r);font-family:'Noto Serif Bengali',serif;font-size:.83rem;color:var(--text);background:var(--void);resize:vertical;outline:none;transition:border-color .2s;" onfocus="this.style.borderColor='var(--green)'" onblur="this.style.borderColor='var(--border2)'"></textarea>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
              <span style="font-size:.7rem;color:var(--text3);font-family:'Noto Serif Bengali',serif;">দ্রুত পরীক্ষা করুন:</span>
              <button style="background:var(--deep);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-family:'Noto Serif Bengali',serif;font-size:.72rem;color:var(--text2);" onclick="setFactCheck('IELTS ছাড়া জার্মানিতে পড়া যায়')">IELTS ছাড়া জার্মানি?</button>
              <button style="background:var(--deep);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-family:'Noto Serif Bengali',serif;font-size:.72rem;color:var(--text2);" onclick="setFactCheck('বাংলাদেশে BCS পরীক্ষায় নেগেটিভ মার্কিং আছে')">BCS নেগেটিভ মার্কিং?</button>
              <button style="background:var(--deep);border:1px solid var(--border);border-radius:20px;padding:3px 10px;font-family:'Noto Serif Bengali',serif;font-size:.72rem;color:var(--text2);" onclick="setFactCheck('Fulbright scholarship শুধু PhD-এর জন্য')">Fulbright শুধু PhD?</button>
            </div>
            <button class="btn-green" id="factCheckBtn" onclick="runFactCheck()" style="display:flex;align-items:center;gap:8px;">✅ তথ্য যাচাই করুন</button>
            <div id="factCheckLoading" style="display:none;margin-top:14px;align-items:center;gap:8px;">
              <div class="eval-spinner" style="border-top-color:var(--green);"></div>
              <span style="font-family:'Noto Serif Bengali',serif;font-size:.8rem;color:var(--green);">AI তথ্য যাচাই করছে…</span>
            </div>
            <div id="factCheckResult" style="display:none;margin-top:16px;"></div>
          </div>
        </div>

        <!-- Education Data Center -->
        <div>
          <div style="display:inline-flex;align-items:center;gap:6px;background:var(--indigo-dim);border:1px solid rgba(11,69,168,.2);border-radius:20px;padding:4px 12px;font-size:.63rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--indigo);margin-bottom:14px;">📊 Phase 4 · Data Center</div>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:700;margin-bottom:8px;">Education <em>Data Center</em></h2>
          <p style="font-family:'Noto Serif Bengali',serif;font-size:.85rem;color:var(--text2);line-height:1.8;margin-bottom:24px;">বাংলাদেশের শিক্ষা খাতের সবচেয়ে গুরুত্বপূর্ণ পরিসংখ্যান ও তথ্য একটি জায়গায়।</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="data-stat-card" style="border-color:rgba(11,69,168,.2);">
              <div class="dsc-icon" style="background:var(--indigo-dim);color:var(--indigo);">🎓</div>
              <div class="dsc-val" style="color:var(--indigo);">৪.৬ কোটি</div>
              <div class="dsc-label">মোট শিক্ষার্থী</div>
              <div class="dsc-change pos">▲ ৩.২% (২০২৫)</div>
            </div>
            <div class="data-stat-card" style="border-color:rgba(26,138,82,.2);">
              <div class="dsc-icon" style="background:var(--green-dim);color:var(--green);">📚</div>
              <div class="dsc-val" style="color:var(--green);">৭৩%</div>
              <div class="dsc-label">সাক্ষরতার হার</div>
              <div class="dsc-change pos">▲ ২.১% (২০২৫)</div>
            </div>
            <div class="data-stat-card" style="border-color:rgba(184,109,5,.2);">
              <div class="dsc-icon" style="background:var(--gold-dim);color:var(--gold);">🏫</div>
              <div class="dsc-val" style="color:var(--gold);">১,৫৮,৭৩৪</div>
              <div class="dsc-label">মোট শিক্ষাপ্রতিষ্ঠান</div>
              <div class="dsc-change pos">▲ ১.৮%</div>
            </div>
            <div class="data-stat-card" style="border-color:rgba(91,53,181,.2);">
              <div class="dsc-icon" style="background:var(--purple-dim);color:var(--purple);">🌍</div>
              <div class="dsc-val" style="color:var(--purple);">৮৫,০০০+</div>
              <div class="dsc-label">বিদেশে শিক্ষার্থী</div>
              <div class="dsc-change pos">▲ ১২.৪%</div>
            </div>
            <div class="data-stat-card" style="border-color:rgba(0,122,148,.2);">
              <div class="dsc-icon" style="background:var(--teal-dim);color:var(--teal);">👩‍🏫</div>
              <div class="dsc-val" style="color:var(--teal);">৫.৩ লাখ</div>
              <div class="dsc-label">নিবন্ধিত শিক্ষক</div>
              <div class="dsc-change neg">▼ ০.৪%</div>
            </div>
            <div class="data-stat-card" style="border-color:rgba(196,32,32,.2);">
              <div class="dsc-icon" style="background:var(--red-dim);color:var(--red);">💰</div>
              <div class="dsc-val" style="color:var(--red);">GDP ২%</div>
              <div class="dsc-label">শিক্ষা বাজেট</div>
              <div class="dsc-change neg">▼ লক্ষ্য ৬% থেকে কম</div>
            </div>
          </div>
          <button class="btn-outline" style="width:100%;margin-top:14px;font-size:.78rem;" onclick="go('research')">📊 সম্পূর্ণ ডেটা ড্যাশবোর্ড দেখুন →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
       SECTION 4: ECOSYSTEM CROSS-LINKS
  ══════════════════════════════════════════════════ -->
  <section style="background:var(--deep);padding:48px 52px;">
    <div style="max-width:1400px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:32px;">
        <div style="font-size:.63rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Ecosystem Integration</div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.9rem;font-weight:700;">সংবাদ থেকে <em>সরাসরি কাজে লাগান</em></h2>
        <p style="font-family:'Noto Serif Bengali',serif;font-size:.83rem;color:var(--text2);margin-top:8px;">Effective News পড়ে সাথে সাথে সংশ্লিষ্ট কোর্স, চাকরি, স্কলারশিপ ও গবেষণায় যোগ দিন</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
